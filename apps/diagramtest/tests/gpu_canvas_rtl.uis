#!args --rtl --verify-dirty
#!lock desktop
# a mirrored window: the canvas stays on the CPU, pan and zoom as without tiles (GPU.md "Leinwände").
# Without a GPU `gpu` prints a SKIP once and does nothing.
system env jfgui_GPU_VALIDATE 1
theme light
gpu on
gpu expect gpu
gpu expect same
drag 550,388 450,338 middle
gpu expect apart 0
gpu expect same
wheel 550,388 120 ctrl
gpu expect apart 0
gpu expect tiles 0
gpu expect same
gpu off
quit
