#!args --font-dirs "lib/doc_view/assets;apps/fonttest/tests/fixtures" --fontconf apps/fontpicktest/tests/fonts.conf --font-rgba rgb
# jfgui_FONT_RGBA=rgb: subpixel smoothing (text/lcd.rs) on the window's framebuffer, red on
# the left of each pixel; fonttest --selftest checks the pixels (BGR is RGB mirrored)
expect text:"Subpixel: RGB" exists
expect text:"Glättung: an  Dialog: 0" exists
shot build/fontpick_subpixel_rgb.png 16 16 400 120
expect_nowarn
