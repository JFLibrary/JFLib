# tools/package.py: setup.exe (Windows) and .deb (Linux) of PaintCraft
display=PaintCraft
version=0.1.0
publisher=JFLib
license=MIT
summary=Bildbearbeitung mit Ebenen und Effekten
description=Bildbearbeitung mit Ebenen, Effekten, PSD-Rasterebenen, dynamischen Bildpinseln und vielen Bildformaten, geschrieben in Rust mit JFLib.
generic=Bildbearbeitung
categories=Graphics;2DGraphics;RasterGraphics;
deb_name=PaintCraft
# Flatpak, AppStream and the MSIX identity: the author's apps use jfreund.org (docs/PACKAGING.md)
app_id=org.jfreund.PaintCraft
homepage=https://github.com/JFLibrary/JFLib
default_win=winui
default_linux=kde
styles=winui classic macos kde
# "Open with" for these types (no "own": PaintCraft does not take them over); a second start
# opens its files as tabs of the running window (AF_SINGLE_INSTANCE)
filetypes=png|image/png|PNG-Bild; jpg,jpeg,jpe,jfif|image/jpeg|JPEG-Bild; bmp,dib|image/bmp|Bitmap; gif|image/gif|GIF-Bild; webp|image/webp|WebP-Bild; tif,tiff|image/tiff|TIFF-Bild; tga|image/x-tga|TGA-Bild; dds|image/vnd-ms.dds|DDS-Textur; avif|image/avif|AVIF-Bild; heic,heif|image/heif|HEIF-Bild; jxl|image/jxl|JPEG-XL-Bild; jxr,wdp,hdp|image/jxr|JPEG-XR-Bild; pdn|image/x-paint.net|Paint.NET-Bild; psd|image/vnd.adobe.photoshop|Photoshop-Bild
