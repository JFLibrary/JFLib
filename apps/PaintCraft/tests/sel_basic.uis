cmd 750
drag 250,158 350,258
expect #9981 text "10,10,110,110"
cmd 968 19661200        # (400, 300)
expect #9901 value 2
expect #9981 value 0
key ctrl+a
expect #9981 text "0,0,400,300"
cmd 969 0
expect #9981 text "10,10,110,110"
cmd 969 1
expect #9981 text "0,0,400,300"
key ctrl+w
expect #9901 value 1
expect #9981 text "10,10,110,110"
cmd 968 13107500        # (300, 200)
expect #9981 value 0
key ctrl+w
expect #9901 value 1
expect #9981 text "10,10,110,110"
