# the second layer was resized too
cmd 314 1
cmd 313 0
expect #5190 text "51FFFFFF"
cmd 313 65539
expect #5190 text "00000000"
cmd 314 0
key ctrl+z
cmd 962 1
expect text:"t.cmp=ok" exists
# 8 x 6 -> 11 x 9, probe (4, 0)
cmd 310 589835
