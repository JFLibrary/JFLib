expect window 24608 closed
expect #4392 value 3
expect #4391 text "Ebeneneigenschaften"
expect #9906 text "Größe Übersicht"
expect #9908 value 1
expect #9907 value 128
cmd 900 0
expect #9900 text "FF8C5330"
window 24579
expect text:"Größe Übersicht" exists
window any
# one Strg+Z restores name, mode and opacity together
key ctrl+z
expect #4391 text "Als Ebene importieren"
expect #9906 text "l4_hi.png"
expect #9908 value 0
expect #9907 value 255
cmd 900 0
expect #9900 text "FF5A8BC7"
key ctrl+y
expect #9906 text "Größe Übersicht"
expect #9908 value 1
expect #9907 value 128

# ------------------------------------------------------------ Abbrechen / Esc restore everything
key f4
expect #5403 value 1
expect #5404 value 128
click #5403
click listitem:"Differenz"
click #1610699201
key ctrl+a
type "51"
key enter
click #5402
click #5401
key ctrl+a
type "weg"
expect #9906 text "weg"
expect #9908 value 8
click button:"Abbrechen"
expect window 24608 closed
expect #9906 text "Größe Übersicht"
expect #9906 value 1
expect #9908 value 1
expect #9907 value 128
expect #4392 value 3
cmd 900 0
expect #9900 text "FF8C5330"
key f4
click #5403
click listitem:"Normal"
expect #9908 value 0
key esc
expect window 24608 closed
expect #9908 value 1
expect #4392 value 3
# unchanged OK: no step
key f4
click button:"OK"
expect #4392 value 3
# the menu item and the layers window button open it too
click menu:"Ebenen"
click menuitem:"Ebeneneigenschaften…"
expect window 24608 open
key esc
click #4207
expect window 24608 open
# opacity with the keyboard (slider focused), then OK
click #1610699201
key ctrl+a
type "51"
key enter
click button:"OK"
expect #9907 value 51
cmd 900 0
expect #9900 text "FFB05D31"
cmd 900 3
expect #9900 text "FF7C6570"
expect #4392 value 4
