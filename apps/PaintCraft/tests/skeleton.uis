# ------------------------------------------------------------ keyboard: Alt, mnemonics
key alt+k
expect menu:"Korrekturen" open
key esc esc
key alt+i
expect menu:"Bild" open
key esc esc

# ------------------------------------------------------------ Hilfe flyout (button and Alt+H)
click #711
expect menuitem:"Dokumentation" enabled
