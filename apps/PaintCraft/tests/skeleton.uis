# skeleton.uis -- PaintCraft skeleton (agent A0): window chrome, all seven menus with their
# items and states, accelerators, tool keys, tool bar tooltips, status bar combo boxes,
# theme switch.  Run: build/win/PaintCraft.exe --script apps/PaintCraft/tests/skeleton.uis
theme light
size 1280 800

# ------------------------------------------------------------ chrome
expect menu:"Datei" exists
expect menu:"Bearbeiten" exists
expect menu:"Ansicht" exists
expect menu:"Bild" exists
expect menu:"Ebenen" exists
expect menu:"Korrekturen" exists
expect menu:"Effekte" exists
expect tab:"Unbenannt" selected
expect #1300 exists
# window toggles (all four tool windows start visible), settings, help
expect #700 checked
expect #701 checked
expect #702 checked
expect #703 checked
expect #710 enabled
expect #711 enabled
# tool bar row 1: file commands (A1) and the view toggles work
expect #100 enabled
expect #101 enabled
expect #102 enabled
expect #106 enabled               # PR1: Drucken… with an image
expect #160 enabled               # K1: Ausschneiden / Kopieren with an image
expect #161 enabled
expect #163 disabled              # Einfügen: the (headless) clipboard is empty
expect #270 disabled
expect #181 disabled
expect #150 disabled
expect #151 disabled
expect #225 unchecked
expect #226 unchecked
# tool row and status bar
expect text:"Werkzeug:" exists
expect #1010 exists
expect text:"Pinselgröße:" exists
expect #2000 value 2
expect text:"Farbpinsel: Mit der linken Maustaste malt der Pinsel in der Primärfarbe, mit der rechten in der Sekundärfarbe." exists
expect text:"800 × 600" exists
expect #1024 value 0
expect combo:"Pixel" exists
expect combo:"100%" exists
expect #1400 exists

# ------------------------------------------------------------ Datei
click menu:"Datei"
expect menu:"Datei" open
expect menuitem:"Neu…" enabled
expect menuitem:"Öffnen…" enabled
expect menuitem:"Zuletzt geöffnet" enabled
expect menuitem:"Übernehmen" enabled
expect menuitem:"Speichern" enabled
expect menuitem:"Speichern unter…" enabled
expect menuitem:"Alles speichern" enabled
expect menuitem:"Schließen" enabled
expect menuitem:"Drucken…" enabled
expect menuitem:"Beenden" enabled
move menuitem:"Zuletzt geöffnet"
expect menuitem:"Zuletzt geöffnet" open
expect menuitem:"(Keine)" disabled
expect menuitem:"Liste leeren" disabled
expect menuitem:"1" missing
move menuitem:"Übernehmen"
expect menuitem:"Übernehmen" open
expect menuitem:"Von Scanner/Kamera…" enabled
key esc esc
expect menuitem:"Neu…" missing

# ------------------------------------------------------------ Bearbeiten
click menu:"Bearbeiten"
expect menuitem:"Rückgängig" disabled
expect menuitem:"Wiederholen" disabled
expect menuitem:"Ausschneiden" enabled
expect menuitem:"Kopieren" enabled
expect menuitem:"Sichtbares kopieren" enabled
expect menuitem:"Einfügen" disabled
expect menuitem:"Einfügen als neue Ebene" disabled
expect menuitem:"Einfügen als neues Bild" disabled
expect menuitem:"Auswahl kopieren" disabled
expect menuitem:"Alles auswählen" enabled
expect menuitem:"Auswahl aufheben" disabled
expect menuitem:"Auswahl löschen" disabled
expect menuitem:"Auswahl füllen" disabled
expect menuitem:"Auswahl umkehren" disabled
expect menuitem:"Verlauf löschen" disabled
move menuitem:"Auswahl einfügen"
expect menuitem:"Auswahl einfügen" open
expect menuitem:"Ersetzen" disabled
expect menuitem:"Hinzufügen (Union)" disabled
expect menuitem:"Ausschließen" disabled
expect menuitem:"Schneiden" disabled
expect menuitem:"Umkehren (\"xor\")" disabled
move menuitem:"Palette"
expect menuitem:"Palette" open
expect menuitem:"Ordner mit Paletten öffnen…" enabled
expect menuitem:"Palette öffnen…" enabled
expect menuitem:"Palette speichern als…" enabled
expect menuitem:"Standardpalette laden" enabled
key esc esc

# ------------------------------------------------------------ Ansicht
click menu:"Ansicht"
expect menuitem:"Vergrößern" enabled
expect menuitem:"Verkleinern" enabled
expect menuitem:"Ganzes Bild" enabled
expect menuitem:"Auf Auswahl zoomen" disabled
expect menuitem:"Originalgröße" enabled
expect menuitem:"Pixel-Raster" unchecked
expect menuitem:"Lineale" unchecked
expect menuitem:"Pixel" checked
expect menuitem:"Zoll" unchecked
expect menuitem:"Zentimeter" unchecked
click menuitem:"Pixel-Raster"
expect menuitem:"Pixel-Raster" missing
expect #225 checked
click menu:"Ansicht"
expect menuitem:"Pixel-Raster" checked
click menuitem:"Zentimeter"
expect #1024 value 2
expect text:"21,17 × 15,88" exists
click menu:"Ansicht"
expect menuitem:"Zentimeter" checked
expect menuitem:"Pixel" unchecked
click menuitem:"Pixel"
expect text:"800 × 600" exists

# ------------------------------------------------------------ Bild
click menu:"Bild"
expect menuitem:"Auf Auswahl zuschneiden" disabled
expect menuitem:"Größe ändern…" enabled
expect menuitem:"Leinwandgröße…" enabled
expect menuitem:"Horizontal spiegeln" enabled
expect menuitem:"Vertikal spiegeln" enabled
