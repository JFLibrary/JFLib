expect menuitem:"Fehler melden oder Feedback geben…" enabled
expect menuitem:"Info" enabled
key esc
expect menuitem:"Info" missing
key alt+h
expect menuitem:"Info" exists
key esc

# ------------------------------------------------------------ window toggles: click and F5..F8
click #700
expect #700 unchecked
key f5
expect #700 checked
key f6
expect #701 unchecked
key f7
expect #702 unchecked
key f8
expect #703 unchecked
key f6 f7 f8
expect #701 checked
expect #702 checked
expect #703 checked

