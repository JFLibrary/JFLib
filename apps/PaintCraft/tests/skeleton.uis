# ------------------------------------------------------------ disabled accelerators do nothing
# (focus on the canvas: a focused drop-down would take F4 itself)
click 100,700
key ctrl+z ctrl+y ctrl+a ctrl+d delete ctrl+f
expect tab:"Unbenannt" selected
expect #700 checked

# ------------------------------------------------------------ tooltips
move #225
wait 600
expect text:"Pixel-Raster" exists
move #700
wait 50
expect text:"Werkzeuge (F5)" exists
move #1400
wait 50
expect text:"Werkzeuge (F5)" missing

# ------------------------------------------------------------ cursor position over the image
move 640,448
expect text:"400, 300" exists

# ------------------------------------------------------------ rulers toggle
# (the canvas shrinks by the ruler bands: the same point is another image pixel)
click #226
expect #226 checked
move 640,448
expect text:"390, 290" exists
click #226
expect #226 unchecked

# ------------------------------------------------------------ theme switch
theme dark
expect menu:"Datei" exists
expect tab:"Unbenannt" selected
theme light
expect #225 checked
