#!args --open apps/PaintCraft/tests/fixtures/a6_photo.png
# fx_all.uis -- every registered effect from its menu row with its default parameters
# (agent A6): the preview (dialog effects) or the committed layer (effects without a
# dialog) equals efftest --fx NAME on a6_photo.png, bit-identical (FNV-1a 64, hook 995).
# Generated by tests/fixtures/make_a6.py --fx-all; palette colours are the defaults
# (black / white) like efftest's.
size 1280 800
theme light
# Automatisch (auto_level)
cmd 380
cmd 995 0
expect #9990 text "cc42e279e7993d68"
key ctrl+z
# Schwarzweiß (black_white)
cmd 381
