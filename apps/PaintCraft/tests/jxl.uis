#!args --open apps/PaintCraft/tests/fixtures/a1_rgba.jxl
# jxl.uis -- JPEG XL import (jxl*.s): a1_rgba.jxl is a1_rgba.png as lossless JPEG XL (modular, alpha
# extra channel; tests/fixtures/make_fixtures.py).  Displayed: red / half transparent green on top,
# blue / white below, the transparent 8 x 8 hole at (48, 32).
size 1280 800
theme light
expect tab:"a1_rgba.jxl" selected
expect #9913 value 64
expect #9914 value 48
expect text:"64 × 48" exists
cmd 900 0
expect #9900 text "FFFF0000"
cmd 900 40
expect #9900 text "8000FF00"
cmd 900 2621450
expect #9900 text "FF0000FF"
cmd 900 2293800
expect #9900 text "FFFFFFFF"
cmd 900 2228274
expect #9900 text "00000000"
cmd 900 2555959
expect #9900 text "00000000"
cmd 900 2621496
expect #9900 text "FFFFFFFF"
