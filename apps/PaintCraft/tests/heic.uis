#!args --open apps/PaintCraft/tests/fixtures/a1_rgba.heic
# heic.uis -- HEIC import (heic.s): a1_rgba.heic is a1_rgba.png as lossless 4:4:4 HEVC
# (identity matrix, full range) with an alpha item, rotated by 180 degrees through irot
# (tests/fixtures/make_fixtures.py).  Displayed: white / blue on top, half transparent green /
# red below, the transparent 8 x 8 hole at (8, 8).
size 1280 800
theme light
expect tab:"a1_rgba.heic" selected
expect #9913 value 64
expect #9914 value 48
expect text:"64 × 48" exists
cmd 900 0
expect #9900 text "FFFFFFFF"
cmd 900 40
expect #9900 text "FF0000FF"
cmd 900 2621450
expect #9900 text "8000FF00"
cmd 900 2293810
expect #9900 text "FFFF0000"
cmd 900 655370
expect #9900 text "00000000"
cmd 900 983055
expect #9900 text "00000000"
cmd 900 1048592
expect #9900 text "FFFFFFFF"
