# ------------------------------------------------------------ the dialog
key ctrl+shift+r
expect window 24617 open
expect window 24617 modal
expect #5203 checked
expect #5201 unchecked
expect #5204 unchecked
expect #5205 value 6
expect #5206 value 4
expect #5212 value 4
expect #5213 value 0
expect #5224 checked
expect #5220 unchecked
expect text:"Neue Größe: 192 Bytes" exists
expect text:"Aktuelle Bildgröße: 192 Bytes" exists
# the grid sets the combo box and back
click #5220
expect #5220 checked
expect #5224 unchecked
expect #5212 value 0
click #5212
click listitem:"Rechts unten"
expect #5228 checked
expect #5212 value 8
click #5205
key ctrl+a
type "8"
key tab
click #5206
key ctrl+a
type "6"
key tab
expect text:"Neue Größe: 384 Bytes" exists
click #5213
click listitem:"Transparent"
expect #5213 value 2
click button:"OK"
expect window 24617 closed
expect #9913 value 8
expect #9914 value 6
cmd 314 0
cmd 313 131074
expect #5190 text "FFFF0000"
cmd 313 0
expect #5190 text "00000000"
key ctrl+z
# remembered: Rechts unten, Transparent; Prozentual 200 % with Mitte and Sekundärfarbe
key ctrl+shift+r
expect #5228 checked
expect #5213 value 2
click #5201
click #5202
key ctrl+a
type "200"
key tab
expect #5205 value 12
expect #5206 value 8
click #5224
click #5213
click listitem:"Sekundärfarbe"
click button:"OK"
expect #9913 value 12
expect #9914 value 8
cmd 314 0
cmd 313 131075
expect #5190 text "FFFF0000"
cmd 313 0
expect #5190 text "FF00FFFF"
key ctrl+z
cmd 962 0
expect text:"t.cmp=ok" exists
# Abbrechen / Esc change nothing
key ctrl+shift+r
click button:"Abbrechen"
expect window 24617 closed
key ctrl+shift+r
key esc
expect window 24617 closed
expect #9913 value 6
expect text:"t.pos=3" exists
# Enter in a number box = OK (the dialog remembered Prozentual: back to Absolut)
key ctrl+shift+r
expect #5201 checked
click #5203
click #5205
key ctrl+a
type "7"
key enter
expect window 24617 closed
expect #9913 value 7
expect #9914 value 8
key ctrl+z
expect #9913 value 6
