# ------------------------------------------------------------ odd growth and shrinking
# 6 x 4 -> 9 x 7, Mitte: offset (3 / 2, 3 / 2) = (1, 1)
cmd 310 458761
cmd 312 4
expect #9913 value 9
expect #9914 value 7
cmd 314 0
cmd 313 65537
expect #5190 text "FFFF0000"
cmd 313 262150
expect #5190 text "FF000000"
cmd 313 393224
expect #5190 text "FF00FFFF"
key ctrl+z
# 6 x 4 -> 3 x 2, Mitte: offset (-3 / 2, -2 / 2) = (-1, -1): new (0,0) = old (1,1)
cmd 310 131075
cmd 312 4
expect #9913 value 3
expect #9914 value 2
expect #5191 value 1
cmd 314 0
cmd 313 0
expect #5190 text "FFFFFFFF"
cmd 314 1
cmd 313 65538
expect #5190 text "00000000"
cmd 313 0
expect #5190 text "00000000"
key ctrl+z
# Rechts unten: new (2,1) = old (5,3) (black), new (0,0) = old (3,2)
cmd 312 8
cmd 314 0
cmd 313 65538
expect #5190 text "FF000000"
key ctrl+z
# Links oben: new (0,0) = old (0,0) (red), layer 1 (1,0) yellow
cmd 312 0
cmd 314 0
cmd 313 0
expect #5190 text "FFFF0000"
cmd 314 1
cmd 313 1
expect #5190 text "FFFFFF00"
key ctrl+z
# wider but lower: 10 x 2, Unten: offset (2, -2)
cmd 310 131082
cmd 312 7
expect #9913 value 10
expect #9914 value 2
cmd 314 0
cmd 313 65538
expect #5190 text "FF0000FF"
cmd 313 65543
expect #5190 text "FF000000"
cmd 313 65545
expect #5190 text "FF00FFFF"
key ctrl+z
cmd 962 0
expect text:"t.cmp=ok" exists

