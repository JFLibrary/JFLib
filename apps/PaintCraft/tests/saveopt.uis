# JPEG XL: Qualität 90 (VarDCT, jxl_venc.s), Verlustfrei (modular, jxl_enc.s); quality 1 gives a
# smaller file, lossless a larger one; OK writes the lossless file
cmd 103
click #81932
key ctrl+a
type "so.jxl"
click button:"Speichern"
expect window 24595 open
window 24595
expect #6022 value 90
expect #6023 unchecked
sync
expect #6100 text "ok"
focus #6022
key home
sync
expect #6022 value 1
expect #6101 text "kleiner"
