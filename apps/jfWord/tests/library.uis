click #1110
expect #1102 text "Bibliotheksmethoden · Institut · 2030 · ID 1"
# The reviewed backup restores a removed record and resets library history.
click #1106
click "Aus Bibliothek entfernen"
click #1113
expect "1 Quelle in der letzten Sicherung" exists
click "Zurück"
expect "0 von 0 Bibliotheksquellen" exists
click #1113
theme dark
scale 150
shot build/jfword-library-recovery-dark-150.png
click "Sicherung wiederherstellen"
