click #713
key ctrl+a
type "2030"
click "Quelle übernehmen"
cmd 18
click #1109
click #1120
click "Dokument → Bibliotheksquelle"
click #1125
click "Jahr"
expect #1128 unchecked
click #1128
click "Bibliotheksquelle aktualisieren"
