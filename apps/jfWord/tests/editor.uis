#!args --editor --structure --sources --navigation
# Formatting selected UTF-8 text, literal replacement, page setup, preview and DOCX reload.
size 1240 840
theme light
click #10000
type "Alpha Forschung Omega. Forschung bleibt."
key ctrl+home right right right right right right
key shift+right shift+right shift+right shift+right shift+right shift+right shift+right shift+right shift+right
click "Fett"
expect textbox:"Forschung" exists
expect "Textsegment · 11 pt · Fett" exists
key ctrl+i
expect "Textsegment · 11 pt · Fett · Kursiv" exists
key ctrl+u
expect "Textsegment · 11 pt · Fett · Kursiv · Unterstrichen" exists
focus #35
key enter
click #820
type "Forschung"
click #821
type "Analyse"
click "Nächster Treffer"
expect "Treffer 1 von 2" exists
click "Alle ersetzen"
expect "2 Treffer ersetzt · ein Rückgängig-Schritt" exists
expect "Textsegment · 11 pt · Fett · Kursiv · Unterstrichen" exists
cmd 5
expect "Textsegment · 11 pt · Fett · Kursiv · Unterstrichen" exists
cmd 6
expect "Textsegment · 11 pt · Fett · Kursiv · Unterstrichen" exists
click "Schließen"
click #2874
expect dialog:"Absatz formatieren" exists
click #855
click "1,5-fach"
click "Übernehmen"
click "Zentriert"
click "Layout"
click #36
expect dialog:"Seite einrichten" exists
click #861
click "Querformat"
click #862
click "US Letter"
click "Übernehmen"
click #36
click #863
key ctrl+a
type "100"
key tab
click #864
key ctrl+a
type "100"
key tab
click "Übernehmen"
expect dialog:"Seite einrichten" exists
expect "Bitte kleinere Ränder wählen; Textbereich oder Absatzeinzüge passen nicht." exists
click "Abbrechen"
cmd 7
type "Zweite Seite mit Quellen."
click #3023
click #44
click #48
expect "2 Seiten" exists
expect "Seite 1 von 2" exists
shot build/jfword-preview-landscape.png
click "Weiter"
expect "Seite 2 von 2" exists
click #126
click "100 %"
expect "Seite 2 von 2" exists
click #48
expect textbox:"Zweite Seite mit Quellen." exists
cmd 4
click #1048588
key ctrl+a
type "build/jfword-editor.docx"
click button:"Speichern"
click "Ersetzen"
cmd 2
click button:"Öffnen"
expect "Dokument geöffnet · Quellen und Zitatverweise geladen" exists
expect "Textsegment · 11 pt · Fett · Kursiv · Unterstrichen" exists
click #48
expect "2 Seiten" exists
theme dark
scale 150
shot build/jfword-preview-dark-150.png
expect_nowarn
