# Search also reaches notes and marks a query spanning separate format runs.
size 1240 840
scale 100
theme light
cmd 23
type "Anmerkung "
key ctrl+b
type "α in zwei Formaten."
expect textbox:"Anmerkung α in zwei Formaten." focused
cmd 25
click #2501
key ctrl+a
type "Anmerkung α"
expect text:"1 Treffer" exists
click #5439488
expect "Fußnote 1 bearbeiten" exists
expect textbox:"Anmerkung α in zwei Formaten." focused
expect textbox:"Anmerkung α in zwei Formaten." value 12
expect textbox:"Anmerkung α in zwei Formaten." max 0
shot build/jfword-navigation-note.png
expect_nowarn
