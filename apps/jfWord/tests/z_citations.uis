#!args --editor --structure --sources --navigation
# Structured citations at a UTF-8 caret, multi-source drafts, navigation and DOCX reload.
size 1240 840
theme light
cmd 9
click #712
type "Alpha"
click #713
type "2020"
click "Autoren"
click #2097154
type "Müller"
click "Quelle übernehmen"
cmd 9
click #712
type "Beta"
click #713
type "2024"
click "Autoren"
click #2097154
type "Meier"
click "Quelle übernehmen"
click #400
click "Alpha"
click #10000
type "Äpfel Ende"
key ctrl+home right right right right right right
click #403
expect textbox:"Äpfel " exists
expect textbox:"Ende" exists
expect "(Müller, 2020)" exists
click button:"Zitat bearbeiten"
expect dialog:"Zitat bearbeiten" exists
key ctrl+n ctrl+s ctrl+o
expect dialog:"Zitat bearbeiten" exists
click #957
type "5"
click #958
type "vgl. "
click #959
type " ff."
click #952
click #956
click "Beta · Meier · 2024"
click #961
