cmd 5
expect "(Müller, 2020)" exists
cmd 6
expect "(Meier; vgl. Müller, 2020, S. 5 ff.)" exists
click button:"Zitat bearbeiten"
click #959
type " verworfen"
click "Abbrechen"
expect "(Meier; vgl. Müller, 2020, S. 5 ff.)" exists
# Deletion protection covers the second item of a multi-source field too.
cmd 11
expect "Quelle wird zitiert. Zitate zuerst entfernen." exists
cmd 7
type "Zweiter Absatz"
click #408
expect dialog:"Verwendungen der Quelle" exists
expect "1 Zitatfelder · Seite 1 von 1" exists
key ctrl+z ctrl+n
expect dialog:"Verwendungen der Quelle" exists
click #1900
expect "Verwendung in Absatz 1 ausgewählt" exists
expect button:"Zitat bearbeiten" focused
expect textbox:"Äpfel " exists
expect textbox:"Ende" exists
cmd 4
click #1048588
key ctrl+a
type "build/jfword-ui-roundtrip.docx"
click button:"Speichern"
click "Ersetzen"
cmd 2
click button:"Öffnen"
expect "Dokument geöffnet · Quellen und Zitatverweise geladen" exists
expect "(Meier; vgl. Müller, 2020, S. 5 ff.)" exists
click button:"Zitat bearbeiten"
click #958
type "bad\"value"
click "Zitat übernehmen"
expect dialog:"Zitat bearbeiten" exists
click #958
key ctrl+a
key backspace
click #953
expect "(vgl. Müller, 2020, S. 5 ff.)" exists
