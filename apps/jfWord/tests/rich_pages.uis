#!args --editor --navigation --file build/jfword-rich-pages.docx
# The imported paragraph spans several pages and has mixed format, Unicode and justification.
size 1240 840
theme light
expect #3145729 exists
expect #10000 exists
click #10000
key ctrl+end
type " ENDE"
expect #10000 focused
shot build/jfword-rich-last-page.png
key shift+home
shot build/jfword-rich-last-line-selection.png
key ctrl+home
expect #10000 value 0
key down
shot build/jfword-rich-first-page.png
size 1000 700
scale 150
theme dark
key ctrl+end
expect #10000 focused
shot build/jfword-rich-last-page-dark-150.png
scale 100
size 1240 840
cmd 4
click #1048588
key ctrl+a
type "jfword-rich-pages-edited.docx"
click button:"Speichern"
click "Ersetzen"
expect_nowarn
