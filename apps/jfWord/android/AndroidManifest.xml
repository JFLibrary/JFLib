<?xml version="1.0" encoding="utf-8"?>
<!-- jfWord on Android (docs/ANDROID.md, AN5): the shared Java host (android/*.java, package
     org.jflib.gallery) under the app's own package.  No permission: documents come and go through
     the system's picker (content:// names), printing through the PrintManager, the fonts from
     /system/fonts; jfWord opens no sockets. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.jfreund.jfWord" android:versionCode="1" android:versionName="0.1.0">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="jfWord" android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:extractNativeLibs="false"
        android:supportsRtl="true">
        <activity android:name="org.jflib.gallery.GalleryActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
