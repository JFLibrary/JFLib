# apps/JFDiagrammer/PACKAGE: the app's identity and packages (docs/PACKAGING.md)
#   python tools/package.py JFDiagrammer --formats all
# version= is the app's own version (MAJOR.MINOR.PATCH, docs/VERSIONING.md); the program reads it
# as rt::app_version!(), the packages and lib/update use it.  The library has its own (Cargo.toml).
display=JFDiagrammer
version=0.1.0
publisher=JFLib
license=MIT OR Apache-2.0
summary=Diagramme, Flussdiagramme und Netzwerkpläne zeichnen
description=Diagramme zeichnen wie in Visio: Shapes aus Schablonen, Verbinder, Container und Designs; öffnet und speichert Visio-Zeichnungen (.vsdx), geschrieben in Rust mit JFLib.
generic=Diagrammeditor
categories=Office;Graphics;VectorGraphics;
deb_name=jfdiagrammer
# Flatpak, AppStream and the MSIX identity: the author's apps use jfreund.org (docs/PACKAGING.md)
app_id=org.jfreund.JFDiagrammer
homepage=https://github.com/JFLibrary/JFLib/tree/main/apps/JFDiagrammer
default_win=netlab
default_linux=netlab
styles=netlab
# file types ("Open with"): drawings and stencils open, a template starts a new drawing (JD13,
# VL-03); the MIME types are the system's (shared-mime-info knows them), so none is "own"
filetypes=vsdx|application/vnd.ms-visio.drawing.main+xml|Visio-Zeichnung; vsdm|application/vnd.ms-visio.drawing.macroenabled.main+xml|Visio-Zeichnung mit Makros; vssx|application/vnd.ms-visio.stencil.main+xml|Visio-Schablone; vssm|application/vnd.ms-visio.stencil.macroenabled.main+xml|Visio-Schablone mit Makros; vstx|application/vnd.ms-visio.template.main+xml|Visio-Vorlage; vstm|application/vnd.ms-visio.template.macroenabled.main+xml|Visio-Vorlage mit Makros
