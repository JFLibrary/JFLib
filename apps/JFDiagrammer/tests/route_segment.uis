#!args --no-system-fonts
# JFDiagrammer, JD21 route (CN-04): a selected dynamic connector shows a midpoint on each piece
# ("Mittelpunkt n", hidden on pieces shorter than 24 DIP) and a vertex at each bend.  (JD21v) The
# L leaves the upper shape at its bottom and comes into the lower one's left side, as Visio 16
# lays it.  Its upright piece dragged right moves across only (right angles stay); at the end a
# stub stays on the shape and a jog carries the piece.  The way is kept when the shape moves
# (ConFixedCode 1).  The last piece dragged up: a stub at the end and a jog.  Undo takes it back.
# The line tool's Ctrl + click adds a vertex on a piece, a click on the vertex and Del removes it
# again; Verbinder zurücksetzen lays the way anew (as before the edits).
cmd 4404
drag 500,330 640,420
drag 820,530 960,620
cmd 4401
drag 560,370 880,570
cmd 4400
expect listitem:"Sheet.6" selected
expect listitem:"Sheet.6" rect 576 424 251 154
expect button:"Mittelpunkt 1" rect 571 495 10 10
expect button:"Mittelpunkt 2" rect 696 570 10 10
expect button:"Scheitelpunkt 1" rect 571 570 10 10
expect button:"Scheitelpunkt 2" missing
# the upright piece dragged right: across only, a jog under the first shape
drag button:"Mittelpunkt 1" 640,500
expect listitem:"Sheet.6" rect 576 424 251 154
expect button:"Scheitelpunkt 1" rect 571 429 10 10
expect button:"Scheitelpunkt 2" rect 646 429 10 10
expect button:"Scheitelpunkt 3" rect 646 570 10 10
expect button:"Mittelpunkt 1" missing
expect button:"Mittelpunkt 2" rect 608 429 10 10
expect button:"Mittelpunkt 3" rect 646 499 10 10
expect button:"Mittelpunkt 4" rect 734 570 10 10
expect button:"Scheitelpunkt 4" missing
# the second shape moves down: the upright piece stays where it was dragged
drag 900,580 900,640
expect listitem:"Sheet.5" selected
expect listitem:"Sheet.6" rect 576 424 251 204
click 760,625
expect listitem:"Sheet.6" selected
expect button:"Scheitelpunkt 2" rect 646 429 10 10
expect button:"Scheitelpunkt 3" rect 646 620 10 10
expect button:"Mittelpunkt 4" rect 734 620 10 10
# the last piece dragged up: a stub at the second shape, then a jog
drag button:"Mittelpunkt 4" 760,600
expect listitem:"Sheet.6" rect 576 424 251 204
expect button:"Scheitelpunkt 3" rect 646 595 10 10
expect button:"Scheitelpunkt 4" rect 813 595 10 10
expect button:"Scheitelpunkt 5" rect 813 620 10 10
shot build/JFDiagrammer-route-segment.png
key ctrl+z
expect listitem:"Sheet.6" rect 576 424 251 204
expect button:"Scheitelpunkt 4" missing
# the line tool: Ctrl + click on the last piece adds a vertex, Del removes it
cmd 4406
click 760,625 ctrl
expect listitem:"Sheet.6" selected
expect button:"Scheitelpunkt 4" rect 756 620 10 10
expect button:"Mittelpunkt 4" rect 701 620 10 10
expect button:"Mittelpunkt 5" rect 789 620 10 10
cmd 4400
click button:"Scheitelpunkt 4"
key delete
expect listitem:"Sheet.6" exists
expect button:"Scheitelpunkt 4" missing
expect button:"Mittelpunkt 4" rect 734 620 10 10
# Verbinder zurücksetzen: laid anew, an L again
cmd 5638
expect listitem:"Sheet.6" rect 576 424 251 204
expect button:"Scheitelpunkt 1" rect 571 620 10 10
expect button:"Scheitelpunkt 2" missing
key ctrl+z
expect button:"Scheitelpunkt 2" rect 646 429 10 10
