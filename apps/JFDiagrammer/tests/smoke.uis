# JFDiagrammer, JD8: the window opens with its parts -- the own title bar with the quick access
# toolbar, the register row (File and the four registers), the ribbon, the Shapes panel, the
# canvas with its page tab, the status bar.  German, the source language (lang_*.uis: the
# other four)
expect tab:"Datei" exists
expect tab:"Start" selected
expect tab:"Einfügen" unselected
expect tab:"Entwurf" exists
expect tab:"Ansicht" exists
# no selection: no context registers
expect tab:"Format" missing
# the quick access toolbar: a new drawing can be saved (JD7), there is nothing to undo yet
expect button:"Speichern" enabled
expect button:"Rückgängig" disabled
expect button:"Wiederholen" disabled
# the ribbon of Start: every P1 group, the commands disabled until their function exists or
# while they have nothing to work on (no selection, an empty clipboard)
expect text:"Zwischenablage" exists
expect text:"Schriftart" exists
expect text:"Absatz" exists
expect text:"Tools" exists
expect text:"Formenarten" exists
expect text:"Anordnen" exists
expect text:"Bearbeiten" exists
expect button:"Einfügen" disabled
expect button:"Ausschneiden" disabled
expect button:"Fett" disabled
expect button:"Zeigertool" enabled
expect button:"Zeigertool" checked
expect button:"Ausrichten" disabled
# the dialog launchers
expect button:"Shape formatieren: Formenarten" enabled
expect button:"Text: Schriftart" disabled
# the Shapes panel, the canvas, the page tab, the status bar
expect tab:"Shapes" exists
expect text:"Keine Schablone geöffnet." exists
expect button:"Weitere Shapes" enabled
expect canvas:"Zeichenfläche" exists
expect tab:"Seite-1" selected
expect button:"Seite 1 von 1" exists
expect text:"67 %" exists
shot build/JFDiagrammer.png
# the registers switch the ribbon
click tab:"Einfügen"
expect tab:"Einfügen" selected
expect text:"Illustrationen" exists
expect button:"Bilder" disabled
expect text:"Zwischenablage" missing
click tab:"Entwurf"
expect text:"Seite einrichten" exists
expect text:"Varianten" exists
click tab:"Ansicht"
expect text:"Anzeigen" exists
expect button:"Aufgabenbereiche" enabled
click tab:"Start"
expect tab:"Start" selected
expect text:"Zwischenablage" exists
