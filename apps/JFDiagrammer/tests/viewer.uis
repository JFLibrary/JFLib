#!args apps/JFDiagrammer/tests/viewer.vsdx --no-system-fonts
# JFDiagrammer, JD4 (the viewer): a drawing named on the command line opens read-only -- the
# notice under the ribbon, a tab per page (the background page after the others), the page
# counter in the status bar, switching pages by tab, by Ctrl+PgDn / Ctrl+PgUp and by the list
# of all pages, zooming and fitting.  viewer.vsdx is diagramiotest's self-built pages.vsdx
# (--write-drawings): a page with themed values on a background page, a page at 1:10
expect "Schreibgeschützt geöffnet" exists
expect tab:"Seite-1" selected
expect tab:"Massstab" exists
expect tab:"Hintergrund-1" exists
expect button:"Seite 1 von 3" exists
expect canvas:"Zeichenfläche" exists
shot build/JFDiagrammer-viewer.png
# the tabs
click tab:"Massstab"
expect tab:"Massstab" selected
expect button:"Seite 2 von 3" exists
key ctrl+pgdn
expect tab:"Hintergrund-1" selected
key ctrl+pgdn
expect tab:"Seite-1" selected
key ctrl+pgup
expect tab:"Hintergrund-1" selected
# the list of all pages in the status bar
click button:"Seite 3 von 3"
click "Massstab"
expect tab:"Massstab" selected
# zoom and fit (the 6 x 4 in page fits at 100 %)
click tab:"Seite-1"
expect text:"100 %" exists
click button:"Vergrößern"
expect text:"125 %" exists
key ctrl+shift+w
expect text:"100 %" exists
