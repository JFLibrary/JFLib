# Differenzmenge von 2 Mengen (SH-007, JD26): zwei Kreise (gestreckt Ellipsen) wie bei der
# Schnittmenge (intersection_2.master: Mitten bei einem und zwei Dritteln der Breite, je zwei
# Drittel breit, Schnittpunkte bei halber Breite, ±0,433 der Höhe um die Mitte), gefüllt ist A
# ohne B: der äußere Bogen von A von Schnittpunkt zu Schnittpunkt, dann der innere (linke) Bogen
# von B zurück durch seinen linken Scheitel bei einem Drittel der Breite.  Eine Gruppe aus zwei
# Teilen wie intersection_2.master: die gefüllte Fläche mit der Füllung von Normal und darüber die
# Umrisse beider Mengen in der Linie der Formatvorlage Connector (QuickStyleType 3, ohne
# Pfeilspitzen: sichtbar auch in Designs ohne Shape-Linien).  Der Text der Gruppe steht in der
# freien Fläche von A.
master: Difference of 2 sets
name.de: Differenzmenge von 2 Mengen
name.en: Difference of two sets
name.es: Diferencia de 2 conjuntos
name.it: Differenza di 2 insiemi
name.fr: Différence de 2 ensembles
prompt.de: Zwei Mengen; hervorgehoben ist die erste ohne die zweite (A ohne B).
prompt.en: Two sets; the first without the second is highlighted (A minus B).
prompt.es: Dos conjuntos; está resaltado el primero sin el segundo (A menos B).
prompt.it: Due insiemi; è evidenziato il primo senza il secondo (A meno B).
prompt.fr: Deux ensembles ; le premier sans le second est mis en évidence (A moins B).
keywords.de: Venn, Differenz, Differenzmenge, Menge, ohne, Mengenlehre, Rest
keywords.en: Venn, difference, set difference, set, minus, without, set theory
keywords.es: Venn, diferencia, conjunto, menos, sin, teoría de conjuntos
keywords.it: Venn, differenza, insieme, meno, senza, teoria degli insiemi
keywords.fr: Venn, différence, ensemble, moins, sans, théorie des ensembles

[Shape]
Width = 60 mm
Width.us = 2.25 in
Height = 40 mm
Height.us = 1.5 in
# nur die Gruppe (SelectMode 0, ausdrücklich): die Teile sind Fläche und Umriss, keine eigenen
# Objekte; der Text gehört der Gruppe
SelectMode = 0
TxtPinX = Width*0.1667
TxtPinY = Height*0.5
TxtWidth = Width*0.3
TxtHeight = Height*0.4
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

# A ohne B: linker Bogen von A, linker Bogen von B zurück
[Part Difference]

[Geometry]
NoLine = TRUE
MoveTo           X = Width*0.5; Y = Height*0.933
EllipticalArcTo  X = Width*0.5; Y = Height*0.067; A = 0; B = Height*0.5; C = 0 deg; D = Width*0.6667/Height
EllipticalArcTo  X = Width*0.5; Y = Height*0.933; A = Width*0.3333; B = Height*0.5; C = 0 deg; D = Width*0.6667/Height

# die Mengen als Umriss
[Part Sets]
style: Connector

[Shape]
BeginArrow = 0
EndArrow = 0
QuickStyleType = 3

[Geometry]
NoFill = TRUE
Ellipse  X = Width*0.3333; Y = Height*0.5; A = Width*0.6667; B = Height*0.5; C = Width*0.3333; D = Height

[Geometry]
NoFill = TRUE
Ellipse  X = Width*0.6667; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.6667; D = Height
