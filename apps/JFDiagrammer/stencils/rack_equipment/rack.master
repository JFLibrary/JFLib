# Gestell (JD13, SH-146, VL-52): offenes 19-Zoll-Gestell nach EIA-310 in Frontansicht, Maßstab 1:20.
# Die Höhe folgt den Höheneinheiten (Prop.RackUnits, 1 bis 52): Höher ziehen schickt die gerundete
# Zahl der HE per SETATREF in die Shape-Daten, die Höhe rastet ein.  Höhe = Sockel + Kopf + HE x 44,45 mm.
# Das Gestell ist ein Container (msvStructureType) für Geräte der Kategorie RackEquipment: Was
# darin liegt, bewegt sich mit.  Die Verbindungspunkte 1 bis 53 („nach innen“) liegen links an der
# Montageschiene auf jeder HE-Grenze von unten; Punkte über der Höhe fallen auf den obersten.
# Geräte rasten mit ihrem Punkt unten links („nach außen“) dort ein.
# Geometrie: 1 Rahmen außen, 2 Öffnung (gerade-ungerade gefüllt: der Rahmen), 3 Schienen,
# 4 HE-Striche links, 5 HE-Striche rechts.
master: Rack
name.de: Gestell
name.en: Rack
name.es: Bastidor
name.it: Rack
name.fr: Baie
prompt.de: Offenes 19-Zoll-Gestell. Die Höhe in Höheneinheiten stellen Sie in den Shape-Daten oder durch Ziehen ein; Geräte rasten auf den Höheneinheiten ein.
prompt.en: Open 19-inch rack. Set its height in rack units in the shape data or by dragging; equipment snaps to the rack units.
prompt.es: Bastidor abierto de 19 pulgadas. Ajuste la altura en unidades de rack en los datos de forma o arrastrando; los equipos se ajustan a las unidades.
prompt.it: Rack aperto da 19 pollici. Imposta l'altezza in unità rack nei dati forma o trascinando; le apparecchiature si agganciano alle unità.
prompt.fr: Baie ouverte 19 pouces. Réglez la hauteur en unités dans les données de forme ou en faisant glisser ; les équipements s'alignent sur les unités.
keywords.de: Rack, Gestell, 19 Zoll, Serverschrank, Höheneinheit, HE, Rechenzentrum
keywords.en: rack, frame, 19 inch, server rack, rack unit, RU, data centre
keywords.es: rack, bastidor, 19 pulgadas, armario, unidad de rack, centro de datos
keywords.it: rack, telaio, 19 pollici, armadio, unità rack, data center
keywords.fr: baie, rack, 19 pouces, armoire, unité, centre de données
scale: 1:20
size: 560 mm x 1966.9 mm
size.us: 22 in x 77.5 in
include: ../net_common/asset.inc

[Shape]
Width = 560 mm
Width.us = 22 in
Height = User.Base+User.Top+SETATREF(Prop.RackUnits,MAX(1,MIN(52,ROUND((SETATREFEXPR()-User.Base-User.Top)/User.U,0))))*User.U
LineWeight = 0.5 pt
LineColor = #2E343B
FillForegnd = #DCDFE3
FillBkgnd = #DCDFE3
FillPattern = 1
TxtWidth = Width*1.6
TxtHeight = 160 mm
TxtHeight.us = 6.3 in
TxtPinX = Width*0.5
TxtPinY = Height
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = 0 mm
VerticalAlign = 2

[User]
U:            Value = 44.45 mm
              Value.us = 1.75 in
Top:          Value = 40 mm
              Value.us = 1.5 in
Base:         Value = 60 mm
              Value.us = 2.5 in
Post:         Value = 56 mm
              Value.us = 2.2 in
MountX:       Value = Width*0.5-241.3 mm
              Value.us = Width*0.5-9.5 in
msvStructureType: Value = "Container"
msvShapeCategories: Value = "Rack"
msvSDContainerMargin: Value = 0 mm
msvSDContainerResize: Value = 0
msvSDContainerLocked: Value = FALSE
msvSDContainerNoHighlight: Value = FALSE
msvSDContainerNoRibbon: Value = TRUE
msvSDContainerRequiredCategories: Value = "RackEquipment"
JFD_HeadingEdge: Value = "None"
JFD_HeadingSize: Value = 0 mm

[Property]
RackUnits:    Type = 2; Value = 42
              Label.de = Höheneinheiten (HE)
              Label.en = Rack units (U)
              Label.es = Unidades de rack (U)
              Label.it = Unità rack (U)
              Label.fr = Unités de baie (U)
ShapeType:    Type = 0; Invisible = TRUE; Label = "ShapeType"
              Value.de = Gestell
              Value.en = Rack
              Value.es = Bastidor
              Value.it = Rack
              Value.fr = Baie
SubShapeType: Type = 0; Invisible = TRUE; Label = "SubShapeType"
              Value.de = Gestell
              Value.en = Rack
              Value.es = Bastidor
              Value.it = Rack
              Value.fr = Baie

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

[Geometry]
MoveTo  X = User.Post; Y = User.Base
LineTo  X = Width-User.Post; Y = User.Base
LineTo  X = Width-User.Post; Y = Height-User.Top
LineTo  X = User.Post; Y = Height-User.Top
LineTo  X = User.Post; Y = User.Base

[Geometry]
NoFill = TRUE
