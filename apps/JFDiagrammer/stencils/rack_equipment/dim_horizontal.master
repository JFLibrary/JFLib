# Bemaßung horizontal (JD15, SH-146): eine Maßkette, die den waagerechten Abstand ihrer Enden in
# einem Textfeld zeigt (Feld 0: ABS(Width) in mm bzw. Zoll, folgt jeder Änderung).  1D mit aufrechtem
# Kasten (README: 1D-Shapes): lokal (0, 0) ist der Anfang, (Width, Height) das Ende.  Die Maßlinie
# liegt waagerecht auf der Höhe des gelben Punkts, Hilfslinien führen von ihr zu den Enden.  Pfeile,
# Überstand und Textblock in Papiermaß (User.S = Zeichnungs- zu Seitenmaßstab), damit sie bei 1:20
# so groß wirken wie bei 1:1.  Formatvorlage Connector ohne Pfeilspitzen (README: Stilregeln); die
# Pfeile zeichnet die Geometrie.
master: Dimension - horizontal
name.de: Bemaßung - horizontal
name.en: Dimension - horizontal
name.es: Cota - horizontal
name.it: Quota - orizzontale
name.fr: Cote - horizontale
prompt.de: Bemaßung horizontal: zeigt den waagerechten Abstand zwischen ihren Enden. Ziehen Sie den gelben Punkt, um die Maßlinie zu verschieben.
prompt.en: Horizontal dimension: shows the horizontal distance between its ends. Drag the yellow handle to move the dimension line.
prompt.es: Cota horizontal: muestra la distancia horizontal entre sus extremos. Arrastre el punto amarillo para mover la línea de cota.
prompt.it: Quota orizzontale: mostra la distanza orizzontale tra le sue estremità. Trascina il punto giallo per spostare la linea di quota.
prompt.fr: Cote horizontale : affiche la distance horizontale entre ses extrémités. Faites glisser la poignée jaune pour déplacer la ligne de cote.
keywords.de: Bemaßung, Maß, Maßkette, Breite, Abstand, horizontal, Rack
keywords.en: dimension, measure, width, distance, horizontal, rack
keywords.es: cota, medida, anchura, distancia, horizontal, rack
keywords.it: quota, misura, larghezza, distanza, orizzontale, rack
keywords.fr: cote, mesure, largeur, distance, horizontale, baie
text.de: {fld 0}
text.en: {fld 0}
text.es: {fld 0}
text.it: {fld 0}
text.fr: {fld 0}
style: Connector
scale: 1:20

[Shape]
BeginX = 100 mm
BeginX.us = 4 in
BeginY = 250 mm
BeginY.us = 10 in
EndX = 700 mm
EndX.us = 28 in
EndY = 250 mm
EndY.us = 10 in
Width = GUARD(EndX-BeginX)
Height = GUARD(EndY-BeginY)
Angle = GUARD(0DA)
BeginArrow = 0
EndArrow = 0
TxtPinX = Width*0.5
TxtPinY = User.Y
TxtWidth = MAX(ABS(Width), 20 mm*User.S)
TxtHeight = 5 mm*User.S
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = 0 mm
VerticalAlign = 2

[User]
# Zeichnungs- zu Papiermaß (1 auf einer Seite 1:1, 20 bei 1:20)
S:   Value = ThePage!DrawingScale/ThePage!PageScale
# Länge und halbe Breite der Pfeilspitzen, Überstand der Hilfslinien über die Maßlinie
L:   Value = 3 mm*User.S
     Value.us = 0.12 in*User.S
Aw:  Value = 1 mm*User.S
     Value.us = 0.04 in*User.S
Ov:  Value = 2 mm*User.S
     Value.us = 0.08 in*User.S
# 1, wenn das Ende rechts vom Anfang liegt, sonst -1 (die Pfeile zeigen nach außen auf die Hilfslinien)
D:   Value = IF(Width<0,-1,1)
# die Höhe der Maßlinie im Kasten (der gelbe Punkt)
Y:   Value = Controls.Line.Y

[Controls]
Line: X = Width*0.5; Y = 6 mm*User.S
      Y.us = 0.25 in*User.S
      XDyn = Controls.Line; YDyn = Controls.Line.Y
      XCon = 1; YCon = 2; CanGlue = FALSE
      Tip.de = "Maßlinie verschieben"
      Tip.en = "Move the dimension line"
      Tip.es = "Mover la línea de cota"
      Tip.it = "Sposta la linea di quota"
      Tip.fr = "Déplacer la ligne de cote"

[Field]
Row  Value = ABS(Width); Unit = mm; Format = "0 u"; Type = 2
     Unit.us = in
     Format.us = "0.## u"

# Maßlinie, Pfeile an beiden Enden, Hilfslinien zu Anfang und Ende
[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = User.Y
LineTo  X = Width; Y = User.Y
MoveTo  X = User.D*User.L; Y = User.Y+User.Aw
LineTo  X = 0; Y = User.Y
LineTo  X = User.D*User.L; Y = User.Y-User.Aw
MoveTo  X = Width-User.D*User.L; Y = User.Y+User.Aw
LineTo  X = Width; Y = User.Y
LineTo  X = Width-User.D*User.L; Y = User.Y-User.Aw
MoveTo  X = 0; Y = 0
LineTo  X = 0; Y = User.Y+User.Ov*IF(User.Y<0,-1,1)
MoveTo  X = Width; Y = Height
LineTo  X = Width; Y = User.Y+User.Ov*IF(User.Y<Height,-1,1)
