# Datengrafik-Element Datenleiste (JD19, DA-07): der Anteil des Werts von Prop.msvCalloutField
# zwischen Prop.msvCalloutPropMin und Prop.msvCalloutPropMax (User.F, 0 bis 1) bestimmt die
# Geometrie.  Farben aus dem Design (Normal); gefüllte Teile in der Linienfarbe (FillForegnd = LineColor),
# kräftig vor dem Shape.  Verborgener Master: die App setzt ihn als Untershape an.
# Tacho: ein halber Ellipsenbogen über der Grundlinie, der Zeiger dreht mit dem Anteil von links
# (Minimum) nach rechts (Maximum); die Nabe ist ein kleines Quadrat.
master: DG Speedometer
name.de: Tacho
name.en: Speedometer
name.es: Velocímetro
name.it: Tachimetro
name.fr: Compteur
prompt.de: Datengrafik: Zeigerinstrument, dessen Zeiger den Wert zwischen Minimum und Maximum zeigt.
prompt.en: Data graphic: dial whose needle shows the value between the minimum and the maximum.
prompt.es: Gráfico de datos: indicador cuya aguja muestra el valor entre el mínimo y el máximo.
prompt.it: Grafico dati: indicatore la cui lancetta mostra il valore tra il minimo e il massimo.
prompt.fr: Graphique de données : cadran dont l'aiguille montre la valeur entre le minimum et le maximum.
hidden: true

[Shape]
Width = 20 mm
Width.us = 0.8 in
Height = 11 mm
Height.us = 0.44 in
FillForegnd = LineColor
FillPattern = 1

[User]
msvCalloutType:  Value = "Data Bar"
# der Anteil des Werts zwischen Minimum und Maximum, 0 bis 1
F:  Value = IFERROR(BOUND((Prop.msvCalloutField-Prop.msvCalloutPropMin)/(Prop.msvCalloutPropMax-Prop.msvCalloutPropMin),0,FALSE,0,1),0)
# der Winkel des Zeigers: 180° beim Minimum, 0° beim Maximum
A:  Value = PI()*(1-User.F)

[Property]
msvCalloutField:  Type = 2; Value = 50; Prompt = "Number"; SortKey = "Wert"
        Label.de = Datenfeld
        Label.en = Data field
        Label.es = Campo de datos
        Label.it = Campo dati
        Label.fr = Champ de données
msvCalloutPropMin:  Type = 2; Value = 0; Prompt = "Number"
        Label.de = Minimalwert
        Label.en = Minimum value
        Label.es = Valor mínimo
        Label.it = Valore minimo
        Label.fr = Valeur minimale
msvCalloutPropMax:  Type = 2; Value = 100; Prompt = "Number"
        Label.de = Maximalwert
        Label.en = Maximum value
        Label.es = Valor máximo
        Label.it = Valore massimo
        Label.fr = Valeur maximale
msvCalloutPropShowValue:  Type = 3; Value = FALSE; Prompt = "Bool"
        Label.de = Wert anzeigen
        Label.en = Show value
        Label.es = Mostrar valor
        Label.it = Mostra valore
        Label.fr = Afficher la valeur
msvCalloutPropValueFormat:  Type = 0; Value = ""; Prompt = "Format"
        Label.de = Wertformat
        Label.en = Value format
        Label.es = Formato del valor
        Label.it = Formato valore
        Label.fr = Format de la valeur

# der Bogen über der Grundlinie
[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
EllipticalArcTo  X = 0; Y = 0; A = Width*0.5; B = Height; C = 0 deg; D = Width*0.5/Height

# der Zeiger
[Geometry]
NoFill = TRUE
MoveTo  X = Width*0.5; Y = 0
LineTo  X = Width*0.5+Width*0.42*COS(User.A); Y = Height*0.84*SIN(User.A)

# die Nabe
[Geometry]
NoLine = TRUE
MoveTo  X = Width*0.45; Y = 0
LineTo  X = Width*0.55; Y = 0
LineTo  X = Width*0.55; Y = Width*0.1
LineTo  X = Width*0.45; Y = Width*0.1
LineTo  X = Width*0.45; Y = 0

