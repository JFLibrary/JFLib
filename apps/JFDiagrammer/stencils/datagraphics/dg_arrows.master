# Pfeile: ein Pfeil, der mit der Symbolnummer von oben (0) über rechts (2) nach unten (4) dreht.
# Datengrafik-Element Symbolsatz (JD19, DA-07): User.msvCalloutIconNumber (-1 keins, 0 bis 4) wählt
# das Symbol (Visios Zelle; die App schreibt dort die aus den Regeln übersetzte Formel), NoShow
# und NoFill der Geometrieabschnitte folgen ihr.  Die Farben sind die Bedeutung der Symbole und
# deshalb fest (begründete Ausnahme der Stilregeln); Linie dunkelgrau.  Verborgener Master.
master: DG Arrows
name.de: Pfeile
name.en: Arrows
name.es: Flechas
name.it: Frecce
name.fr: Flèches
prompt.de: Datengrafik: Trendpfeil von oben über rechts nach unten, von grün nach rot.
prompt.en: Data graphic: trend arrow from up through right to down, from green to red.
prompt.es: Gráfico de datos: flecha de tendencia de arriba a abajo pasando por la derecha, de verde a rojo.
prompt.it: Grafico dati: freccia di tendenza dall'alto verso il basso passando per destra, dal verde al rosso.
prompt.fr: Graphique de données : flèche de tendance du haut vers le bas en passant par la droite, du vert au rouge.
hidden: true

[Shape]
Width = 6 mm
Width.us = 0.25 in
Height = 6 mm
Height.us = 0.25 in
FillForegnd = IF(User.msvCalloutIconNumber=0,RGB(58,154,74),IF(User.msvCalloutIconNumber=1,RGB(140,195,75),IF(User.msvCalloutIconNumber=2,RGB(230,180,34),IF(User.msvCalloutIconNumber=3,RGB(230,126,34),RGB(200,60,60)))))
FillPattern = 1
LineColor = #404040
LineWeight = 0.5 pt
Rounding = 0 mm

[User]
msvCalloutType:  Value = "Icon Set"
msvCalloutIconCount:  Value = 5
msvCalloutIconNumber:  Value = 0
# die Richtung: 90° bei 0, 45° Schritte nach unten
A:  Value = (90-45*MAX(User.msvCalloutIconNumber,0))*PI()/180
C:  Value = COS(User.A)
S:  Value = SIN(User.A)

[Property]
msvCalloutField:  Type = 0; Value = ""; Prompt = "String"; SortKey = "Wert"
        Label.de = Datenfeld
        Label.en = Data field
        Label.es = Campo de datos
        Label.it = Campo dati
        Label.fr = Champ de données

[Geometry]
NoShow = User.msvCalloutIconNumber<0
MoveTo  X = Width*(0.5-0.42*User.C+0.12*User.S); Y = Height*(0.5-0.42*User.S-0.12*User.C)
LineTo  X = Width*(0.5+0.06*User.C+0.12*User.S); Y = Height*(0.5+0.06*User.S-0.12*User.C)
LineTo  X = Width*(0.5+0.06*User.C+0.32*User.S); Y = Height*(0.5+0.06*User.S-0.32*User.C)
LineTo  X = Width*(0.5+0.44*User.C-0*User.S); Y = Height*(0.5+0.44*User.S+0*User.C)
LineTo  X = Width*(0.5+0.06*User.C-0.32*User.S); Y = Height*(0.5+0.06*User.S+0.32*User.C)
LineTo  X = Width*(0.5+0.06*User.C-0.12*User.S); Y = Height*(0.5+0.06*User.S+0.12*User.C)
LineTo  X = Width*(0.5-0.42*User.C-0.12*User.S); Y = Height*(0.5-0.42*User.S+0.12*User.C)
LineTo  X = Width*(0.5-0.42*User.C+0.12*User.S); Y = Height*(0.5-0.42*User.S-0.12*User.C)
