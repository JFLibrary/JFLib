# Datengrafik-Element Datenleiste (JD19, DA-07): der Anteil des Werts von Prop.msvCalloutField
# zwischen Prop.msvCalloutPropMin und Prop.msvCalloutPropMax (User.F, 0 bis 1) bestimmt die
# Geometrie.  Farben aus dem Design (Normal); gefüllte Teile in der Linienfarbe (FillForegnd = LineColor),
# kräftig vor dem Shape.  Verborgener Master: die App setzt ihn als Untershape an.
# Thermometer: ein senkrechtes Rohr über einem quadratischen Fuß, die Säule steigt mit dem Anteil.
master: DG Thermometer
name.de: Thermometer
name.en: Thermometer
name.es: Termómetro
name.it: Termometro
name.fr: Thermomètre
prompt.de: Datengrafik: Thermometer, dessen Säule den Wert zwischen Minimum und Maximum zeigt.
prompt.en: Data graphic: thermometer whose column shows the value between the minimum and the maximum.
prompt.es: Gráfico de datos: termómetro cuya columna muestra el valor entre el mínimo y el máximo.
prompt.it: Grafico dati: termometro la cui colonna mostra il valore tra il minimo e il massimo.
prompt.fr: Graphique de données : thermomètre dont la colonne montre la valeur entre le minimum et le maximum.
hidden: true

[Shape]
Width = 6 mm
Width.us = 0.25 in
Height = 20 mm
Height.us = 0.8 in
FillForegnd = LineColor
FillPattern = 1

[User]
msvCalloutType:  Value = "Data Bar"
# Visios Kennzeichen eines Datengrafik-Callouts (JD19, Visio-Gegenprobe: ohne sie und ohne die
# Shape-ID 5 des Masters zählt Visio die Elemente einer Datengrafik nicht)
visDGCalloutItem:  Value = 5
visDGDefaultPos:  Value = 0
visDGStackHeight:  Value = 0
# der Anteil des Werts zwischen Minimum und Maximum, 0 bis 1
F:  Value = IFERROR(BOUND((Prop.msvCalloutField-Prop.msvCalloutPropMin)/(Prop.msvCalloutPropMax-Prop.msvCalloutPropMin),0,FALSE,0,1),0)

[Property]
msvCalloutField:  Type = 2; Value = 50; Prompt = "Number"; SortKey = "Wert"
        Label.de = Datenfeld
        Label.en = Data field
        Label.es = Campo de datos
        Label.it = Campo dati
        Label.fr = Champ de données
msvCalloutPropMin:  Type = 2; Value = 0; Prompt = "Number"
        Label.de = Minimalwert
        Label.en = Minimum value
        Label.es = Valor mínimo
        Label.it = Valore minimo
        Label.fr = Valeur minimale
msvCalloutPropMax:  Type = 2; Value = 100; Prompt = "Number"
        Label.de = Maximalwert
        Label.en = Maximum value
        Label.es = Valor máximo
        Label.it = Valore massimo
        Label.fr = Valeur maximale
msvCalloutPropShowValue:  Type = 3; Value = FALSE; Prompt = "Bool"
        Label.de = Wert anzeigen
        Label.en = Show value
        Label.es = Mostrar valor
        Label.it = Mostra valore
        Label.fr = Afficher la valeur
msvCalloutPropValueFormat:  Type = 0; Value = ""; Prompt = "Format"
        Label.de = Wertformat
        Label.en = Value format
        Label.es = Formato del valor
        Label.it = Formato valore
        Label.fr = Format de la valeur

# der Umriss: Fuß und Rohr
[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Width
LineTo  X = Width*0.7; Y = Width
LineTo  X = Width*0.7; Y = Height
LineTo  X = Width*0.3; Y = Height
LineTo  X = Width*0.3; Y = Width
LineTo  X = 0; Y = Width
LineTo  X = 0; Y = 0

# der gefüllte Fuß
[Geometry]
NoLine = TRUE
MoveTo  X = Width*0.15; Y = Width*0.15
LineTo  X = Width*0.85; Y = Width*0.15
LineTo  X = Width*0.85; Y = Width*0.85
LineTo  X = Width*0.15; Y = Width*0.85
LineTo  X = Width*0.15; Y = Width*0.15

# die Säule
[Geometry]
NoLine = TRUE
NoShow = User.F<=0
MoveTo  X = Width*0.38; Y = Width*0.85
LineTo  X = Width*0.62; Y = Width*0.85
LineTo  X = Width*0.62; Y = Width*0.85+(Height-Width*0.85-Width*0.08)*User.F
LineTo  X = Width*0.38; Y = Width*0.85+(Height-Width*0.85-Width*0.08)*User.F
LineTo  X = Width*0.38; Y = Width*0.85

