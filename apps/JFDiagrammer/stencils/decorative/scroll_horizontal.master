# Horizontale Schriftrolle (SH-003, JD26): ein breites Blatt zwischen zwei Rollen links und rechts,
# die vertikale Schriftrolle (scroll_vertical.master) um 90° gedreht.  Die Rollen sind Balken über
# die ganze Höhe, das Blatt ist oben und unten um eine halbe Rollendicke niedriger; zwischen Blatt
# und Rollen liegt eine Fuge von 0,8 mm (sichtbar auch in einem Design ohne Shape-Linien).  Die
# Enden der Rollen zeigen je ein rundes Loch (das aufgerollte Papier, Gerade-Ungerade-Regel).
# Row_1 an der Innenkante der rechten Rolle ändert die Dicke beider Rollen (Abstand vom rechten
# Rand, nur waagrecht: die Rollen bleiben beim Strecken gleich dick).  Der Text steht auf dem
# Blatt.
master: Horizontal scroll
name.de: Horizontale Schriftrolle
name.en: Horizontal scroll
name.es: Pergamino horizontal
name.it: Pergamena orizzontale
name.fr: Parchemin horizontal
prompt.de: Breite Schriftrolle für Urkunden, Titel und Hinweise. Mit dem gelben Steuerpunkt ändern Sie die Dicke der Rollen.
prompt.en: Wide scroll for certificates, titles and notes. Drag the yellow control handle to change the thickness of the rolls.
prompt.es: Pergamino ancho para certificados, títulos y avisos. Arrastre el controlador amarillo para cambiar el grosor de los rollos.
prompt.it: Pergamena larga per attestati, titoli e avvisi. Trascina la maniglia di controllo gialla per cambiare lo spessore dei rotoli.
prompt.fr: Parchemin horizontal pour les certificats, les titres et les remarques. Faites glisser la poignée de contrôle jaune pour modifier l'épaisseur des rouleaux.
keywords.de: Schriftrolle, Rolle, Pergament, Urkunde, Scrollen, Titel, Dekor
keywords.en: scroll, roll, parchment, certificate, title, decoration
keywords.es: pergamino, rollo, certificado, título, desplazamiento, decoración
keywords.it: pergamena, rotolo, attestato, titolo, scorrimento, decorazione
keywords.fr: parchemin, rouleau, certificat, titre, défilement, décoration

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 30 mm
Height.us = 1.25 in
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtWidth = Width-User.R*2-User.G*2
TxtHeight = Height-User.R
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[User]
# die Dicke der Rollen, die Fuge, der Radius der Löcher
R:   Value = MIN(MAX(Width-Controls.Row_1, 2 mm), Width*0.25, Height*0.3)
G:   Value = MIN(0.8 mm, User.R*0.2)
Hr:  Value = User.R*0.22

# 1 das Blatt
[Geometry]
MoveTo  X = User.R+User.G; Y = User.R*0.5
LineTo  X = Width-User.R-User.G; Y = User.R*0.5
LineTo  X = Width-User.R-User.G; Y = Height-User.R*0.5
LineTo  X = User.R+User.G; Y = Height-User.R*0.5
LineTo  X = User.R+User.G; Y = User.R*0.5

# 2 die linke Rolle
[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = User.R; Y = 0
LineTo  X = User.R; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

# 3 die rechte Rolle
[Geometry]
MoveTo  X = Width-User.R; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = Width-User.R; Y = Height
LineTo  X = Width-User.R; Y = 0

# 4 bis 7 die Löcher an den Enden der Rollen
[Geometry]
Ellipse  X = User.R*0.5; Y = Height-User.R*0.5; A = User.R*0.5+User.Hr; B = Height-User.R*0.5
         C = User.R*0.5; D = Height-User.R*0.5+User.Hr

[Geometry]
Ellipse  X = Width-User.R*0.5; Y = Height-User.R*0.5; A = Width-User.R*0.5+User.Hr; B = Height-User.R*0.5
         C = Width-User.R*0.5; D = Height-User.R*0.5+User.Hr

[Geometry]
Ellipse  X = User.R*0.5; Y = User.R*0.5; A = User.R*0.5+User.Hr; B = User.R*0.5
         C = User.R*0.5; D = User.R*0.5+User.Hr

[Geometry]
Ellipse  X = Width-User.R*0.5; Y = User.R*0.5; A = Width-User.R*0.5+User.Hr; B = User.R*0.5
         C = Width-User.R*0.5; D = User.R*0.5+User.Hr

[Controls]
Row_1:  X = Width-5 mm; Y = Height*0.5
        X.us = Width-0.2 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 4; YCon = 1; CanGlue = FALSE
        Tip.de = "Dicke der Rollen ändern"
        Tip.en = "Change the thickness of the rolls"
        Tip.es = "Cambiar el grosor de los rollos"
        Tip.it = "Cambia lo spessore dei rotoli"
        Tip.fr = "Modifier l'épaisseur des rouleaux"

[Connection]
Row  X = Width*0.5; Y = User.R*0.5; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height-User.R*0.5; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
