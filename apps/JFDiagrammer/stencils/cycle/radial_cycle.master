# Radialzyklus (SH-033, JD26): drei bis acht Kreise (gestreckt Ellipsen) gleichmäßig im Ring um
# eine Mitte, Kreis 1 oben, im Uhrzeigersinn; jeder ein Teil der Gruppe mit eigenem Text und
# eigener Variantenfarbe (100 bis 106, der achte 103).  Die Kreise füllen 0,8 ihres Abstands und
# reichen bis an den Rand; ihr Durchmesser folgt der Zahl.  Die Zahl steht in den Shape-Daten
# (Prop.Count); Kreise über der Zahl liegen verborgen auf dem letzten (die Teile stehen von 8 bis 1
# in der Datei).  Die Kreise tragen anfangs ihre Nummer (sie passt auch in kleine Kreise).
master: Radial cycle
name.de: Radialzyklus
name.en: Radial cycle
name.es: Ciclo radial
name.it: Ciclo radiale
name.fr: Cycle radial
prompt.de: Kreise im Ring um eine Mitte für wiederkehrende Abläufe. Die Zahl der Kreise stellen Sie in den Shape-Daten ein.
prompt.en: Circles in a ring around a centre for recurring processes. Set the number of circles in the shape data.
prompt.es: Círculos en anillo alrededor de un centro para procesos recurrentes. Defina el número de círculos en los datos de la forma.
prompt.it: Cerchi ad anello intorno a un centro per processi ricorrenti. Imposta il numero di cerchi nei dati della forma.
prompt.fr: Cercles en anneau autour d'un centre pour les processus récurrents. Définissez le nombre de cercles dans les données de la forme.
keywords.de: Zyklus, radial, Kreise, Ring, Kreislauf, Phasen, wiederkehrend
keywords.en: cycle, radial, circles, ring, loop, phases, recurring
keywords.es: ciclo, radial, círculos, anillo, fases, recurrente
keywords.it: ciclo, radiale, cerchi, anello, fasi, ricorrente
keywords.fr: cycle, radial, cercles, anneau, phases, récurrent

[Shape]
Width = 70 mm
Width.us = 2.75 in
Height = 70 mm
Height.us = 2.75 in

[User]
# die Zahl der Elemente (3 bis 8), der Winkel je Element, der Sinus des halben Winkels; der
# Durchmesser eines Kreises und der Radius des Rings ihrer Mitten als Anteil der Breite (die
# Elemente füllen 0.8 ihres Abstands, der Ring reicht bis an den Rand)
N:   Value = MIN(MAX(ROUND(Prop.Count,0),3),8)
S:   Value = 2*PI()/User.N
Sn:  Value = SIN(PI()/User.N)
Dc:  Value = User.Sn*0.8/(1+0.8*User.Sn)
Rc:  Value = 0.5-User.Dc*0.5

[Property]
Count:  Type = 2; Format = "0"; Value = 6
        Label.de = Kreise
        Label.en = Circles
        Label.es = Círculos
        Label.it = Cerchi
        Label.fr = Cercles
        Prompt.de = Anzahl der Kreise (3 bis 8)
        Prompt.en = Number of circles (3 to 8)
        Prompt.es = Número de círculos (de 3 a 8)
        Prompt.it = Numero di cerchi (da 3 a 8)
        Prompt.fr = Nombre de cercles (de 3 à 8)

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

# Element 8 (von oben im Uhrzeigersinn): sichtbar ab 8; sonst deckungsgleich mit dem letzten, verborgen
[Part C8]
text.de: 8
text.en: 8
text.es: 8
text.it: 8
text.fr: 8

[User]
# das Element, an dessen Stelle das Teil liegt, sein Winkel (mathematisch, im Bogenmaß)
K:   Value = MIN(8,Sheet.1!User.N)
T:   Value = PI()*0.5-(User.K-1)*Sheet.1!User.S

[Shape]
Width = GUARD(Sheet.1!Width*Sheet.1!User.Dc)
Height = GUARD(Sheet.1!Height*Sheet.1!User.Dc)
PinX = GUARD(Sheet.1!Width*(0.5+Sheet.1!User.Rc*COS(User.T)))
PinY = GUARD(Sheet.1!Height*(0.5+Sheet.1!User.Rc*SIN(User.T)))
HideText = 8>Sheet.1!User.N
QuickStyleLineColor = 103
QuickStyleFillColor = 103

[Geometry]
NoShow = 8>Sheet.1!User.N
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

