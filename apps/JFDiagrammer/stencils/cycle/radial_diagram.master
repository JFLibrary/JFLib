# Radialdiagramm (SH-033, JD26): eine Mitte mit Speichen zu drei bis acht Kreisen ringsum.  Teile
# der Gruppe: zuerst die Speichen (nur Linien von der Mitte zu den Mitten der Kreise:
# Formatvorlage Connector ohne deren Pfeilspitzen, sichtbar auch in Designs ohne Shape-Linien;
# Speichen über der Zahl verborgen), dann der Mittelkreis (0,3 der Breite, Variantenfarbe 106) und
# die Kreise, jeder mit eigenem Text und eigener Variantenfarbe (100 bis 106, der achte 103).  Die
# Kreise füllen 0,8 ihres Abstands, höchstens 0,24 der Breite, damit die Speichen sichtbar bleiben.
# Die Zahl steht in den Shape-Daten (Prop.Count); Kreise über der Zahl liegen verborgen auf dem
# letzten.  Die Kreise tragen anfangs ihre Nummer, die Mitte „Kern“.
master: Radial diagram
name.de: Radialdiagramm
name.en: Radial diagram
name.es: Diagrama radial
name.it: Diagramma radiale
name.fr: Diagramme radial
prompt.de: Mitte mit Speichen zu Kreisen für Themen um einen Kern. Die Zahl der Kreise stellen Sie in den Shape-Daten ein.
prompt.en: Centre with spokes to circles for topics around a core. Set the number of circles in the shape data.
prompt.es: Centro con radios hacia círculos para temas alrededor de un núcleo. Defina el número de círculos en los datos de la forma.
prompt.it: Centro con raggi verso cerchi per temi intorno a un nucleo. Imposta il numero di cerchi nei dati della forma.
prompt.fr: Centre avec des rayons vers des cercles pour les thèmes autour d'un noyau. Définissez le nombre de cercles dans les données de la forme.
keywords.de: radial, Speichen, Mitte, Nabe, Kreise, Themen, Netz
keywords.en: radial, spokes, centre, hub, circles, topics, network
keywords.es: radial, radios, centro, círculos, temas, red
keywords.it: radiale, raggi, centro, mozzo, cerchi, temi, rete
keywords.fr: radial, rayons, centre, moyeu, cercles, thèmes, réseau

[Shape]
Width = 70 mm
Width.us = 2.75 in
Height = 70 mm
Height.us = 2.75 in

[User]
# die Zahl der Elemente (3 bis 8), der Winkel je Element, der Sinus des halben Winkels; der
# Durchmesser eines Kreises und der Radius des Rings ihrer Mitten als Anteil der Breite (die
# Elemente füllen 0.8 ihres Abstands, der Ring reicht bis an den Rand)
N:   Value = MIN(MAX(ROUND(Prop.Count,0),3),8)
S:   Value = 2*PI()/User.N
Sn:  Value = SIN(PI()/User.N)
Dc:  Value = MIN(User.Sn*0.8/(1+0.8*User.Sn),0.24)
Rc:  Value = 0.5-User.Dc*0.5

[Property]
Count:  Type = 2; Format = "0"; Value = 5
        Label.de = Kreise
        Label.en = Circles
        Label.es = Círculos
        Label.it = Cerchi
        Label.fr = Cercles
        Prompt.de = Anzahl der Kreise (3 bis 8)
        Prompt.en = Number of circles (3 to 8)
        Prompt.es = Número de círculos (de 3 a 8)
        Prompt.it = Numero di cerchi (da 3 a 8)
        Prompt.fr = Nombre de cercles (de 3 à 8)

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

# die Speichen
[Part Spokes]
style: Connector

[Shape]
BeginArrow = 0
EndArrow = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3

[Geometry]
NoFill = TRUE
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5))

[Geometry]
NoFill = TRUE
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5-1*Sheet.1!User.S)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5-1*Sheet.1!User.S))

[Geometry]
NoFill = TRUE
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5-2*Sheet.1!User.S)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5-2*Sheet.1!User.S))

[Geometry]
NoFill = TRUE
NoShow = 4>Sheet.1!User.N
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5-3*Sheet.1!User.S)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5-3*Sheet.1!User.S))

[Geometry]
NoFill = TRUE
NoShow = 5>Sheet.1!User.N
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5-4*Sheet.1!User.S)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5-4*Sheet.1!User.S))

[Geometry]
NoFill = TRUE
NoShow = 6>Sheet.1!User.N
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5-5*Sheet.1!User.S)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5-5*Sheet.1!User.S))

[Geometry]
NoFill = TRUE
NoShow = 7>Sheet.1!User.N
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5-6*Sheet.1!User.S)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5-6*Sheet.1!User.S))

[Geometry]
NoFill = TRUE
NoShow = 8>Sheet.1!User.N
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width*(0.5+Sheet.1!User.Rc*COS(PI()*0.5-7*Sheet.1!User.S)); Y = Height*(0.5+Sheet.1!User.Rc*SIN(PI()*0.5-7*Sheet.1!User.S))

# die Mitte
[Part Center]
text.de: Kern
text.en: Core
text.es: Núcleo
text.it: Nucleo
text.fr: Noyau

[Shape]
Width = GUARD(Sheet.1!Width*0.3)
Height = GUARD(Sheet.1!Height*0.3)
QuickStyleLineColor = 106
QuickStyleFillColor = 106

[Geometry]
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

# Element 8 (von oben im Uhrzeigersinn): sichtbar ab 8; sonst deckungsgleich mit dem letzten, verborgen
[Part C8]
text.de: 8
text.en: 8
text.es: 8
text.it: 8
text.fr: 8

[User]
# das Element, an dessen Stelle das Teil liegt, sein Winkel (mathematisch, im Bogenmaß)
K:   Value = MIN(8,Sheet.1!User.N)
T:   Value = PI()*0.5-(User.K-1)*Sheet.1!User.S

[Shape]
Width = GUARD(Sheet.1!Width*Sheet.1!User.Dc)
Height = GUARD(Sheet.1!Height*Sheet.1!User.Dc)
PinX = GUARD(Sheet.1!Width*(0.5+Sheet.1!User.Rc*COS(User.T)))
PinY = GUARD(Sheet.1!Height*(0.5+Sheet.1!User.Rc*SIN(User.T)))
HideText = 8>Sheet.1!User.N
QuickStyleLineColor = 103
QuickStyleFillColor = 103

[Geometry]
NoShow = 8>Sheet.1!User.N
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

