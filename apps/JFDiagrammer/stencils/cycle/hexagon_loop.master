# Sechseckige Schleife (SH-033, JD26): drei bis acht Sechsecke (Spitzen links und rechts) im Ring,
# Sechseck 1 oben, im Uhrzeigersinn; jedes ein Teil der Gruppe mit eigenem Text und eigener
# Variantenfarbe (100 bis 106, das achte 103).  Die Sechsecke füllen 0,95 des Abstands ihrer
# Umkreise und reichen bis an den Rand; bei sechs liegen sie wie Waben um eine leere Mitte, mit
# einer Fuge zwischen den Kanten.  Die Zahl steht in den Shape-Daten (Prop.Count); Sechsecke über
# der Zahl liegen verborgen auf dem letzten.  Die Sechsecke tragen anfangs ihre Nummer.
master: Hexagon loop
name.de: Sechseckige Schleife
name.en: Hexagon loop
name.es: Bucle hexagonal
name.it: Anello esagonale
name.fr: Boucle hexagonale
prompt.de: Sechsecke im Ring für zusammenhängende Schritte oder Bausteine. Die Zahl der Sechsecke stellen Sie in den Shape-Daten ein.
prompt.en: Hexagons in a ring for connected steps or building blocks. Set the number of hexagons in the shape data.
prompt.es: Hexágonos en anillo para pasos o componentes relacionados. Defina el número de hexágonos en los datos de la forma.
prompt.it: Esagoni ad anello per passi o componenti collegati. Imposta il numero di esagoni nei dati della forma.
prompt.fr: Hexagones en anneau pour des étapes ou des éléments liés. Définissez le nombre d'hexagones dans les données de la forme.
keywords.de: Sechseck, Schleife, Ring, Waben, Zyklus, Bausteine, Kreislauf
keywords.en: hexagon, loop, ring, honeycomb, cycle, building blocks
keywords.es: hexágono, bucle, anillo, panal, ciclo, componentes
keywords.it: esagono, anello, nido d'ape, ciclo, componenti
keywords.fr: hexagone, boucle, anneau, nid d'abeille, cycle, éléments

[Shape]
Width = 70 mm
Width.us = 2.75 in
Height = 70 mm
Height.us = 2.75 in

[User]
# die Zahl der Elemente (3 bis 8), der Winkel je Element, der Sinus des halben Winkels; der
# Durchmesser eines Sechsecks (Umkreis) und der Radius des Rings ihrer Mitten als Anteil der Breite (die
# Elemente füllen 0.95 ihres Abstands, der Ring reicht bis an den Rand)
N:   Value = MIN(MAX(ROUND(Prop.Count,0),3),8)
S:   Value = 2*PI()/User.N
Sn:  Value = SIN(PI()/User.N)
Dc:  Value = User.Sn*0.95/(1+0.95*User.Sn)
Rc:  Value = 0.5-User.Dc*0.5

[Property]
Count:  Type = 2; Format = "0"; Value = 6
        Label.de = Sechsecke
        Label.en = Hexagons
        Label.es = Hexágonos
        Label.it = Esagoni
        Label.fr = Hexagones
        Prompt.de = Anzahl der Sechsecke (3 bis 8)
        Prompt.en = Number of hexagons (3 to 8)
        Prompt.es = Número de hexágonos (de 3 a 8)
        Prompt.it = Numero di esagoni (da 3 a 8)
        Prompt.fr = Nombre d'hexagones (de 3 à 8)

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

# Element 8 (von oben im Uhrzeigersinn): sichtbar ab 8; sonst deckungsgleich mit dem letzten, verborgen
[Part H8]
text.de: 8
text.en: 8
text.es: 8
text.it: 8
text.fr: 8

[User]
# das Element, an dessen Stelle das Teil liegt, sein Winkel (mathematisch, im Bogenmaß)
K:   Value = MIN(8,Sheet.1!User.N)
T:   Value = PI()*0.5-(User.K-1)*Sheet.1!User.S

[Shape]
Width = GUARD(Sheet.1!Width*Sheet.1!User.Dc)
Height = GUARD(Sheet.1!Height*Sheet.1!User.Dc*0.866)
PinX = GUARD(Sheet.1!Width*(0.5+Sheet.1!User.Rc*COS(User.T)))
PinY = GUARD(Sheet.1!Height*(0.5+Sheet.1!User.Rc*SIN(User.T)))
HideText = 8>Sheet.1!User.N
QuickStyleLineColor = 103
QuickStyleFillColor = 103

[Geometry]
NoShow = 8>Sheet.1!User.N
MoveTo  X = Width*0.25; Y = 0
LineTo  X = Width*0.75; Y = 0
LineTo  X = Width; Y = Height*0.5
LineTo  X = Width*0.75; Y = Height
LineTo  X = Width*0.25; Y = Height
LineTo  X = 0; Y = Height*0.5
LineTo  X = Width*0.25; Y = 0

