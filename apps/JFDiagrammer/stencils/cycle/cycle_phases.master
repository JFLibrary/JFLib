                 A = Width*0.5*(1+COS(User.Am)); B = Height*0.5*(1+SIN(User.Am)); C = 0 deg; D = Width/Height
LineTo           X = Width*0.5*(1+User.Rm*COS(User.A1-Sheet.1!User.Tip)); Y = Height*0.5*(1+User.Rm*SIN(User.A1-Sheet.1!User.Tip))
LineTo           X = Width*0.5*(1+User.Ri*COS(User.A1)); Y = Height*0.5*(1+User.Ri*SIN(User.A1))
EllipticalArcTo  X = Width*0.5*(1+User.Ri*COS(User.A0)); Y = Height*0.5*(1+User.Ri*SIN(User.A0))
                 A = Width*0.5*(1+User.Ri*COS(User.Am)); B = Height*0.5*(1+User.Ri*SIN(User.Am)); C = 0 deg; D = Width/Height
