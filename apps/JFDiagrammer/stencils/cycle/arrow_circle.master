# Schaftende, Spitze, Fuß der Spitze (mathematisch, im Bogenmaß), die Mitte des Schafts, der Ort
# des Texts und sein Winkel
A0:  Value = PI()*0.5-6*Sheet.1!User.S-Sheet.1!User.G
A1:  Value = PI()*0.5-7*Sheet.1!User.S+Sheet.1!User.G
Ae:  Value = User.A1+Sheet.1!User.Hd
Ms:  Value = (User.A0+User.Ae)*0.5
Am:  Value = (User.A0+User.A1)*0.5+Sheet.1!User.Hd*0.2
Ta:  Value = IF(SIN(User.Am)<0,User.Am+PI()*0.5,User.Am-PI()*0.5)

[Shape]
HideText = 7>Sheet.1!User.N
QuickStyleLineColor = 106
QuickStyleFillColor = 106
TxtPinX = Width*0.5*(1+Sheet.1!User.Rc*COS(User.Am))
TxtPinY = Height*0.5*(1+Sheet.1!User.Rc*SIN(User.Am))
TxtWidth = Width*0.5*Sheet.1!User.Rc*(User.A0-User.A1)
TxtHeight = Height*0.5*Sheet.1!User.T*1.6
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
# kurze Texte (die Nummer) aufrecht, längere dem Bogen nach
TxtAngle = IF(TEXTWIDTH(TheText)>Height*0.75*Sheet.1!User.T,User.Ta,0)

[Geometry]
NoShow = 7>Sheet.1!User.N
MoveTo           X = Width*0.5*(1+Sheet.1!User.Ro*COS(User.A0)); Y = Height*0.5*(1+Sheet.1!User.Ro*SIN(User.A0))
EllipticalArcTo  X = Width*0.5*(1+Sheet.1!User.Ro*COS(User.Ae)); Y = Height*0.5*(1+Sheet.1!User.Ro*SIN(User.Ae))
                 A = Width*0.5*(1+Sheet.1!User.Ro*COS(User.Ms)); B = Height*0.5*(1+Sheet.1!User.Ro*SIN(User.Ms)); C = 0 deg; D = Width/Height
LineTo           X = Width*0.5*(1+COS(User.Ae)); Y = Height*0.5*(1+SIN(User.Ae))
LineTo           X = Width*0.5*(1+Sheet.1!User.Rc*COS(User.A1)); Y = Height*0.5*(1+Sheet.1!User.Rc*SIN(User.A1))
LineTo           X = Width*0.5*(1+Sheet.1!User.Rh*COS(User.Ae)); Y = Height*0.5*(1+Sheet.1!User.Rh*SIN(User.Ae))
LineTo           X = Width*0.5*(1+Sheet.1!User.Ri*COS(User.Ae)); Y = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.Ae))
EllipticalArcTo  X = Width*0.5*(1+Sheet.1!User.Ri*COS(User.A0)); Y = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.A0))
                 A = Width*0.5*(1+Sheet.1!User.Ri*COS(User.Ms)); B = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.Ms)); C = 0 deg; D = Width/Height
LineTo           X = Geometry1.X1; Y = Geometry1.Y1

# Schritt 8: sichtbar ab 8 Schritten
[Part A8]
text.de: 8
text.en: 8
text.es: 8
text.it: 8
text.fr: 8

[User]
# Schaftende, Spitze, Fuß der Spitze (mathematisch, im Bogenmaß), die Mitte des Schafts, der Ort
# des Texts und sein Winkel
A0:  Value = PI()*0.5-7*Sheet.1!User.S-Sheet.1!User.G
A1:  Value = PI()*0.5-8*Sheet.1!User.S+Sheet.1!User.G
Ae:  Value = User.A1+Sheet.1!User.Hd
Ms:  Value = (User.A0+User.Ae)*0.5
Am:  Value = (User.A0+User.A1)*0.5+Sheet.1!User.Hd*0.2
Ta:  Value = IF(SIN(User.Am)<0,User.Am+PI()*0.5,User.Am-PI()*0.5)

[Shape]
HideText = 8>Sheet.1!User.N
QuickStyleLineColor = 103
QuickStyleFillColor = 103
TxtPinX = Width*0.5*(1+Sheet.1!User.Rc*COS(User.Am))
TxtPinY = Height*0.5*(1+Sheet.1!User.Rc*SIN(User.Am))
TxtWidth = Width*0.5*Sheet.1!User.Rc*(User.A0-User.A1)
TxtHeight = Height*0.5*Sheet.1!User.T*1.6
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
# kurze Texte (die Nummer) aufrecht, längere dem Bogen nach
TxtAngle = IF(TEXTWIDTH(TheText)>Height*0.75*Sheet.1!User.T,User.Ta,0)

[Geometry]
NoShow = 8>Sheet.1!User.N
MoveTo           X = Width*0.5*(1+Sheet.1!User.Ro*COS(User.A0)); Y = Height*0.5*(1+Sheet.1!User.Ro*SIN(User.A0))
EllipticalArcTo  X = Width*0.5*(1+Sheet.1!User.Ro*COS(User.Ae)); Y = Height*0.5*(1+Sheet.1!User.Ro*SIN(User.Ae))
                 A = Width*0.5*(1+Sheet.1!User.Ro*COS(User.Ms)); B = Height*0.5*(1+Sheet.1!User.Ro*SIN(User.Ms)); C = 0 deg; D = Width/Height
LineTo           X = Width*0.5*(1+COS(User.Ae)); Y = Height*0.5*(1+SIN(User.Ae))
LineTo           X = Width*0.5*(1+Sheet.1!User.Rc*COS(User.A1)); Y = Height*0.5*(1+Sheet.1!User.Rc*SIN(User.A1))
LineTo           X = Width*0.5*(1+Sheet.1!User.Rh*COS(User.Ae)); Y = Height*0.5*(1+Sheet.1!User.Rh*SIN(User.Ae))
LineTo           X = Width*0.5*(1+Sheet.1!User.Ri*COS(User.Ae)); Y = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.Ae))
EllipticalArcTo  X = Width*0.5*(1+Sheet.1!User.Ri*COS(User.A0)); Y = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.A0))
                 A = Width*0.5*(1+Sheet.1!User.Ri*COS(User.Ms)); B = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.Ms)); C = 0 deg; D = Width/Height
LineTo           X = Geometry1.X1; Y = Geometry1.Y1
