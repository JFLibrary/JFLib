# Einfache Matrix 3x3 (SH-031, JD26): neun gleich große Felder als Teile einer Gruppe, je mit
# eigenem Text, in der Füllung der Formatvorlage, 1 mm Fuge zwischen den Feldern (sichtbar auch in
# Designs ohne Shape-Linien).  Die Felder folgen der Größe der Gruppe.
master: Simple matrix 3x3
name.de: Einfache Matrix 3x3
name.en: Simple matrix 3x3
name.es: Matriz simple 3x3
name.it: Matrice semplice 3x3
name.fr: Matrice simple 3x3
prompt.de: Matrix aus neun Feldern, etwa für Risiko- oder Portfoliobewertungen. Klicken Sie ein Feld zweimal an, um seinen Text zu ändern.
prompt.en: Matrix of nine fields, for example for risk or portfolio assessments. Click a field twice to change its text.
prompt.es: Matriz de nueve campos, por ejemplo para evaluaciones de riesgos o de cartera. Haga clic dos veces en un campo para cambiar su texto.
prompt.it: Matrice di nove campi, ad esempio per valutazioni di rischio o di portafoglio. Fai clic due volte su un campo per cambiarne il testo.
prompt.fr: Matrice de neuf champs, par exemple pour les évaluations de risques ou de portefeuille. Cliquez deux fois sur un champ pour modifier son texte.
keywords.de: Matrix, 3x3, neun Felder, Raster, Risikomatrix, Portfolio, Bewertung
keywords.en: matrix, 3x3, nine fields, grid, risk matrix, portfolio, assessment
keywords.es: matriz, 3x3, nueve campos, cuadrícula, matriz de riesgos, cartera, evaluación
keywords.it: matrice, 3x3, nove campi, griglia, matrice dei rischi, portafoglio, valutazione
keywords.fr: matrice, 3x3, neuf champs, grille, matrice des risques, portefeuille, évaluation

[Shape]
Width = 75 mm
Width.us = 3 in
Height = 55 mm
Height.us = 2.25 in

[User]
# die Fuge zwischen den Feldern, Breite und Höhe eines Felds
G:   Value = 1 mm
     Value.us = 0.04 in
QW:  Value = (Width-2*User.G)/3
QH:  Value = (Height-2*User.G)/3

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

[Part F1]
text.de: Feld 1
text.en: Field 1
text.es: Campo 1
text.it: Campo 1
text.fr: Champ 1

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Width*0.5)
PinY = GUARD(Sheet.1!Height-Height*0.5)

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

