# Matrix 1 (SH-031, JD26): vier Kreise (gestreckt Ellipsen) im Raster 2 x 2 als Teile einer
# Gruppe, je mit eigenem Text und eigener Variantenfarbe des Designs (Schnellformatvorlage 100 bis
# 103), 2 mm Abstand.  Die Kreise folgen der Größe der Gruppe.
master: Matrix 1
name.de: Matrix 1
name.en: Matrix 1
name.es: Matriz 1
name.it: Matrice 1
name.fr: Matrice 1
prompt.de: Vier Kreise im Raster als Vierfeldermatrix. Klicken Sie einen Kreis zweimal an, um seinen Text zu ändern.
prompt.en: Four circles in a grid as a four-field matrix. Click a circle twice to change its text.
prompt.es: Cuatro círculos en cuadrícula como matriz de cuatro campos. Haga clic dos veces en un círculo para cambiar su texto.
prompt.it: Quattro cerchi in griglia come matrice a quattro campi. Fai clic due volte su un cerchio per cambiarne il testo.
prompt.fr: Quatre cercles en grille formant une matrice à quatre champs. Cliquez deux fois sur un cercle pour modifier son texte.
keywords.de: Matrix, Kreise, Raster, Vierfeldermatrix, Quadranten, Einordnung
keywords.en: matrix, circles, grid, four-field matrix, quadrants, classification
keywords.es: matriz, círculos, cuadrícula, cuatro cuadrantes, cuadrantes, clasificación
keywords.it: matrice, cerchi, griglia, quattro quadranti, quadranti, classificazione
keywords.fr: matrice, cercles, grille, quatre quadrants, quadrants, classement

[Shape]
Width = 50 mm
Width.us = 2 in
Height = 50 mm
Height.us = 2 in

[User]
# der Abstand der Kreise, Breite und Höhe eines Kreises
G:   Value = 2 mm
     Value.us = 0.08 in
QW:  Value = (Width-User.G)*0.5
QH:  Value = (Height-User.G)*0.5

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

[Part F1]
text.de: Feld 1
text.en: Field 1
text.es: Campo 1
text.it: Campo 1
text.fr: Champ 1

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Width*0.5)
PinY = GUARD(Sheet.1!Height-Height*0.5)
QuickStyleLineColor = 100
QuickStyleFillColor = 100

[Geometry]
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

[Part F2]
text.de: Feld 2
text.en: Field 2
text.es: Campo 2
text.it: Campo 2
text.fr: Champ 2

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Sheet.1!Width-Width*0.5)
PinY = GUARD(Sheet.1!Height-Height*0.5)
QuickStyleLineColor = 101
QuickStyleFillColor = 101

[Geometry]
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

[Part F3]
text.de: Feld 3
text.en: Field 3
text.es: Campo 3
text.it: Campo 3
text.fr: Champ 3

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Width*0.5)
PinY = GUARD(Height*0.5)
QuickStyleLineColor = 102
QuickStyleFillColor = 102

[Geometry]
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

