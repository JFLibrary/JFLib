# SWOT 1 (SH-031, JD26): eine SWOT-Matrix mit Buchstabenfeldern, anders gestaltet als
# marketing/swot.master.  Vier Felder (Stärken, Schwächen, Chancen, Risiken) mit 2 mm Abstand und
# in ihrer inneren Ecke je ein quadratisches Buchstabenfeld; die vier Buchstabenfelder bilden in
# der Mitte zusammen das Kürzel.  Die Buchstaben sind die des Kürzels der Sprache (SWOT; spanisch
# DAFO: F, D, O, A; französisch FFOM: F, F, O, M), fett und mit der Größe des Felds wachsend
# (Character Size = halbe Höhe).  Felder und Buchstabenfeld je in der Variantenfarbe des Designs
# wie marketing/swot (101, 103, 100, 102); das Buchstabenfeld um 40 Einheiten dunkler (SHADE auf
# THEMEVAL("FillColor"), unter THEMEGUARD).  Der Text der oberen Felder steht oben, der unteren
# unten, weg von den Buchstaben.  Alle Teile folgen der Größe der Gruppe.
master: SWOT 1
name.de: SWOT 1
name.en: SWOT 1
name.es: DAFO 1
name.it: SWOT 1
name.fr: SWOT 1
prompt.de: SWOT-Analyse mit Buchstabenfeldern für Stärken, Schwächen, Chancen und Risiken. Klicken Sie ein Feld zweimal an, um seinen Text zu ändern.
prompt.en: SWOT analysis with letter tiles for strengths, weaknesses, opportunities and threats. Click a field twice to change its text.
prompt.es: Análisis DAFO con casillas de letras para fortalezas, debilidades, oportunidades y amenazas. Haga clic dos veces en un campo para cambiar su texto.
prompt.it: Analisi SWOT con riquadri delle lettere per punti di forza, punti di debolezza, opportunità e minacce. Fai clic due volte su un campo per cambiarne il testo.
prompt.fr: Analyse SWOT avec cases de lettres pour les forces, faiblesses, opportunités et menaces. Cliquez deux fois sur un champ pour modifier son texte.
keywords.de: SWOT, Stärken, Schwächen, Chancen, Risiken, Analyse, Strategie, Matrix
keywords.en: SWOT, strengths, weaknesses, opportunities, threats, analysis, strategy, matrix
keywords.es: DAFO, FODA, SWOT, fortalezas, debilidades, oportunidades, amenazas, estrategia
keywords.it: SWOT, punti di forza, punti di debolezza, opportunità, minacce, analisi, strategia
keywords.fr: SWOT, FFOM, forces, faiblesses, opportunités, menaces, analyse, stratégie

[Shape]
Width = 80 mm
Width.us = 3 in
Height = 60 mm
Height.us = 2.25 in

[User]
# der Abstand der Felder, Breite und Höhe eines Felds, die Seite eines Buchstabenfelds
G:   Value = 2 mm
     Value.us = 0.08 in
QW:  Value = (Width-User.G)*0.5
QH:  Value = (Height-User.G)*0.5
L:   Value = MIN(User.QW,User.QH)*0.4

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

[Part S]
text.de: Stärken
text.en: Strengths
text.es: Fortalezas
text.it: Punti di forza
text.fr: Forces

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Width*0.5)
PinY = GUARD(Sheet.1!Height-Height*0.5)
VerticalAlign = 0
QuickStyleLineColor = 101
QuickStyleFillColor = 101

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

[Part W]
text.de: Schwächen
text.en: Weaknesses
text.es: Debilidades
text.it: Punti di debolezza
text.fr: Faiblesses

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Sheet.1!Width-Width*0.5)
PinY = GUARD(Sheet.1!Height-Height*0.5)
VerticalAlign = 0
QuickStyleLineColor = 103
QuickStyleFillColor = 103

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

[Part O]
text.de: Chancen
text.en: Opportunities
text.es: Oportunidades
text.it: Opportunità
text.fr: Opportunités

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Width*0.5)
PinY = GUARD(Height*0.5)
VerticalAlign = 2
QuickStyleLineColor = 100
QuickStyleFillColor = 100

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

[Part T]
text.de: Risiken
text.en: Threats
text.es: Amenazas
text.it: Minacce
text.fr: Menaces

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Sheet.1!Width-Width*0.5)
PinY = GUARD(Height*0.5)
VerticalAlign = 2
QuickStyleLineColor = 102
QuickStyleFillColor = 102

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

