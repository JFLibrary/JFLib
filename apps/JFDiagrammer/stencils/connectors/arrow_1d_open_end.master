# 1D-Pfeil, Ende offen: der 1D-Pfeil ohne Linie am Schaftende -- die Füllung ist ein geschlossener
# Abschnitt ohne Linie (NoLine), der Umriss ein offener Abschnitt ohne Füllung (NoFill).  Liegt
# auf der Linie vom Anfang zum Ende und dreht sich mit ihr (PinX, Width, Angle aus den Enden); die
# Enden kleben an Shapes, mit GlueType 2 auch an das ganze Shape.  Die Dicke ist Height; Row_1
# ändert die Länge der Spitze (Abstand vom Ende), Row_2 die Dicke des Schafts.  Formatvorlage
# "Normal".
master: 1-D arrow, open end
name.de: 1D-Pfeil, Ende offen
name.en: 1-D arrow, open end
name.es: Flecha 1D, extremo abierto
name.it: Freccia 1D, estremità aperta
name.fr: Flèche 1D, extrémité ouverte
prompt.de: Flächiger Pfeil ohne Abschluss am Schaftende, als käme er aus einem Shape. Spitze und Schaft ändern Sie mit den gelben Steuerpunkten.
prompt.en: Flat arrow without an edge at the end of the shaft, as if it came out of a shape. Drag the yellow control handles to change the head and the shaft.
prompt.es: Flecha plana sin borde al final del cuerpo, como si saliera de una forma. Arrastre los controladores amarillos para cambiar la punta y el cuerpo.
prompt.it: Freccia piatta senza bordo alla fine del corpo, come se uscisse da una forma. Trascina le maniglie di controllo gialle per cambiare la punta e il corpo.
prompt.fr: Flèche pleine sans bord au bout du corps, comme si elle sortait d'une forme. Faites glisser les poignées de contrôle jaunes pour modifier la pointe et le corps.
keywords.de: 1D, offen, Schaftende, Ausgang, Pfeil, Blockpfeil, kleben
keywords.en: 1-D, open, shaft end, exit, arrow, block arrow, glue
keywords.es: 1D, abierto, extremo del cuerpo, salida, flecha, flecha de bloque, pegar
keywords.it: 1D, aperto, fine del corpo, uscita, freccia, freccia a blocco, incollare
keywords.fr: 1D, ouvert, bout du corps, sortie, flèche, flèche pleine, coller

[Shape]
BeginX = 0 mm
BeginY = 5 mm
BeginY.us = 0.1875 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 5 mm
EndY.us = 0.1875 in
Height = 10 mm
Height.us = 0.375 in
GlueType = 2

[User]
# die Länge der Spitze und der halbe Schaft
Hl:     Value = MIN(MAX(Width-Controls.Row_1, 0), Width)
Shaft:  Value = MIN(MAX(Controls.Row_2.Y-Height*0.5, 0), Height*0.5)

# 1 die Füllung
[Geometry]
NoLine = TRUE
MoveTo  X = 0; Y = Height*0.5-User.Shaft
LineTo  X = Width-User.Hl; Y = Height*0.5-User.Shaft
LineTo  X = Width-User.Hl; Y = 0
LineTo  X = Width; Y = Height*0.5
LineTo  X = Width-User.Hl; Y = Height
LineTo  X = Width-User.Hl; Y = Height*0.5+User.Shaft
LineTo  X = 0; Y = Height*0.5+User.Shaft
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

# 2 der Umriss, am Schaftende offen
[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5-User.Shaft
LineTo  X = Width-User.Hl; Y = Height*0.5-User.Shaft
LineTo  X = Width-User.Hl; Y = 0
LineTo  X = Width; Y = Height*0.5
LineTo  X = Width-User.Hl; Y = Height
LineTo  X = Width-User.Hl; Y = Height*0.5+User.Shaft
LineTo  X = 0; Y = Height*0.5+User.Shaft

[Controls]
Row_1:  X = Width-8 mm; Y = Height
        X.us = Width-0.3 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 4; YCon = 1; CanGlue = FALSE
        Tip.de = "Länge der Spitze ändern"
        Tip.en = "Change the length of the head"
        Tip.es = "Cambiar la longitud de la punta"
        Tip.it = "Cambia la lunghezza della punta"
        Tip.fr = "Modifier la longueur de la pointe"
Row_2:  X = 0; Y = Height*0.75
        XDyn = Controls.Row_2; YDyn = Controls.Row_2.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Dicke des Schafts ändern"
        Tip.en = "Change the thickness of the shaft"
        Tip.es = "Cambiar el grosor del cuerpo"
        Tip.it = "Cambia lo spessore del corpo"
        Tip.fr = "Modifier l'épaisseur du corps"
