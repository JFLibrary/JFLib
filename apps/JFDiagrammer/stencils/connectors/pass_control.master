# Übergabe der Kontrolle: eine gerade Linie ohne Linienenden (BeginArrow/EndArrow 0) mit einem
# offenen Dreieck in der Mitte, das zum Ende zeigt (ein Abschnitt ohne Füllung, 5 x 4 mm).  Liegt
# auf der Linie vom Anfang zum Ende und dreht sich mit ihr (PinX, Width, Angle aus den Enden); die
# Enden kleben an Shapes, mit GlueType 2 auch an das ganze Shape.
master: Pass control
name.de: Übergabe der Kontrolle
name.en: Pass control
name.es: Paso de control
name.it: Passaggio del controllo
name.fr: Passage du contrôle
prompt.de: Gerade Linie mit einem offenen Dreieck in der Mitte: die Kontrolle geht an das Ziel über. Ziehen Sie die Enden auf Shapes.
prompt.en: Straight line with an open triangle in the middle: control passes to the target. Drag the ends onto shapes.
prompt.es: Línea recta con un triángulo abierto en el centro: el control pasa al destino. Arrastre los extremos sobre las formas.
prompt.it: Linea retta con un triangolo vuoto al centro: il controllo passa alla destinazione. Trascina le estremità sulle forme.
prompt.fr: Ligne droite avec un triangle vide au milieu : le contrôle passe à la cible. Faites glisser les extrémités sur les formes.
keywords.de: Kontrolle, Übergabe, Steuerung, Dreieck, Linie, Verbinder
keywords.en: control, handover, pass, triangle, line, connector
keywords.es: control, traspaso, paso, triángulo, línea, conector
keywords.it: controllo, passaggio, consegna, triangolo, linea, connettore
keywords.fr: contrôle, passage, transfert, triangle, ligne, connecteur
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 2.5 mm
BeginY.us = 0.1 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 2.5 mm
EndY.us = 0.1 in
Height = 0 mm
Height.us = 0 in
GlueType = 2
BeginArrow = 0
EndArrow = 0
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Width*0.5
TxtPinY = Height*0.5-5 mm
TxtPinY.us = Height*0.5-0.2 in
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[User]
# die Länge und die halbe Breite des Dreiecks
Al:  Value = 5 mm
     Value.us = 0.2 in
Aw:  Value = 2 mm
     Value.us = 0.08 in

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5
LineTo  X = Width*0.5-User.Al*0.5; Y = Height*0.5
MoveTo  X = Width*0.5+User.Al*0.5; Y = Height*0.5
LineTo  X = Width; Y = Height*0.5

[Geometry]
NoFill = TRUE
MoveTo  X = Width*0.5+User.Al*0.5; Y = Height*0.5
LineTo  X = Width*0.5-User.Al*0.5; Y = Height*0.5+User.Aw
LineTo  X = Width*0.5-User.Al*0.5; Y = Height*0.5-User.Aw
LineTo  X = Geometry2.X1; Y = Geometry2.Y1
