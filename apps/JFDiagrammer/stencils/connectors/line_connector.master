# Verbinder: Linie: gerade (ShapeRouteStyle 2); die App setzt die Enden dorthin, wo die Linie
# zwischen den Shapes ihre Umrisse verlässt.  Dynamischer Verbinder (ObjType 2 verlegbar, GlueType
# 2): die App verlegt ihn selbst und ersetzt die gezeichnete Geometrie durch ihren Weg; der Kasten
# bleibt aufrecht (Width = EndX-BeginX ..., Angle 0).  Route-Zellen mit Visios Namen und Werten:
# ShapeRouteStyle 2 (gerade), ConLineRouteExt 1, ConFixedCode 0.  Der Text folgt
# Controls.TextPosition, das die App in die Mitte des Wegs setzt (ohne Text verborgen).
master: Line connector
name.de: Verbinder: Linie
name.en: Line connector
name.es: Conector de línea
name.it: Connettore lineare
name.fr: Connecteur droit
prompt.de: Dynamischer Verbinder als gerade Linie zwischen zwei Shapes. Ziehen Sie die Enden auf Shapes.
prompt.en: Dynamic connector as a straight line between two shapes. Drag the ends onto shapes.
prompt.es: Conector dinámico como línea recta entre dos formas. Arrastre los extremos sobre las formas.
prompt.it: Connettore dinamico come linea retta tra due forme. Trascina le estremità sulle forme.
prompt.fr: Connecteur dynamique en ligne droite entre deux formes. Faites glisser les extrémités sur les formes.
keywords.de: Verbinder, dynamisch, verbinden, gerade, Linie, direkt
keywords.en: connector, dynamic, connect, straight, line, direct
keywords.es: conector, dinámico, conectar, recto, línea, directo
keywords.it: connettore, dinamico, collegare, diritto, linea, diretto
keywords.fr: connecteur, dynamique, relier, droit, ligne, direct
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 0 mm
EndX = 40 mm
EndX.us = 1.5 in
EndY = 20 mm
EndY.us = 0.75 in
Width = GUARD(EndX-BeginX)
Height = GUARD(EndY-BeginY)
Angle = GUARD(0DA)
ObjType = 2
ShapeSplittable = 1
GlueType = 2
ShapeRouteStyle = 2
ConLineRouteExt = 1
ConFixedCode = 0
NoAlignBox = TRUE
DynFeedback = 2
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Controls.TextPosition
TxtPinY = Controls.TextPosition.Y
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[Geometry]
NoFill = TRUE
RelMoveTo  X = 0; Y = 0
RelLineTo  X = 1; Y = 1

[Controls]
TextPosition:  X = Width*0.5; Y = Height*0.5
        XDyn = Controls.TextPosition; YDyn = Controls.TextPosition.Y
        XCon = IF(OR(STRSAME(SHAPETEXT(TheText),""),HideText),5,0); YCon = 0; CanGlue = FALSE
        Tip.de = "Text verschieben"
        Tip.en = "Move the text"
        Tip.es = "Mover el texto"
        Tip.it = "Sposta il testo"
        Tip.fr = "Déplacer le texte"
