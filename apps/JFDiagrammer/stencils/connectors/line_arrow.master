# Linie mit Pfeil: eine gerade Linie als 1D-Shape (Height 0), sie liegt auf der Linie vom
# Anfang zum Ende und dreht sich mit ihr.  Die Pfeilspitze am Ende kommt aus der Formatvorlage
# "Connector" (jedes Design hat eine).  Die Enden kleben, mit GlueType 2 auch an das ganze
# Shape.  Der Text steht in der Mitte der Linie.
master: Line with arrow
name.de: Linie mit Pfeil
name.en: Line with arrow
name.es: Línea con flecha
name.it: Linea con freccia
name.fr: Ligne avec flèche
prompt.de: Gerade Linie mit Pfeilspitze am Ende. Ziehen Sie ihre Enden auf Shapes.
prompt.en: Straight line with an arrowhead at the end. Drag its ends onto shapes.
prompt.es: Línea recta con punta de flecha en el extremo. Arrastre sus extremos sobre las formas.
prompt.it: Linea retta con punta di freccia all'estremità. Trascina le sue estremità sulle forme.
prompt.fr: Ligne droite avec une pointe de flèche à l'extrémité. Faites glisser ses extrémités sur les formes.
keywords.de: Linie, Pfeil, Pfeilspitze, gerade, Verbinder, Richtung, verbinden
keywords.en: line, arrow, arrowhead, straight, connector, direction, connect
keywords.es: línea, flecha, punta de flecha, recta, conector, dirección, conectar
keywords.it: linea, freccia, punta di freccia, retta, connettore, direzione, collegare
keywords.fr: ligne, flèche, pointe de flèche, droite, connecteur, direction, connecter, relier
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 2.5 mm
BeginY.us = 0.1 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 2.5 mm
EndY.us = 0.1 in
Height = 0 mm
Height.us = 0 in
GlueType = 2
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
# die Pfeilspitze des Designs auch in Visio: ein 1D-Shape ohne ObjType 2 bekommt sie dort
# nur mit QuickStyleType 3 (die Verbinder-Liste des Designs)
QuickStyleType = 3

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5
LineTo  X = Width; Y = Height*0.5
