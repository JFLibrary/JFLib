# Seite nach Seite: von Seite zu Seite (einfach links nach rechts), gezeichnet ein waagrechtes
# Stück.  Dynamischer Verbinder (ObjType 2 verlegbar, GlueType 2): die App verlegt ihn selbst und
# ersetzt die gezeichnete Geometrie durch ihren Weg; der Kasten bleibt aufrecht (Width =
# EndX-BeginX ..., Angle 0).  Route-Zellen mit Visios Namen und Werten: ShapeRouteStyle 18
# (einfach links nach rechts), ConLineRouteExt 1, ConFixedCode 0.  Der Text folgt
# Controls.TextPosition, das die App in die Mitte des Wegs setzt (ohne Text verborgen).
master: Side to side
name.de: Seite nach Seite
name.en: Side to side
name.es: Lado a lado
name.it: Lato a lato
name.fr: Côté à côté
prompt.de: Gerader dynamischer Verbinder von Seite zu Seite zweier nebeneinanderliegender Shapes. Ziehen Sie die Enden auf Shapes.
prompt.en: Straight dynamic connector from side to side of two shapes next to each other. Drag the ends onto shapes.
prompt.es: Conector dinámico recto de lado a lado entre dos formas contiguas. Arrastre los extremos sobre las formas.
prompt.it: Connettore dinamico diritto da lato a lato tra due forme affiancate. Trascina le estremità sulle forme.
prompt.fr: Connecteur dynamique droit de côté à côté entre deux formes voisines. Faites glisser les extrémités sur les formes.
keywords.de: Verbinder, dynamisch, verbinden, Seite, waagrecht, nebeneinander
keywords.en: connector, dynamic, connect, side, horizontal, next to each other
keywords.es: conector, dinámico, conectar, lado, horizontal, contiguas
keywords.it: connettore, dinamico, collegare, lato, orizzontale, affiancate
keywords.fr: connecteur, dynamique, relier, côté, horizontal, voisines
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 5 mm
BeginY.us = 0.2 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 5 mm
EndY.us = 0.2 in
Width = GUARD(EndX-BeginX)
Height = GUARD(EndY-BeginY)
Angle = GUARD(0DA)
ObjType = 2
ShapeSplittable = 1
GlueType = 2
ShapeRouteStyle = 18
ConLineRouteExt = 1
ConFixedCode = 0
NoAlignBox = TRUE
DynFeedback = 2
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Controls.TextPosition
TxtPinY = Controls.TextPosition.Y
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[Geometry]
NoFill = TRUE
RelMoveTo  X = 0; Y = 0
RelLineTo  X = 1; Y = 1

[Controls]
TextPosition:  X = Width*0.5; Y = Height*0.5
        XDyn = Controls.TextPosition; YDyn = Controls.TextPosition.Y
        XCon = IF(OR(STRSAME(SHAPETEXT(TheText),""),HideText),5,0); YCon = 0; CanGlue = FALSE
        Tip.de = "Text verschieben"
        Tip.en = "Move the text"
        Tip.es = "Mover el texto"
        Tip.it = "Sposta il testo"
        Tip.fr = "Déplacer le texte"
