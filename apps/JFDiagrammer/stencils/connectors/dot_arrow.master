# Punkt und Pfeil: eine gerade Linie mit gefülltem Punkt am Anfang (BeginArrow 10, der Punkt ist
# der Sinn dieses Shapes) und der Pfeilspitze des Designs am Ende (Formatvorlage "Connector").
# Liegt auf der Linie vom Anfang zum Ende und dreht sich mit ihr (PinX, Width, Angle aus den
# Enden); die Enden kleben an Shapes, mit GlueType 2 auch an das ganze Shape.
master: Dot and arrow
name.de: Punkt und Pfeil
name.en: Dot and arrow
name.es: Punto y flecha
name.it: Punto e freccia
name.fr: Point et flèche
prompt.de: Gerade Linie mit einem Punkt am Anfang und einer Pfeilspitze am Ende. Ziehen Sie die Enden auf Shapes.
prompt.en: Straight line with a dot at the beginning and an arrowhead at the end. Drag the ends onto shapes.
prompt.es: Línea recta con un punto al principio y una punta de flecha al final. Arrastre los extremos sobre las formas.
prompt.it: Linea retta con un punto all'inizio e una punta di freccia alla fine. Trascina le estremità sulle forme.
prompt.fr: Ligne droite avec un point au début et une pointe de flèche à la fin. Faites glisser les extrémités sur les formes.
keywords.de: Punkt, Pfeil, Anfang, Ende, Linie, Verbinder
keywords.en: dot, arrow, beginning, end, line, connector
keywords.es: punto, flecha, principio, final, línea, conector
keywords.it: punto, freccia, inizio, fine, linea, connettore
keywords.fr: point, flèche, début, fin, ligne, connecteur
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 2.5 mm
BeginY.us = 0.1 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 2.5 mm
EndY.us = 0.1 in
Height = 0 mm
Height.us = 0 in
GlueType = 2
BeginArrow = 10
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
# die Pfeilspitze des Designs auch in Visio: ein 1D-Shape ohne ObjType 2 bekommt sie dort
# nur mit QuickStyleType 3 (die Verbinder-Liste des Designs)
QuickStyleType = 3

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5
LineTo  X = Width; Y = Height*0.5
