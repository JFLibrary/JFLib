# Hohler Verbinder: ein Hohlpfeil als 1D-Shape -- nur der Umriss eines flächigen Pfeils, ohne
# Füllung und am Schaftende offen, als käme er aus dem Shape, an dem sein Anfang klebt.  Er
# liegt auf der Linie vom Anfang zum Ende und dreht sich mit ihr (PinX, Width, Angle aus den
# Enden); die Dicke ist Height.  Row_1 an der oberen Ecke der Spitze ändert ihre Länge (Abstand
# vom Ende), Row_2 an der Schaftkante die Breite des Schafts.  Formatvorlage "Connector" wie die
# Linienverbinder (ein Design ohne Shape-Linien, etwa Kontrast, ließe ihn sonst verschwinden),
# ohne deren Pfeilspitzen: die Spitze ist der Umriss selbst.
master: Hollow connector
name.de: Hohler Verbinder
name.en: Hollow connector
name.es: Conector hueco
name.it: Connettore cavo
name.fr: Connecteur creux
prompt.de: Hohlpfeil als Verbinder, seine Enden kleben an Shapes. Spitze und Schaft ändern Sie mit den gelben Steuerpunkten.
prompt.en: Hollow arrow as a connector whose ends glue to shapes. Drag the yellow control handles to change the head and the shaft.
prompt.es: Flecha hueca como conector cuyos extremos se pegan a las formas. Arrastre los controladores amarillos para cambiar la punta y el cuerpo.
prompt.it: Freccia cava come connettore con estremità che si incollano alle forme. Trascina le maniglie di controllo gialle per cambiare la punta e il corpo.
prompt.fr: Flèche creuse servant de connecteur, dont les extrémités se collent aux formes. Faites glisser les poignées de contrôle jaunes pour modifier la pointe et le corps.
keywords.de: Verbinder, Hohlpfeil, hohl, Pfeil, Umriss, Fluss, verbinden
keywords.en: connector, hollow arrow, hollow, arrow, outline, flow, connect
keywords.es: conector, flecha hueca, hueco, flecha, contorno, flujo, conectar
keywords.it: connettore, freccia cava, cavo, freccia, contorno, flusso, collegare
keywords.fr: connecteur, flèche creuse, creux, flèche, contour, flux, connecter, relier
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 5 mm
BeginY.us = 0.1875 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 5 mm
EndY.us = 0.1875 in
Height = 10 mm
Height.us = 0.375 in
GlueType = 2
BeginArrow = 0
EndArrow = 0

[User]
# die Länge der Spitze und der halbe Schaft
Hl:     Value = MIN(MAX(Width-Controls.Row_1, 0), Width)
Shaft:  Value = MIN(MAX(Controls.Row_2.Y-Height*0.5, 0), Height*0.5)

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5+User.Shaft
LineTo  X = Width-User.Hl; Y = Height*0.5+User.Shaft
LineTo  X = Width-User.Hl; Y = Height
LineTo  X = Width; Y = Height*0.5
LineTo  X = Width-User.Hl; Y = 0
LineTo  X = Width-User.Hl; Y = Height*0.5-User.Shaft
LineTo  X = 0; Y = Height*0.5-User.Shaft

[Controls]
Row_1:  X = Width-8 mm; Y = Height
        X.us = Width-0.3 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 4; YCon = 1; CanGlue = FALSE
        Tip.de = "Länge der Spitze ändern"
        Tip.en = "Change the length of the head"
        Tip.es = "Cambiar la longitud de la punta"
        Tip.it = "Cambia la lunghezza della punta"
        Tip.fr = "Modifier la longueur de la pointe"
Row_2:  X = 0; Y = Height*0.75
        XDyn = Controls.Row_2; YDyn = Controls.Row_2.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Breite des Schafts ändern"
        Tip.en = "Change the width of the shaft"
        Tip.es = "Cambiar el ancho del cuerpo"
        Tip.it = "Cambia la larghezza del corpo"
        Tip.fr = "Modifier la largeur du corps"
