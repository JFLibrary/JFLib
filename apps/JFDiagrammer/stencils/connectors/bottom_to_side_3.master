# Unten nach Seite 3: senkrecht aus der Unterkante, waagrecht in die Seite eines Shapes daneben;
# gezeichnet ein Haken (hinab, hinüber, hinauf, hinein).  Dynamischer Verbinder (ObjType 2
# verlegbar, GlueType 2): die App verlegt ihn selbst und ersetzt die gezeichnete Geometrie durch
# ihren Weg; der Kasten bleibt aufrecht (Width = EndX-BeginX ..., Angle 0).  Route-Zellen mit
# Visios Namen und Werten: ShapeRouteStyle 22 (einfach senkrecht-waagrecht), ConLineRouteExt 1,
# ConFixedCode 0.  Der Text folgt Controls.TextPosition, das die App in die Mitte des Wegs setzt
# (ohne Text verborgen).
master: Bottom to side 3
name.de: Unten nach Seite 3
name.en: Bottom to side 3
name.es: De abajo al lado 3
name.it: Dal basso al lato 3
name.fr: Du bas vers le côté 3
prompt.de: Dynamischer Verbinder von der Unterkante des einen Shapes zur Seite eines anderen daneben oder höher, mit einem Haken. Ziehen Sie die Enden auf Shapes.
prompt.en: Dynamic connector from the bottom edge of one shape to the side of another beside it or higher, with a hook. Drag the ends onto shapes.
prompt.es: Conector dinámico del borde inferior de una forma al lado de otra situada al lado o más arriba, con un gancho. Arrastre los extremos sobre las formas.
prompt.it: Connettore dinamico dal bordo inferiore di una forma al lato di un'altra accanto o più in alto, con un gancio. Trascina le estremità sulle forme.
prompt.fr: Connecteur dynamique du bord inférieur d'une forme au côté d'une autre à côté ou plus haut, avec un crochet. Faites glisser les extrémités sur les formes.
keywords.de: Verbinder, dynamisch, verbinden, unten, Seite, Haken, Knick
keywords.en: connector, dynamic, connect, bottom, side, hook, bend
keywords.es: conector, dinámico, conectar, abajo, lado, gancho, codo
keywords.it: connettore, dinamico, collegare, basso, lato, gancio, piega
keywords.fr: connecteur, dynamique, relier, bas, côté, crochet, coude
style: Connector

[Shape]
BeginX = 5 mm
BeginX.us = 0.2 in
BeginY = 10 mm
BeginY.us = 0.4 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 18 mm
EndY.us = 0.7 in
Width = GUARD(EndX-BeginX)
Height = GUARD(EndY-BeginY)
Angle = GUARD(0DA)
ObjType = 2
ShapeSplittable = 1
GlueType = 2
ShapeRouteStyle = 22
ConLineRouteExt = 1
ConFixedCode = 0
NoAlignBox = TRUE
DynFeedback = 2
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Controls.TextPosition
TxtPinY = Controls.TextPosition.Y
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[User]
# der Abstand, mit dem der gezeichnete Verlauf um die Shapes herumführt
Gap:  Value = 6 mm
      Value.us = 0.25 in

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = 0
LineTo  X = 0; Y = -User.Gap
LineTo  X = Width*0.5; Y = -User.Gap
LineTo  X = Width*0.5; Y = Height
LineTo  X = Width; Y = Height

[Controls]
TextPosition:  X = Width*0.5; Y = Height*0.5
        XDyn = Controls.TextPosition; YDyn = Controls.TextPosition.Y
        XCon = IF(OR(STRSAME(SHAPETEXT(TheText),""),HideText),5,0); YCon = 0; CanGlue = FALSE
        Tip.de = "Text verschieben"
        Tip.en = "Move the text"
        Tip.es = "Mover el texto"
        Tip.it = "Sposta il testo"
        Tip.fr = "Déplacer le texte"
