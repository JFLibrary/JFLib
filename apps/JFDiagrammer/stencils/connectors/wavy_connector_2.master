# Welliger Verbinder 2: eine Wellenlinie aus 8 Kreisbögen (ArcTo, die Bogenhöhe abwechselnd
# +-Height/2: die Bögen treffen sich auf der Mittellinie tangential).  Liegt auf der Linie vom
# Anfang zum Ende und dreht sich mit ihr (PinX, Width, Angle aus den Enden); die Enden kleben an
# Shapes, mit GlueType 2 auch an das ganze Shape.  Die Wellen strecken sich mit der Länge, ihre
# Höhe ist die Dicke (Height).  Pfeilspitze am Ende aus der Formatvorlage "Connector".
master: Wavy connector 2
name.de: Welliger Verbinder 2
name.en: Wavy connector 2
name.es: Conector ondulado 2
name.it: Connettore ondulato 2
name.fr: Connecteur ondulé 2
prompt.de: Wellenlinie mit 4 Wellen und Pfeilspitze am Ende. Ziehen Sie die Enden auf Shapes.
prompt.en: Wavy line with 4 waves and an arrowhead at the end. Drag the ends onto shapes.
prompt.es: Línea ondulada con 4 ondas y punta de flecha al final. Arrastre los extremos sobre las formas.
prompt.it: Linea ondulata con 4 onde e punta di freccia alla fine. Trascina le estremità sulle forme.
prompt.fr: Ligne ondulée avec 4 ondes et une pointe de flèche à la fin. Faites glisser les extrémités sur les formes.
keywords.de: Welle, wellig, Wellenlinie, Schwingung, Linie, Verbinder
keywords.en: wave, wavy, wavy line, oscillation, line, connector
keywords.es: onda, ondulado, línea ondulada, oscilación, línea, conector
keywords.it: onda, ondulato, linea ondulata, oscillazione, linea, connettore
keywords.fr: onde, ondulé, ligne ondulée, oscillation, ligne, connecteur
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 2 mm
BeginY.us = 0.075 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 2 mm
EndY.us = 0.075 in
Height = 4 mm
Height.us = 0.15 in
GlueType = 2
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
# die Pfeilspitze des Designs auch in Visio: ein 1D-Shape ohne ObjType 2 bekommt sie dort
# nur mit QuickStyleType 3 (die Verbinder-Liste des Designs)
QuickStyleType = 3

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5
ArcTo   X = Width*0.125; Y = Height*0.5; A = -Height*0.5
ArcTo   X = Width*0.25; Y = Height*0.5; A = Height*0.5
ArcTo   X = Width*0.375; Y = Height*0.5; A = -Height*0.5
ArcTo   X = Width*0.5; Y = Height*0.5; A = Height*0.5
ArcTo   X = Width*0.625; Y = Height*0.5; A = -Height*0.5
ArcTo   X = Width*0.75; Y = Height*0.5; A = Height*0.5
ArcTo   X = Width*0.875; Y = Height*0.5; A = -Height*0.5
ArcTo   X = Width; Y = Height*0.5; A = Height*0.5
