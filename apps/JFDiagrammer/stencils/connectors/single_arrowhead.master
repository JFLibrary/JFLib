# Einfache Pfeilspitze: eine gerade Linie mit offener Pfeilspitze aus zwei Strichen am Ende
# (EndArrow 1, in jedem Design gleich -- die offene Spitze ist der Sinn dieses Shapes).  Liegt auf
# der Linie vom Anfang zum Ende und dreht sich mit ihr (PinX, Width, Angle aus den Enden); die
# Enden kleben an Shapes, mit GlueType 2 auch an das ganze Shape.
master: Single arrowhead
name.de: Einfache Pfeilspitze
name.en: Single arrowhead
name.es: Punta de flecha simple
name.it: Punta di freccia singola
name.fr: Pointe de flèche simple
prompt.de: Gerade Linie mit einer offenen, einfachen Pfeilspitze am Ende. Ziehen Sie die Enden auf Shapes.
prompt.en: Straight line with an open, simple arrowhead at the end. Drag the ends onto shapes.
prompt.es: Línea recta con una punta de flecha simple y abierta al final. Arrastre los extremos sobre las formas.
prompt.it: Linea retta con una punta di freccia semplice e aperta alla fine. Trascina le estremità sulle forme.
prompt.fr: Ligne droite avec une pointe de flèche simple et ouverte à la fin. Faites glisser les extrémités sur les formes.
keywords.de: Pfeil, Pfeilspitze, offen, einfach, Linie, Verbinder
keywords.en: arrow, arrowhead, open, simple, line, connector
keywords.es: flecha, punta de flecha, abierta, simple, línea, conector
keywords.it: freccia, punta di freccia, aperta, semplice, linea, connettore
keywords.fr: flèche, pointe de flèche, ouverte, simple, ligne, connecteur
style: Connector

[Shape]
BeginX = 0 mm
BeginY = 2.5 mm
BeginY.us = 0.1 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 2.5 mm
EndY.us = 0.1 in
Height = 0 mm
Height.us = 0 in
GlueType = 2
BeginArrow = 0
EndArrow = 1
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5
LineTo  X = Width; Y = Height*0.5
