name.de: ATM-Router
name.en: ATM router
name.es: Enrutador ATM
name.it: Router ATM
name.fr: Routeur ATM
prompt.de: ATM-Router: Router mit ATM-Anschluss.
prompt.en: ATM router: router with an ATM interface.
prompt.es: Enrutador ATM: enrutador con interfaz ATM.
prompt.it: Router ATM: router con interfaccia ATM.
prompt.fr: Routeur ATM : routeur avec interface ATM.
keywords.de: ATM-Router, Netzwerk
keywords.en: ATM router, network
keywords.es: Enrutador ATM, red
keywords.it: Router ATM, rete
