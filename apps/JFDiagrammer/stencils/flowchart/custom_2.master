# Benutzerdefiniert 2: eine frei belegbare Form, das Trapez von Benutzerdefiniert 1 auf dem Kopf
# (die lange Seite oben; in ISO 5807 sähe so die manuelle Verarbeitung aus).  Row_1 an der linken
# unteren Ecke ändert, wie weit die kurze Seite eingerückt ist (nur waagrecht, als Abstand von
# links).
master: Custom 2
name.de: Benutzerdefiniert 2
name.en: Custom 2
name.es: Personalizado 2
name.it: Personalizzato 2
name.fr: Personnalisé 2
prompt.de: Eine frei belegbare Form: ein Trapez mit der langen Seite oben. Mit dem gelben Steuerpunkt ändern Sie die Neigung der Seiten.
prompt.en: A shape for your own meaning: a trapezoid with the long side at the top. Drag the yellow control handle to change the slant of the sides.
prompt.es: Una forma para el significado que usted elija: un trapecio con el lado largo arriba. Arrastre el controlador amarillo para cambiar la inclinación de los lados.
prompt.it: Una forma dal significato libero: un trapezio con il lato lungo in alto. Trascina la maniglia di controllo gialla per cambiare l'inclinazione dei lati.
prompt.fr: Une forme à la signification libre : un trapèze avec le grand côté en haut. Faites glisser la poignée de contrôle jaune pour modifier l'inclinaison des côtés.
keywords.de: benutzerdefiniert, Trapez, umgekehrt, frei, eigene Bedeutung, Form, Flussdiagramm
keywords.en: custom, trapezoid, upside down, free, own meaning, shape, flowchart
keywords.es: personalizado, trapecio, invertido, libre, significado propio, forma, diagrama de flujo
keywords.it: personalizzato, trapezio, capovolto, libero, significato proprio, forma, diagramma di flusso
keywords.fr: personnalisé, trapèze, inversé, libre, signification propre, forme, diagramme de flux

[Shape]
Width = 36 mm
Width.us = 1.5 in
Height = 24 mm
Height.us = 1 in
TxtWidth = Width-User.Inset
TxtHeight = Height
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[User]
msvShapeCategories:  Value = "Flowchart"
# wie weit die kurze Seite eingerückt ist
Inset:  Value = MIN(MAX(Controls.Row_1, 0), Width*0.5)

[Geometry]
MoveTo  X = User.Inset; Y = 0
LineTo  X = Width-User.Inset; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = 6 mm; Y = 0
        X.us = 0.25 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Neigung der Seiten ändern"
        Tip.en = "Change the slant of the sides"
        Tip.es = "Cambiar la inclinación de los lados"
        Tip.it = "Cambia l'inclinazione dei lati"
        Tip.fr = "Modifier l'inclinaison des côtés"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width-User.Inset*0.5; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = User.Inset*0.5; Y = Height*0.5; DirX = 1; DirY = 0
