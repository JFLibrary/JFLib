# Benutzerdefiniert 1: eine frei belegbare Form, ein Trapez mit der langen Seite unten.  Row_1 an
# der linken oberen Ecke ändert, wie weit die kurze Seite eingerückt ist (nur waagrecht, als
# Abstand von links).  Verbindungspunkte in der Mitte jeder Seite, seitlich auf halber Höhe der
# Schrägen.
master: Custom 1
name.de: Benutzerdefiniert 1
name.en: Custom 1
name.es: Personalizado 1
name.it: Personalizzato 1
name.fr: Personnalisé 1
prompt.de: Eine frei belegbare Form: ein Trapez. Mit dem gelben Steuerpunkt ändern Sie die Neigung der Seiten.
prompt.en: A shape for your own meaning: a trapezoid. Drag the yellow control handle to change the slant of the sides.
prompt.es: Una forma para el significado que usted elija: un trapecio. Arrastre el controlador amarillo para cambiar la inclinación de los lados.
prompt.it: Una forma dal significato libero: un trapezio. Trascina la maniglia di controllo gialla per cambiare l'inclinazione dei lati.
prompt.fr: Une forme à la signification libre : un trapèze. Faites glisser la poignée de contrôle jaune pour modifier l'inclinaison des côtés.
keywords.de: benutzerdefiniert, Trapez, frei, eigene Bedeutung, Form, Symbol, Flussdiagramm
keywords.en: custom, trapezoid, free, own meaning, shape, symbol, flowchart
keywords.es: personalizado, trapecio, libre, significado propio, forma, símbolo, diagrama de flujo
keywords.it: personalizzato, trapezio, libero, significato proprio, forma, simbolo, diagramma di flusso
keywords.fr: personnalisé, trapèze, libre, signification propre, forme, symbole, diagramme de flux

[Shape]
Width = 36 mm
Width.us = 1.5 in
Height = 24 mm
Height.us = 1 in
TxtWidth = Width-User.Inset
TxtHeight = Height
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
ShapeSplit = 1
ObjType = 1

[User]
msvShapeCategories:  Value = "Flowchart"
# wie weit die kurze Seite eingerückt ist
Inset:  Value = MIN(MAX(Controls.Row_1, 0), Width*0.5)

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width-User.Inset; Y = Height
LineTo  X = User.Inset; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = 6 mm; Y = Height
        X.us = 0.25 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Neigung der Seiten ändern"
        Tip.en = "Change the slant of the sides"
        Tip.es = "Cambiar la inclinación de los lados"
        Tip.it = "Cambia l'inclinazione dei lati"
        Tip.fr = "Modifier l'inclinaison des côtés"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width-User.Inset*0.5; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = User.Inset*0.5; Y = Height*0.5; DirX = 1; DirY = 0
