# Netzwerksymbole (JD13): Größe und Textblock aller Symbole des gemeinsamen Satzes (SH-G09).
# Die Grafik liegt im Raster 64 x 48 wie bei JFNetworker; das Shape ist 24 x 18 mm (US 1 x 0,75 in),
# der Name steht mittig unter dem Symbol.
[Shape]
Width = 24 mm
Width.us = 1 in
Height = 18 mm
Height.us = 0.75 in
TxtWidth = Width*2
TxtHeight = 7 mm
TxtHeight.us = 0.28 in
TxtPinX = Width*0.5
TxtPinY = 0 mm
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight
VerticalAlign = 0
ShapeSplit = 1
