[Shape]
Width = 100 mm
Width.us = 3.9370 in
Height = 50 mm
Height.us = 1.9685 in
TxtPinY = 0 mm
TxtLocPinY = TxtHeight
TxtHeight = 160 mm
TxtWidth = Width*2
VerticalAlign = 0

