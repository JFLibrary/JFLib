# Textfeld-Beschriftung, 90° Mitte: Kasten.  Der Zeiger geht von der Mitte der Kante, die der
# Spitze zugewandt ist (unten oder oben) senkrecht zur Kante hinaus (mindestens Stub weit) und
# knickt dann im rechten Winkel zur Spitze. Liegt die Spitze im Körper, sind Zeiger und Punkt aus
# (NoShow).
master: Callout box center 90
name.de: Textfeld-Beschriftung, 90° Mitte
name.en: Callout box, 90° center
name.es: Llamada rectángulo, 90° central
name.it: Richiamo rettangolo, 90° centrale
name.fr: Bulle d'annotation rectangle, 90° centrale
prompt.de: Text im Kasten, der Zeiger knickt im rechten Winkel von der Mitte der Unter- oder Oberkante zum Ziel. Ziehen Sie den gelben Steuerpunkt auf das Ziel.
prompt.en: Text in a box, the pointer turns at a right angle from the middle of the bottom or top edge to the target. Drag the yellow control handle onto the target.
prompt.es: Texto en un cuadro, el puntero gira en ángulo recto del centro del borde inferior o superior al destino. Arrastre el controlador amarillo hasta el destino.
prompt.it: Testo in un riquadro, il puntatore piega ad angolo retto dal centro del bordo inferiore o superiore alla destinazione. Trascina la maniglia di controllo gialla sulla destinazione.
prompt.fr: Texte dans un cadre, le pointeur tourne à angle droit du milieu du bord inférieur ou supérieur à la cible. Faites glisser la poignée de contrôle jaune sur la cible.
keywords.de: Beschriftung, Hinweis, Kommentar, Zeiger, Kasten, Rechteck, Mitte, 90°, Winkel
keywords.en: callout, note, comment, pointer, box, rectangle, center, 90°, elbow
keywords.es: llamada, nota, comentario, puntero, cuadro, rectángulo, centro, 90°, codo
keywords.it: richiamo, nota, commento, puntatore, riquadro, rettangolo, centro, 90°, gomito
keywords.fr: bulle d'annotation, note, commentaire, pointeur, cadre, rectangle, centre, 90°, coude
text.de: Text
text.en: Text
text.es: Texto
text.it: Testo
text.fr: Texte

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 16 mm
Height.us = 0.6 in

[User]
msvStructureType:         Value = "Callout"
msvShapeCategories:       Value = "Callout"
msvSDCalloutNoHighlight:  Value = FALSE
# die Spitze des Zeigers
Ax:                       Value = Controls.Association
Ay:                       Value = Controls.Association.Y
Out:                      Value = OR(User.Ax<0,User.Ax>Width,User.Ay<0,User.Ay>Height)
# die Spitze unter der Mitte: der Zeiger beginnt an der Unterkante
Below:                    Value = User.Ay<Height*0.5
Sy:                       Value = IF(User.Below,0,Height)
# der erste Arm geht mindestens Stub weit hinaus, dann im rechten Winkel weiter
Stub:                     Value = 4 mm
                          Value.us = 0.15 in
Ey:                       Value = IF(User.Below,MIN(User.Ay,-User.Stub),MAX(User.Ay,Height+User.Stub))
Dot:                      Value = 0.8 mm
                          Value.us = 0.03 in

# der Kasten
[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

# der Zeiger
[Geometry]
NoFill = TRUE
NoShow = NOT(User.Out)
MoveTo  X = Width*0.5; Y = User.Sy
LineTo  X = Width*0.5; Y = User.Ey
LineTo  X = User.Ax; Y = User.Ey
LineTo  X = User.Ax; Y = User.Ay

# der Punkt an der Spitze
[Geometry]
NoShow = NOT(User.Out)
Ellipse  X = User.Ax; Y = User.Ay; A = User.Ax+User.Dot; B = User.Ay; C = User.Ax; D = User.Ay+User.Dot

[Controls]
Association:  X = -12 mm; Y = -10 mm
              X.us = -0.5 in; Y.us = -0.4 in
              XDyn = Width*0.5; YDyn = User.Sy
              XCon = 2; YCon = 2; CanGlue = FALSE
              Tip.de = "Zeiger auf das Ziel ziehen"
              Tip.en = "Drag the pointer onto the target"
              Tip.es = "Arrastre el puntero hasta el destino"
              Tip.it = "Trascina il puntatore sulla destinazione"
              Tip.fr = "Faites glisser le pointeur sur la cible"
