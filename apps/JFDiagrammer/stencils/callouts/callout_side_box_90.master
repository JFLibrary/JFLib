# Textfeld-Beschriftung, 90° Seite: Kasten.  Der Zeiger geht von der Mitte der Seite, die der
# Spitze zugewandt ist (links oder rechts) senkrecht zur Kante hinaus (mindestens Stub weit) und
# knickt dann im rechten Winkel zur Spitze. Liegt die Spitze im Körper, sind Zeiger und Punkt aus
# (NoShow).
master: Callout box side 90
name.de: Textfeld-Beschriftung, 90° Seite
name.en: Callout box, 90° side
name.es: Llamada rectángulo, 90° lateral
name.it: Richiamo rettangolo, 90° laterale
name.fr: Bulle d'annotation rectangle, 90° latérale
prompt.de: Text im Kasten, der Zeiger knickt im rechten Winkel von der Seite zum Ziel. Ziehen Sie den gelben Steuerpunkt auf das Ziel.
prompt.en: Text in a box, the pointer turns at a right angle from the side to the target. Drag the yellow control handle onto the target.
prompt.es: Texto en un cuadro, el puntero gira en ángulo recto del lateral al destino. Arrastre el controlador amarillo hasta el destino.
prompt.it: Testo in un riquadro, il puntatore piega ad angolo retto dal lato alla destinazione. Trascina la maniglia di controllo gialla sulla destinazione.
prompt.fr: Texte dans un cadre, le pointeur tourne à angle droit du côté à la cible. Faites glisser la poignée de contrôle jaune sur la cible.
keywords.de: Beschriftung, Hinweis, Kommentar, Zeiger, Kasten, Rechteck, seitlich, 90°, Winkel
keywords.en: callout, note, comment, pointer, box, rectangle, side, 90°, elbow
keywords.es: llamada, nota, comentario, puntero, cuadro, rectángulo, lateral, 90°, codo
keywords.it: richiamo, nota, commento, puntatore, riquadro, rettangolo, laterale, 90°, gomito
keywords.fr: bulle d'annotation, note, commentaire, pointeur, cadre, rectangle, latéral, 90°, coude
text.de: Text
text.en: Text
text.es: Texto
text.it: Testo
text.fr: Texte

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 16 mm
Height.us = 0.6 in

[User]
msvStructureType:         Value = "Callout"
msvShapeCategories:       Value = "Callout"
msvSDCalloutNoHighlight:  Value = FALSE
# die Spitze des Zeigers
Ax:                       Value = Controls.Association
Ay:                       Value = Controls.Association.Y
Out:                      Value = OR(User.Ax<0,User.Ax>Width,User.Ay<0,User.Ay>Height)
# die Spitze rechts der Mitte: der Zeiger beginnt an der rechten Seite
Right:                    Value = User.Ax>Width*0.5
Sx:                       Value = IF(User.Right,Width,0)
# der erste Arm geht mindestens Stub weit hinaus, dann im rechten Winkel weiter
Stub:                     Value = 4 mm
                          Value.us = 0.15 in
Ex:                       Value = IF(User.Right,MAX(User.Ax,Width+User.Stub),MIN(User.Ax,-User.Stub))
Dot:                      Value = 0.8 mm
                          Value.us = 0.03 in

# der Kasten
[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

# der Zeiger
[Geometry]
NoFill = TRUE
NoShow = NOT(User.Out)
MoveTo  X = User.Sx; Y = Height*0.5
LineTo  X = User.Ex; Y = Height*0.5
LineTo  X = User.Ex; Y = User.Ay
LineTo  X = User.Ax; Y = User.Ay

# der Punkt an der Spitze
[Geometry]
NoShow = NOT(User.Out)
Ellipse  X = User.Ax; Y = User.Ay; A = User.Ax+User.Dot; B = User.Ay; C = User.Ax; D = User.Ay+User.Dot

[Controls]
Association:  X = -12 mm; Y = -10 mm
              X.us = -0.5 in; Y.us = -0.4 in
              XDyn = User.Sx; YDyn = Height*0.5
              XCon = 2; YCon = 2; CanGlue = FALSE
              Tip.de = "Zeiger auf das Ziel ziehen"
              Tip.en = "Drag the pointer onto the target"
              Tip.es = "Arrastre el puntero hasta el destino"
              Tip.it = "Trascina il puntatore sulla destinazione"
              Tip.fr = "Faites glisser le pointeur sur la cible"
