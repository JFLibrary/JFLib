# Sprechblase horizontal: wie „Beschriftung Sprechblase“, der Keil wächst aber aus der linken oder
# rechten Kante, sobald die Spitze seitlich außerhalb liegt; nur wenn sie genau über oder unter
# dem Körper liegt, aus der oberen oder unteren. Körper und Keil sind ein Umriss; liegt die Spitze
# im Körper, liegen die Keilpunkte auf der Ecke davor (Strecken der Länge 0).
master: Callout bubble horizontal
name.de: Sprechblase horizontal
name.en: Speech bubble, horizontal
name.es: Bocadillo horizontal
name.it: Fumetto orizzontale
name.fr: Bulle horizontale
prompt.de: Eckige Sprechblase, deren Keil seitlich aus der linken oder rechten Kante wächst. Ziehen Sie den gelben Steuerpunkt auf das Ziel, der Keil folgt.
prompt.en: Square speech bubble whose wedge grows out of the left or right edge. Drag the yellow control handle onto the target and the wedge follows.
prompt.es: Bocadillo rectangular cuya cuña sale del borde izquierdo o derecho. Arrastre el controlador amarillo hasta el destino y la cuña lo sigue.
prompt.it: Fumetto rettangolare il cui cuneo esce dal bordo sinistro o destro. Trascina la maniglia di controllo gialla sulla destinazione e il cuneo la segue.
prompt.fr: Bulle rectangulaire dont la pointe sort du bord gauche ou droit. Faites glisser la poignée de contrôle jaune sur la cible, la pointe suit.
keywords.de: Beschriftung, Hinweis, Kommentar, Zeiger, Sprechblase, Keil, horizontal, seitlich
keywords.en: callout, note, comment, pointer, speech bubble, wedge, horizontal, side
keywords.es: llamada, nota, comentario, puntero, bocadillo, cuña, horizontal, lateral
keywords.it: richiamo, nota, commento, puntatore, fumetto, cuneo, orizzontale, laterale
keywords.fr: bulle d'annotation, note, commentaire, pointeur, bulle, pointe, horizontale, latérale
text.de: Text
text.en: Text
text.es: Texto
text.it: Testo
text.fr: Texte

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 16 mm
Height.us = 0.6 in

[User]
msvStructureType:         Value = "Callout"
msvShapeCategories:       Value = "Callout"
msvSDCalloutNoHighlight:  Value = FALSE
# die Spitze des Zeigers
Ax:                       Value = Controls.Association
Ay:                       Value = Controls.Association.Y
Out:                      Value = OR(User.Ax<0,User.Ax>Width,User.Ay<0,User.Ay>Height)
# wie weit die Spitze außerhalb liegt, waagerecht und senkrecht
Dx:                       Value = MAX(-User.Ax,User.Ax-Width,0)
Dy:                       Value = MAX(-User.Ay,User.Ay-Height,0)
# die Kante mit dem Keil: 0 keine (Spitze im Körper), 1 unten, 2 rechts, 3 oben, 4 links
Side:                     Value = IF(User.Dx+User.Dy<=0,0,IF(User.Dx>0,IF(User.Ax>Width,2,4),IF(User.Ay<0,1,3)))
Wedge:                    Value = 3 mm
                          Value.us = 0.12 in
# die halbe Breite des Keils an der Kante und die Mitte seines Fußes (zur Spitze hin)
Hb:                       Value = MIN(User.Wedge,Width*0.25)
Hv:                       Value = MIN(User.Wedge,Height*0.25)
Cx:                       Value = MIN(MAX(User.Ax,User.Hb*1.5),Width-User.Hb*1.5)
Cy:                       Value = MIN(MAX(User.Ay,User.Hv*1.5),Height-User.Hv*1.5)

# der Körper mit dem Keil: ein Umriss
[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = IF(User.Side=1,User.Cx-User.Hb,0); Y = 0
LineTo  X = IF(User.Side=1,User.Ax,0); Y = IF(User.Side=1,User.Ay,0)
LineTo  X = IF(User.Side=1,User.Cx+User.Hb,0); Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = IF(User.Side=2,User.Cy-User.Hv,0)
LineTo  X = IF(User.Side=2,User.Ax,Width); Y = IF(User.Side=2,User.Ay,0)
LineTo  X = Width; Y = IF(User.Side=2,User.Cy+User.Hv,0)
LineTo  X = Width; Y = Height
LineTo  X = IF(User.Side=3,User.Cx+User.Hb,Width); Y = Height
LineTo  X = IF(User.Side=3,User.Ax,Width); Y = IF(User.Side=3,User.Ay,Height)
LineTo  X = IF(User.Side=3,User.Cx-User.Hb,Width); Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = IF(User.Side=4,User.Cy+User.Hv,Height)
LineTo  X = IF(User.Side=4,User.Ax,0); Y = IF(User.Side=4,User.Ay,Height)
LineTo  X = 0; Y = IF(User.Side=4,User.Cy-User.Hv,Height)
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Association:  X = -12 mm; Y = -10 mm
              X.us = -0.5 in; Y.us = -0.4 in
              XDyn = Width*0.5; YDyn = Height*0.5
              XCon = 2; YCon = 2; CanGlue = FALSE
              Tip.de = "Zeiger auf das Ziel ziehen"
              Tip.en = "Drag the pointer onto the target"
              Tip.es = "Arrastre el puntero hasta el destino"
              Tip.it = "Trascina il puntatore sulla destinazione"
              Tip.fr = "Faites glisser le pointeur sur la cible"
