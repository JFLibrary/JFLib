# Text mit geschweifter Klammer: die Klammer steht an der Seite zur Spitze hin (links oder rechts,
# gespiegelt über Bx0 und Sg), vier Viertelellipsenbögen durch den 45°-Punkt; der Zeiger geht von
# ihrer Spitze in der Mitte zur Spitze des Zeigers, dort ein Punkt.  Liegt die Spitze im Körper,
# sind Zeiger und Punkt aus (NoShow), die Klammer bleibt.
master: Callout side brace
name.de: Text mit geschweifter Klammer
name.en: Text with brace
name.es: Texto con llave
name.it: Testo con parentesi graffa
name.fr: Texte avec accolade
prompt.de: Text mit einer geschweiften Klammer an der Seite zum Ziel hin, der Zeiger geht von ihrer Spitze aus. Ziehen Sie den gelben Steuerpunkt auf das Ziel.
prompt.en: Text with a brace on the side facing the target; the pointer starts at its point. Drag the yellow control handle onto the target.
prompt.es: Texto con una llave en el lado que mira al destino; el puntero sale de su punta. Arrastre el controlador amarillo hasta el destino.
prompt.it: Testo con una parentesi graffa sul lato verso la destinazione; il puntatore parte dalla sua punta. Trascina la maniglia di controllo gialla sulla destinazione.
prompt.fr: Texte avec une accolade du côté tourné vers la cible ; le pointeur part de sa pointe. Faites glisser la poignée de contrôle jaune sur la cible.
keywords.de: Beschriftung, Hinweis, Kommentar, Zeiger, geschweifte Klammer, Klammer, Gruppe, seitlich
keywords.en: callout, note, comment, pointer, brace, curly bracket, group, side
keywords.es: llamada, nota, comentario, puntero, llave, grupo, agrupar, lateral
keywords.it: richiamo, nota, commento, puntatore, parentesi graffa, graffa, gruppo, laterale
keywords.fr: bulle d'annotation, note, commentaire, pointeur, accolade, groupe, regrouper, latéral
text.de: Text
text.en: Text
text.es: Texto
text.it: Testo
text.fr: Texte

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 16 mm
Height.us = 0.6 in
LeftMargin = 4 mm
LeftMargin.us = 0.16 in
RightMargin = 4 mm
RightMargin.us = 0.16 in

[User]
msvStructureType:         Value = "Callout"
msvShapeCategories:       Value = "Callout"
msvSDCalloutNoHighlight:  Value = FALSE
# die Spitze des Zeigers
Ax:                       Value = Controls.Association
Ay:                       Value = Controls.Association.Y
Out:                      Value = OR(User.Ax<0,User.Ax>Width,User.Ay<0,User.Ay>Height)
# die Spitze rechts der Mitte: die Klammer rechts, ihre Spitze bei Bx0, nach innen Sg
Right:                    Value = User.Ax>Width*0.5
Bx0:                      Value = IF(User.Right,Width,0)
Sg:                       Value = IF(User.Right,-1,1)
# die Breite der Klammer, ihre halbe Breite, die Höhe der Bögen
Bw:                       Value = MIN(3 mm,Width*0.2)
                          Value.us = MIN(0.12 in,Width*0.2)
Bh:                       Value = User.Bw*0.5
R:                        Value = MAX(MIN(2.5 mm,Height*0.25),0.1 mm)
                          Value.us = MAX(MIN(0.1 in,Height*0.25),0.004 in)
Dot:                      Value = 0.8 mm
                          Value.us = 0.03 in

# die Klammer
[Geometry]
NoFill = TRUE
MoveTo  X = User.Bx0+User.Sg*User.Bw; Y = Height
EllipticalArcTo  X = User.Bx0+User.Sg*User.Bh; Y = Height-User.R; A = User.Bx0+User.Sg*(User.Bw-User.Bh*0.707107); B = Height-User.R+User.R*0.707107; C = 0 deg; D = User.Bh/User.R
LineTo  X = User.Bx0+User.Sg*User.Bh; Y = Height*0.5+User.R
EllipticalArcTo  X = User.Bx0; Y = Height*0.5; A = User.Bx0+User.Sg*User.Bh*0.707107; B = Height*0.5+User.R-User.R*0.707107; C = 0 deg; D = User.Bh/User.R
EllipticalArcTo  X = User.Bx0+User.Sg*User.Bh; Y = Height*0.5-User.R; A = User.Bx0+User.Sg*User.Bh*0.707107; B = Height*0.5-User.R+User.R*0.707107; C = 0 deg; D = User.Bh/User.R
LineTo  X = User.Bx0+User.Sg*User.Bh; Y = User.R
EllipticalArcTo  X = User.Bx0+User.Sg*User.Bw; Y = 0; A = User.Bx0+User.Sg*(User.Bw-User.Bh*0.707107); B = User.R-User.R*0.707107; C = 0 deg; D = User.Bh/User.R

# der Zeiger
[Geometry]
NoFill = TRUE
NoShow = NOT(User.Out)
MoveTo  X = User.Bx0; Y = Height*0.5
LineTo  X = User.Ax; Y = User.Ay

# der Punkt an der Spitze
[Geometry]
NoShow = NOT(User.Out)
Ellipse  X = User.Ax; Y = User.Ay; A = User.Ax+User.Dot; B = User.Ay; C = User.Ax; D = User.Ay+User.Dot

[Controls]
Association:  X = -12 mm; Y = -10 mm
              X.us = -0.5 in; Y.us = -0.4 in
              XDyn = User.Bx0; YDyn = Height*0.5
              XCon = 2; YCon = 2; CanGlue = FALSE
              Tip.de = "Zeiger auf das Ziel ziehen"
              Tip.en = "Drag the pointer onto the target"
              Tip.es = "Arrastre el puntero hasta el destino"
              Tip.it = "Trascina il puntatore sulla destinazione"
              Tip.fr = "Faites glisser le pointeur sur la cible"
