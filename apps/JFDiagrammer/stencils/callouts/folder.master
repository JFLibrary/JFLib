# Eine Fläche ohne Zeiger (kein msvStructureType): ein Ordner, die Lasche links oben mit schräger
# Kante, ein Umriss.  Row_1 am Ende der Lasche ändert ihre Breite (nur waagrecht, Abstand von
# links).  Der Text steht unter der Lasche.
master: Folder
name.de: Ordner
name.en: Folder
name.es: Carpeta
name.it: Cartella
name.fr: Dossier
prompt.de: Ordner mit Lasche, etwa für Dateien und Ablagen. Mit dem gelben Steuerpunkt ändern Sie die Breite der Lasche.
prompt.en: Folder with a tab, for example for files and storage. Drag the yellow control handle to change the width of the tab.
prompt.es: Carpeta con pestaña, por ejemplo para archivos. Arrastre el controlador amarillo para cambiar el ancho de la pestaña.
prompt.it: Cartella con linguetta, ad esempio per file e archivi. Trascina la maniglia di controllo gialla per cambiare la larghezza della linguetta.
prompt.fr: Dossier avec onglet, par exemple pour des fichiers. Faites glisser la poignée de contrôle jaune pour modifier la largeur de l'onglet.
keywords.de: Ordner, Datei, Dateien, Mappe, Ablage, Verzeichnis
keywords.en: folder, file, files, directory, storage, archive
keywords.es: carpeta, archivo, archivos, directorio, almacenamiento
keywords.it: cartella, file, archivio, directory, raccoglitore
keywords.fr: dossier, fichier, fichiers, répertoire, classeur

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 30 mm
Height.us = 1.125 in
TxtWidth = Width
TxtHeight = Height-User.Th
TxtPinX = Width*0.5
TxtPinY = (Height-User.Th)*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[User]
# die Höhe und die Breite der Lasche
Th:  Value = MIN(4 mm,Height*0.25)
     Value.us = MIN(0.16 in,Height*0.25)
Tw:  Value = MIN(MAX(Controls.Row_1,Width*0.1),Width-User.Th)

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height-User.Th
LineTo  X = User.Tw+User.Th; Y = Height-User.Th
LineTo  X = User.Tw; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = 15 mm; Y = Height
        X.us = 0.5625 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Breite der Lasche ändern"
        Tip.en = "Change the width of the tab"
        Tip.es = "Cambiar el ancho de la pestaña"
        Tip.it = "Cambia la larghezza della linguetta"
        Tip.fr = "Modifier la largeur de l'onglet"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = (Height-User.Th)*0.5; DirX = -1; DirY = 0
Row  X = (Width+User.Tw+User.Th)*0.5; Y = Height-User.Th; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
