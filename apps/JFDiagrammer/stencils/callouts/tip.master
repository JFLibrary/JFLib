# Tipp (JD13): verborgener Hinweiskasten für die Startdiagramme der Vorlagen; die App legt ihn
# per Code ab, der Text kommt je Vorlage.  Eine Fläche ohne Rahmen (Füllung aus "Normal") mit
# einem Akzentbalken links: eine senkrechte Linie in der Linienfarbe aus "Normal", 3 pt dick, um
# die halbe Dicke eingerückt, mit flachen Enden (LineCap 1).  Der Text steht links oben.  Ecken
# auch in den abgerundeten Design-Varianten eckig (Rounding 0): sonst stünde der Balken über
# die runden Ecken hinaus.
master: Tip
name.de: Tipp
name.en: Tip
name.es: Consejo
name.it: Suggerimento
name.fr: Astuce
prompt.de: Hinweiskasten mit einem Tipp zur Vorlage.
prompt.en: Note box with a tip about the template.
prompt.es: Cuadro de nota con un consejo sobre la plantilla.
prompt.it: Riquadro di nota con un suggerimento sul modello.
prompt.fr: Encadré avec une astuce sur le modèle.
keywords.de: Tipp, Hinweis, Notiz, Info, Erklärung, Vorlage
keywords.en: tip, hint, note, info, explanation, template
keywords.es: consejo, sugerencia, nota, información, explicación, plantilla
keywords.it: suggerimento, consiglio, nota, informazione, spiegazione, modello
keywords.fr: astuce, conseil, note, information, explication, modèle
hidden: true

[Shape]
Width = 70 mm
Width.us = 2.75 in
Height = 30 mm
Height.us = 1.25 in
LineWeight = 3 pt
LineCap = 1
Rounding = 0 mm
VerticalAlign = 0
LeftMargin = 4 mm
LeftMargin.us = 0.16 in
RightMargin = 3 mm
RightMargin.us = 0.12 in
TopMargin = 2.5 mm
TopMargin.us = 0.1 in
BottomMargin = 2.5 mm
BottomMargin.us = 0.1 in

# 1 die Fläche
[Geometry]
NoLine = TRUE
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

# 2 der Akzentbalken
[Geometry]
NoFill = TRUE
MoveTo  X = LineWeight*0.5; Y = 0
LineTo  X = LineWeight*0.5; Y = Height

[Paragraph]
Row  HorzAlign = 0
