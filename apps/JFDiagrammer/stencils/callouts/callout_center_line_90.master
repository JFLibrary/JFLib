# Text mit Linie, 90° Mitte: Text mit einem Strich an dieser Kante (er wechselt mit).  Der Zeiger
# geht von der Mitte der Kante, die der Spitze zugewandt ist (unten oder oben) senkrecht zur Kante
# hinaus (mindestens Stub weit) und knickt dann im rechten Winkel zur Spitze. Liegt die Spitze im
# Körper, sind Zeiger und Punkt aus (NoShow).
master: Callout center line 90
name.de: Text mit Linie, 90° Mitte
name.en: Callout with center line, 90°
name.es: Llamada con línea central, 90°
name.it: Richiamo con linea centrale, 90°
name.fr: Bulle d'annotation à trait central, 90°
prompt.de: Text mit einem Strich darunter oder darüber, der Zeiger knickt im rechten Winkel von der Mitte der Unter- oder Oberkante zum Ziel. Ziehen Sie den gelben Steuerpunkt auf das Ziel.
prompt.en: Text with a line below or above it, the pointer turns at a right angle from the middle of the bottom or top edge to the target. Drag the yellow control handle onto the target.
prompt.es: Texto con una línea debajo o encima, el puntero gira en ángulo recto del centro del borde inferior o superior al destino. Arrastre el controlador amarillo hasta el destino.
prompt.it: Testo con una linea sotto o sopra, il puntatore piega ad angolo retto dal centro del bordo inferiore o superiore alla destinazione. Trascina la maniglia di controllo gialla sulla destinazione.
prompt.fr: Texte avec un trait dessous ou dessus, le pointeur tourne à angle droit du milieu du bord inférieur ou supérieur à la cible. Faites glisser la poignée de contrôle jaune sur la cible.
keywords.de: Beschriftung, Hinweis, Kommentar, Zeiger, Linie, Strich, Mitte, 90°, Winkel
keywords.en: callout, note, comment, pointer, line, rule, center, 90°, elbow
keywords.es: llamada, nota, comentario, puntero, línea, trazo, centro, 90°, codo
keywords.it: richiamo, nota, commento, puntatore, linea, tratto, centro, 90°, gomito
keywords.fr: bulle d'annotation, note, commentaire, pointeur, trait, ligne, centre, 90°, coude
text.de: Text
text.en: Text
text.es: Texto
text.it: Testo
text.fr: Texte

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 16 mm
Height.us = 0.6 in
VerticalAlign = IF(User.Below,2,0)
TopMargin = 1 mm
TopMargin.us = 0.04 in
BottomMargin = 1 mm
BottomMargin.us = 0.04 in

[User]
msvStructureType:         Value = "Callout"
msvShapeCategories:       Value = "Callout"
msvSDCalloutNoHighlight:  Value = FALSE
# die Spitze des Zeigers
Ax:                       Value = Controls.Association
Ay:                       Value = Controls.Association.Y
Out:                      Value = OR(User.Ax<0,User.Ax>Width,User.Ay<0,User.Ay>Height)
# die Spitze unter der Mitte: der Zeiger beginnt an der Unterkante
Below:                    Value = User.Ay<Height*0.5
Sy:                       Value = IF(User.Below,0,Height)
# der erste Arm geht mindestens Stub weit hinaus, dann im rechten Winkel weiter
Stub:                     Value = 4 mm
                          Value.us = 0.15 in
Ey:                       Value = IF(User.Below,MIN(User.Ay,-User.Stub),MAX(User.Ay,Height+User.Stub))
Dot:                      Value = 0.8 mm
                          Value.us = 0.03 in

# der Strich unter oder über dem Text
[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = User.Sy
LineTo  X = Width; Y = User.Sy

# der Zeiger
[Geometry]
NoFill = TRUE
NoShow = NOT(User.Out)
MoveTo  X = Width*0.5; Y = User.Sy
LineTo  X = Width*0.5; Y = User.Ey
LineTo  X = User.Ax; Y = User.Ey
LineTo  X = User.Ax; Y = User.Ay

# der Punkt an der Spitze
[Geometry]
NoShow = NOT(User.Out)
Ellipse  X = User.Ax; Y = User.Ay; A = User.Ax+User.Dot; B = User.Ay; C = User.Ax; D = User.Ay+User.Dot

[Controls]
Association:  X = -12 mm; Y = -10 mm
              X.us = -0.5 in; Y.us = -0.4 in
              XDyn = Width*0.5; YDyn = User.Sy
              XCon = 2; YCon = 2; CanGlue = FALSE
              Tip.de = "Zeiger auf das Ziel ziehen"
              Tip.en = "Drag the pointer onto the target"
              Tip.es = "Arrastre el puntero hasta el destino"
              Tip.it = "Trascina il puntatore sulla destinazione"
              Tip.fr = "Faites glisser le pointeur sur la cible"
