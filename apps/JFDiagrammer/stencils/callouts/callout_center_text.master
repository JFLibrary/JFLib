# Textbeschriftung Mitte: Text ohne Rahmen.  Der Zeiger geht gerade von der Mitte der Kante, die
# der Spitze zugewandt ist (unten oder oben) zur Spitze. Liegt die Spitze im Körper, sind Zeiger
# und Punkt aus (NoShow).
master: Callout text center
name.de: Textbeschriftung Mitte
name.en: Text callout, center
name.es: Llamada de texto central
name.it: Richiamo di testo centrale
name.fr: Annotation de texte centrale
prompt.de: Text ohne Rahmen, der Zeiger geht gerade von der Mitte der Unter- oder Oberkante zum Ziel. Ziehen Sie den gelben Steuerpunkt auf das Ziel.
prompt.en: Text without a frame, the pointer runs straight from the middle of the bottom or top edge to the target. Drag the yellow control handle onto the target.
prompt.es: Texto sin marco, el puntero va recto del centro del borde inferior o superior al destino. Arrastre el controlador amarillo hasta el destino.
prompt.it: Testo senza cornice, il puntatore va dritto dal centro del bordo inferiore o superiore alla destinazione. Trascina la maniglia di controllo gialla sulla destinazione.
prompt.fr: Texte sans cadre, le pointeur va droit du milieu du bord inférieur ou supérieur à la cible. Faites glisser la poignée de contrôle jaune sur la cible.
keywords.de: Beschriftung, Hinweis, Kommentar, Zeiger, Text, ohne Rahmen, Mitte
keywords.en: callout, note, comment, pointer, text, frameless, center
keywords.es: llamada, nota, comentario, puntero, texto, sin marco, centro
keywords.it: richiamo, nota, commento, puntatore, testo, senza cornice, centro
keywords.fr: bulle d'annotation, note, commentaire, pointeur, texte, sans cadre, centre
text.de: Text
text.en: Text
text.es: Texto
text.it: Testo
text.fr: Texte

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 16 mm
Height.us = 0.6 in
VerticalAlign = IF(User.Below,2,0)

[User]
msvStructureType:         Value = "Callout"
msvShapeCategories:       Value = "Callout"
msvSDCalloutNoHighlight:  Value = FALSE
# die Spitze des Zeigers
Ax:                       Value = Controls.Association
Ay:                       Value = Controls.Association.Y
Out:                      Value = OR(User.Ax<0,User.Ax>Width,User.Ay<0,User.Ay>Height)
# die Spitze unter der Mitte: der Zeiger beginnt an der Unterkante
Below:                    Value = User.Ay<Height*0.5
Sy:                       Value = IF(User.Below,0,Height)
Dot:                      Value = 0.8 mm
                          Value.us = 0.03 in

# der Körper: unsichtbar, nur zum Anfassen
[Geometry]
NoFill = TRUE
NoLine = TRUE
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

# der Zeiger
[Geometry]
NoFill = TRUE
NoShow = NOT(User.Out)
MoveTo  X = Width*0.5; Y = User.Sy
LineTo  X = User.Ax; Y = User.Ay

# der Punkt an der Spitze
[Geometry]
NoShow = NOT(User.Out)
Ellipse  X = User.Ax; Y = User.Ay; A = User.Ax+User.Dot; B = User.Ay; C = User.Ax; D = User.Ay+User.Dot

[Controls]
Association:  X = -12 mm; Y = -10 mm
              X.us = -0.5 in; Y.us = -0.4 in
              XDyn = Width*0.5; YDyn = User.Sy
              XCon = 2; YCon = 2; CanGlue = FALSE
              Tip.de = "Zeiger auf das Ziel ziehen"
              Tip.en = "Drag the pointer onto the target"
              Tip.es = "Arrastre el puntero hasta el destino"
              Tip.it = "Trascina il puntatore sulla destinazione"
              Tip.fr = "Faites glisser le pointeur sur la cible"
