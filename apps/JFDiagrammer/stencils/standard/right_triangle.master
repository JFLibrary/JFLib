[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 25 mm
Height.us = 1 in

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width*0.5; Y = Height*0.5; DirX = -0.707107; DirY = -0.707107
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
