# Geschweifte Klammer rechts: eine offene Linie ohne Füllung aus vier Viertelellipsenbögen durch
# den 45°-Punkt (Halbachsen halbe Breite und R) und zwei geraden Stücken, die Spitze in der Mitte.
# Row_1 am unteren Ende des unteren geraden Stücks ändert R (nur senkrecht, Abstand von unten).
# Der Textblock liegt links neben der Klammer.
master: Right brace
name.de: Geschweifte Klammer rechts
name.en: Right brace
name.es: Llave derecha
name.it: Parentesi graffa destra
name.fr: Accolade droite
prompt.de: Geschweifte Klammer als Linie, der Text links daneben. Mit dem gelben Steuerpunkt ändern Sie die Rundung der Bögen.
prompt.en: Brace drawn as a line, the text beside it on the left. Drag the yellow control handle to change the curve of the bends.
prompt.es: Llave dibujada como línea, con el texto al lado a la izquierda. Arrastre el controlador amarillo para cambiar la curvatura de los arcos.
prompt.it: Parentesi graffa disegnata come linea, con il testo accanto a sinistra. Trascina la maniglia di controllo gialla per cambiare la curvatura degli archi.
prompt.fr: Accolade dessinée comme un trait, le texte à côté à gauche. Faites glisser la poignée de contrôle jaune pour modifier la courbure des arcs.
keywords.de: Klammer, geschweifte Klammer, rechts, Gruppe, zusammenfassen, Bereich
keywords.en: brace, curly bracket, right, group, enclose, range
keywords.es: llave, derecha, grupo, agrupar, encerrar, rango
keywords.it: parentesi graffa, graffa, destra, gruppo, racchiudere, intervallo
keywords.fr: accolade, droite, groupe, regrouper, encadrer, plage

[Shape]
Width = 5 mm
Width.us = 0.2 in
Height = 30 mm
Height.us = 1.25 in
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = Height
TxtPinX = 0
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth
TxtLocPinY = TxtHeight*0.5
ShapeSplit = 1

[User]
# die Höhe der Bögen und das Verhältnis ihrer Halbachsen
R:      Value = MIN(MAX(Controls.Row_1.Y,Height*0.02),Height*0.25)
Ratio:  Value = Width*0.5/User.R

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height
EllipticalArcTo  X = Width-Width*0.5; Y = Height-User.R; A = Width-Width*0.646447; B = Height-User.R*0.292893; C = 0 deg; D = User.Ratio
LineTo  X = Width-Width*0.5; Y = Height*0.5+User.R
EllipticalArcTo  X = Width; Y = Height*0.5; A = Width-Width*0.353553; B = Height*0.5+User.R*0.292893; C = 0 deg; D = User.Ratio
EllipticalArcTo  X = Width-Width*0.5; Y = Height*0.5-User.R; A = Width-Width*0.353553; B = Height*0.5-User.R*0.292893; C = 0 deg; D = User.Ratio
LineTo  X = Width-Width*0.5; Y = User.R
EllipticalArcTo  X = 0; Y = 0; A = Width-Width*0.646447; B = User.R*0.292893; C = 0 deg; D = User.Ratio

[Paragraph]
Row  HorzAlign = 2

[Controls]
Row_1:  X = Width-Width*0.5; Y = 4 mm
        Y.us = 0.15 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 2; CanGlue = FALSE
        Tip.de = "Rundung der Enden ändern"
        Tip.en = "Change the curve of the ends"
        Tip.es = "Cambiar la curvatura de los extremos"
        Tip.it = "Cambia la curvatura delle estremità"
        Tip.fr = "Modifier la courbure des extrémités"

[Connection]
Row  X = 0; Y = 0; DirX = 0; DirY = 1
Row  X = 0; Y = Height; DirX = 0; DirY = -1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
