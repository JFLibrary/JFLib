# Rechteck, 1 Ecke abgerundet (rechts oben, ArcTo).  Row_1 an der oberen Kante ändert den Radius
# (nur waagrecht, Abstand von rechts).
master: Round single corner rectangle
name.de: Rechteck, 1 Ecke abgerundet
name.en: Round single corner rectangle
name.es: Rectángulo, 1 esquina redondeada
name.it: Rettangolo, 1 angolo arrotondato
name.fr: Rectangle, 1 coin arrondi
prompt.de: Rechteck mit runder Ecke rechts oben. Mit dem gelben Steuerpunkt ändern Sie den Radius.
prompt.en: Rectangle with a round top right corner. Drag the yellow control handle to change the radius.
prompt.es: Rectángulo con la esquina superior derecha redondeada. Arrastre el controlador amarillo para cambiar el radio.
prompt.it: Rettangolo con l'angolo in alto a destra arrotondato. Trascina la maniglia di controllo gialla per cambiare il raggio.
prompt.fr: Rectangle dont le coin supérieur droit est arrondi. Faites glisser la poignée de contrôle jaune pour modifier le rayon.
keywords.de: Rechteck, Ecke, Kasten, Schaltfläche, abgerundet, Radius, rund, eine Ecke, Registerkarte
keywords.en: rectangle, corner, box, button, rounded, radius, round, one corner, tab
keywords.es: rectángulo, esquina, caja, botón, redondeado, radio, redondo, una esquina, pestaña
keywords.it: rettangolo, angolo, riquadro, pulsante, arrotondato, raggio, rotondo, un angolo, scheda
keywords.fr: rectangle, coin, boîte, bouton, arrondi, rayon, rond, un coin, onglet

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 20 mm
Height.us = 0.75 in

[User]
# der Radius der runden Ecken
R:    Value = MIN(MAX(Width-Controls.Row_1,0),Width,Height)
# der Stich eines Viertelkreises mit dem Radius R (ArcTo A)
Bow:  Value = User.R*0.292893

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height-User.R
ArcTo   X = Width-User.R; Y = Height; A = User.Bow
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = Width-5 mm; Y = Height
        X.us = Width-0.2 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 4; YCon = 1; CanGlue = FALSE
        Tip.de = "Radius der Ecke ändern"
        Tip.en = "Change the radius of the corner"
        Tip.es = "Cambiar el radio de la esquina"
        Tip.it = "Cambia il raggio dell'angolo"
        Tip.fr = "Modifier le rayon du coin"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
