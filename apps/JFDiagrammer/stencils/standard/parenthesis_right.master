# Runde Klammer rechts: eine offene Linie ohne Füllung, oben und unten ein Viertelellipsenbogen
# durch den 45°-Punkt, dazwischen gerade.  Row_1 am unteren Ende des geraden Stücks ändert die
# Höhe der Bögen (nur senkrecht, Abstand von unten).  Der Textblock liegt links neben der Klammer,
# damit Text nicht auf 5 mm Breite umbricht.
master: Right parenthesis
name.de: Runde Klammer rechts
name.en: Right parenthesis
name.es: Paréntesis derecho
name.it: Parentesi tonda destra
name.fr: Parenthèse droite
prompt.de: Runde Klammer als Linie, der Text links daneben. Mit dem gelben Steuerpunkt ändern Sie die Rundung der Enden.
prompt.en: Parenthesis drawn as a line, the text beside it on the left. Drag the yellow control handle to change the curve of the ends.
prompt.es: Paréntesis dibujado como línea, con el texto al lado a la izquierda. Arrastre el controlador amarillo para cambiar la curvatura de los extremos.
prompt.it: Parentesi tonda disegnata come linea, con il testo accanto a sinistra. Trascina la maniglia di controllo gialla per cambiare la curvatura delle estremità.
prompt.fr: Parenthèse dessinée comme un trait, le texte à côté à gauche. Faites glisser la poignée de contrôle jaune pour modifier la courbure des extrémités.
keywords.de: Klammer, runde Klammer, rechts, Gruppe, zusammenfassen
keywords.en: parenthesis, round bracket, right, group, enclose
keywords.es: paréntesis, derecho, grupo, agrupar, encerrar
keywords.it: parentesi, parentesi tonda, destra, gruppo, racchiudere
keywords.fr: parenthèse, droite, groupe, regrouper, encadrer

[Shape]
Width = 5 mm
Width.us = 0.2 in
Height = 30 mm
Height.us = 1.25 in
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = Height
TxtPinX = 0
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth
TxtLocPinY = TxtHeight*0.5
ShapeSplit = 1

[User]
# die Höhe der Bögen und das Verhältnis ihrer Halbachsen
R:      Value = MIN(MAX(Controls.Row_1.Y,Height*0.02),Height*0.5)
Ratio:  Value = Width/User.R

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height
EllipticalArcTo  X = Width; Y = Height-User.R; A = Width-Width*0.292893; B = Height-User.R*0.292893; C = 0 deg; D = User.Ratio
LineTo  X = Width; Y = User.R
EllipticalArcTo  X = 0; Y = 0; A = Width-Width*0.292893; B = User.R*0.292893; C = 0 deg; D = User.Ratio

[Paragraph]
Row  HorzAlign = 2

[Controls]
Row_1:  X = Width; Y = 5 mm
        Y.us = 0.2 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 2; CanGlue = FALSE
        Tip.de = "Rundung der Enden ändern"
        Tip.en = "Change the curve of the ends"
        Tip.es = "Cambiar la curvatura de los extremos"
        Tip.it = "Cambia la curvatura delle estremità"
        Tip.fr = "Modifier la courbure des extrémités"

[Connection]
Row  X = 0; Y = 0; DirX = 0; DirY = 1
Row  X = 0; Y = Height; DirX = 0; DirY = -1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
