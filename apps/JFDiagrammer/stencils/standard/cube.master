# Würfel: Vorderseite, Deckel und rechte Seite als drei Flächen mit derselben Füllung (die Kanten
# zeigen die Tiefe).  Row_1 an der hinteren linken Ecke des Deckels ändert die Tiefe (nur
# waagrecht, Abstand von links).  Der Text steht auf der Vorderseite.  Ecken immer eckig (Rounding
# 0): in den abgerundeten Design-Varianten fiele der Würfel sonst auseinander.
master: Cube
name.de: Würfel
name.en: Cube
name.es: Cubo
name.it: Cubo
name.fr: Cube
prompt.de: Quader in Schrägansicht mit Vorderseite, Deckel und rechter Seite. Mit dem gelben Steuerpunkt ändern Sie die Tiefe.
prompt.en: Box in oblique view with front, top and right side. Drag the yellow control handle to change the depth.
prompt.es: Caja en vista oblicua con frente, tapa y lado derecho. Arrastre el controlador amarillo para cambiar la profundidad.
prompt.it: Parallelepipedo in vista obliqua con fronte, coperchio e lato destro. Trascina la maniglia di controllo gialla per cambiare la profondità.
prompt.fr: Pavé en vue oblique avec face avant, dessus et côté droit. Faites glisser la poignée de contrôle jaune pour modifier la profondeur.
keywords.de: Würfel, Quader, 3D, Kasten, Schachtel, Körper, Tiefe
keywords.en: cube, cuboid, 3-D, box, block, solid, depth
keywords.es: cubo, prisma, 3D, caja, bloque, sólido, profundidad
keywords.it: cubo, parallelepipedo, 3D, scatola, blocco, solido, profondità
keywords.fr: cube, pavé, 3D, boîte, bloc, solide, profondeur

[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 30 mm
Height.us = 1.25 in
Rounding = 0 mm
TxtWidth = Width-User.D
TxtHeight = Height-User.D
TxtPinX = (Width-User.D)*0.5
TxtPinY = (Height-User.D)*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
ShapeSplit = 1

[User]
# die Tiefe
D:  Value = MIN(MAX(Controls.Row_1,0),Width*0.5,Height*0.5)

# 1 die Vorderseite
[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width-User.D; Y = 0
LineTo  X = Width-User.D; Y = Height-User.D
LineTo  X = 0; Y = Height-User.D
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

# 2 der Deckel
[Geometry]
MoveTo  X = 0; Y = Height-User.D
LineTo  X = Width-User.D; Y = Height-User.D
LineTo  X = Width; Y = Height
LineTo  X = User.D; Y = Height
LineTo  X = Geometry2.X1; Y = Geometry2.Y1

# 3 die rechte Seite
[Geometry]
MoveTo  X = Width-User.D; Y = 0
LineTo  X = Width; Y = User.D
LineTo  X = Width; Y = Height
LineTo  X = Width-User.D; Y = Height-User.D
LineTo  X = Geometry3.X1; Y = Geometry3.Y1

[Controls]
Row_1:  X = 7.5 mm; Y = Height
        X.us = 0.3 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Tiefe ändern"
        Tip.en = "Change the depth"
        Tip.es = "Cambiar la profundidad"
        Tip.it = "Cambia la profondità"
        Tip.fr = "Modifier la profondeur"

[Connection]
Row  X = (Width-User.D)*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = (Height+User.D)*0.5; DirX = -1; DirY = 0
Row  X = (Width+User.D)*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = (Height-User.D)*0.5; DirX = 1; DirY = 0
