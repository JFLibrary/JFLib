# Rechteck, drei Ecken abgerundet, links unten eckig (ArcTo).  Row_1 an der oberen Kante ändert
# den Radius (nur waagrecht, Abstand von links).
master: Round three corners rectangle
name.de: Rechteck, 3 Ecken abgerundet
name.en: Round three corners rectangle
name.es: Rectángulo, 3 esquinas redondeadas
name.it: Rettangolo, 3 angoli arrotondati
name.fr: Rectangle, 3 coins arrondis
prompt.de: Rechteck mit drei runden Ecken, nur links unten eckig. Mit dem gelben Steuerpunkt ändern Sie den Radius.
prompt.en: Rectangle with three round corners, only the bottom left one square. Drag the yellow control handle to change the radius.
prompt.es: Rectángulo con tres esquinas redondeadas, solo la inferior izquierda en ángulo recto. Arrastre el controlador amarillo para cambiar el radio.
prompt.it: Rettangolo con tre angoli arrotondati, solo quello in basso a sinistra squadrato. Trascina la maniglia di controllo gialla per cambiare il raggio.
prompt.fr: Rectangle avec trois coins arrondis, seul le coin inférieur gauche est droit. Faites glisser la poignée de contrôle jaune pour modifier le rayon.
keywords.de: Rechteck, Ecke, Kasten, Schaltfläche, abgerundet, Radius, rund, drei Ecken, Etikett, Blatt
keywords.en: rectangle, corner, box, button, rounded, radius, round, three corners, label, leaf
keywords.es: rectángulo, esquina, caja, botón, redondeado, radio, redondo, tres esquinas, etiqueta, hoja
keywords.it: rettangolo, angolo, riquadro, pulsante, arrotondato, raggio, rotondo, tre angoli, etichetta, foglia
keywords.fr: rectangle, coin, boîte, bouton, arrondi, rayon, rond, trois coins, étiquette, feuille

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 20 mm
Height.us = 0.75 in
ShapeSplit = 1

[User]
# der Radius der runden Ecken
R:    Value = MIN(MAX(Controls.Row_1,0),MIN(Width,Height)*0.5)
# der Stich eines Viertelkreises mit dem Radius R (ArcTo A)
Bow:  Value = User.R*0.292893

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width-User.R; Y = 0
ArcTo   X = Width; Y = User.R; A = User.Bow
LineTo  X = Width; Y = Height-User.R
ArcTo   X = Width-User.R; Y = Height; A = User.Bow
LineTo  X = User.R; Y = Height
ArcTo   X = 0; Y = Height-User.R; A = User.Bow
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = 5 mm; Y = Height
        X.us = 0.2 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Eckenradius ändern"
        Tip.en = "Change the corner radius"
        Tip.es = "Cambiar el radio de las esquinas"
        Tip.it = "Cambia il raggio degli angoli"
        Tip.fr = "Modifier le rayon des coins"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
