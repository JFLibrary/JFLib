# Achteck: regelmäßig, je eine Kante oben, unten, links und rechts
master: Octagon
name.de: Achteck
name.en: Octagon
name.es: Octágono
name.it: Ottagono
name.fr: Octogone
prompt.de: Regelmäßiges Achteck mit waagrechten und senkrechten Kanten.
prompt.en: Regular octagon with horizontal and vertical edges.
prompt.es: Octágono regular con lados horizontales y verticales.
prompt.it: Ottagono regolare con lati orizzontali e verticali.
prompt.fr: Octogone régulier avec des côtés horizontaux et verticaux.
keywords.de: Achteck, acht, Oktagon, Stopp, Vieleck, Polygon, regelmäßig, Ecken
keywords.en: octagon, eight, eight-sided, stop, polygon, regular, corners
keywords.es: octágono, ocho, ocho lados, stop, polígono, regular, esquinas
keywords.it: ottagono, otto, otto lati, stop, poligono, regolare, angoli
keywords.fr: octogone, huit, huit côtés, stop, polygone, régulier, coins

[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 30 mm
Height.us = 1.25 in
ShapeSplit = 1

[Geometry]
MoveTo  X = Width; Y = Height*0.707107
LineTo  X = Width*0.707107; Y = Height
LineTo  X = Width*0.292893; Y = Height
LineTo  X = 0; Y = Height*0.707107
LineTo  X = 0; Y = Height*0.292893
LineTo  X = Width*0.292893; Y = 0
LineTo  X = Width*0.707107; Y = 0
LineTo  X = Width; Y = Height*0.292893
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
