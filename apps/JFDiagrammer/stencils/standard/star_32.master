# Stern mit 32 Zacken: die äußeren Spitzen auf einem Kreis (eine oben), die inneren Ecken auf
# einem Kreis mit dem Radius User.R (Anteil des äußeren); der Kasten ist so breit und hoch wie die
# Spitzen.  Row_1 sitzt auf der inneren Ecke rechts der oberen Spitze und ändert R (nur senkrecht,
# anteilig; ihr X folgt der Ecke).  R bleibt zwischen 0,2 und cos(180°/32), wo der Stern zum
# Vieleck wird.
master: 32-point star
name.de: Stern mit 32 Zacken
name.en: 32-point star
name.es: Estrella de 32 puntas
name.it: Stella a 32 punte
name.fr: Étoile à 32 branches
prompt.de: Stern mit 32 Zacken, eine davon oben. Mit dem gelben Steuerpunkt ändern Sie die Zackentiefe.
prompt.en: Star with 32 points, one of them at the top. Drag the yellow control handle to change the depth of the points.
prompt.es: Estrella de 32 puntas, una de ellas arriba. Arrastre el controlador amarillo para cambiar la profundidad de las puntas.
prompt.it: Stella a 32 punte, una delle quali in alto. Trascina la maniglia di controllo gialla per cambiare la profondità delle punte.
prompt.fr: Étoile à 32 branches, dont une en haut. Faites glisser la poignée de contrôle jaune pour modifier la profondeur des branches.
keywords.de: Stern, Zacken, Siegel, Sonne, Stempel, Auszeichnung
keywords.en: star, points, seal, sun, stamp, highlight
keywords.es: estrella, puntas, sello, sol, sello de goma, destacar
keywords.it: stella, punte, sigillo, sole, timbro, evidenziare
keywords.fr: étoile, branches, sceau, soleil, tampon, mise en avant

[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 30 mm
Height.us = 1.25 in
ShapeSplit = 1

[User]
# der Radius der inneren Ecken als Anteil des äußeren
R:  Value = MIN(MAX((Controls.Row_1.Y/Height-0.5)/0.497592,0.2),0.995185)

[Geometry]
MoveTo  X = Width*0.5; Y = Height
LineTo  X = Width*(0.5-0.049009*User.R); Y = Height*(0.5+0.497592*User.R)
LineTo  X = Width*0.402455; Y = Height*0.990393
