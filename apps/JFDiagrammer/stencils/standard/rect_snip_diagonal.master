# Rechteck, Ecken rechts oben und links unten abgeschnitten.  Row_1 an der oberen Kante ändert die
# Größe beider Ecken (nur waagrecht, Abstand von rechts).
master: Snip diagonal corner rectangle
name.de: Rechteck, diagonal abgeschnitten
name.en: Snip diagonal corner rectangle
name.es: Rectángulo, esquinas diagonales cortadas
name.it: Rettangolo, angoli diagonali tagliati
name.fr: Rectangle, coins diagonaux coupés
prompt.de: Rechteck mit abgeschnittenen Ecken rechts oben und links unten. Mit dem gelben Steuerpunkt ändern Sie die Größe der Ecken.
prompt.en: Rectangle with the top right and bottom left corners snipped. Drag the yellow control handle to change the size of the corners.
prompt.es: Rectángulo con las esquinas superior derecha e inferior izquierda cortadas. Arrastre el controlador amarillo para cambiar el tamaño de las esquinas.
prompt.it: Rettangolo con gli angoli in alto a destra e in basso a sinistra tagliati. Trascina la maniglia di controllo gialla per cambiare la dimensione degli angoli.
prompt.fr: Rectangle dont les coins supérieur droit et inférieur gauche sont coupés. Faites glisser la poignée de contrôle jaune pour modifier la taille des coins.
keywords.de: Rechteck, Ecke, Kasten, Schaltfläche, abgeschnitten, abgeschrägt, Fase, diagonal, gegenüber
keywords.en: rectangle, corner, box, button, snipped, cut, bevel, diagonal, opposite
keywords.es: rectángulo, esquina, caja, botón, cortado, biselado, chaflán, diagonal, opuestas
keywords.it: rettangolo, angolo, riquadro, pulsante, tagliato, smussato, smusso, diagonale, opposti
keywords.fr: rectangle, coin, boîte, bouton, coupé, biseauté, chanfrein, diagonale, opposés

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 20 mm
Height.us = 0.75 in
ShapeSplit = 1

[User]
# die Größe der abgeschnittenen Ecken
D:  Value = MIN(MAX(Width-Controls.Row_1,0),MIN(Width,Height)*0.5)

[Geometry]
MoveTo  X = User.D; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height-User.D
LineTo  X = Width-User.D; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = User.D
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = Width-5 mm; Y = Height
        X.us = Width-0.2 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 4; YCon = 1; CanGlue = FALSE
        Tip.de = "Größe der Ecken ändern"
        Tip.en = "Change the size of the corners"
        Tip.es = "Cambiar el tamaño de las esquinas"
        Tip.it = "Cambia la dimensione degli angoli"
        Tip.fr = "Modifier la taille des coins"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
