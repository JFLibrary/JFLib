# Stern mit 6 Zacken: die äußeren Spitzen auf einem Kreis (eine oben), die inneren Ecken auf einem
# Kreis mit dem Radius User.R (Anteil des äußeren); der Kasten ist so breit und hoch wie die
# Spitzen.  Row_1 sitzt auf der inneren Ecke rechts der oberen Spitze und ändert R (nur senkrecht,
# anteilig; ihr X folgt der Ecke).  R bleibt zwischen 0,2 und cos(180°/6), wo der Stern zum
# Vieleck wird.
master: 6-point star
name.de: Stern mit 6 Zacken
name.en: 6-point star
name.es: Estrella de 6 puntas
name.it: Stella a 6 punte
name.fr: Étoile à 6 branches
prompt.de: Stern mit 6 Zacken, eine davon oben. Mit dem gelben Steuerpunkt ändern Sie die Zackentiefe.
prompt.en: Star with 6 points, one of them at the top. Drag the yellow control handle to change the depth of the points.
prompt.es: Estrella de 6 puntas, una de ellas arriba. Arrastre el controlador amarillo para cambiar la profundidad de las puntas.
prompt.it: Stella a 6 punte, una delle quali in alto. Trascina la maniglia di controllo gialla per cambiare la profondità delle punte.
prompt.fr: Étoile à 6 branches, dont une en haut. Faites glisser la poignée de contrôle jaune pour modifier la profondeur des branches.
keywords.de: Stern, Zacken, Hexagramm, Davidstern, sechs, Auszeichnung
keywords.en: star, points, hexagram, six-pointed, six, highlight
keywords.es: estrella, puntas, hexagrama, seis puntas, seis, destacar
keywords.it: stella, punte, esagramma, sei punte, sei, evidenziare
keywords.fr: étoile, branches, hexagramme, six branches, six, mise en avant

[Shape]
Width = 26 mm
Width.us = 1.08 in
Height = 30 mm
Height.us = 1.25 in
ShapeSplit = 1

[User]
# der Radius der inneren Ecken als Anteil des äußeren
R:  Value = MIN(MAX((Controls.Row_1.Y/Height-0.5)/0.433013,0.2),0.866025)

[Geometry]
MoveTo  X = Width*0.5; Y = Height
LineTo  X = Width*(0.5-0.288675*User.R); Y = Height*(0.5+0.433013*User.R)
LineTo  X = 0; Y = Height*0.75
LineTo  X = Width*(0.5-0.57735*User.R); Y = Height*0.5
LineTo  X = 0; Y = Height*0.25
LineTo  X = Width*(0.5-0.288675*User.R); Y = Height*(0.5-0.433013*User.R)
LineTo  X = Width*0.5; Y = 0
LineTo  X = Width*(0.5+0.288675*User.R); Y = Height*(0.5-0.433013*User.R)
LineTo  X = Width; Y = Height*0.25
LineTo  X = Width*(0.5+0.57735*User.R); Y = Height*0.5
LineTo  X = Width; Y = Height*0.75
LineTo  X = Width*(0.5+0.288675*User.R); Y = Height*(0.5+0.433013*User.R)
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = Width*(0.5+0.288675*User.R); Y = Height*0.751147
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Zackentiefe ändern"
        Tip.en = "Change the depth of the points"
        Tip.es = "Cambiar la profundidad de las puntas"
        Tip.it = "Cambia la profondità delle punte"
        Tip.fr = "Modifier la profondeur des branches"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width*(0.5+0.57735*User.R); Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = Width*(0.5-0.57735*User.R); Y = Height*0.5; DirX = 1; DirY = 0
