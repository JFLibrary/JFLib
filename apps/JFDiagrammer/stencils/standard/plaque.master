# Plakette: die Ecken als Viertelkreise um die Ecke des Kastens, nach innen gewölbt (ArcTo mit
# negativem Stich).  Row_1 an der oberen Kante ändert den Radius (nur waagrecht, Abstand von
# links).
master: Plaque
name.de: Plakette
name.en: Plaque
name.es: Placa
name.it: Targa
name.fr: Plaque
prompt.de: Rechteck mit nach innen gewölbten Ecken. Mit dem gelben Steuerpunkt ändern Sie den Radius der Ecken.
prompt.en: Rectangle with inward curved corners. Drag the yellow control handle to change the radius of the corners.
prompt.es: Rectángulo con las esquinas curvadas hacia dentro. Arrastre el controlador amarillo para cambiar el radio de las esquinas.
prompt.it: Rettangolo con gli angoli curvati verso l'interno. Trascina la maniglia di controllo gialla per cambiare il raggio degli angoli.
prompt.fr: Rectangle aux coins incurvés vers l'intérieur. Faites glisser la poignée de contrôle jaune pour modifier le rayon des coins.
keywords.de: Plakette, Schild, Tafel, Ecken, Urkunde, Titel
keywords.en: plaque, sign, plate, corners, certificate, title
keywords.es: placa, letrero, tablilla, esquinas, certificado, título
keywords.it: targa, cartello, placca, angoli, attestato, titolo
keywords.fr: plaque, panneau, écriteau, coins, diplôme, titre

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 20 mm
Height.us = 0.75 in

[User]
# der Radius der Ecken und der Stich eines Viertelkreises (ArcTo A, nach innen negativ)
R:    Value = MIN(MAX(Controls.Row_1,0),MIN(Width,Height)*0.5)
Bow:  Value = User.R*0.292893

[Geometry]
MoveTo  X = User.R; Y = 0
LineTo  X = Width-User.R; Y = 0
ArcTo   X = Width; Y = User.R; A = -User.Bow
LineTo  X = Width; Y = Height-User.R
ArcTo   X = Width-User.R; Y = Height; A = -User.Bow
LineTo  X = User.R; Y = Height
ArcTo   X = 0; Y = Height-User.R; A = -User.Bow
LineTo  X = 0; Y = User.R
ArcTo   X = Geometry1.X1; Y = Geometry1.Y1; A = -User.Bow

[Controls]
Row_1:  X = 5 mm; Y = Height
        X.us = 0.2 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Eckenradius ändern"
        Tip.en = "Change the corner radius"
        Tip.es = "Cambiar el radio de las esquinas"
        Tip.it = "Cambia il raggio degli angoli"
        Tip.fr = "Modifier le rayon des coins"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
