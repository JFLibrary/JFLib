# Rechteck, Ecken rechts oben und links unten abgerundet.  Row_1 an der oberen Kante ändert den
# Radius (nur waagrecht, Abstand von rechts).
master: Round diagonal corner rectangle
name.de: Rechteck, diagonal abgerundet
name.en: Round diagonal corner rectangle
name.es: Rectángulo, esquinas diagonales redondeadas
name.it: Rettangolo, angoli diagonali arrotondati
name.fr: Rectangle, coins diagonaux arrondis
prompt.de: Rechteck mit runden Ecken rechts oben und links unten. Mit dem gelben Steuerpunkt ändern Sie den Radius.
prompt.en: Rectangle with round top right and bottom left corners. Drag the yellow control handle to change the radius.
prompt.es: Rectángulo con las esquinas superior derecha e inferior izquierda redondeadas. Arrastre el controlador amarillo para cambiar el radio.
prompt.it: Rettangolo con gli angoli in alto a destra e in basso a sinistra arrotondati. Trascina la maniglia di controllo gialla per cambiare il raggio.
prompt.fr: Rectangle dont les coins supérieur droit et inférieur gauche sont arrondis. Faites glisser la poignée de contrôle jaune pour modifier le rayon.
keywords.de: Rechteck, Ecke, Kasten, Schaltfläche, abgerundet, Radius, rund, diagonal, gegenüber, Blatt
keywords.en: rectangle, corner, box, button, rounded, radius, round, diagonal, opposite, leaf
keywords.es: rectángulo, esquina, caja, botón, redondeado, radio, redondo, diagonal, opuestas, hoja
keywords.it: rettangolo, angolo, riquadro, pulsante, arrotondato, raggio, rotondo, diagonale, opposti, foglia
keywords.fr: rectangle, coin, boîte, bouton, arrondi, rayon, rond, diagonale, opposés, feuille

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = 20 mm
Height.us = 0.75 in

[User]
# der Radius der runden Ecken
R:    Value = MIN(MAX(Width-Controls.Row_1,0),MIN(Width,Height)*0.5)
# der Stich eines Viertelkreises mit dem Radius R (ArcTo A)
Bow:  Value = User.R*0.292893

[Geometry]
MoveTo  X = User.R; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height-User.R
ArcTo   X = Width-User.R; Y = Height; A = User.Bow
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = User.R
ArcTo   X = Geometry1.X1; Y = Geometry1.Y1; A = User.Bow

[Controls]
Row_1:  X = Width-5 mm; Y = Height
        X.us = Width-0.2 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 4; YCon = 1; CanGlue = FALSE
        Tip.de = "Eckenradius ändern"
        Tip.en = "Change the corner radius"
        Tip.es = "Cambiar el radio de las esquinas"
        Tip.it = "Cambia il raggio degli angoli"
        Tip.fr = "Modifier le rayon des coins"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
