# Donut: äußere und innere Ellipse als zwei Abschnitte (Gerade-Ungerade-Regel: innen frei). Row_1
# auf dem oberen Punkt des inneren Rands ändert den Innenradius als Anteil des äußeren (nur
# senkrecht, anteilig).
master: Donut
name.de: Donut
name.en: Donut
name.es: Anillo
name.it: Anello
name.fr: Anneau
prompt.de: Ring mit Loch in der Mitte. Mit dem gelben Steuerpunkt ändern Sie die Breite des Rings.
prompt.en: Ring with a hole in the middle. Drag the yellow control handle to change the width of the ring.
prompt.es: Anillo con un agujero en el centro. Arrastre el controlador amarillo para cambiar el ancho del anillo.
prompt.it: Anello con un foro al centro. Trascina la maniglia di controllo gialla per cambiare la larghezza dell'anello.
prompt.fr: Anneau avec un trou au milieu. Faites glisser la poignée de contrôle jaune pour modifier la largeur de l'anneau.
keywords.de: Donut, Ring, Kreisring, Scheibe, Loch, Reifen
keywords.en: donut, ring, annulus, disc, hole, tyre
keywords.es: anillo, rosquilla, corona circular, disco, agujero
keywords.it: anello, ciambella, corona circolare, disco, foro
keywords.fr: anneau, beignet, couronne, disque, trou

[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 30 mm
Height.us = 1.25 in

[User]
# der Innenradius als Anteil des Außenradius
K:  Value = MIN(MAX(Controls.Row_1.Y*2/Height-1,0.05),0.95)

# 1 außen
[Geometry]
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

# 2 das Loch
[Geometry]
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width*0.5*(1+User.K); B = Height*0.5; C = Width*0.5; D = Height*0.5*(1+User.K)

[Controls]
Row_1:  X = Width*0.5; Y = Height*0.8
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Breite des Rings ändern"
        Tip.en = "Change the width of the ring"
        Tip.es = "Cambiar el ancho del anillo"
        Tip.it = "Cambia la larghezza dell'anello"
        Tip.fr = "Modifier la largeur de l'anneau"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
