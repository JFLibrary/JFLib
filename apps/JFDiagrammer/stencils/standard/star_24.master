# Stern mit 24 Zacken: die äußeren Spitzen auf einem Kreis (eine oben), die inneren Ecken auf
# einem Kreis mit dem Radius User.R (Anteil des äußeren); der Kasten ist so breit und hoch wie die
# Spitzen.  Row_1 sitzt auf der inneren Ecke rechts der oberen Spitze und ändert R (nur senkrecht,
# anteilig; ihr X folgt der Ecke).  R bleibt zwischen 0,2 und cos(180°/24), wo der Stern zum
# Vieleck wird.
master: 24-point star
name.de: Stern mit 24 Zacken
name.en: 24-point star
name.es: Estrella de 24 puntas
name.it: Stella a 24 punte
name.fr: Étoile à 24 branches
prompt.de: Stern mit 24 Zacken, eine davon oben. Mit dem gelben Steuerpunkt ändern Sie die Zackentiefe.
prompt.en: Star with 24 points, one of them at the top. Drag the yellow control handle to change the depth of the points.
prompt.es: Estrella de 24 puntas, una de ellas arriba. Arrastre el controlador amarillo para cambiar la profundidad de las puntas.
prompt.it: Stella a 24 punte, una delle quali in alto. Trascina la maniglia di controllo gialla per cambiare la profondità delle punte.
prompt.fr: Étoile à 24 branches, dont une en haut. Faites glisser la poignée de contrôle jaune pour modifier la profondeur des branches.
keywords.de: Stern, Zacken, Siegel, Sonne, Auszeichnung
keywords.en: star, points, seal, sun, highlight
keywords.es: estrella, puntas, sello, sol, destacar
keywords.it: stella, punte, sigillo, sole, evidenziare
keywords.fr: étoile, branches, sceau, soleil, mise en avant

[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 30 mm
Height.us = 1.25 in
ShapeSplit = 1

[User]
# der Radius der inneren Ecken als Anteil des äußeren
R:  Value = MIN(MAX((Controls.Row_1.Y/Height-0.5)/0.495722,0.2),0.991445)

[Geometry]
MoveTo  X = Width*0.5; Y = Height
LineTo  X = Width*(0.5-0.065263*User.R); Y = Height*(0.5+0.495722*User.R)
LineTo  X = Width*0.37059; Y = Height*0.982963
LineTo  X = Width*(0.5-0.191342*User.R); Y = Height*(0.5+0.46194*User.R)
LineTo  X = Width*0.25; Y = Height*0.933013
