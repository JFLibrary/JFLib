# Beschriftung 8: sichtbar ab 8 Ebenen; sonst deckungsgleich mit der untersten, verborgen
[Part T8]
text.de: Ebene 8
text.en: Level 8
text.es: Nivel 8
text.it: Livello 8
text.fr: Niveau 8
style: Connector

[User]
# die Ebene, an deren Stelle das Teil liegt, ihre Mitte, der Anfang der Linie und des Texts
K:   Value = MIN(8,Sheet.1!User.N)
Ym:  Value = Sheet.1!Height-(User.K-0.5)*Sheet.1!User.H1
X0:  Value = Sheet.1!User.P*(1-0.5*User.Ym/Sheet.1!Height)+Sheet.1!User.Gp
X1:  Value = Sheet.1!User.P+Sheet.1!User.Gl

[Shape]
Width = GUARD(Sheet.1!Width-User.X0)
Height = GUARD(Sheet.1!User.H1-Sheet.1!User.Gp)
PinX = GUARD(User.X0+Width*0.5)
PinY = GUARD(User.Ym)
TxtWidth = Width-(User.X1-User.X0)
TxtHeight = Height
TxtPinX = Width-TxtWidth*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
HideText = 8>Sheet.1!User.N
BeginArrow = 0
EndArrow = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3
QuickStyleLineMatrix = 2

[Paragraph]
Row  HorzAlign = 0

[Geometry]
NoFill = TRUE
NoShow = 8>Sheet.1!User.N
MoveTo  X = 0; Y = Height*0.5
LineTo  X = User.X1-User.X0; Y = Height*0.5

