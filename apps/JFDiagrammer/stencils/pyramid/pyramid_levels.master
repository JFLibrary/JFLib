# Pyramide mit Ebenen (SH-032, JD26): eine Pyramide aus zwei bis acht Ebenen, jede ein Teil der
# Gruppe mit eigenem Text und eigener Variantenfarbe des Designs (Schnellformatvorlage 100 bis
# 106, ab der achten Ebene wieder von vorn), 1 mm Fuge zwischen den Ebenen.  Ebene 1 ist die
# Spitze.  Die Zahl steht in den Shape-Daten (Prop.Levels); der Steuerpunkt Row_1 an der Spitze
# ändert sie beim Ziehen nach oben oder unten: jede Ebene ist User.LH hoch, die Höhe der Gruppe
# Ebenen x LH (Ziehen vermehrt die Ebenen, die Pyramide wächst mit); zieht man die Höhe selbst,
# schickt SETATREF die neue Ebenenhöhe nach User.LH.  Teile über der Zahl der Ebenen liegen
# verborgen unter der untersten (die Teile stehen von unten nach oben in der Datei).  Die Teile
# zeichnen nach Height/N (User.H1), damit sie auch passen, wenn jemand die Höhe ohne SETATREF setzt.
master: Layered pyramid
name.de: Pyramide mit Ebenen
name.en: Layered pyramid
name.es: Pirámide con niveles
name.it: Piramide a livelli
name.fr: Pyramide à niveaux
prompt.de: Pyramide mit farbigen Ebenen für Hierarchien. Ziehen Sie den gelben Steuerpunkt an der Spitze nach oben oder unten, um Ebenen hinzuzufügen oder zu entfernen.
prompt.en: Pyramid with coloured levels for hierarchies. Drag the yellow control handle at the top up or down to add or remove levels.
prompt.es: Pirámide con niveles de colores para jerarquías. Arrastre el controlador amarillo de la cúspide hacia arriba o hacia abajo para agregar o quitar niveles.
prompt.it: Piramide a livelli colorati per gerarchie. Trascina la maniglia di controllo gialla sulla punta in alto o in basso per aggiungere o togliere livelli.
prompt.fr: Pyramide à niveaux colorés pour les hiérarchies. Faites glisser la poignée de contrôle jaune du sommet vers le haut ou le bas pour ajouter ou supprimer des niveaux.
keywords.de: Pyramide, Ebenen, Hierarchie, Stufen, Bedürfnispyramide, Schichten, Rangfolge
keywords.en: pyramid, levels, hierarchy, tiers, layers, ranking
keywords.es: pirámide, niveles, jerarquía, capas, escalones, clasificación
keywords.it: piramide, livelli, gerarchia, strati, gradini, classifica
keywords.fr: pyramide, niveaux, hiérarchie, couches, étages, classement

[Shape]
Width = 80 mm
Width.us = 3.25 in
Height = SETATREF(User.LH,SETATREFEVAL(SETATREFEXPR()/User.N))*User.N

[User]
# die Zahl der Ebenen (2 bis 8), die Höhe einer Ebene, die Fuge
N:   Value = MIN(MAX(ROUND(Prop.Levels,0),2),8)
LH:  Value = 12.5 mm
     Value.us = 0.5 in
Gp:  Value = 1 mm
     Value.us = 0.04 in
# die Höhe einer Ebene, wie die Teile sie zeichnen
H1:  Value = Height/User.N

[Property]
Levels:  Type = 2; Format = "0"; Value = 4
         Label.de = Ebenen
         Label.en = Levels
         Label.es = Niveles
         Label.it = Livelli
         Label.fr = Niveaux
         Prompt.de = Anzahl der Ebenen (2 bis 8)
         Prompt.en = Number of levels (2 to 8)
         Prompt.es = Número de niveles (de 2 a 8)
         Prompt.it = Numero di livelli (da 2 a 8)
         Prompt.fr = Nombre de niveaux (de 2 à 8)

[Controls]
Row_1:  X = Width*0.5; Y = SETATREF(Prop.Levels,SETATREFEVAL(MIN(MAX(ROUND(SETATREFEXPR()/User.LH,0),2),8)))*User.LH
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Ebenen hinzufügen oder entfernen"
        Tip.en = "Add or remove levels"
        Tip.es = "Agregar o quitar niveles"
        Tip.it = "Aggiungi o togli livelli"
        Tip.fr = "Ajouter ou supprimer des niveaux"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width*0.75; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = Width*0.25; Y = Height*0.5; DirX = 1; DirY = 0

# Ebene 8 (von oben): sichtbar ab 8 Ebenen; sonst deckungsgleich mit der untersten, verborgen
[Part L8]
text.de: Ebene 8
text.en: Level 8
text.es: Nivel 8
text.it: Livello 8
text.fr: Niveau 8

[User]
# die Ebene, an deren Stelle das Teil liegt, ihre Unter- und Oberkante, die Breite dort
K:   Value = MIN(8,Sheet.1!User.N)
Y0:  Value = IF(User.K>=Sheet.1!User.N,0,Sheet.1!Height-User.K*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
Y1:  Value = IF(User.K<=1,Sheet.1!Height,Sheet.1!Height-(User.K-1)*Sheet.1!User.H1-Sheet.1!User.Gp*0.5)
B:   Value = Sheet.1!Width*(1-User.Y0/Sheet.1!Height)
T:   Value = Sheet.1!Width*(1-User.Y1/Sheet.1!Height)

[Shape]
PinX = GUARD(Sheet.1!Width*0.5)
PinY = GUARD((User.Y0+User.Y1)*0.5)
Width = GUARD(User.B)
Height = GUARD(User.Y1-User.Y0)
HideText = 8>Sheet.1!User.N
QuickStyleLineColor = 100
QuickStyleFillColor = 100

[Geometry]
NoShow = 8>Sheet.1!User.N
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = (Width+User.T)*0.5; Y = Height
LineTo  X = (Width-User.T)*0.5; Y = Height
LineTo  X = 0; Y = 0

