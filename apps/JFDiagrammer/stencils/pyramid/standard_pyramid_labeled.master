# Standardpyramide mit Beschriftung (SH-032, JD26): eine Standardpyramide aus zwei bis acht Ebenen
# (ein Teil, eine Farbe, je Ebene ein Geometrieabschnitt mit 1 mm Fuge) und rechts daneben je Ebene
# eine Beschriftung (ein Teil mit Text): eine waagrechte Linie von der Seite der Ebene in ihrer
# Mitte bis zum Text, der links ausgerichtet folgt.
# Die Pyramide ist User.P breit (60 % der Gruppe), der Text beginnt User.Gl rechts davon.  Die Zahl
# der Ebenen steht in den Shape-Daten (Prop.Levels); Row_1 an der Spitze ändert sie beim Ziehen
# nach oben oder unten: jede Ebene ist User.LH hoch, die Höhe Ebenen x LH; zieht man die Höhe
# selbst, schickt SETATREF die neue Ebenenhöhe nach User.LH.  Beschriftungen über der Zahl liegen
# verborgen auf der untersten (die Teile stehen von unten nach oben in der Datei).  Die
# Beschriftungen nehmen die Formatvorlage Connector (Linie und Text sichtbar auch in Designs ohne
# Shape-Linien, der Text auf der Seite statt auf einer Füllung) ohne deren Pfeilspitzen.
master: Standard pyramid with labels
name.de: Standardpyramide mit Beschriftung
name.en: Standard pyramid with labels
name.es: Pirámide estándar con etiquetas
name.it: Piramide standard con etichette
name.fr: Pyramide standard avec étiquettes
prompt.de: Pyramide in einer Farbe mit Texten neben den Ebenen. Ziehen Sie den gelben Steuerpunkt an der Spitze nach oben oder unten, um Ebenen hinzuzufügen oder zu entfernen.
prompt.en: Single-colour pyramid with texts beside the levels. Drag the yellow control handle at the top up or down to add or remove levels.
prompt.es: Pirámide de un color con textos junto a los niveles. Arrastre el controlador amarillo de la cúspide hacia arriba o hacia abajo para agregar o quitar niveles.
prompt.it: Piramide di un colore con testi accanto ai livelli. Trascina la maniglia di controllo gialla sulla punta in alto o in basso per aggiungere o togliere livelli.
prompt.fr: Pyramide d'une couleur avec des textes à côté des niveaux. Faites glisser la poignée de contrôle jaune du sommet vers le haut ou le bas pour ajouter ou supprimer des niveaux.
keywords.de: Pyramide, Beschriftung, Ebenen, Hierarchie, Legende, Text, Stufen
keywords.en: pyramid, labels, levels, hierarchy, legend, text, tiers
keywords.es: pirámide, etiquetas, niveles, jerarquía, leyenda, texto
keywords.it: piramide, etichette, livelli, gerarchia, legenda, testo
keywords.fr: pyramide, étiquettes, niveaux, hiérarchie, légende, texte

[Shape]
Width = 100 mm
Width.us = 4 in
Height = SETATREF(User.LH,SETATREFEVAL(SETATREFEXPR()/User.N))*User.N

[User]
# die Zahl der Ebenen (2 bis 8), die Höhe einer Ebene, die Fuge
N:   Value = MIN(MAX(ROUND(Prop.Levels,0),2),8)
LH:  Value = 12.5 mm
     Value.us = 0.5 in
Gp:  Value = 1 mm
     Value.us = 0.04 in
# die Höhe einer Ebene, wie die Teile sie zeichnen
H1:  Value = Height/User.N
# die Breite der Pyramide, der Abstand des Texts von ihr
P:   Value = Width*0.6
Gl:  Value = 4 mm
     Value.us = 0.16 in

[Property]
Levels:  Type = 2; Format = "0"; Value = 4
         Label.de = Ebenen
         Label.en = Levels
         Label.es = Niveles
         Label.it = Livelli
         Label.fr = Niveaux
         Prompt.de = Anzahl der Ebenen (2 bis 8)
         Prompt.en = Number of levels (2 to 8)
         Prompt.es = Número de niveles (de 2 a 8)
         Prompt.it = Numero di livelli (da 2 a 8)
         Prompt.fr = Nombre de niveaux (de 2 à 8)

[Controls]
Row_1:  X = User.P*0.5; Y = SETATREF(Prop.Levels,SETATREFEVAL(MIN(MAX(ROUND(SETATREFEXPR()/User.LH,0),2),8)))*User.LH
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Ebenen hinzufügen oder entfernen"
        Tip.en = "Add or remove levels"
        Tip.es = "Agregar o quitar niveles"
        Tip.it = "Aggiungi o togli livelli"
        Tip.fr = "Ajouter ou supprimer des niveaux"

[Connection]
Row  X = User.P*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = User.P*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = User.P*0.25; Y = Height*0.5; DirX = 1; DirY = 0

# die Standardpyramide, User.P breit
[Part Pyramid]

[Shape]
Width = GUARD(Sheet.1!User.P)
PinX = GUARD(Width*0.5)

# Ebene 1 (von oben)
[Geometry]
MoveTo  X = Width*0.5*Geometry1.Y1/Height; Y = IF(1>=Sheet.1!User.N,0,Height-1*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry1.X1; Y = Geometry1.Y1
LineTo  X = Width-Width*0.5*Geometry1.Y3/Height; Y = Height
LineTo  X = Width-Geometry1.X3; Y = Geometry1.Y3
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

# Ebene 2 (von oben)
[Geometry]
MoveTo  X = Width*0.5*Geometry2.Y1/Height; Y = IF(2>=Sheet.1!User.N,0,Height-2*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry2.X1; Y = Geometry2.Y1
LineTo  X = Width-Width*0.5*Geometry2.Y3/Height; Y = Height-Sheet.1!User.H1-Sheet.1!User.Gp*0.5
LineTo  X = Width-Geometry2.X3; Y = Geometry2.Y3
LineTo  X = Geometry2.X1; Y = Geometry2.Y1

# Ebene 3 (von oben)
[Geometry]
NoShow = 3>Sheet.1!User.N
MoveTo  X = Width*0.5*Geometry3.Y1/Height; Y = IF(3>=Sheet.1!User.N,0,Height-3*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry3.X1; Y = Geometry3.Y1
LineTo  X = Width-Width*0.5*Geometry3.Y3/Height; Y = IF(3>Sheet.1!User.N,0,Height-2*Sheet.1!User.H1-Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry3.X3; Y = Geometry3.Y3
LineTo  X = Geometry3.X1; Y = Geometry3.Y1

# Ebene 4 (von oben)
[Geometry]
NoShow = 4>Sheet.1!User.N
MoveTo  X = Width*0.5*Geometry4.Y1/Height; Y = IF(4>=Sheet.1!User.N,0,Height-4*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry4.X1; Y = Geometry4.Y1
LineTo  X = Width-Width*0.5*Geometry4.Y3/Height; Y = IF(4>Sheet.1!User.N,0,Height-3*Sheet.1!User.H1-Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry4.X3; Y = Geometry4.Y3
LineTo  X = Geometry4.X1; Y = Geometry4.Y1

# Ebene 5 (von oben)
[Geometry]
NoShow = 5>Sheet.1!User.N
MoveTo  X = Width*0.5*Geometry5.Y1/Height; Y = IF(5>=Sheet.1!User.N,0,Height-5*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry5.X1; Y = Geometry5.Y1
LineTo  X = Width-Width*0.5*Geometry5.Y3/Height; Y = IF(5>Sheet.1!User.N,0,Height-4*Sheet.1!User.H1-Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry5.X3; Y = Geometry5.Y3
LineTo  X = Geometry5.X1; Y = Geometry5.Y1

# Ebene 6 (von oben)
[Geometry]
NoShow = 6>Sheet.1!User.N
MoveTo  X = Width*0.5*Geometry6.Y1/Height; Y = IF(6>=Sheet.1!User.N,0,Height-6*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry6.X1; Y = Geometry6.Y1
LineTo  X = Width-Width*0.5*Geometry6.Y3/Height; Y = IF(6>Sheet.1!User.N,0,Height-5*Sheet.1!User.H1-Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry6.X3; Y = Geometry6.Y3
LineTo  X = Geometry6.X1; Y = Geometry6.Y1

# Ebene 7 (von oben)
[Geometry]
NoShow = 7>Sheet.1!User.N
MoveTo  X = Width*0.5*Geometry7.Y1/Height; Y = IF(7>=Sheet.1!User.N,0,Height-7*Sheet.1!User.H1+Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry7.X1; Y = Geometry7.Y1
LineTo  X = Width-Width*0.5*Geometry7.Y3/Height; Y = IF(7>Sheet.1!User.N,0,Height-6*Sheet.1!User.H1-Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry7.X3; Y = Geometry7.Y3
LineTo  X = Geometry7.X1; Y = Geometry7.Y1

# Ebene 8 (von oben)
[Geometry]
NoShow = 8>Sheet.1!User.N
MoveTo  X = Width*0.5*Geometry8.Y1/Height; Y = 0
LineTo  X = Width-Geometry8.X1; Y = Geometry8.Y1
LineTo  X = Width-Width*0.5*Geometry8.Y3/Height; Y = IF(8>Sheet.1!User.N,0,Height-7*Sheet.1!User.H1-Sheet.1!User.Gp*0.5)
LineTo  X = Width-Geometry8.X3; Y = Geometry8.Y3
LineTo  X = Geometry8.X1; Y = Geometry8.Y1

# Beschriftung 8: sichtbar ab 8 Ebenen; sonst deckungsgleich mit der untersten, verborgen
[Part T8]
text.de: Ebene 8
text.en: Level 8
text.es: Nivel 8
text.it: Livello 8
text.fr: Niveau 8
style: Connector

[User]
# die Ebene, an deren Stelle das Teil liegt, ihre Mitte, der Anfang der Linie und des Texts
K:   Value = MIN(8,Sheet.1!User.N)
Ym:  Value = Sheet.1!Height-(User.K-0.5)*Sheet.1!User.H1
X0:  Value = Sheet.1!User.P*(1-0.5*User.Ym/Sheet.1!Height)+Sheet.1!User.Gp
X1:  Value = Sheet.1!User.P+Sheet.1!User.Gl

[Shape]
Width = GUARD(Sheet.1!Width-User.X0)
Height = GUARD(Sheet.1!User.H1-Sheet.1!User.Gp)
PinX = GUARD(User.X0+Width*0.5)
PinY = GUARD(User.Ym)
TxtWidth = Width-(User.X1-User.X0)
TxtHeight = Height
TxtPinX = Width-TxtWidth*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
HideText = 8>Sheet.1!User.N
BeginArrow = 0
EndArrow = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3

[Paragraph]
Row  HorzAlign = 0

[Geometry]
NoFill = TRUE
NoShow = 8>Sheet.1!User.N
MoveTo  X = 0; Y = Height*0.5
LineTo  X = User.X1-User.X0; Y = Height*0.5

