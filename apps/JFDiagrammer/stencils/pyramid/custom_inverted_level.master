# Benutzerdefinierte invertierte Ebene (SH-032, JD26): eine einzelne Ebene einer umgedrehten
# Pyramide zum Stapeln, ein Trapez, oben so breit wie das Shape, unten um User.D je Seite
# eingerückt.  Row_1 an der unteren linken Ecke ändert den Einzug (Abstand vom linken Rand, nur
# waagrecht): er bleibt beim Strecken, so passen gleich hohe Ebenen mit gleichem Einzug
# aufeinander, wenn die untere um 2 x Einzug schmaler ist.
master: Custom inverted level
name.de: Benutzerdefinierte invertierte Ebene
name.en: Custom inverted level
name.es: Nivel invertido personalizado
name.it: Livello invertito personalizzato
name.fr: Niveau inversé personnalisé
prompt.de: Einzelne Ebene einer umgedrehten Pyramide zum Stapeln. Die Neigung der Seiten ändern Sie mit dem gelben Steuerpunkt.
prompt.en: Single level of an inverted pyramid for stacking. Drag the yellow control handle to change the slope of the sides.
prompt.es: Nivel individual de una pirámide invertida para apilar. Arrastre el controlador amarillo para cambiar la inclinación de los lados.
prompt.it: Singolo livello di una piramide invertita da impilare. Trascina la maniglia di controllo gialla per cambiare l'inclinazione dei lati.
prompt.fr: Niveau individuel d'une pyramide inversée à empiler. Faites glisser la poignée de contrôle jaune pour modifier l'inclinaison des côtés.
keywords.de: Ebene, Trapez, invertiert, Pyramide, stapeln, benutzerdefiniert, Schicht
keywords.en: level, trapezoid, inverted, pyramid, stack, custom, layer
keywords.es: nivel, trapecio, invertido, pirámide, apilar, personalizado, capa
keywords.it: livello, trapezio, invertito, piramide, impilare, personalizzato, strato
keywords.fr: niveau, trapèze, inversé, pyramide, empiler, personnalisé, couche

[Shape]
Width = 60 mm
Width.us = 2.5 in
Height = 12.5 mm
Height.us = 0.5 in

[User]
# der Einzug je Seite
D:  Value = MIN(MAX(Controls.Row_1,0),Width*0.49)

[Geometry]
MoveTo  X = User.D; Y = 0
LineTo  X = Width-User.D; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = User.D; Y = 0

[Controls]
Row_1:  X = 6 mm; Y = 0
        X.us = 0.25 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Neigung der Seiten ändern"
        Tip.en = "Change the slope of the sides"
        Tip.es = "Cambiar la inclinación de los lados"
        Tip.it = "Cambia l'inclinazione dei lati"
        Tip.fr = "Modifier l'inclinaison des côtés"

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width-User.D*0.5; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = User.D*0.5; Y = Height*0.5; DirX = 1; DirY = 0
