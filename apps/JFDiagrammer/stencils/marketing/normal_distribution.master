# Normalverteilung (SH-030, JD26): die Glockenkurve exp(-x²/2) von -3,5 bis +3,5
# Standardabweichungen als Polylinie in Schritten von 0,1 (im Skript ausgewertet, als Anteile der
# Kurvenfläche).  Teile der Gruppe: die Fläche unter der Kurve (Füllung von Normal, ohne Linie), die
# Linien darüber (Grundlinie, Kurve und senkrechte Linien bei μ und μ ± 1, 2, 3 σ bis an die
# Kurve; Formatvorlage Connector ohne Pfeilspitzen, sichtbar auch in Designs ohne Shape-Linien)
# und die Beschriftungen μ-3σ … μ+3σ im Band unten (Text Only).
master: Normal distribution
name.de: Normalverteilung
name.en: Normal distribution
name.es: Distribución normal
name.it: Distribuzione normale
name.fr: Distribution normale
prompt.de: Glockenkurve der Normalverteilung mit Achse und Linien bei einer, zwei und drei Standardabweichungen. Klicken Sie eine Beschriftung zweimal an, um ihren Text zu ändern.
prompt.en: Bell curve of the normal distribution with an axis and lines at one, two and three standard deviations. Click a label twice to change its text.
prompt.es: Curva de campana de la distribución normal con eje y líneas a una, dos y tres desviaciones típicas. Haga clic dos veces en una etiqueta para cambiar su texto.
prompt.it: Curva a campana della distribuzione normale con asse e linee a una, due e tre deviazioni standard. Fai clic due volte su un'etichetta per cambiarne il testo.
prompt.fr: Courbe en cloche de la loi normale avec axe et lignes à un, deux et trois écarts-types. Cliquez deux fois sur une étiquette pour modifier son texte.
keywords.de: Normalverteilung, Glockenkurve, Gauß, Standardabweichung, Sigma, Statistik, Verteilung
keywords.en: normal distribution, bell curve, Gaussian, standard deviation, sigma, statistics, distribution
keywords.es: distribución normal, campana de Gauss, desviación típica, sigma, estadística, distribución
keywords.it: distribuzione normale, curva a campana, gaussiana, deviazione standard, sigma, statistica
keywords.fr: loi normale, courbe en cloche, gaussienne, écart-type, sigma, statistique, distribution

[Shape]
Width = 100 mm
Width.us = 4 in
Height = 50 mm
Height.us = 2 in

[User]
# das Band unten für die Beschriftungen, die Höhe der Kurvenfläche
MB:  Value = 7 mm
     Value.us = 0.3 in
CH:  Value = Height-User.MB

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = User.MB+User.CH*0.05; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = User.MB+User.CH*0.05; DirX = 1; DirY = 0

