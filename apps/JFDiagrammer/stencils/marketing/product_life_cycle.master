# Produktlebenszyklus (SH-030, JD26, in Visio „PLZ“): Achsen Umsatz und Zeit mit offenen Spitzen,
# die typische Kurve (langsamer Anstieg, steiles Wachstum, Gipfel in der Reife, Rückgang) als
# Polylinie aus 49 Punkten (vier kubische Stücke, im Skript ausgewertet, als Anteile der
# Kurvenfläche), die Grenzen der vier gleich breiten Phasen als gestrichelte Linien (LinePattern
# 2: Ausnahme, damit sie sich von der Kurve abheben) und die Phasentexte Einführung, Wachstum,
# Reife, Rückgang in einem Band über der Kurve.  Achsen, Kurve und Grenzen sind Teile in der
# Formatvorlage Connector ohne deren Pfeilspitzen (sichtbar auch in Designs ohne Shape-Linien),
# alle Texte Teile in Text Only.  Alle Teile folgen der Größe der Gruppe.
master: Product life cycle
name.de: Produktlebenszyklus
name.en: Product life cycle
name.es: Ciclo de vida del producto
name.it: Ciclo di vita del prodotto
name.fr: Cycle de vie du produit
prompt.de: Umsatzkurve eines Produkts über die Zeit mit den Phasen Einführung, Wachstum, Reife und Rückgang. Klicken Sie eine Beschriftung zweimal an, um ihren Text zu ändern.
prompt.en: Sales curve of a product over time with the phases introduction, growth, maturity and decline. Click a label twice to change its text.
prompt.es: Curva de ventas de un producto en el tiempo con las fases introducción, crecimiento, madurez y declive. Haga clic dos veces en una etiqueta para cambiar su texto.
prompt.it: Curva delle vendite di un prodotto nel tempo con le fasi introduzione, crescita, maturità e declino. Fai clic due volte su un'etichetta per cambiarne il testo.
prompt.fr: Courbe des ventes d'un produit dans le temps avec les phases lancement, croissance, maturité et déclin. Cliquez deux fois sur une étiquette pour modifier son texte.
keywords.de: Produktlebenszyklus, PLZ, Lebenszyklus, Umsatz, Einführung, Wachstum, Reife, Rückgang
keywords.en: product life cycle, PLC, life cycle, sales, introduction, growth, maturity, decline
keywords.es: ciclo de vida, producto, ventas, introducción, crecimiento, madurez, declive
keywords.it: ciclo di vita, prodotto, vendite, introduzione, crescita, maturità, declino
keywords.fr: cycle de vie, produit, ventes, lancement, croissance, maturité, déclin

[Shape]
Width = 130 mm
Width.us = 5.25 in
Height = 70 mm
Height.us = 2.75 in

[User]
# die Ränder links (Text Umsatz), unten (Text Zeit) und rechts (für die Pfeilspitze), das Band oben
# für die Phasentexte, die Länge der Pfeilspitzen; Breite der Phasen zusammen, Höhe der
# Kurvenfläche
ML:  Value = 8 mm
     Value.us = 0.3 in
MB:  Value = 8 mm
     Value.us = 0.3 in
MR:  Value = 4 mm
     Value.us = 0.15 in
TB:  Value = 8 mm
     Value.us = 0.3 in
L:   Value = 3 mm
     Value.us = 0.12 in
PW:  Value = Width-User.ML-User.MR
CH:  Value = Height-User.MB-User.TB

[Connection]
Row  X = User.ML+User.PW*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = User.MB+User.CH*0.5; DirX = -1; DirY = 0
Row  X = User.ML+User.PW*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = User.MB+User.CH*0.5; DirX = 1; DirY = 0

# die Grenzen der Phasen, gestrichelt
[Part Borders]
style: Connector

[Shape]
BeginArrow = 0
EndArrow = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3
LinePattern = 2

[Geometry]
NoFill = TRUE
MoveTo  X = Sheet.1!User.ML+Sheet.1!User.PW*0.25; Y = Sheet.1!User.MB
LineTo  X = Sheet.1!User.ML+Sheet.1!User.PW*0.25; Y = Height

[Geometry]
NoFill = TRUE
MoveTo  X = Sheet.1!User.ML+Sheet.1!User.PW*0.5; Y = Sheet.1!User.MB
LineTo  X = Sheet.1!User.ML+Sheet.1!User.PW*0.5; Y = Height

[Geometry]
NoFill = TRUE
MoveTo  X = Sheet.1!User.ML+Sheet.1!User.PW*0.75; Y = Sheet.1!User.MB
LineTo  X = Sheet.1!User.ML+Sheet.1!User.PW*0.75; Y = Height

# die Kurve in ihrer Fläche (Anteile von Breite und Höhe)
[Part Curve]
style: Connector

[Shape]
Width = GUARD(Sheet.1!User.PW)
Height = GUARD(Sheet.1!User.CH)
PinX = GUARD(Sheet.1!User.ML+Width*0.5)
PinY = GUARD(Sheet.1!User.MB+Height*0.5)
BeginArrow = 0
EndArrow = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3

