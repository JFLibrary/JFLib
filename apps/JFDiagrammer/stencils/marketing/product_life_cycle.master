QuickStyleType = 3

[Geometry]
NoFill = TRUE
MoveTo  X = Sheet.1!User.ML; Y = Height
LineTo  X = Sheet.1!User.ML; Y = Sheet.1!User.MB
LineTo  X = Width; Y = Sheet.1!User.MB
MoveTo  X = Width-Sheet.1!User.L; Y = Sheet.1!User.MB+Sheet.1!User.L*0.5
