# die waagrechte Achse unter den Vorderseiten: der Pfeil oben im Rand, der Text darunter
[Part AX]
text.de: x-Achse
text.en: x axis
text.es: Eje x
text.it: Asse x
text.fr: Axe x
style: Connector

[Shape]
Width = GUARD(Sheet.1!Width-Sheet.1!User.M-Sheet.1!User.D)
Height = GUARD(Sheet.1!User.M)
PinX = GUARD(Sheet.1!User.M+Width*0.5)
PinY = GUARD(Height*0.5)
TxtPinX = Width*0.5
TxtPinY = Height*0.35
TxtWidth = Width
TxtHeight = Height*0.6
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
BeginArrow = 0
EndArrow = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.8
LineTo  X = Width; Y = Height*0.8
MoveTo  X = Width-Height*0.25; Y = Height*0.92
LineTo  X = Width; Y = Height*0.8
LineTo  X = Width-Height*0.25; Y = Height*0.68

# die senkrechte Achse links der Vorderseiten: der Pfeil rechts im Rand, der Text links davon, um 90° gedreht
[Part AY]
text.de: y-Achse
text.en: y axis
text.es: Eje y
text.it: Asse y
text.fr: Axe y
style: Connector

[Shape]
Width = GUARD(Sheet.1!User.M)
Height = GUARD(Sheet.1!Height-Sheet.1!User.M-Sheet.1!User.D)
PinX = GUARD(Width*0.5)
PinY = GUARD(Sheet.1!User.M+Height*0.5)
TxtPinX = Width*0.35
TxtPinY = Height*0.5
TxtWidth = Height
TxtHeight = Width*0.6
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
TxtAngle = 90 deg
BeginArrow = 0
EndArrow = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3

[Geometry]
NoFill = TRUE
MoveTo  X = Width*0.8; Y = 0
LineTo  X = Width*0.8; Y = Height
MoveTo  X = Width*0.68; Y = Height-Width*0.25
LineTo  X = Width*0.8; Y = Height
LineTo  X = Width*0.92; Y = Height-Width*0.25
