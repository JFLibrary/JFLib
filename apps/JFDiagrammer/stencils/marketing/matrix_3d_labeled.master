# 3D-Matrix mit Beschriftungen (SH-030, JD26): wie die 3D-Matrix (vier Blöcke mit Tiefe, je
# Vorderseite mit Text, Deckel und rechte Seite schattiert über TINT/SHADE der Designfarbe), dazu
# links und unten ein Rand von User.M für die Achsen: je ein Pfeil (offene Spitze) mit Text, der
# senkrechte um 90° gedreht, beide in der Formatvorlage Connector ohne deren Pfeilspitzen
# (sichtbar auch in Designs ohne Shape-Linien).  Row_1 an der hinteren linken Ecke ändert die
# Tiefe (Abstand vom linken Rand des Felds).  Rounding 0 an allen Flächen: in den abgerundeten
# Design-Varianten würde jede Fläche für sich gerundet und die Blöcke fielen auseinander.
master: 3-D matrix with labels
name.de: 3D-Matrix mit Beschriftungen
name.en: 3-D matrix with labels
name.es: Matriz 3D con etiquetas
name.it: Matrice 3D con etichette
name.fr: Matrice 3D avec étiquettes
prompt.de: Vierfeldermatrix aus Blöcken mit Tiefe und beschrifteten Achsen. Mit dem gelben Steuerpunkt ändern Sie die Tiefe.
prompt.en: Four-field matrix of blocks with depth and labelled axes. Drag the yellow control handle to change the depth.
prompt.es: Matriz de cuatro bloques con profundidad y ejes etiquetados. Arrastre el controlador amarillo para cambiar la profundidad.
prompt.it: Matrice a quattro blocchi con profondità e assi etichettati. Trascina la maniglia di controllo gialla per cambiare la profondità.
prompt.fr: Matrice de quatre blocs avec profondeur et axes étiquetés. Faites glisser la poignée de contrôle jaune pour modifier la profondeur.
keywords.de: Matrix, 3D, Vierfeldermatrix, Achsen, Portfolio, Quadrant, Beschriftung
keywords.en: matrix, 3D, four-field matrix, axes, portfolio, quadrant, labels
keywords.es: matriz, 3D, cuatro campos, ejes, cartera, cuadrante, etiquetas
keywords.it: matrice, 3D, quattro campi, assi, portafoglio, quadrante, etichette
keywords.fr: matrice, 3D, quatre champs, axes, portefeuille, quadrant, étiquettes

[Shape]
Width = 80 mm
Width.us = 3 in
Height = 70 mm
Height.us = 2.75 in

[User]
# der Rand für die Achsen, der Abstand der Blöcke, die Tiefe, Breite und Höhe einer Vorderseite
M:   Value = 12 mm
     Value.us = 0.5 in
G:   Value = 2 mm
     Value.us = 0.08 in
D:   Value = MIN(MAX(Controls.Row_1-User.M,0),(Width-User.M)*0.25,(Height-User.M)*0.25)
QW:  Value = (Width-User.M-User.D-User.G)*0.5
QH:  Value = (Height-User.M-User.D-User.G)*0.5

[Controls]
Row_1:  X = 17 mm; Y = Height
        X.us = 0.7 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 2; YCon = 1; CanGlue = FALSE
        Tip.de = "Tiefe ändern"
        Tip.en = "Change the depth"
        Tip.es = "Cambiar la profundidad"
        Tip.it = "Cambia la profondità"
        Tip.fr = "Modifier la profondeur"

[Connection]
Row  X = User.M+(Width-User.M-User.D)*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = User.M+(Height-User.M+User.D)*0.5; DirX = -1; DirY = 0
Row  X = User.M+(Width-User.M+User.D)*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = User.M+(Height-User.M-User.D)*0.5; DirX = 1; DirY = 0

# Block 3: Deckel, rechte Seite, Vorderseite
[Part Q3T]

[User]
Bx:  Value = Sheet.1!User.M
By:  Value = Sheet.1!User.M+Sheet.1!User.QH

[Shape]
FillForegnd = THEMEGUARD(TINT(THEMEVAL("FillColor"),40))
Rounding = 0 mm

[Geometry]
MoveTo  X = User.Bx; Y = User.By
LineTo  X = User.Bx+Sheet.1!User.QW; Y = User.By
LineTo  X = User.Bx+Sheet.1!User.QW+Sheet.1!User.D; Y = User.By+Sheet.1!User.D
LineTo  X = User.Bx+Sheet.1!User.D; Y = User.By+Sheet.1!User.D
LineTo  X = User.Bx; Y = User.By

[Part Q3S]

[User]
Bx:  Value = Sheet.1!User.M+Sheet.1!User.QW
By:  Value = Sheet.1!User.M

[Shape]
FillForegnd = THEMEGUARD(SHADE(THEMEVAL("FillColor"),50))
Rounding = 0 mm

[Geometry]
MoveTo  X = User.Bx; Y = User.By
LineTo  X = User.Bx+Sheet.1!User.D; Y = User.By+Sheet.1!User.D
LineTo  X = User.Bx+Sheet.1!User.D; Y = User.By+Sheet.1!User.QH+Sheet.1!User.D
LineTo  X = User.Bx; Y = User.By+Sheet.1!User.QH
LineTo  X = User.Bx; Y = User.By

[Part Q3]
text.de: Feld 3
text.en: Field 3
text.es: Campo 3
text.it: Campo 3
text.fr: Champ 3

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Sheet.1!User.M+Width*0.5)
PinY = GUARD(Sheet.1!User.M+Height*0.5)
Rounding = 0 mm

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = 0; Y = 0

