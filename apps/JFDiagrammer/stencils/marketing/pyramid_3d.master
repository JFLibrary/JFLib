LineTo  X = Sheet.1!User.Wf+User.T0*(Width*0.5-Sheet.1!User.Wf); Y = Height*User.T0

# Ebene 2 (von oben): Vorderseite, dann Seitenfläche; verborgen unter 2 Ebenen
[Part L2]
text.de: Ebene 2
text.en: Level 2
text.es: Nivel 2
text.it: Livello 2
text.fr: Niveau 2

[User]
# die Ebene, an deren Stelle das Teil liegt, Unter- und Oberkante als Anteil t der Kanten
K:   Value = MIN(2,Sheet.1!User.N)
T0:  Value = IF(User.K>=Sheet.1!User.N,0,1-User.K/Sheet.1!User.N+Sheet.1!User.Gp*0.5/Height)
T1:  Value = IF(User.K<=1,1,1-(User.K-1)/Sheet.1!User.N-Sheet.1!User.Gp*0.5/Height)
# die Höhe des Texts: Mitte der Ebene, in der Spitze tiefer
Tt:  Value = User.T0+(User.T1-User.T0)*IF(User.K<=1,0.35,0.5)

[Shape]
HideText = 2>Sheet.1!User.N
QuickStyleLineColor = 101
QuickStyleFillColor = 101
Rounding = 0 mm
TxtPinX = (Sheet.1!User.Wf*(1-User.Tt)+Width*User.Tt)*0.5
TxtPinY = Height*User.Tt
TxtWidth = MAX(Sheet.1!User.Wf*(1-User.Tt),18 mm)
TxtHeight = Height*(User.T1-User.T0)
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
TxtWidth.us = MAX(Sheet.1!User.Wf*(1-User.Tt),0.7 in)

[Geometry]
NoShow = 2>Sheet.1!User.N
MoveTo  X = Width*0.5*User.T0; Y = Height*User.T0
LineTo  X = Sheet.1!User.Wf+User.T0*(Width*0.5-Sheet.1!User.Wf); Y = Height*User.T0
LineTo  X = Sheet.1!User.Wf+User.T1*(Width*0.5-Sheet.1!User.Wf); Y = Height*User.T1
LineTo  X = Width*0.5*User.T1; Y = Height*User.T1
LineTo  X = Width*0.5*User.T0; Y = Height*User.T0

[Part L2S]

[User]
K:   Value = MIN(2,Sheet.1!User.N)
T0:  Value = IF(User.K>=Sheet.1!User.N,0,1-User.K/Sheet.1!User.N+Sheet.1!User.Gp*0.5/Height)
T1:  Value = IF(User.K<=1,1,1-(User.K-1)/Sheet.1!User.N-Sheet.1!User.Gp*0.5/Height)

