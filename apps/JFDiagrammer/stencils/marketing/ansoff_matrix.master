# Ansoff-Matrix (SH-030, JD26): die Produkt-Markt-Matrix als Gruppe.  Vier Felder mit 2 mm Abstand
# und je einer Variantenfarbe des Designs (Schnellformatvorlage 100 bis 103): unten links
# Marktdurchdringung (bestehende Produkte, bestehende Märkte), unten rechts Produktentwicklung,
# oben links Marktentwicklung, oben rechts Diversifikation; der Ursprung (bestehend/bestehend)
# liegt also unten links wie bei Achsen üblich.  Im Rand unten die Achse Produkte (Spaltentexte
# bestehend/neu, darunter der Achsentitel), im Rand links die Achse Märkte (Zeilentexte und
# Titel um 90° gedreht).  Die Beschriftungen sind Teile in der Formatvorlage Text Only (dunkler
# Text in allen Designs).  Alle Teile folgen der Größe der Gruppe.
master: Ansoff matrix
name.de: Ansoff-Matrix
name.en: Ansoff matrix
name.es: Matriz de Ansoff
name.it: Matrice di Ansoff
name.fr: Matrice d'Ansoff
prompt.de: Produkt-Markt-Matrix nach Ansoff mit den vier Wachstumsstrategien. Klicken Sie ein Feld oder eine Beschriftung zweimal an, um den Text zu ändern.
prompt.en: Ansoff product-market matrix with the four growth strategies. Click a field or a label twice to change its text.
prompt.es: Matriz producto-mercado de Ansoff con las cuatro estrategias de crecimiento. Haga clic dos veces en un campo o una etiqueta para cambiar el texto.
prompt.it: Matrice prodotto-mercato di Ansoff con le quattro strategie di crescita. Fai clic due volte su un campo o un'etichetta per cambiarne il testo.
prompt.fr: Matrice produit-marché d'Ansoff avec les quatre stratégies de croissance. Cliquez deux fois sur un champ ou une étiquette pour modifier le texte.
keywords.de: Ansoff, Produkt-Markt-Matrix, Wachstumsstrategie, Marktdurchdringung, Produktentwicklung, Marktentwicklung, Diversifikation
keywords.en: Ansoff, product-market matrix, growth strategy, market penetration, product development, market development, diversification
keywords.es: Ansoff, matriz producto-mercado, estrategia de crecimiento, penetración de mercado, desarrollo de productos, diversificación
keywords.it: Ansoff, matrice prodotto-mercato, strategia di crescita, penetrazione del mercato, sviluppo del prodotto, diversificazione
keywords.fr: Ansoff, matrice produit-marché, stratégie de croissance, pénétration du marché, développement de produits, diversification

[Shape]
Width = 110 mm
Width.us = 4.25 in
Height = 80 mm
Height.us = 3 in

[User]
# die Ränder links und unten für die Beschriftungen, der Abstand der Felder, Breite und Höhe
# eines Felds
ML:  Value = 16 mm
     Value.us = 0.6 in
MB:  Value = 14 mm
     Value.us = 0.55 in
G:   Value = 2 mm
     Value.us = 0.08 in
QW:  Value = (Width-User.ML-User.G)*0.5
QH:  Value = (Height-User.MB-User.G)*0.5

[Connection]
Row  X = User.ML+(Width-User.ML)*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = User.MB+(Height-User.MB)*0.5; DirX = -1; DirY = 0
Row  X = User.ML+(Width-User.ML)*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = User.MB+(Height-User.MB)*0.5; DirX = 1; DirY = 0

[Part Q1]
text.de: Marktentwicklung
text.en: Market development
text.es: Desarrollo de mercados
text.it: Sviluppo del mercato
text.fr: Développement de marchés

[Shape]
Width = GUARD(Sheet.1!User.QW)
Height = GUARD(Sheet.1!User.QH)
PinX = GUARD(Sheet.1!User.ML+Width*0.5)
PinY = GUARD(Sheet.1!Height-Height*0.5)
QuickStyleLineColor = 102
QuickStyleFillColor = 102

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
