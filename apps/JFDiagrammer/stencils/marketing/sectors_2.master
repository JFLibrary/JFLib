# Sektoren 2 (SH-030, JD26): ein Ring aus zwei bis acht gleichen Sektoren um eine Mitte.  Die Zahl
# steht in den Shape-Daten (Prop.Sectors); Sektor 1 beginnt oben, die übrigen folgen im
# Uhrzeigersinn.  Jeder Sektor ist ein Teil mit eigenem Text und Variantenfarbe (100 bis 105,
# dann 101, 102: Nachbarn nie gleich), die Mitte ein Teil mit Text in der siebten Variantenfarbe
# (106).  Zwischen den Sektoren und zur Mitte 1 mm Fuge: die Kanten sind um die halbe Fuge
# parallel verschoben (die Bögen beginnen um ASIN(Fuge/Radius) später), so bleibt die Fuge überall
# gleich breit (sichtbar auch in Designs ohne Shape-Linien).  Sektoren über der Zahl liegen
# verborgen (NoShow, HideText) deckungsgleich unter dem letzten (die Teile stehen von hinten nach
# vorn in der Datei).  Anders als Sektoren 1 (voller Kreis) ein Ring mit Mitte.
master: Sectors 2
name.de: Sektoren 2
name.en: Sectors 2
name.es: Sectores 2
name.it: Settori 2
name.fr: Secteurs 2
prompt.de: Ring aus Sektoren um eine Mitte, jeder Sektor mit eigenem Text. Die Zahl der Sektoren stellen Sie in den Shape-Daten ein.
prompt.en: Ring of sectors around a centre, each sector with its own text. Set the number of sectors in the shape data.
prompt.es: Anillo de sectores alrededor de un centro, cada sector con su propio texto. Defina el número de sectores en los datos de la forma.
prompt.it: Anello di settori attorno a un centro, ogni settore con il proprio testo. Imposta il numero di settori nei dati della forma.
prompt.fr: Anneau de secteurs autour d'un centre, chaque secteur avec son propre texte. Définissez le nombre de secteurs dans les données de la forme.
keywords.de: Sektoren, Ring, Kreis, Segmente, Mitte, Bestandteile, Kreislauf
keywords.en: sectors, ring, circle, segments, centre, components, cycle
keywords.es: sectores, anillo, círculo, segmentos, centro, componentes
keywords.it: settori, anello, cerchio, segmenti, centro, componenti
keywords.fr: secteurs, anneau, cercle, segments, centre, composantes

[Shape]
Width = 60 mm
Width.us = 2.5 in
Height = 60 mm
Height.us = 2.5 in

[User]
# die Zahl der Sektoren (2 bis 8), der Winkel je Sektor, die halbe Fuge als Anteil des Radius
N:   Value = MIN(MAX(ROUND(Prop.Sectors,0),2),8)
S:   Value = 2*PI()/User.N
Gp:  Value = 1 mm
     Value.us = 0.04 in
Gn:  Value = User.Gp/Width
# Innenradius des Rings und Radius der Mitte (Anteile des Radius), Radius der Texte
Ri:  Value = 0.5
Rc:  Value = User.Ri-2*User.Gn
Rt:  Value = (1+User.Ri)*0.5

[Property]
Sectors:  Type = 2; Format = "0"; Value = 4
          Label.de = Sektoren
          Label.en = Sectors
          Label.es = Sectores
          Label.it = Settori
          Label.fr = Secteurs
          Prompt.de = Anzahl der Sektoren (2 bis 8)
          Prompt.en = Number of sectors (2 to 8)
          Prompt.es = Número de sectores (de 2 a 8)
          Prompt.it = Numero di settori (da 2 a 8)
          Prompt.fr = Nombre de secteurs (de 2 à 8)

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0

# Sektor 8: sichtbar ab 8 Sektoren; sonst deckungsgleich mit dem letzten, verborgen
[Part S8]
text.de: Sektor 8
text.en: Sector 8
text.es: Sector 8
text.it: Settore 8
text.fr: Secteur 8

[User]
# der Sektor, an dessen Stelle das Teil liegt; Anfang, Ende, Mitte und halber Winkel (Bogenmaß)
K:   Value = MIN(8,Sheet.1!User.N)
As:  Value = PI()*0.5-(User.K-1)*Sheet.1!User.S
Ae:  Value = User.As-Sheet.1!User.S
Am:  Value = (User.As+User.Ae)*0.5
H:   Value = Sheet.1!User.S*0.5

[Shape]
HideText = 8>Sheet.1!User.N
QuickStyleLineColor = 102
QuickStyleFillColor = 102
TxtPinX = Width*0.5*(1+Sheet.1!User.Rt*COS(User.Am))
TxtPinY = Height*0.5*(1+Sheet.1!User.Rt*SIN(User.Am))
TxtWidth = Width*0.37
TxtHeight = Height*0.5*(1-Sheet.1!User.Ri)*0.8
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[Geometry]
NoShow = 8>Sheet.1!User.N
MoveTo           X = Width*0.5*(1+1*COS(User.As-ASIN(Sheet.1!User.Gn))); Y = Height*0.5*(1+1*SIN(User.As-ASIN(Sheet.1!User.Gn)))
EllipticalArcTo  X = Width*0.5*(1+1*COS(User.Ae+ASIN(Sheet.1!User.Gn))); Y = Height*0.5*(1+1*SIN(User.Ae+ASIN(Sheet.1!User.Gn)))
                 A = Width*0.5*(1+1*COS(User.Am)); B = Height*0.5*(1+1*SIN(User.Am)); C = 0 deg; D = Width/Height
LineTo           X = Width*0.5*(1+Sheet.1!User.Ri*COS(User.Ae+ASIN(Sheet.1!User.Gn/Sheet.1!User.Ri))); Y = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.Ae+ASIN(Sheet.1!User.Gn/Sheet.1!User.Ri)))
EllipticalArcTo  X = Width*0.5*(1+Sheet.1!User.Ri*COS(User.As-ASIN(Sheet.1!User.Gn/Sheet.1!User.Ri))); Y = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.As-ASIN(Sheet.1!User.Gn/Sheet.1!User.Ri)))
                 A = Width*0.5*(1+Sheet.1!User.Ri*COS(User.Am)); B = Height*0.5*(1+Sheet.1!User.Ri*SIN(User.Am)); C = 0 deg; D = Width/Height
LineTo           X = Geometry1.X1; Y = Geometry1.Y1

