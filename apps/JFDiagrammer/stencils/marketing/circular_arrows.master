                 A = Width*0.5*(1+User.Ro*COS(User.Am)); B = Height*0.5*(1+User.Ro*SIN(User.Am)); C = 0 deg; D = Width/Height
LineTo           X = Width*0.5*(1+User.Ho*COS(User.Ah)); Y = Height*0.5*(1+User.Ho*SIN(User.Ah))
LineTo           X = Width*0.5*(1+Sheet.1!User.Rm*COS(User.A1)); Y = Height*0.5*(1+Sheet.1!User.Rm*SIN(User.A1))
LineTo           X = Width*0.5*(1+User.Hi*COS(User.Ah)); Y = Height*0.5*(1+User.Hi*SIN(User.Ah))
LineTo           X = Width*0.5*(1+User.Ri*COS(User.Ah)); Y = Height*0.5*(1+User.Ri*SIN(User.Ah))
EllipticalArcTo  X = Width*0.5*(1+User.Ri*COS(User.A0)); Y = Height*0.5*(1+User.Ri*SIN(User.A0))
                 A = Width*0.5*(1+User.Ri*COS(User.Am)); B = Height*0.5*(1+User.Ri*SIN(User.Am)); C = 0 deg; D = Width/Height
LineTo           X = Geometry1.X1; Y = Geometry1.Y1

