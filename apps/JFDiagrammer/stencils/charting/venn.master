# Venn-Diagramm (SH-004, JD26): ein Kreis (gestreckt eine Ellipse) für Mengendiagramme, zu 35 %
# durchscheinend: legt man mehrere übereinander, bleiben die Überlappungen sichtbar (Ausnahme von
# der Stilregel wie bei venn/venn_3.master: ohne Durchsicht verdeckte der obere Kreis die
# Überlappung).  Farbe aus dem Design.  Keine Steuerpunkte; der Text steht in der Mitte.  Kopie
# in venn (venn/venn.master), gleich halten.
master: Venn diagram
name.de: Venn-Diagramm
name.en: Venn diagram
name.es: Diagrama de Venn
name.it: Diagramma di Venn
name.fr: Diagramme de Venn
prompt.de: Durchscheinender Kreis für Mengendiagramme. Legen Sie mehrere Kreise übereinander, um Schnittmengen zu zeigen.
prompt.en: Translucent circle for set diagrams. Place several circles on top of each other to show intersections.
prompt.es: Círculo translúcido para diagramas de conjuntos. Superponga varios círculos para mostrar intersecciones.
prompt.it: Cerchio traslucido per diagrammi degli insiemi. Sovrapponi più cerchi per mostrare le intersezioni.
prompt.fr: Cercle translucide pour les diagrammes d'ensembles. Superposez plusieurs cercles pour montrer les intersections.
keywords.de: Venn, Menge, Kreis, Mengendiagramm, Schnittmenge, Überlappung, durchscheinend
keywords.en: Venn, set, circle, set diagram, intersection, overlap, translucent
keywords.es: Venn, conjunto, círculo, diagrama de conjuntos, intersección, superposición, translúcido
keywords.it: Venn, insieme, cerchio, diagramma degli insiemi, intersezione, sovrapposizione, traslucido
keywords.fr: Venn, ensemble, cercle, diagramme d'ensembles, intersection, chevauchement, translucide

[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 30 mm
Height.us = 1.25 in
FillForegndTrans = 35%

[Geometry]
Ellipse  X = Width*0.5; Y = Height*0.5; A = Width; B = Height*0.5; C = Width*0.5; D = Height

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
