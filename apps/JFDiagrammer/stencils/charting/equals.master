# Gleichheitszeichen (SH-004, JD26): das Gleichheitszeichen nach DIN 1302 / ISO 80000-2 (=): zwei
# waagrechte Balken, genau die des Ungleichheitszeichens (not_equal.master) ohne den
# Schrägstrich: gleiche Länge, Strichstärke und gleicher Abstand.  Zwei getrennte Flächen.
# Row_1 auf der Oberkante des oberen Balkens ändert die Strichstärke (anteilig, nur senkrecht);
# der Abstand der Balken bleibt.
master: Equals sign
name.de: Gleichheitszeichen
name.en: Equals sign
name.es: Signo igual
name.it: Segno di uguale
name.fr: Signe égal
prompt.de: Gleichheitszeichen (=). Mit dem gelben Steuerpunkt ändern Sie die Strichstärke.
prompt.en: Equals sign (=). Drag the yellow control handle to change the stroke width.
prompt.es: Signo igual (=). Arrastre el controlador amarillo para cambiar el grosor del trazo.
prompt.it: Segno di uguale (=). Trascina la maniglia di controllo gialla per cambiare lo spessore del tratto.
prompt.fr: Signe égal (=). Faites glisser la poignée de contrôle jaune pour modifier l'épaisseur du trait.
keywords.de: gleich, Gleichheitszeichen, Gleichung, Rechenzeichen, Mathematik, Vergleich, Symbol
keywords.en: equals, equals sign, equation, operator, math, comparison, symbol
keywords.es: igual, signo igual, ecuación, operador, matemáticas, comparación, símbolo
keywords.it: uguale, segno di uguale, equazione, operatore, matematica, confronto, simbolo
keywords.fr: égal, signe égal, équation, opérateur, mathématiques, comparaison, symbole

[Shape]
Width = 20 mm
Width.us = 0.75 in
Height = 20 mm
Height.us = 0.75 in

[User]
# die Strichstärke, der halbe Abstand der Balken, ihre Kanten (unten, oben); wie not_equal.master
T:    Value = MIN(MAX(Controls.Row_1.Y-Height*0.58, Height*0.04), Height*0.25)
G:    Value = Height*0.08
Yb0:  Value = Height*0.5-User.G-User.T
Yb1:  Value = Height*0.5-User.G
Yt0:  Value = Height*0.5+User.G
Yt1:  Value = Height*0.5+User.G+User.T

# 1 der untere Balken
[Geometry]
MoveTo  X = Width*0.1; Y = User.Yb0
LineTo  X = Width*0.9; Y = User.Yb0
LineTo  X = Width*0.9; Y = User.Yb1
LineTo  X = Width*0.1; Y = User.Yb1
LineTo  X = Width*0.1; Y = User.Yb0

# 2 der obere Balken
[Geometry]
MoveTo  X = Width*0.1; Y = User.Yt0
LineTo  X = Width*0.9; Y = User.Yt0
LineTo  X = Width*0.9; Y = User.Yt1
LineTo  X = Width*0.1; Y = User.Yt1
LineTo  X = Width*0.1; Y = User.Yt0

[Controls]
Row_1:  X = Width*0.9; Y = Height*0.72
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Strichstärke ändern"
        Tip.en = "Change the stroke width"
        Tip.es = "Cambiar el grosor del trazo"
        Tip.it = "Cambia lo spessore del tratto"
        Tip.fr = "Modifier l'épaisseur du trait"

[Connection]
Row  X = Width*0.5; Y = User.Yb0; DirX = 0; DirY = 1
Row  X = Width*0.9; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = User.Yt1; DirX = 0; DirY = -1
Row  X = Width*0.1; Y = Height*0.5; DirX = 1; DirY = 0
