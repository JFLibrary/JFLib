# Minus (SH-004, JD26): das Minuszeichen nach DIN 1302 / ISO 80000-2 (−): ein waagrechter Balken
# in halber Höhe, so lang (80 % der Breite) und so dick wie die Balken des Ungleichheitszeichens
# (not_equal.master).  Row_1 an der rechten oberen Ecke ändert die Strichstärke (anteilig, nur
# senkrecht).
master: Minus
name.de: Minus
name.en: Minus
name.es: Menos
name.it: Meno
name.fr: Moins
prompt.de: Minuszeichen (−). Mit dem gelben Steuerpunkt ändern Sie die Strichstärke.
prompt.en: Minus sign (−). Drag the yellow control handle to change the stroke width.
prompt.es: Signo menos (−). Arrastre el controlador amarillo para cambiar el grosor del trazo.
prompt.it: Segno meno (−). Trascina la maniglia di controllo gialla per cambiare lo spessore del tratto.
prompt.fr: Signe moins (−). Faites glisser la poignée de contrôle jaune pour modifier l'épaisseur du trait.
keywords.de: minus, Minuszeichen, Subtraktion, Rechenzeichen, Mathematik, Symbol, abziehen
keywords.en: minus, minus sign, subtraction, operator, math, symbol, subtract
keywords.es: menos, signo menos, resta, operador, matemáticas, símbolo
keywords.it: meno, segno meno, sottrazione, operatore, matematica, simbolo
keywords.fr: moins, signe moins, soustraction, opérateur, mathématiques, symbole

[Shape]
Width = 20 mm
Width.us = 0.75 in
Height = 20 mm
Height.us = 0.75 in

[User]
# die Strichstärke (wie not_equal.master: 4 bis 25 % der Höhe), ihre Hälfte
T:  Value = MIN(MAX((Controls.Row_1.Y-Height*0.5)*2, Height*0.04), Height*0.25)
H:  Value = User.T*0.5

[Geometry]
MoveTo  X = Width*0.1; Y = Height*0.5-User.H
LineTo  X = Width*0.9; Y = Height*0.5-User.H
LineTo  X = Width*0.9; Y = Height*0.5+User.H
LineTo  X = Width*0.1; Y = Height*0.5+User.H
LineTo  X = Width*0.1; Y = Height*0.5-User.H

[Controls]
Row_1:  X = Width*0.9; Y = Height*0.57
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Strichstärke ändern"
        Tip.en = "Change the stroke width"
        Tip.es = "Cambiar el grosor del trazo"
        Tip.it = "Cambia lo spessore del tratto"
        Tip.fr = "Modifier l'épaisseur du trait"

[Connection]
Row  X = Width*0.5; Y = Height*0.5-User.H; DirX = 0; DirY = 1
Row  X = Width*0.9; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height*0.5+User.H; DirX = 0; DirY = -1
Row  X = Width*0.1; Y = Height*0.5; DirX = 1; DirY = 0
