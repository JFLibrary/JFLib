# 1D-Pfeil: ein flächiger Pfeil als 1D-Shape (README: 1D-Shapes).  Er liegt auf der Linie vom
# Anfang zum Ende und dreht sich mit ihr (PinX, Width, Angle aus den Enden); die Enden kleben an
# Shapes, mit GlueType 2 auch an das ganze Shape.  Die Dicke ist Height.  Row_1 an der oberen
# Ecke der Spitze ändert ihre Länge (Abstand vom Ende: die Spitze bleibt gleich lang, wenn der
# Pfeil länger wird), Row_2 an der Schaftkante die Dicke des Schafts.
master: 1-D arrow
name.de: 1D-Pfeil
name.en: 1-D arrow
name.es: Flecha 1D
name.it: Freccia 1D
name.fr: Flèche 1D
prompt.de: Flächiger Pfeil, dessen Enden an Shapes kleben. Spitze und Schaft ändern Sie mit den gelben Steuerpunkten.
prompt.en: Flat arrow whose ends glue to shapes. Drag the yellow control handles to change the head and the shaft.
prompt.es: Flecha plana cuyos extremos se pegan a las formas. Arrastre los controladores amarillos para cambiar la punta y el cuerpo.
prompt.it: Freccia piatta le cui estremità si incollano alle forme. Trascina le maniglie di controllo gialle per cambiare la punta e il corpo.
prompt.fr: Flèche pleine dont les extrémités se collent aux formes. Faites glisser les poignées de contrôle jaunes pour modifier la pointe et le corps.
keywords.de: Pfeil, 1D, Blockpfeil, Verbindung, kleben, Richtung, Fluss
keywords.en: arrow, 1-D, block arrow, connection, glue, direction, flow
keywords.es: flecha, 1D, flecha de bloque, conexión, pegar, dirección, flujo
keywords.it: freccia, 1D, freccia a blocco, collegamento, incollare, direzione, flusso
keywords.fr: flèche, 1D, flèche pleine, connexion, coller, direction, flux

[Shape]
BeginX = 0 mm
BeginY = 5 mm
BeginY.us = 0.1875 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 5 mm
EndY.us = 0.1875 in
Height = 10 mm
Height.us = 0.375 in
GlueType = 2
# Visio zeichnet ein 1D-Shape mit QuickStyleType 0 aus der Verbinder-Liste des Designs (graue
# Fläche, dunkle Linie); 2: aus der Shape-Liste wie in JFDiagrammer
QuickStyleType = 2

[User]
# die Länge der Spitze und der halbe Schaft
Hl:     Value = MIN(MAX(Width-Controls.Row_1, 0), Width)
Shaft:  Value = MIN(MAX(Controls.Row_2.Y-Height*0.5, 0), Height*0.5)

[Geometry]
MoveTo  X = 0; Y = Height*0.5-User.Shaft
LineTo  X = Width-User.Hl; Y = Height*0.5-User.Shaft
LineTo  X = Width-User.Hl; Y = 0
LineTo  X = Width; Y = Height*0.5
LineTo  X = Width-User.Hl; Y = Height
LineTo  X = Width-User.Hl; Y = Height*0.5+User.Shaft
LineTo  X = 0; Y = Height*0.5+User.Shaft
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Controls]
Row_1:  X = Width-8 mm; Y = Height
        X.us = Width-0.3 in
        XDyn = Controls.Row_1; YDyn = Controls.Row_1.Y
        XCon = 4; YCon = 1; CanGlue = FALSE
        Tip.de = "Länge der Spitze ändern"
        Tip.en = "Change the length of the head"
        Tip.es = "Cambiar la longitud de la punta"
        Tip.it = "Cambia la lunghezza della punta"
        Tip.fr = "Modifier la longueur de la pointe"
Row_2:  X = 0; Y = Height*0.75
        XDyn = Controls.Row_2; YDyn = Controls.Row_2.Y
        XCon = 1; YCon = 0; CanGlue = FALSE
        Tip.de = "Dicke des Schafts ändern"
        Tip.en = "Change the thickness of the shaft"
        Tip.es = "Cambiar el grosor del cuerpo"
        Tip.it = "Cambia lo spessore del corpo"
        Tip.fr = "Modifier l'épaisseur du corps"
