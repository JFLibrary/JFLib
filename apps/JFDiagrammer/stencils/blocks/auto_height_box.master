# Feld mit Auto-Höhe: ein Feld, dessen Höhe dem Text folgt.  Height ist eine Formel aus dem
# umbrochenen Text (TEXTHEIGHT mit der Breite des Felds, samt Textrand), mindestens 10 mm;
# GUARD und LockHeight halten sie fest, die Breite ändert der Nutzer, die Höhe folgt.  Keine
# Steuerpunkte; die Verbindungspunkte liegen in der Mitte jeder Seite.
master: Auto-height box
name.de: Feld mit Auto-Höhe
name.en: Auto-height box
name.es: Cuadro con alto automático
name.it: Riquadro ad altezza automatica
name.fr: Bloc à hauteur automatique
prompt.de: Block, dessen Höhe sich dem Text anpasst.
prompt.en: Block whose height adjusts to its text.
prompt.es: Bloque cuyo alto se ajusta al texto.
prompt.it: Blocco la cui altezza si adatta al testo.
prompt.fr: Bloc dont la hauteur s'adapte au texte.
keywords.de: Feld, Block, Auto-Höhe, automatische Höhe, Text, anpassen, wachsen
keywords.en: box, block, auto height, automatic height, text, fit, grow
keywords.es: cuadro, bloque, alto automático, altura automática, texto, ajustar, crecer
keywords.it: riquadro, blocco, altezza automatica, testo, adattare, crescere
keywords.fr: bloc, boîte, hauteur automatique, texte, ajuster, agrandir

[Shape]
Width = 40 mm
Width.us = 1.5 in
Height = GUARD(MAX(10 mm, TEXTHEIGHT(TheText,Width)))
Height.us = GUARD(MAX(0.375 in, TEXTHEIGHT(TheText,Width)))
LockHeight = TRUE
ShapeSplit = 1

[Geometry]
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = 0
LineTo  X = Width; Y = Height
LineTo  X = 0; Y = Height
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
