# Pfeil mit Endpunkten: eine gerade Linie als 1D-Shape (Height 0) mit Punkten an beiden Enden
# (BeginArrow und EndArrow 10, gefüllte Kreise) und einer Pfeilspitze in der Mitte, die die
# Richtung zeigt; sie liegt auf der Linie vom Anfang zum Ende und dreht sich mit ihr, die Enden
# kleben (GlueType 2 auch an das ganze Shape).  Abschnitte: 1 die erste Hälfte der Linie, 2 die
# Spitze als gefülltes Dreieck in der Linienfarbe (FillForegnd = LineColor, FillPattern 1),
# 3 die zweite Hälfte -- die Linienenden sitzen am Anfang des ersten und am Ende des letzten
# Abschnitts.  Formatvorlage "Connector"; der Text steht in der Mitte der Linie.
master: Arrow with endpoints
name.de: Pfeil mit Endpunkten
name.en: Arrow with endpoints
name.es: Flecha con puntos finales
name.it: Freccia con punti finali
name.fr: Flèche avec points d'extrémité
style: Connector
prompt.de: Linie mit Punkten an beiden Enden und einer Pfeilspitze in der Mitte, deren Enden an Shapes kleben.
prompt.en: Line with dots at both ends and an arrowhead in the middle whose ends glue to shapes.
prompt.es: Línea con puntos en ambos extremos y una punta de flecha en el centro cuyos extremos se pegan a las formas.
prompt.it: Linea con punti a entrambe le estremità e una punta di freccia al centro le cui estremità si incollano alle forme.
prompt.fr: Ligne avec des points aux deux extrémités et une pointe de flèche au milieu dont les extrémités se collent aux formes.
keywords.de: Linie, Pfeil, Punkte, Endpunkte, Richtung, Verbindung, Strecke
keywords.en: line, arrow, dots, end points, direction, connection, segment
keywords.es: línea, flecha, puntos, extremos, dirección, conexión, segmento
keywords.it: linea, freccia, punti, estremi, direzione, collegamento, segmento
keywords.fr: ligne, flèche, points, extrémités, direction, connexion, segment

[Shape]
BeginX = 0 mm
BeginY = 2.5 mm
BeginY.us = 0.1 in
EndX = 40 mm
EndX.us = 1.5 in
EndY = 2.5 mm
EndY.us = 0.1 in
Height = 0 mm
Height.us = 0 in
GlueType = 2
BeginArrow = 10
EndArrow = 10
FillForegnd = LineColor
FillPattern = 1
TxtWidth = 30 mm
TxtWidth.us = 1.25 in
TxtHeight = 8 mm
TxtHeight.us = 0.3 in
TxtPinX = Width*0.5
TxtPinY = Height*0.5
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5

[User]
# Länge und halbe Breite der Pfeilspitze in der Mitte
L:   Value = 3 mm
     Value.us = 0.12 in
Aw:  Value = 1.2 mm
     Value.us = 0.05 in

# 1 die erste Hälfte der Linie
[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5
LineTo  X = Width*0.5; Y = Height*0.5

# 2 die Pfeilspitze
[Geometry]
MoveTo  X = Width*0.5+User.L*0.5; Y = Height*0.5
LineTo  X = Width*0.5-User.L*0.5; Y = Height*0.5+User.Aw
LineTo  X = Width*0.5-User.L*0.5; Y = Height*0.5-User.Aw
LineTo  X = Geometry2.X1; Y = Geometry2.Y1

# 3 die zweite Hälfte der Linie
[Geometry]
NoFill = TRUE
MoveTo  X = Width*0.5; Y = Height*0.5
LineTo  X = Width; Y = Height*0.5
