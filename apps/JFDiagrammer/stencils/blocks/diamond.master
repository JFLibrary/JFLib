# Raute: ein Block in Rautenform, die Ecken in der Mitte der Seiten des Kastens; dort liegen
# auch die Verbindungspunkte.  Keine Steuerpunkte.
master: Diamond
name.de: Raute
name.en: Diamond
name.es: Rombo
name.it: Rombo
name.fr: Losange
prompt.de: Block in Rautenform mit Text für Blockdiagramme.
prompt.en: Diamond-shaped block with text for block diagrams.
prompt.es: Bloque en forma de rombo con texto para diagramas de bloques.
prompt.it: Blocco a forma di rombo con testo per diagrammi a blocchi.
prompt.fr: Bloc en forme de losange avec texte pour les diagrammes de blocs.
keywords.de: Raute, Rhombus, Block, Verzweigung, Entscheidung, Blockdiagramm
keywords.en: diamond, rhombus, block, branch, decision, block diagram
keywords.es: rombo, diamante, bloque, bifurcación, decisión, diagrama de bloques
keywords.it: rombo, diamante, blocco, diramazione, decisione, diagramma a blocchi
keywords.fr: losange, rhombe, bloc, embranchement, décision, diagramme de blocs

[Shape]
Width = 30 mm
Width.us = 1.25 in
Height = 30 mm
Height.us = 1.25 in
ShapeSplit = 1

[Geometry]
MoveTo  X = Width*0.5; Y = 0
LineTo  X = Width; Y = Height*0.5
LineTo  X = Width*0.5; Y = Height
LineTo  X = 0; Y = Height*0.5
LineTo  X = Geometry1.X1; Y = Geometry1.Y1

[Connection]
Row  X = Width*0.5; Y = 0; DirX = 0; DirY = 1
Row  X = Width; Y = Height*0.5; DirX = -1; DirY = 0
Row  X = Width*0.5; Y = Height; DirX = 0; DirY = -1
Row  X = 0; Y = Height*0.5; DirX = 1; DirY = 0
