# Sekundäre Ursache 1 (SH-041, JD26): eine kurze beschriftete Nebenlinie von links oben nach rechts
# unten, 45°; ihr Ende mit der Pfeilspitze des Designs (Formatvorlage Connector, wie
# primary_cause_1.master) klebt an einem Punkt einer primären Ursache.  Ein 1D-Shape mit aufrechtem
# Kasten (wie die Kategorien: Width = EndX-BeginX, Height = EndY-BeginY, Angle 0; lokal (0, 0) ist
# der Anfang), damit der Text waagrecht bleibt, gleich wie die Linie liegt: 30 x 5 mm mittig über
# dem Anfang, ohne den Texthintergrund der Formatvorlage (TextBkgnd 0).  Die sechs Varianten
# unterscheiden sich nur in der Lage der Enden.  Auf der Linie liegen 3 Verbindungspunkte (1/4 bis
# 3/4) für eine weitere Ebene von Ursachen (wie bei den Kategorien und primären Ursachen eine
# begründete Ausnahme von der Stilregel für 1D-Shapes).
master: Secondary cause 1
style: Connector
name.de: Sekundäre Ursache 1
name.en: Secondary cause 1
name.es: Causa secundaria 1
name.it: Causa secondaria 1
name.fr: Cause secondaire 1
text.de: Nebenursache
text.en: Sub-cause
text.es: Subcausa
text.it: Sottocausa
text.fr: Sous-cause
prompt.de: Nebenursache, die von links oben schräg (45°) auf eine Ursache zeigt; der Text steht über ihrem Anfang. Ziehen Sie ihr Ende auf die Linie einer primären Ursache.
prompt.en: Sub-cause that points from the upper left at 45° at a cause; the text is above its start. Drag its end onto the line of a primary cause.
prompt.es: Subcausa que apunta desde arriba a la izquierda a 45° a una causa; el texto está sobre su inicio. Arrastre su extremo sobre la línea de una causa primaria.
prompt.it: Sottocausa che punta dall'alto a sinistra a 45° verso una causa; il testo è sopra il suo inizio. Trascina la sua estremità sulla linea di una causa primaria.
prompt.fr: Sous-cause qui pointe depuis le haut à gauche à 45° vers une cause ; le texte est au-dessus de son début. Faites glisser son extrémité sur la ligne d'une cause primaire.
keywords.de: Nebenursache, sekundäre Ursache, Ursache, Ishikawa, Fischgräte, Unterursache
keywords.en: sub-cause, secondary cause, cause, Ishikawa, fishbone, factor
keywords.es: subcausa, causa secundaria, causa, Ishikawa, espina de pescado, factor
keywords.it: sottocausa, causa secondaria, causa, Ishikawa, lisca di pesce, fattore
keywords.fr: sous-cause, cause secondaire, cause, Ishikawa, arête de poisson, facteur

[Shape]
BeginX = 15 mm
BeginX.us = 0.6 in
BeginY = 18 mm
BeginY.us = 0.75 in
EndX = 27 mm
EndX.us = 1.1 in
EndY = 6 mm
EndY.us = 0.25 in
Width = GUARD(EndX-BeginX)
Height = GUARD(EndY-BeginY)
LocPinX = GUARD(Width*0.5)
LocPinY = GUARD(Height*0.5)
Angle = GUARD(0DA)
FlipX = GUARD(FALSE)
FlipY = GUARD(FALSE)
TxtPinX = 0
TxtPinY = 3 mm
TxtPinY.us = 0.12 in
TxtWidth = 30 mm
TxtWidth.us = 1.2 in
TxtHeight = 5 mm
TxtHeight.us = 0.2 in
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
TxtAngle = 0 deg
TextBkgnd = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3)
QuickStyleType = 3
QuickStyleLineMatrix = 2

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = 0
LineTo  X = Width; Y = Height

[Connection]
Row  X = Width*0.25; Y = Height*0.25; DirX = 0; DirY = 0
Row  X = Width*0.5; Y = Height*0.5; DirX = 0; DirY = 0
Row  X = Width*0.75; Y = Height*0.75; DirX = 0; DirY = 0
