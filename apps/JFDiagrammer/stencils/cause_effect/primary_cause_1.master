# Primäre Ursache 1 (SH-041, JD26): eine waagrechte Linie mit dem Text darüber, von links an eine
# Kategorie: ein 1D-Shape (Visios 1D-Formeln, der Kasten liegt auf der Linie), dessen Ende mit der
# Pfeilspitze des Designs (Formatvorlage Connector) an einem Punkt der Kategorie-Gräte klebt.
# Der Text steht 30 mm breit über der Linie, mittig, ohne den Texthintergrund der
# Formatvorlage (TextBkgnd 0: er steht nicht auf der Linie).  Auf der Linie liegen 5 Verbindungspunkte
# (1/6 bis 5/6) für die sekundären Ursachen (wie bei den Kategorien eine begründete Ausnahme von
# der Stilregel für 1D-Shapes).
master: Primary cause 1
style: Connector
name.de: Primäre Ursache 1
name.en: Primary cause 1
name.es: Causa primaria 1
name.it: Causa primaria 1
name.fr: Cause primaire 1
text.de: Ursache
text.en: Cause
text.es: Causa
text.it: Causa
text.fr: Cause
prompt.de: Ursache mit Text über der Linie. Ziehen Sie ihr Ende auf die Gräte einer Kategorie.
prompt.en: Cause with its text above the line. Drag its end onto the bone of a category.
prompt.es: Causa con el texto sobre la línea. Arrastre su extremo sobre la espina de una categoría.
prompt.it: Causa con il testo sopra la linea. Trascina la sua estremità sulla lisca di una categoria.
prompt.fr: Cause avec son texte au-dessus de la ligne. Faites glisser son extrémité sur l'arête d'une catégorie.
keywords.de: Ursache, primäre Ursache, Ishikawa, Fischgräte, Grund, Einflussgröße
keywords.en: cause, primary cause, Ishikawa, fishbone, reason, factor
keywords.es: causa, causa primaria, Ishikawa, espina de pescado, motivo, factor
keywords.it: causa, causa primaria, Ishikawa, lisca di pesce, motivo, fattore
keywords.fr: cause, cause primaire, Ishikawa, arête de poisson, raison, facteur

[Shape]
BeginX = 0 mm
BeginY = 4 mm
BeginY.us = 0.15 in
EndX = 30 mm
EndX.us = 1.2 in
EndY = 4 mm
EndY.us = 0.15 in
Height = 0 mm
TxtPinX = Width*0.5
TxtPinY = 3 mm
TxtPinY.us = 0.12 in
TxtWidth = 30 mm
TxtWidth.us = 1.2 in
TxtHeight = 5 mm
TxtHeight.us = 0.2 in
TxtLocPinX = TxtWidth*0.5
TxtLocPinY = TxtHeight*0.5
TextBkgnd = 0
# die Verbinder-Liste des Designs auch in Visio (QuickStyleType 3), Linie 2 (1 pt,
# Variantenfarbe) ausdrücklich: Visio nimmt die Schnellformatzellen aus der
# Füll-Formatvorlage und kennt dk2 (Linie 1) nicht
QuickStyleType = 3
QuickStyleLineMatrix = 2

[Geometry]
NoFill = TRUE
MoveTo  X = 0; Y = Height*0.5
LineTo  X = Width; Y = Height*0.5

[Connection]
Row  X = Width*1/6; Y = Height*0.5; DirX = 0; DirY = 0
Row  X = Width*2/6; Y = Height*0.5; DirX = 0; DirY = 0
Row  X = Width*3/6; Y = Height*0.5; DirX = 0; DirY = 0
Row  X = Width*4/6; Y = Height*0.5; DirX = 0; DirY = 0
Row  X = Width*5/6; Y = Height*0.5; DirX = 0; DirY = 0
