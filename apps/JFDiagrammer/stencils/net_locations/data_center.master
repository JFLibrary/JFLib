# Rechenzentrum (JD13, eigene Grafik im JFNetworker-Stil)
master: Data center
name.de: Rechenzentrum
name.en: Data centre
name.es: Centro de datos
name.it: Data center
name.fr: Centre de données
prompt.de: Rechenzentrum: Standort mit Servern und Netztechnik.
prompt.en: Data centre: site with servers and network equipment.
prompt.es: Centro de datos: ubicación con servidores y equipos de red.
prompt.it: Data center: sede con server e apparati di rete.
prompt.fr: Centre de données : site avec serveurs et équipements réseau.
keywords.de: Rechenzentrum, Standort, WAN
keywords.en: Data centre, location, site, WAN
keywords.es: Centro de datos, ubicación, WAN
keywords.it: Data center, sede, WAN
keywords.fr: Centre de données, site, WAN
svg: ../../symbols/network/data_center.svg
include: ../net_common/symbol.inc, ../net_common/location.inc

[Property]
ShapeType: Type = 0; Invisible = TRUE; Label = "ShapeType"
    Value.de = Standort
    Value.en = Location
    Value.es = Ubicación
    Value.it = Sede
    Value.fr = Site
SubShapeType: Type = 0; Invisible = TRUE; Label = "SubShapeType"
    Value.de = Rechenzentrum
    Value.en = Data centre
    Value.es = Centro de datos
    Value.it = Data center
