    Value.en = Network
    Value.es = Red
    Value.it = Rete
    Value.fr = Réseau
SubShapeType: Type = 0; Invisible = TRUE; Label = "SubShapeType"
    Value.de = Switch
    Value.en = Switch
    Value.es = Conmutador
    Value.it = Switch
