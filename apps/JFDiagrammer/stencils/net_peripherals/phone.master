include: ../net_common/symbol.inc, ../net_common/asset.inc

[Property]
ShapeType: Type = 0; Invisible = TRUE; Label = "ShapeType"
    Value.de = Peripherie
    Value.en = Peripheral
    Value.es = Periférico
    Value.it = Periferica
    Value.fr = Périphérique
SubShapeType: Type = 0; Invisible = TRUE; Label = "SubShapeType"
    Value.de = Telefon
    Value.en = Telephone
    Value.es = Teléfono
    Value.it = Telefono
    Value.fr = Téléphone
