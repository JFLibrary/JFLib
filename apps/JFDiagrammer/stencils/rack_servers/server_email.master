# E-Mail-Server (JD13, eigene Grafik im JFNetworker-Stil)
master: Email server
name.de: E-Mail-Server
name.en: Email server
name.es: Servidor de correo
name.it: Server di posta
name.fr: Serveur de messagerie
prompt.de: E-Mail-Server: stellt E-Mails zu, 19-Zoll-Einschub.
prompt.en: Email server: delivers email, 19-inch rack unit.
prompt.es: Servidor de correo: entrega el correo, unidad de rack de 19 pulgadas.
prompt.it: Server di posta: recapita la posta, unità rack da 19 pollici.
prompt.fr: Serveur de messagerie : distribue le courrier électronique, unité de baie 19 pouces.
keywords.de: E-Mail-Server, Rack, 19 Zoll, HE
keywords.en: Email server, rack, 19 inch, U
keywords.es: Servidor de correo, rack, 19 pulgadas, U
keywords.it: Server di posta, rack, 19 pollici, U
keywords.fr: Serveur de messagerie, baie, 19 pouces, U
svg: ../../symbols/rack/server_email.svg
scale: 1:20
size: 482.6 mm x 44.45 mm
size.us: 19 in x 1.75 in
include: ../net_common/rackdev.inc, ../net_common/asset.inc, ../net_common/network.inc, ../net_common/computer.inc

[Shape]
ObjType = 1

[Property]
RackUnits: Value = 1
ShapeType: Type = 0; Invisible = TRUE; Label = "ShapeType"
    Value.de = Gestellmontiert
    Value.en = Rack-mounted
