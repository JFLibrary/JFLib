# A finger on a resizable tool window (lib/ui/touch.rs, chrome.rs edge_grips): the band at the sides and
# the bottom is wider than for a pointer, the corners at the bottom too; the title bar (higher for a
# finger) moves the window; the close button is wide enough
theme light
click "Werkzeug"
expect window 601 open
system env jfgui_CSD 1
pointer touch
wait 16
expect wm none
window 601
# 10 DIP inside the bottom edge: a vertical move there resizes
flick 131,140 0 30 300
expect wm resize s
# 10 DIP inside the right and the left edge: a horizontal move
flick 252,90 30 0 300
expect wm resize e
flick 10,90 -30 0 300
expect wm resize w
# the corner at the bottom: at once
finger down 256,146
expect wm resize se
finger up
wait 200
# on top the title bar moves the window, all along
flick 100,6 30 30 300
window any
expect wm none
expect window 601 rect 54 78 260 120
window 601
flick 100,34 -30 -30 300
window any
expect window 601 rect 24 48 260 120
# WF_TOUCH_HOLD: the title bar only moves it after the finger rested there; a quick swipe does nothing
system env jfgui_DESKTEST_HOLD 1
wait 16
window 601
tap 100,20
window any
window 601
flick 100,20 30 30 300
window any
expect window 601 rect 24 48 260 120
window 601
finger down 100,20
wait 500
finger move 110,30
finger up
window any
expect window 601 rect 24 48 260 120
window 601
finger down 100,20
wait 700
finger move 130,50
finger up
window any
expect window 601 rect 54 78 260 120
window 601
tap 240,20
window any
expect window 601 closed

# ------------------------------------------------------------ the on-screen keyboard follows a finger's focus
system env jfgui_CSD 0
wait 16
expect keyboard hidden
focus #202
expect dialog:"Editor" selected
expect keyboard hidden
wait 16
tap #201
wait 16
expect #201 focused
expect keyboard shown
tap #202
wait 16
expect #202 focused
expect keyboard hidden
wait 200
# a mouse that gives the focus asks for no keyboard
pointer mouse
click #201
wait 16
expect #201 focused
expect keyboard hidden
click #202
pointer touch
wait 200

# ------------------------------------------------------------ a widget that takes one finger or two
tap #602
wait 16
expect text:"ein Klick" exists
wait 200
finger down 200,20
wait 16
finger move 260,20
wait 16
expect text:"ein Finger zieht" exists
finger up
wait 200
pinch 400,20 100 200 200
expect text:"zwei: 400,20 von 400,20 mal 200 00" exists
wait 200
pan2 300,20 40 10 200
expect text:"zwei: 340,30 von 300,20 mal 100 00" exists
wait 200
# the second finger right after the first one moved off: the press is taken back and it says so
finger down 300,20
wait 16
finger move 330,20
wait 16
finger 1 down 500,20
wait 16
finger 1 move 520,20
expect text:"zwei: 425,20 von 415,20 mal 111 00" exists
finger 1 up
finger up
wait 200
