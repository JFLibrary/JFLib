# viewtest: a TB_PASSWORD box sets the input method's purpose itself: IP_PASSWORD (5) while it has
# the keyboard ("Zweck: N" shows plat::ime_purpose_of), the purpose of before after it lost it --
# to another text box, to the page's own field (ui.ime_enable), or because the box went away
# while it had the keyboard (command 6, as with a closed window).
expect text:"Zweck: 0" exists
click #122
expect text:"Zweck: 5" exists
type "geheim"
expect #122 text "●●●●●●"
click #117
expect text:"Zweck: 0" exists
click #122
expect text:"Zweck: 5" exists
# the page's field says its purpose itself (IP_TEXT)
click "Eingabefeld"
click #101
expect text:"Zweck: 0" exists
click "Eingabefeld"
# the box goes away while it has the keyboard
click #122
expect text:"Zweck: 5" exists
cmd 6
expect #122 missing
expect text:"Zweck: 0" exists
cmd 6
click #117
expect text:"Zweck: 0" exists
