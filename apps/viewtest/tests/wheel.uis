# viewtest: the wheel over the page (UiInput, "Rad:"): its notches (wheel_y wheel_x, 120 a
# notch) and, for a device that scrolls by pixels or in fine steps, "genau" with the pixels
# (wheel_px_y wheel_px_x); what a notch scrolls is the system's setting (ui.wheel_lines,
# wheel_chars: Windows' mouse settings, KDE's; 3 and 3 in a headless run)
expect text:"Rad: - Zeilen 3 Zeichen 3" exists
# a mouse wheel: two notches down, one right
wheel #101 -240 120
expect text:"Rad: -240 120 Zeilen 3 Zeichen 3" exists
# a precision touchpad on Windows (WHEEL_FINE): 120 a notch in fine steps; in pixels a notch is
# three lines of 16 DIP
wheel #101 -30 fine
expect text:"Rad: -30 0 genau -12 0 Zeilen 3 Zeichen 3" exists
# a trackpad (WHEEL_PIXELS): its pixels; as notches 120 per 48 DIP
wheel #101 -24 10 pixels
expect text:"Rad: -60 25 genau -24 10 Zeilen 3 Zeichen 3" exists
# the fractions wait for the next turn: two pixels make five of 120
wheel #101 -1 pixels
expect text:"Rad: -2 0 genau -1 0 Zeilen 3 Zeichen 3" exists
wheel #101 -1 pixels
expect text:"Rad: -3 0 genau -1 0 Zeilen 3 Zeichen 3" exists
# the system's setting: five lines a notch, then a page
system env jfgui_WHEEL_LINES 5
system settings other
expect text:"Rad: -3 0 genau -1 0 Zeilen 5 Zeichen 3" exists
wheel #101 -30 fine
expect text:"Rad: -30 0 genau -20 0 Zeilen 5 Zeichen 3" exists
system env jfgui_WHEEL_LINES page
system env jfgui_WHEEL_CHARS 7
system settings other
expect text:"Rad: -30 0 genau -20 0 Zeilen Seite Zeichen 7" exists
system env jfgui_WHEEL_LINES -
system env jfgui_WHEEL_CHARS -
system settings other
expect text:"Rad: -30 0 genau -20 0 Zeilen 3 Zeichen 3" exists
