# timers on the virtual clock: no waiting, exact times; same times run in the order of creation
args: --virtual-time {dir}/timers.jfs
--- stdout
start 0.0
cancel before: true again: false
error: timer.after: die Zeit muss eine Zahl ab 0 sein (Millisekunden)
error: timer.every: das zweite Argument muss eine Funktion sein
top level done at 0.0
half a millisecond: 0.5
every #1 at 7.0
after 10 at 10.0
second after 10 at 10.0
every #2 at 14.0
nested at 15.0
every #3 at 21.0
cancel: true
after 30 at 30.0
===
# --until ends a loop that would run for ever
args: --virtual-time --until 35 -e "timer.every(10, fn() { print(now()) })"
--- stdout
10.0
20.0
30.0
===
# an error in a callback ends the program; its trace starts at the callback
args: --virtual-time -e "timer.after(5, fn() { print(\"at\", now()); let x = [1][3] })"
exit: 1
--- stdout
at 5.0
--- stderr
-e:1:54: Fehler: Index 3 liegt außerhalb der Liste (Länge 1)
    timer.after(5, fn() { print("at", now()); let x = [1][3] })
                                                         ^
  in fn (1:54)
