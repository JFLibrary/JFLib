# --test: every function test_* of the files in a fresh VM (fresh globals and modules), its
# timers on the virtual clock; a failure with file, line, column, message and what the test
# printed; the count; exit code 1 when a test failed
args: --test {dir}/unit_ok.jfs {dir}/unit_fail.jfs
exit: 1
--- stdout
ok      test_greet ({dir}/unit_ok.jfs)
ok      test_fresh_globals ({dir}/unit_ok.jfs)
ok      test_fresh_again ({dir}/unit_ok.jfs)
ok      test_timer ({dir}/unit_ok.jfs)
ok      test_math ({dir}/unit_fail.jfs)
FEHLER  test_wrong ({dir}/unit_fail.jfs:7:3): Liste: erwartet [1, 3], ist [1, 2]
        | rechne
FEHLER  test_throws ({dir}/unit_fail.jfs:11:7): Nur Maps haben Felder, nicht nil (Feld y)
FEHLER  test_later ({dir}/unit_fail.jfs:15:5): Annahme verletzt: im Timer
8 Tests: 5 bestanden, 3 fehlgeschlagen
===
# all passed: exit code 0 (what the top-level code prints is not shown)
args: --test {dir}/unit_ok.jfs
--- stdout
ok      test_greet ({dir}/unit_ok.jfs)
ok      test_fresh_globals ({dir}/unit_ok.jfs)
ok      test_fresh_again ({dir}/unit_ok.jfs)
ok      test_timer ({dir}/unit_ok.jfs)
4 Tests: 4 bestanden, 0 fehlgeschlagen
===
# no test at all is a failure too
args: --test {dir}/hello.jfs
exit: 1
--- stdout
{dir}/hello.jfs: keine Tests (Funktionen test_…)
0 Tests: 0 bestanden, 0 fehlgeschlagen
===
# --test takes files
args: --test -e "print(1)"
exit: 2
--- stderr
jfs: --test braucht Dateien mit Tests
(jfs --help zeigt die Optionen)
