// tests that fail: a wrong value, an exception, an assertion in a timer
fn test_math() {
  assert_eq(1 + 1, 2)
}
fn test_wrong() {
  print("rechne")
  assert_eq([1, 2], [1, 3], "Liste")
}
fn test_throws() {
  let m = {}
  m.x.y = 1
}
fn test_later() {
  timer.after(5, fn() {
    assert(false, "im Timer")
  })
}
