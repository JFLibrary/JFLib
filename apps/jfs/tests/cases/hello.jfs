// hello.jfs -- the first example: text, the arguments (config.args), the standard library
let names = config.args
if len(names) == 0 {
  names = ["Welt"]
}
for n in names {
  print("Hallo, ${n}!")
}

let total = 0
for i in 1..11 {
  total += i
}
print("1 + 2 + ... + 10 =", total)
print(json.encode({name: "jfs", tags: ["a", "b"], ratio: 0.5}))
print("{:>8.3}|{:#x}|{:<5}|".format(math.pi, 255, "ab"))
print("Größe".upper(), "a,b,,c".split(","), [3, 1, 2].sort())
