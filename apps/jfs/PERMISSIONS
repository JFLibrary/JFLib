# jfs: what the program may do (docs/PERMISSIONS.md).  Scripts reach almost none of it: the
# language has no access to programs or the network of its own, of files only the .jfs files
# it imports (modules); the runner reads the script and the --disk file named on its command
# line.
fs.user                              # the files named on the command line (script, --disk FILE)
# import: modules are .jfs files (the runner reads no other file for a script)
fs.read  /**/*.jfs C:/**/*.jfs D:/**/*.jfs E:/**/*.jfs F:/**/*.jfs G:/**/*.jfs H:/**/*.jfs
fs.write $TEMP/jfs-*/**              # --selftest: a scratch folder per run ({tmp} of the cases)
process  $EXE/jfs $EXE/jfs.exe       # --selftest: starts itself for every case
