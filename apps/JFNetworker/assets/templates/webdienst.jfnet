{
  "format": "jfn",
  "version": 1,
  "title": "Webdienst hinter Loadbalancer",
  "description": "Ein Loadbalancer verteilt die Anfragen auf drei Webserver und prüft sie.",
  "seed": 25,
  "next_id": 18,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "GEN1",
      "model": "traffic-gen",
      "x": 0,
      "y": -60,
      "off": false,
      "startup_config": "hostname GEN1\nip addr add 10.0.1.10/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.1.1/"
            ],
            "mode": "open",
            "rps": 30,
            "arrival": "poisson",
            "delay_ms": 1000,
            "timeout_ms": 2000,
            "mix": [
              {
                "path": "/"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 60,
      "off": false,
      "startup_config": "hostname PC1\nip addr add 10.0.1.20/24 dev eth0\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 160,
      "y": 0,
      "off": false,
      "startup_config": "hostname SW1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "LB1",
      "model": "load-balancer",
      "x": 320,
      "y": 0,
      "off": false,
      "startup_config": "hostname LB1\nip addr add 10.0.1.1/24 dev eth0\nip addr add 10.0.2.1/24 dev eth1\n",
      "services": [
        {
          "kind": "lb",
          "name": "lb",
          "disabled": false,
          "config": {
            "mode": "http",
            "port": 80,
            "algorithm": "round-robin",
            "backends": [
              {
                "name": "web1",
                "addr": "10.0.2.11"
              },
              {
                "name": "web2",
                "addr": "10.0.2.12"
              },
              {
                "name": "web3",
                "addr": "10.0.2.13"
              }
            ],
            "health": {
              "type": "http",
              "path": "/health",
              "interval_ms": 1000,
              "timeout_ms": 500,
              "rise": 2,
              "fall": 3
            }
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 5,
      "name": "SW2",
      "model": "jf-s24p",
      "x": 480,
      "y": 0,
      "off": false,
      "startup_config": "hostname SW2\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 6,
      "name": "WEB1",
      "model": "server-1u",
      "x": 640,
      "y": -120,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 10.0.2.11/24 dev eth0\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "workers": 4,
            "queue": 50,
            "time_ms": 10,
            "jitter_ms": 5,
            "routes": [
              {
                "path": "/health",
                "body": "ok\n",
                "time_ms": 0
              },
              {
                "path": "/",
                "body": "Hallo von {host}\n"
              }
            ]
          }
        }
      ],
