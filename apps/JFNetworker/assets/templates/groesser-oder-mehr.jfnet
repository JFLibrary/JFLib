{
  "format": "jfn",
  "version": 1,
  "title": "Größer oder mehr?",
  "description": "Ein Webdienst mit Datenbank: ein immer größerer Server gegen immer mehr kleine, als Experiment im Bereich Experimente.",
  "seed": 11,
  "next_id": 50,
  "strict_mdix": false,
  "metered": true,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 40,
      "y": 355,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.0.2/"
            ],
            "mode": "open",
            "rps": 100,
            "arrival": "poisson",
            "timeout_ms": 30000,
            "connect_timeout_ms": 1000,
            "max_conns": 256
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s48x",
      "x": 220,
      "y": 355,
      "off": false,
      "startup_config": "hostname SW1\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "LB",
      "model": "load-balancer",
      "x": 400,
      "y": 200,
      "off": false,
      "startup_config": "hostname LB\nip addr add 10.0.0.2/24 dev eth0\n",
      "services": [
        {
          "kind": "lb",
          "name": "lb",
          "disabled": false,
          "config": {
            "port": 80,
            "algorithm": "least-conn",
            "cpu_us": 60,
            "health": {
              "type": "tcp",
              "interval_ms": 5000,
              "timeout_ms": 1000
            },
            "backends": [
              {
                "name": "WEB1",
                "addr": "10.0.0.11",
                "port": 80
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 4,
      "name": "DB",
      "model": "database",
      "x": 400,
      "y": 510,
      "off": false,
      "startup_config": "hostname DB\nip addr add 10.0.0.30/24 dev eth0\n",
      "services": [
        {
          "kind": "db",
          "name": "db",
          "disabled": false,
          "config": {
            "port": 7100,
            "pool_mb": 4096,
            "max_conns": 512,
            "write_us": 150,
            "tables": [
              {
                "name": "users",
                "rows": 1000000,
                "row_bytes": 200,
                "key": "id",
                "columns": [
                  "email:text"
                ],
                "indexes": [
                  "email"
                ]
              },
              {
                "name": "counters",
                "rows": 10,
                "row_bytes": 64,
                "key": "id",
                "columns": [
                  "hits"
                ]
              }
            ],
            "mem_mb": 2048,
            "conn_kb": 256
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 10,
      "name": "WEB1",
      "model": "server-s",
      "x": 620,
      "y": 40,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 10.0.0.11/24 dev eth1\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "port": 80,
            "cpu_ms": 4,
            "serial_us": 180,
            "usl": {
              "sigma": 0.01,
              "kappa": 0.0002
            },
            "routes": [
              {
                "path": "/",
                "backend": "db",
                "param": "draw",
                "sql": [
                  "SELECT * FROM users WHERE id = ?",
                  "UPDATE counters SET hits = hits + 1 WHERE id = 1"
                ]
              }
            ],
            "mem_mb": 256,
            "conn_kb": 64,
            "db": {
              "addr": "10.0.0.30",
              "port": 7100,
              "timeout_ms": 30000,
              "conns": 32
            }
          }
        }
      ],
      "comment": ""
    },
