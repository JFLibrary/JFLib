{
  "format": "jfn",
  "version": 1,
  "title": "Campus",
  "description": "Zwei Gebäude mit L3-Switches, OSPF zum Router, DHCP über Relays, DNS.",
  "seed": 23,
  "next_id": 26,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "R1",
      "model": "jf-r4",
      "x": 380,
      "y": 0,
      "off": false,
      "startup_config": "hostname R1\n!\nip dhcp excluded-address 10.20.10.1 10.20.10.49\nip dhcp excluded-address 10.20.20.1 10.20.20.49\nip dhcp excluded-address 10.30.10.1 10.30.10.49\nip dhcp excluded-address 10.30.20.1 10.30.20.49\n!\nip dhcp pool A_STAFF\n network 10.20.10.0 255.255.255.0\n default-router 10.20.10.1\n dns-server 10.10.100.10\n domain-name campus.lab\n!\nip dhcp pool A_STUD\n network 10.20.20.0 255.255.255.0\n default-router 10.20.20.1\n dns-server 10.10.100.10\n domain-name campus.lab\n!\nip dhcp pool B_STAFF\n network 10.30.10.0 255.255.255.0\n default-router 10.30.10.1\n dns-server 10.10.100.10\n domain-name campus.lab\n!\nip dhcp pool B_STUD\n network 10.30.20.0 255.255.255.0\n default-router 10.30.20.1\n dns-server 10.10.100.10\n domain-name campus.lab\n!\ninterface GigabitEthernet0/0/1\n description Servernetz\n ip address 10.10.100.1 255.255.255.0\n no shutdown\n!\ninterface TenGigabitEthernet0/1/0\n description Gebaeude A\n ip address 10.10.0.1 255.255.255.252\n ip ospf network point-to-point\n no shutdown\n!\ninterface TenGigabitEthernet0/1/1\n description Gebaeude B\n ip address 10.10.0.5 255.255.255.252\n ip ospf network point-to-point\n no shutdown\n!\nrouter ospf 1\n router-id 10.10.0.1\n network 10.0.0.0 0.255.255.255 area 0\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SRV1",
      "model": "server-1u",
      "x": 640,
      "y": 0,
      "off": false,
      "startup_config": "hostname SRV1\nip addr add 10.10.100.10/24 dev eth0\nip route add default via 10.10.100.1\n",
      "services": [
        {
          "kind": "dns-server",
          "name": "named",
          "disabled": false,
          "config": {
            "zones": [
              {
                "origin": "campus.lab",
                "ttl": 300,
                "records": [
                  "www A 10.10.100.10",
                  "srv1 CNAME www"
                ]
              }
            ]
          }
        },
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "workers": 4,
            "time_ms": 2,
            "routes": [
              {
                "path": "/",
                "body": "Willkommen auf dem Campus, {client}\n"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 3,
      "name": "MLS1",
      "model": "jf-s24l3",
      "x": 160,
      "y": 150,
      "off": false,
      "startup_config": "hostname MLS1\n!\nip routing\n!\nvlan 10\n name Staff\n!\nvlan 20\n name Students\n!\ninterface GigabitEthernet1/0/1\n description zum Access-Switch\n switchport trunk allowed vlan 1,10,20\n switchport mode trunk\n!\ninterface TenGigabitEthernet1/1/1\n description zu R1\n no switchport\n ip address 10.10.0.2 255.255.255.252\n ip ospf network point-to-point\n!\ninterface Vlan10\n ip address 10.20.10.1 255.255.255.0\n ip helper-address 10.10.100.1\n!\ninterface Vlan20\n ip address 10.20.20.1 255.255.255.0\n ip helper-address 10.10.100.1\n!\nrouter ospf 1\n router-id 10.10.0.2\n network 10.0.0.0 0.255.255.255 area 0\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "MLS2",
      "model": "jf-s24l3",
      "x": 600,
      "y": 150,
      "off": false,
      "startup_config": "hostname MLS2\n!\nip routing\n!\nvlan 10\n name Staff\n!\nvlan 20\n name Students\n!\ninterface GigabitEthernet1/0/1\n description zum Access-Switch\n switchport trunk allowed vlan 1,10,20\n switchport mode trunk\n!\ninterface TenGigabitEthernet1/1/1\n description zu R1\n no switchport\n ip address 10.10.0.6 255.255.255.252\n ip ospf network point-to-point\n!\ninterface Vlan10\n ip address 10.30.10.1 255.255.255.0\n ip helper-address 10.10.100.1\n!\ninterface Vlan20\n ip address 10.30.20.1 255.255.255.0\n ip helper-address 10.10.100.1\n!\nrouter ospf 1\n router-id 10.10.0.6\n network 10.0.0.0 0.255.255.255 area 0\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 5,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 160,
      "y": 290,
      "off": false,
      "startup_config": "hostname SW1\n!\nvlan 10\n name Staff\n!\nvlan 20\n name Students\n!\ninterface GigabitEthernet1/0/1\n switchport access vlan 10\n switchport mode access\n!\ninterface GigabitEthernet1/0/2\n switchport access vlan 20\n switchport mode access\n!\ninterface GigabitEthernet1/0/3\n switchport access vlan 20\n switchport mode access\n!\ninterface GigabitEthernet1/0/24\n description zum L3-Switch\n switchport trunk allowed vlan 1,10,20\n switchport mode trunk\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 6,
      "name": "SW2",
