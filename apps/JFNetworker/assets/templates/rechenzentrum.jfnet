  "devices": [
    {
      "id": 1,
      "name": "Spine1",
      "model": "jf-s48x",
      "x": 220,
      "y": 0,
      "off": false,
      "startup_config": "hostname Spine1\n!\nip routing\n!\ninterface Loopback0\n ip address 10.255.0.1 255.255.255.255\n no shutdown\n!\ninterface HundredGigE1/0/49\n description Leaf1\n no switchport\n ip address 10.0.11.1 255.255.255.252\n ip ospf network point-to-point\n!\ninterface HundredGigE1/0/50\n description Leaf2\n no switchport\n ip address 10.0.12.1 255.255.255.252\n ip ospf network point-to-point\n!\ninterface HundredGigE1/0/51\n description Leaf3\n no switchport\n ip address 10.0.13.1 255.255.255.252\n ip ospf network point-to-point\n!\ninterface HundredGigE1/0/52\n description Leaf4\n no switchport\n ip address 10.0.14.1 255.255.255.252\n ip ospf network point-to-point\n!\nrouter ospf 1\n router-id 10.255.0.1\n passive-interface default\n no passive-interface HundredGigE1/0/49\n no passive-interface HundredGigE1/0/50\n no passive-interface HundredGigE1/0/51\n no passive-interface HundredGigE1/0/52\n network 10.0.0.0 0.255.255.255 area 0\n!\nend\n",
      "services": [],
      "comment": ""
    },
