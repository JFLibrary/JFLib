{
  "format": "jfn",
  "version": 1,
  "title": "Rechenzentrum (Leaf-Spine)",
  "description": "Zwei Spines, vier Leafs, acht Server; geroutet mit OSPF über gleich gute Wege.",
  "seed": 24,
