{
  "format": "jfn",
  "version": 1,
  "title": "Büro mit VLANs",
  "description": "VLANs für Büro, Technik und Server, ein Router am Trunk, DHCP und DNS.",
  "seed": 22,
  "next_id": 21,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "R1",
      "model": "jf-r4",
      "x": 300,
      "y": 0,
      "off": false,
      "startup_config": "hostname R1\n!\nip dhcp excluded-address 10.0.10.1 10.0.10.49\nip dhcp excluded-address 10.0.20.1 10.0.20.49\n!\nip dhcp pool BUERO\n network 10.0.10.0 255.255.255.0\n default-router 10.0.10.1\n dns-server 10.0.30.10\n domain-name buero.lab\n!\nip dhcp pool TECHNIK\n network 10.0.20.0 255.255.255.0\n default-router 10.0.20.1\n dns-server 10.0.30.10\n domain-name buero.lab\n!\ninterface GigabitEthernet0/0/0\n description Trunk zu SW1\n no ip address\n no shutdown\n!\ninterface GigabitEthernet0/0/0.10\n description Buero\n encapsulation dot1Q 10\n ip address 10.0.10.1 255.255.255.0\n!\ninterface GigabitEthernet0/0/0.20\n description Technik\n encapsulation dot1Q 20\n ip address 10.0.20.1 255.255.255.0\n!\ninterface GigabitEthernet0/0/0.30\n description Server\n encapsulation dot1Q 30\n ip address 10.0.30.1 255.255.255.0\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 160,
      "y": 140,
      "off": false,
      "startup_config": "hostname SW1\n!\nvlan 10\n name Buero\n!\nvlan 20\n name Technik\n!\nvlan 30\n name Server\n!\ninterface GigabitEthernet1/0/1\n switchport access vlan 10\n switchport mode access\n!\ninterface GigabitEthernet1/0/2\n switchport access vlan 10\n switchport mode access\n!\ninterface GigabitEthernet1/0/3\n switchport access vlan 10\n switchport mode access\n!\ninterface GigabitEthernet1/0/23\n description zu SW2\n switchport trunk allowed vlan 1,10,20,30\n switchport mode trunk\n!\ninterface GigabitEthernet1/0/24\n description zu R1\n switchport trunk allowed vlan 1,10,20,30\n switchport mode trunk\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SW2",
      "model": "jf-s24p",
      "x": 440,
      "y": 140,
      "off": false,
      "startup_config": "hostname SW2\n!\nvlan 10\n name Buero\n!\nvlan 20\n name Technik\n!\nvlan 30\n name Server\n!\ninterface GigabitEthernet1/0/1\n switchport access vlan 20\n switchport mode access\n!\ninterface GigabitEthernet1/0/2\n switchport access vlan 20\n switchport mode access\n!\ninterface GigabitEthernet1/0/3\n switchport access vlan 30\n switchport mode access\n!\ninterface GigabitEthernet1/0/23\n description zu SW1\n switchport trunk allowed vlan 1,10,20,30\n switchport mode trunk\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 300,
      "off": false,
      "startup_config": "hostname PC1\n",
