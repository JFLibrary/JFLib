{
  "format": "jfn",
  "version": 1,
  "title": "Heimnetz",
  "description": "Heimrouter mit WLAN und DHCP, dazu PC, Drucker, Laptop und Smartphone.",
  "seed": 21,
  "next_id": 14,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "ISP1",
      "model": "jf-r4",
      "x": 280,
      "y": 0,
      "off": false,
      "startup_config": "hostname ISP1\n!\ninterface GigabitEthernet0/0/0\n description Kunde\n ip address 100.64.0.1 255.255.255.252\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n description Internet\n ip address 203.0.113.1 255.255.255.0\n no shutdown\n!\nip route 192.168.1.0 255.255.255.0 100.64.0.2\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "WEB1",
      "model": "server-1u",
      "x": 560,
      "y": 0,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 203.0.113.10/24 dev eth0\nip route add default via 203.0.113.1\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "workers": 4,
            "time_ms": 2,
            "routes": [
              {
                "path": "/",
                "body": "Hallo aus dem Internet, {client} fragt {host}\n"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 3,
      "name": "Gateway1",
      "model": "home-router",
      "x": 280,
      "y": 160,
      "off": false,
      "startup_config": "hostname Gateway1\nip addr add 100.64.0.2/30 dev wan\nip addr add 192.168.1.1/24 dev br0\nip route add default via 100.64.0.1\n",
      "services": [
        {
          "kind": "dhcp-server",
          "name": "dhcp-server",
          "disabled": false,
          "config": {
            "pools": [
              {
                "name": "HEIM",
                "network": "192.168.1.0/24",
                "range": [
                  "192.168.1.100",
                  "192.168.1.199"
                ],
                "routers": [
                  "192.168.1.1"
                ],
                "lease": 3600
              }
            ]
          }
        }
      ],
      "comment": "",
      "wlan": {
        "nets": [
          {
            "ssid": "Zuhause",
            "band": "5",
            "channel": 36,
            "security": "wpa2-personal",
            "passphrase": "Sonnenschein24",
            "vlan": 0,
            "guest": false,
            "isolate": false
          }
        ],
        "join": null
      }
    },
