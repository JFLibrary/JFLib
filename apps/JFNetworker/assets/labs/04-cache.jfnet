      "off": false,
      "startup_config": "hostname CACHE1\nip addr add 10.0.2.20/24 dev eth0\n",
      "services": [
        {
          "kind": "cache",
          "name": "cache",
          "disabled": false,
          "config": {
            "port": 80,
