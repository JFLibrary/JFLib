        {
          "path": "/root/bestell",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/root/bestell/bestell.jfs",
          "text": "// die Bestellung: schreibt Aufträge in den KV-Speicher; Version 1\nlet version = 1\nmetrics.gauge(\"version\", version)\nlet kv = config.env.KV\nlet nr = 0\ntimer.after(1500, fn() {\n  http.serve(8081, fn(req, res) {\n    if (req.path == \"/health\") {\n      res.send(200, \"gesund\\n\")\n      return nil\n    }\n    nr = nr + 1\n    http.request({url: \"${kv}/kv/auftrag${rand(1000)}\", method: \"PUT\", body: \"Auftrag ${nr}\", timeout_ms: 1000}, fn(err, r) {\n      if (err != nil || r.status >= 500) {\n        res.send(502, \"Bestellung: der Speicher antwortet nicht\\n\")\n      } else {\n        res.send(200, \"Bestellung v${version}: angenommen\\n\")\n      }\n    })\n    return nil\n  })\n  print(\"Bestellung bereit, Version ${version}\")\n})\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/multi-user.target.wants",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/bestell.service",
          "text": "[Unit]\nDescription=Die Bestellung\n\n[Service]\nExecStart=jfs /root/bestell/bestell.jfs\nEnvironment=KV=http://10.0.2.31:7000\nRestart=on-failure\nRestartSec=1\n\n[Install]\nWantedBy=multi-user.target\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/multi-user.target.wants/bestell.service",
          "text": "/etc/systemd/system/bestell.service\n",
          "mtime": 1767225600
        }
      ]
    },
