      "x": 320,
      "y": 0,
      "off": false,
      "startup_config": "hostname LB1\nip addr add 10.0.1.1/24 dev eth0\nip addr add 10.0.2.1/24 dev eth1\n",
      "services": [
        {
          "kind": "lb",
          "name": "katalog",
          "disabled": false,
          "config": {
            "mode": "http",
            "port": 80,
            "algorithm": "round-robin",
            "backends": [
              {
                "name": "api1",
                "addr": "10.0.2.11",
                "port": 8080
              },
              {
                "name": "api2",
                "addr": "10.0.2.12",
                "port": 8080
              },
              {
                "name": "api3",
                "addr": "10.0.2.13",
                "port": 8080
              }
            ],
            "health": {
              "type": "http",
              "path": "/health",
              "interval_ms": 1000,
              "timeout_ms": 500,
              "rise": 2,
              "fall": 3
            },
            "retries": 2
          }
        },
        {
          "kind": "lb",
          "name": "bestell",
          "disabled": false,
          "config": {
            "mode": "http",
            "port": 81,
            "algorithm": "round-robin",
            "backends": [
              {
                "name": "ord1",
                "addr": "10.0.2.21",
                "port": 8081
              },
              {
                "name": "ord2",
                "addr": "10.0.2.22",
                "port": 8081
              }
            ],
            "health": {
              "type": "http",
              "path": "/health",
              "interval_ms": 1000,
              "timeout_ms": 500,
              "rise": 2,
              "fall": 3
            },
            "retries": 2
          }
        }
      ],
      "comment": "",
      "wlan": null,
      "files": []
    },
