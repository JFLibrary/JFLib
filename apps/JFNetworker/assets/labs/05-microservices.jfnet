    {
      "id": 5,
      "name": "API1",
      "model": "server-1u",
      "x": 640,
      "y": -240,
      "off": false,
      "startup_config": "hostname API1\nip addr add 10.0.2.11/24 dev eth0\n",
      "services": [],
      "comment": "",
      "wlan": null,
      "files": [
        {
          "path": "/root/katalog",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/root/katalog/katalog.jfs",
          "text": "// der Katalog: liest Artikel über den Cache aus dem KV-Speicher; Version 1\nlet version = 1\nmetrics.gauge(\"version\", version)\nlet cache = config.env.CACHE\n// Startzeit: der Dienst nimmt erst nach einer Weile Verbindungen an\ntimer.after(1500, fn() {\n  http.serve(8080, fn(req, res) {\n    if (req.path == \"/health\") {\n      res.send(200, \"gesund\\n\")\n      return nil\n    }\n    http.request({url: \"${cache}/kv/artikel${rand(40)}\", timeout_ms: 1000}, fn(err, r) {\n      if (err != nil || r.status >= 500) {\n        res.send(502, \"Katalog: der Speicher antwortet nicht\\n\")\n      } else {\n        res.send(200, \"Katalog v${version}: ${r.status}\\n\")\n      }\n    })\n    return nil\n  })\n  print(\"Katalog bereit, Version ${version}\")\n})\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/multi-user.target.wants",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/katalog.service",
          "text": "[Unit]\nDescription=Der Katalog\n\n[Service]\nExecStart=jfs /root/katalog/katalog.jfs\nEnvironment=CACHE=http://10.0.2.41:8000\nRestart=on-failure\nRestartSec=1\n\n[Install]\nWantedBy=multi-user.target\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/multi-user.target.wants/katalog.service",
          "text": "/etc/systemd/system/katalog.service\n",
          "mtime": 1767225600
        }
      ]
    },
