{
  "format": "jfn",
  "version": 1,
  "title": "Microservices: Version 2 ausrollen",
  "description": "Labor: zwei kleine Dienste als Einheiten hinter einem Loadbalancer, mit KV-Speicher und Cache; die neue Version geht nacheinander auf die Hosts.",
  "seed": 5,
  "next_id": 32,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.1.10/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "last",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.1.1/",
              "http://10.0.1.1:81/"
            ],
            "mode": "open",
            "rps": 80,
            "arrival": "poisson",
            "delay_ms": 4000,
            "timeout_ms": 3000,
            "mix": [
              {
                "path": "/"
              }
            ]
          }
        }
      ],
      "comment": "",
      "wlan": null,
      "files": []
    },
    {
