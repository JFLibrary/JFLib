#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/web_dev.jfnet
# simulated HTTPS in the Webbrowser (B4) on PC1's desktop: a certificate of the lab CA with the lock and
# its card; a warning page for each fault (self-signed, expired, another name, not valid yet) with
# Trotzdem fortfahren and the way back; what is accepted stays for that one certificate; a port without
# TLS; a redirect from http to https; pictures and sheets over https; the warning before a first page
# Ids (window 0): the window 26624; the address 26800, Zurück 26803, Neu laden 26805; the lock 124929,
# Trotzdem fortfahren 124930, Zurück zur sicheren Seite 124931
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
resizewin 26624 1000 760
dblclick listitem:"Webbrowser"
# ---- http has no lock
click #26800
key ctrl+a
type "web.lab\n"
wait 1000
expect heading:"Hofladen Sonnenfeld" exists
expect button:"Zertifikat" missing
# ---- a link to https: the same site with a lock
click link:"Dieselbe Seite über https"
wait 1000
expect heading:"Hofladen Sonnenfeld" exists
expect #26800 text "https://web.lab/"
expect button:"Zertifikat" exists
expect text:"Diese Verbindung ist nicht sicher" missing
# the card
click #124929
expect text:"Verschlüsselte Verbindung" exists
expect text:"TLS 1.3, TLS_CHACHA20_POLY1305_SHA256" exists
expect text:"web.lab (Hofladen Sonnenfeld)" exists
expect text:"JFNetworker Lab CA (JFNetworker)" exists
expect text:"web.lab, www.web.lab" exists
expect text:"Fingerabdruck (SHA-256)" exists
expect text:"Ein Zertifikat aus dem simulierten Netz: seine Schlüssel kommen aus dem Startwert des Projekts und schützen nichts Echtes." exists
shot build/jfnetworker/https_card.png window 26624
click #124929
expect text:"Fingerabdruck (SHA-256)" missing
# its picture and its sheets came over https too
key f12
click tab:"Netzwerk"
expect text:"https://web.lab/basis.css" exists
expect text:"https://web.lab/ende.css" exists
expect text:"https://web.lab/zeichen.svg" exists
click text:"https://web.lab/basis.css"
expect text:"TLS 1.3, TLS_CHACHA20_POLY1305_SHA256" exists
expect text:"Zertifikat für web.lab, ausgestellt von JFNetworker Lab CA" exists
click tab:"Konsole"
key f12
# ---- self-signed: the warning; back to where it was
click #26800
key ctrl+a
type "https://web.lab:8441/\n"
wait 1000
expect heading:"Diese Verbindung ist nicht sicher" exists
expect text:"Das Zertifikat ist von web.lab selbst unterschrieben: niemand, dem dieses Gerät vertraut, bürgt dafür." exists
expect text:"Das Zertifikat dieses Servers hat Fehler. Nur fortfahren, wenn klar ist, warum." exists
expect button:"Trotzdem fortfahren" exists
expect #124931 enabled
shot build/jfnetworker/https_warning.png window 26624
click #124931
expect heading:"Hofladen Sonnenfeld" exists
expect #26800 text "https://web.lab/"
# ---- and going on: the page, the lock says what is wrong
click #26800
key ctrl+a
type "https://web.lab:8441/\n"
wait 1000
expect heading:"Diese Verbindung ist nicht sicher" exists
click button:"Trotzdem fortfahren"
wait 1000
expect heading:"Hofladen Sonnenfeld" exists
expect #26800 text "https://web.lab:8441/"
expect button:"Trotzdem fortfahren" missing
click #124929
expect text:"Verschlüsselt, aber das Zertifikat hat Fehler" exists
expect text:"web.lab (Eigenbau)" exists
expect text:"Das Zertifikat ist von web.lab selbst unterschrieben: niemand, dem dieses Gerät vertraut, bürgt dafür." exists
click #124929
# what is accepted stays: Reload asks no more
click #26805
wait 1000
expect heading:"Hofladen Sonnenfeld" exists
expect heading:"Diese Verbindung ist nicht sicher" missing
# ---- expired
click #26800
key ctrl+a
type "https://web.lab:8442/\n"
wait 1000
expect heading:"Diese Verbindung ist nicht sicher" exists
expect text:"Das Zertifikat ist abgelaufen: es galt bis 2025-11-27 00:00 UTC." exists
click button:"Trotzdem fortfahren"
wait 1000
expect heading:"Hofladen Sonnenfeld" exists
# ---- another name
click #26800
key ctrl+a
type "https://web.lab:8443/\n"
wait 1000
expect heading:"Diese Verbindung ist nicht sicher" exists
expect text:"Das Zertifikat gilt für andere.lab, nicht für web.lab." exists
# (the same certificate under its own name is fine)
click #26800
key ctrl+a
type "https://andere.lab:8443/\n"
wait 1000
expect heading:"Hofladen Sonnenfeld" exists
expect button:"Zertifikat" exists
# ---- not valid yet
click #26800
key ctrl+a
type "https://web.lab:8444/\n"
wait 1000
expect heading:"Diese Verbindung ist nicht sicher" exists
expect text:"Das Zertifikat gilt erst ab 2026-01-11 00:00 UTC." exists
# ---- a port without TLS
click #26800
key ctrl+a
type "https://web.lab:8080/\n"
wait 1000
expect heading:"Keine sichere Verbindung" exists
expect text:"Mit web.lab kam keine verschlüsselte Verbindung zustande." exists
# ---- nobody on port 443 of another name's address (DNS1)
click #26800
key ctrl+a
type "https://dns.lab/\n"
wait 1000
expect heading:"Seite nicht erreichbar" exists
expect text:"dns.lab lehnt die Verbindung ab: auf Port 443 lauscht kein Dienst." exists
# ---- http redirects to https
click #26800
key ctrl+a
type "web.lab:8081/\n"
wait 1000
expect heading:"Hofladen Sonnenfeld" exists
expect #26800 text "https://web.lab/"
expect button:"Zertifikat" exists
# ---- the certificates of a closed browser are forgotten
click button:"Schließen: Hofladen Sonnenfeld – Webbrowser"
dblclick listitem:"Webbrowser"
click #26800
key ctrl+a
type "https://web.lab:8441/\n"
wait 1000
expect heading:"Diese Verbindung ist nicht sicher" exists
expect #124931 missing
expect button:"Trotzdem fortfahren" exists
# ---- the packets in the Simulationsmodus' words: the server's service says TLS
close window 26624
dblclick listitem:"WEB1" shift
expect window 26624 open
click tab:"Dienste"
expect text:"Port 443 (TLS): 8 Anfragen, 8 Antworten, 0 in Arbeit, 0 wartend" exists
expect_nowarn
