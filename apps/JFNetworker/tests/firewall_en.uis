#!args --verify-dirty --lang en --open apps/JFNetworker/tests/fixtures/nat_pat.jfnet
# the Firewall tab in English (--lang en; F1): the parts, what the bindings and a list mean, a refusal,
# the form's words, NAT, the Test part with its answer.  Ids as in firewall_panel.uis.
size 1280 900
theme light
wait 500
dblclick listitem:"R1" shift
expect window 26624 open
resizewin 26624 900 840
click tab:"Firewall"
expect tab:"Rules" selected
expect tab:"NAT" exists
expect tab:"Test" exists
expect text:"What protects which interface?" exists
expect text:"Gi0/0/0 inbound: list 110" exists
expect text:"Gi0/0/0 outbound: no list, everything passes" exists
expect text:"This list filters nothing: NAT uses it to choose the hosts it translates." exists
expect text:"Line 10: permit 192.168.1.0 0.0.0.255, 0 hits" exists
click #131088
click listitem:"110 (extended, 2 rules)"
expect text:"Bound to Gi0/0/0 inbound. What no rule permits is dropped by the implicit deny at the end." exists
expect text:"At the end: implicit deny" exists
click button:"Delete list"
expect text:"List 110 still filters Gi0/0/0 (inbound): remove the binding first." exists
click #131098
expect text:"New rule after line 0" missing
click #131110
key ctrl+a
type "300.1.1.1"
click #131120
expect text:"“300.1.1.1” is no address: any, 10.0.0.5, 10.0.0.0/24 or 10.0.0.0 0.0.0.255." exists
click #131121
click tab:"NAT"
expect text:"Many hosts: dynamic and PAT" exists
expect text:"List 1 → address of Gi0/0/1 (PAT)" exists
expect text:"Running translations" exists
click tab:"Test"
expect text:"Which rule meets this packet?" exists
click #131171
type "192.168.1.11"
click #131172
type "198.51.100.10"
click #131174
type "80"
click #131177
expect text:"Dropped" exists
expect text:"List 110, line 10: deny tcp host 192.168.1.11 any eq www" exists
