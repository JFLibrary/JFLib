#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/cables.jfnet
# the choice of a cable first (workspace/palette.rs, canvas/connect.rs): the palette's Kabel part
# sets the Verbinden tool with a kind until Esc or another tool; only pairs that fit are offered,
# what fits nowhere is refused with its reason at the target; a wrong copper kind may be connected
# and shows its fault under "Auto-MDI-X aus"; the choice's list holds the kind while the ports
# change; the keyboard; the new kinds in the context menu; category and colour in the inspector.
# World (0, 0) shows at 630,320: the middle of a device at (x, y) is 662 + x, 344 + y.
# Ids: the search 16385, the port lists' rows 12545 + i / 12801 + i, the choice's cable 12337, the
# cable inspector's kind 20496, category 127040, colour 127041, "Auto-MDI-X aus" 127042.
theme light
expect text:"9 Geräte · 0 Kabel" exists
# closed until it is opened; the search looks at the kinds too
expect button:"Kabel: Automatisch" missing
click #16385
type "koax"
expect button:"Kabel: Koaxialkabel" exists
expect button:"Kabel: Automatisch" missing
key ctrl+a
key delete
expect button:"Kabel: Koaxialkabel" missing
click button:"Kabel (14)"
expect button:"Kabel: Automatisch" exists
expect button:"Kabel: Seriell, erstes Ende DCE" exists
expect button:"Kabel: Seriell, erstes Ende DTE" exists
expect button:"Kabel: Telefonkabel (RJ11)" exists
expect button:"Kabel: Koaxialkabel" exists
expect button:"Kabel: Direktkabel (DAC)" exists
expect button:"Kabel: Aktives Glasfaserkabel (AOC)" exists
# its limits in the tooltip
move button:"Kabel: Direktkabel (DAC)"
wait 600
expect text:"Direktkabel (DAC) · 7 m bei 10G, 7 m bei 100G" exists
move 700,600
# a tile sets Verbinden with its kind, the status bar says so
click button:"Kabel: Glasfaser, Singlemode"
expect button:"Verbinden" checked
expect button:"Kabel: Glasfaser, Singlemode" checked
expect text:"Verbinden: Glasfaser, Singlemode" exists
shot build/jfnetworker/cable_palette_chosen.png
# only the ports it plugs into, only pairs that fit: the switches' four cages each
drag listitem:"SW1" listitem:"SW2"
expect text:"Ports wählen" exists
expect #12337 text "Glasfaser, Singlemode"
expect text:"Gi1/0/1" missing
expect #12545 selected
expect #12801 selected
expect #12549 missing
shot build/jfnetworker/cable_palette_choice.png
key enter
expect text:"Ports wählen" missing
expect text:"SW1 Te1/1/1 – SW2 Te1/1/1" exists
expect #20496 text "Glasfaser, Singlemode"
# a real fault: SR optics on single-mode fibre
expect text:"Die Faser passt nicht zur Optik SR. Die Leitung bleibt aus." exists
# the kind stays; Shift connects at once with it
expect button:"Kabel: Glasfaser, Singlemode" checked
drag listitem:"SW1" listitem:"SW2" 8 shift
expect text:"SW1 Te1/1/2 – SW2 Te1/1/2" exists
expect #20496 text "Glasfaser, Singlemode"
expect text:"9 Geräte · 2 Kabel" exists
# fibre into RJ45: refused at the target with its reason, no choice, no cable
down 662,284
move 600,240
move 420,180
move 384,166
wait 600
expect text:"Glasfaser, Singlemode passt nicht in einen RJ45-Port." exists
shot build/jfnetworker/cable_palette_refused.png
up
expect text:"Ports wählen" missing
expect box:"Dieses Kabel passt hier nicht" exists
expect text:"9 Geräte · 2 Kabel" exists
# Esc ends the tool and the kind, the warning goes with them (a cable selected stays so)
key esc
expect button:"Auswahl" checked
expect text:"Verbinden: Glasfaser, Singlemode" missing
expect box:"Dieses Kabel passt hier nicht" missing
# undo: each connection one step
key ctrl+z
expect text:"9 Geräte · 1 Kabel" exists
key ctrl+y
expect text:"9 Geräte · 2 Kabel" exists
# Auto-MDI-X aus: one undo step
click 640,500
expect #127042 value 0
click #127042
expect #127042 value 1
key ctrl+z
expect #127042 value 0
key ctrl+y
expect #127042 value 1
# a wrong copper kind may be connected and shows its fault as a real one does
click button:"Kabel: Kupfer, gekreuzt"
drag listitem:"PC1" listitem:"SW1"
expect #12337 text "Kupfer, gekreuzt"
expect #12545 selected
key enter
expect text:"PC1 eth0 – SW1 Gi1/0/1" exists
expect #20496 text "Kupfer, gekreuzt"
expect text:"unten · 0 Pakete/s" exists
click tab:"Probleme"
expect text:"Falsches Kabel zwischen PC1 eth0 und SW1 Gi1/0/1: hierher gehört Kupfer, gerade; ohne Auto-MDI-X bleibt die Leitung aus." exists
shot build/jfnetworker/cable_palette_fault.png
key esc
# with Auto-MDI-X it works: the setting off again
click 640,500
click #127042
expect #127042 value 0
expect text:"3 (1 aktiv)" exists
# a serial line with a chosen end
click button:"Kabel: Seriell, erstes Ende DTE"
drag listitem:"R1" listitem:"R2"
expect #12337 text "Seriell, erstes Ende DTE"
key enter
expect text:"R1 Se0/2/0 – R2 Se0/2/0" exists
expect #20496 text "Seriell, erstes Ende DTE"
# Automatisch as ever; the list holds the kind, not its place, while the ports change, and the
# right kind stands in it once
click button:"Kabel: Automatisch"
expect text:"Verbinden" exists
drag listitem:"R1" listitem:"R2"
expect #12337 text "Automatisch: Glasfaser, Multimode"
focus #12337
key down
expect #12337 text "Glasfaser, Singlemode"
key down
expect #12337 text "Direktkabel (DAC)"
click #12545
expect #12337 text "Automatisch: Kupfer, gekreuzt"
click #12549
expect #12337 text "Direktkabel (DAC)"
key enter
expect text:"R1 Te0/1/0 – R2 Te0/1/0" exists
expect #20496 text "Direktkabel (DAC)"
# the inspector: category and colour on copper; each one undo step
key v
click listitem:"Kabel PC1 eth0 – SW1 Gi1/0/1, Kupfer, gekreuzt, aktiv"
expect #127040 text "Ohne Angabe"
focus #127040
key down
expect #127040 text "Cat5e"
key ctrl+z
expect #127040 text "Ohne Angabe"
key ctrl+y
expect #127040 text "Cat5e"
focus #127041
key down
expect #127041 text "Blau"
key ctrl+z
expect #127041 text "Farbe der Kabelart"
key ctrl+y
expect #127041 text "Blau"
expect text:"PC1 eth0 – SW1 Gi1/0/1" exists
# the context menu: only kinds that plug in, the category stays on the other copper kind
rclick 452,224
click menuitem:"Kabeltyp"
expect menuitem:"Koaxialkabel" disabled
expect menuitem:"Direktkabel (DAC)" disabled
expect menuitem:"Kupfer, gerade" enabled
click menuitem:"Kupfer, gerade"
expect #20496 text "Kupfer, gerade"
expect #127040 text "Cat5e"
# the context menu offers the new kinds where they plug in
rclick 592,281
click menuitem:"Kabeltyp"
expect menuitem:"Direktkabel (DAC)" enabled
expect menuitem:"Aktives Glasfaserkabel (AOC)" enabled
expect menuitem:"Telefonkabel (RJ11)" disabled
expect menuitem:"Seriell, erstes Ende DCE" disabled
click menuitem:"Aktives Glasfaserkabel (AOC)"
expect #20496 text "Aktives Glasfaserkabel (AOC)"
key ctrl+z
expect #20496 text "Glasfaser, Singlemode"
# the keyboard: Ctrl+1 to the search, Tab to the part's expander, Tab to its tiles (one stop, the
# arrows move), Enter chooses
key ctrl+1
expect #16385 focused
key tab
key tab
expect button:"Kabel: Automatisch" focused
key right
expect button:"Kabel: Kupfer, gerade" focused
key enter
expect button:"Kabel: Kupfer, gerade" checked
expect text:"Verbinden: Kupfer, gerade" exists
key enter
expect button:"Kabel: Kupfer, gerade" checked
key esc
expect button:"Auswahl" checked
expect text:"Verbinden: Kupfer, gerade" missing
# a click on the chosen tile gives it up, C keeps the kind
click button:"Kabel: Koaxialkabel"
key c
expect text:"Verbinden: Koaxialkabel" exists
click button:"Kabel: Koaxialkabel"
expect button:"Auswahl" checked
expect_nowarn
