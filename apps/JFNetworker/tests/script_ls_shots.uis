#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/scripts.jfnet
# the shot matrix of the Skripte tab's language services (SK6): SRV1's zaehler with the
# completion list of net. (the host's names, the description of the chosen one), signature help
# of net.listen, the flyout of Name umbenennen and the outline beside the editor; light and dark
# at 100 and 150 % (build/jfnetworker/script_ls_<what>_<theme>_<scale>.png).  Ids: 26624 the
# device window, 53280 the editor.
size 1280 900
theme light
wait 3500
rclick listitem:"SRV1"
move 700,300
click menuitem:"Skripte …"
expect window 26624 open
wait 600
click #53280
key ctrl+end
type "\nnet."
expect listitem:"connect – net.connect(addr, port, handlers)" exists
shot build/jfnetworker/script_ls_complete_light_100.png window 26624
theme dark
shot build/jfnetworker/script_ls_complete_dark_100.png window 26624
scale 150 window 26624
focus #53280
key ctrl+space
shot build/jfnetworker/script_ls_complete_dark_150.png window 26624
theme light
shot build/jfnetworker/script_ls_complete_light_150.png window 26624
scale 100 window 26624
# signature help
focus #53280
key esc
type "listen(80, "
expect text:"net.listen(port, handlers) – handlers – Wartet auf TCP-Verbindungen; handlers ist eine Map mit accept, data, close und binary." exists
shot build/jfnetworker/script_ls_signature_light_100.png window 26624
theme dark
shot build/jfnetworker/script_ls_signature_dark_100.png window 26624
scale 150 window 26624
focus #53280
key ctrl+shift+space
shot build/jfnetworker/script_ls_signature_dark_150.png window 26624
theme light
shot build/jfnetworker/script_ls_signature_light_150.png window 26624
scale 100 window 26624
# the rename flyout on n
focus #53280
key esc
key ctrl+home
key down
key right
key right
key right
key right
key f2
expect #81921 focused
expect #81921 text "n"
shot build/jfnetworker/script_ls_rename_light_100.png window 26624
theme dark
shot build/jfnetworker/script_ls_rename_dark_100.png window 26624
theme light
expect_nowarn
