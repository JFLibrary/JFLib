#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/sessions.jfnet
# a further session of a PC in the Terminal panel (X1e, doc/console.rs new_tab): "Neue Sitzung"
# opens ADMIN's second terminal as the tab "ADMIN (2)" with its own prompt and working
# directory next to the console's; switching the tabs shows each one's directory, who lists
# both terminals, closing the tab ends the session.
# Ids: ADMIN's console 25088 (input 25089); the first further session's console 106496 (input
# 106497, ID_SES0).
size 1280 900
theme light
wait 600
drag 630,671 630,380 8
dblclick listitem:"ADMIN"
expect tab:"ADMIN" selected
expect #25089 focused
type "cd /etc\n"
expect text:"root@ADMIN:/etc# " exists
# the second session: its own tab, its own prompt
click button:"Neue Sitzung"
expect tab:"ADMIN (2)" selected
expect #106497 focused
expect text:"root@ADMIN:~# " exists
type "mkdir -p /tmp/zwei\n"
type "cd /tmp/zwei\n"
expect text:"root@ADMIN:~# cd /tmp/zwei" exists
expect text:"root@ADMIN:/tmp/zwei# " exists
type "tty\n"
expect text:"/dev/pts/0" exists
# the console kept its directory
click tab:"ADMIN"
expect tab:"ADMIN" selected
expect text:"root@ADMIN:/etc# " exists
type "who\n"
expect text:"root     pts/0        2025-12-31 23:59" exists
# and the session its own
click tab:"ADMIN (2)"
expect tab:"ADMIN (2)" selected
expect text:"root@ADMIN:/tmp/zwei# " exists
shot build/jfnetworker/sessions_terminal.png
# closing the tab ends the session
click button:"Konsole schließen"
expect tab:"ADMIN (2)" missing
expect tab:"ADMIN" selected
click #25089
type "clear; who\n"
wait 200
expect text:"root     tty1         2025-12-31 23:59" exists
expect_nowarn
