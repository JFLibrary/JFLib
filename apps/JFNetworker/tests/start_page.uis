#!args --verify-dirty --start-page --recent=apps/JFNetworker/tests/fixtures/two_pcs.jfnet --recent=build/st1/gone.jfnet --recent=apps/JFNetworker/tests/fixtures/office.jfnet|C:/Windows/win.ini
# the start page (workspace/startpage.rs): it opens on Neu, Zuletzt and Lernen with the first card
# in the keyboard's hands; the empty project; a template (without a file, saving asks for a new
# name); Datei › Startseite with an unsaved project (the save question); the recent files: one that
# opens, a missing one that is marked and leaves the list, one outside what the app may read (the
# file dialog, as in the menu); a lab and an assessment; Tab through the cards and Enter; the
# Projektinfo dialog into the inspector; the setting.  --recent= gives a headless run its recent
# files: one path alone is granted by the command line, several joined with | are not.  Ids:
# 129040 "Leeres Projekt", 129041 .. 129045 the templates, 129056 + i the recent rows, 129072 + i
# their removal, 129026 Öffnen …, 129280 + i the cards of Lernen, 1000 Datei › Startseite, 1001
# Projektinfo.  start_page_shots.uis has the pictures, start_page_recover.uis the recovery bar.
size 1280 800
theme light
# ---- the page instead of the workspace: the menu bar stays
expect menu:"Datei" exists
expect text:"Neu" exists
expect text:"Zuletzt" exists
expect text:"Lernen" exists
expect button:"Leeres Projekt" exists
expect button:"Vorlage: Heimnetz" exists
expect button:"Vorlage: Büro mit VLANs" exists
expect button:"Vorlage: Campus" exists
expect button:"Vorlage: Rechenzentrum (Leaf-Spine)" exists
expect button:"Vorlage: Webdienst hinter Loadbalancer" exists
expect text:"Heimrouter mit WLAN und DHCP, dazu PC, Drucker, Laptop und Smartphone." exists
expect tab:"Geräte" missing
expect text:"0 Geräte · 0 Kabel" missing
# the first card has the keyboard, Enter is what the window did before the page: an empty project
expect #129040 focused
# what makes no sense without a project is off
click menu:"Datei"
expect menuitem:"Speichern" disabled
expect menuitem:"Neu" exists
expect menuitem:"Startseite" disabled
expect menuitem:"Projektinfo …" disabled
key esc
click menu:"Ansicht"
expect menuitem:"Alles zeigen" disabled
key esc
key enter
expect tab:"Geräte" exists
expect text:"0 Geräte · 0 Kabel" exists
expect button:"Leeres Projekt" missing
# ---- back: nothing unsaved, no question; a template opens without a file
cmd 1000
expect dialog:"Änderungen speichern?" missing
expect button:"Leeres Projekt" exists
expect tab:"Geräte" missing
click button:"Vorlage: Büro mit VLANs"
expect tab:"Geräte" exists
expect text:"9 Geräte · 8 Kabel" exists
expect listitem:"SRV1" exists
expect #20482 text "Büro mit VLANs"
expect text:"VLANs für Büro, Technik und Server, ein Router am Trunk, DHCP und DNS." exists
expect text:"noch nicht gespeichert" exists
# a change: Datei › Startseite asks; Abbrechen stays, Verwerfen goes back
click listitem:"PC1"
key right
key esc
expect text:"geändert" exists
click menu:"Datei"
click menuitem:"Startseite"
expect dialog:"Änderungen speichern?" exists
expect text:"„buero-vlans.jfnet“ hat ungespeicherte Änderungen. Sollen sie gespeichert werden?" exists
click button:"Abbrechen"
expect dialog:"Änderungen speichern?" missing
expect listitem:"SRV1" exists
cmd 1000
click button:"Verwerfen"
expect button:"Leeres Projekt" exists
expect #129040 focused
# ---- saving a template asks for a new name, with the template's name proposed
click button:"Vorlage: Heimnetz"
expect text:"7 Geräte · 4 Kabel" exists
cmd 4
expect dialog:"Speichern unter" exists
expect #1048588 text "heimnetz.jfnet"
click button:"Abbrechen"
cmd 1000
expect button:"Leeres Projekt" exists
# ---- the recent files: name, folder, a missing one marked, the time of the one that can be read
expect text:"two_pcs.jfnet" exists
expect text:"gone.jfnet" exists
expect text:"Nicht gefunden" exists
expect button:"gone.jfnet, nicht gefunden" exists
expect #129072 missing
expect button:"Aus der Liste entfernen" exists
expect text:"office.jfnet" exists
expect text:"win.ini" exists
# the missing one goes from the list, the others stay
click button:"Aus der Liste entfernen"
expect text:"gone.jfnet" missing
expect text:"Nicht gefunden" missing
expect text:"two_pcs.jfnet" exists
# the first opens; its project takes the page down and it stays first in the list
click button:"two_pcs.jfnet"
expect tab:"Geräte" exists
expect text:"3 Geräte · 2 Kabel" exists
expect text:"PC1 und PC2 im selben Netz an SW1; SW1 hat eine Management-Adresse in VLAN 1." exists
cmd 1000
expect button:"Leeres Projekt" exists
expect text:"two_pcs.jfnet" exists
# a file the app may not read (no grant: --recent= of two paths): the file dialog at that file,
# Abbrechen leaves the page as it is
click button:"office.jfnet"
expect dialog:"Öffnen" exists
expect #1048588 text "office.jfnet"
click button:"Abbrechen"
expect dialog:"Öffnen" missing
expect button:"Leeres Projekt" exists
# ---- Öffnen …: a file that is no project leaves its message on the page
click button:"Öffnen …"
expect dialog:"Öffnen" exists
click #1048588
key ctrl+a
type "apps/JFNetworker/tests/place.uis"
click button:"Öffnen"
expect "„place.uis“ ließ sich nicht öffnen" exists
expect button:"Leeres Projekt" exists
# ---- Lernen: every lab and assessment by its title
expect button:"Campus: ein VLAN für die Studierenden" exists
expect text:"Lastverteilung: der dritte Webserver" exists
click button:"Campus: ein VLAN für die Studierenden"
expect tab:"Aufgabe" exists
expect text:"0 von 4 Zielen erreicht" exists
expect text:"noch nicht gespeichert" missing
cmd 1000
expect button:"Leeres Projekt" exists
focus #129285
key enter
expect tab:"Aufgabe" exists
expect button:"Prüfen" exists
cmd 1000
expect button:"Leeres Projekt" exists
# ---- the keyboard: Tab through the cards, Shift+Tab back, Enter opens
expect #129040 focused
key tab
expect #129041 focused
key tab
expect #129042 focused
key shift+tab
expect #129041 focused
key tab
key tab
key tab
key tab
expect #129045 focused
key tab
expect #129026 focused
key tab
expect #129056 focused
key shift+tab
key shift+tab
expect #129045 focused
key enter
expect text:"8 Geräte · 7 Kabel" exists
expect listitem:"LB1" exists
# ---- Datei › Projektinfo: description and author at the top of the inspector, one undo step
# (the labs before left the Aufgabe tab in front)
cmd 31
cmd 1001
expect dialog:"Projektinfo" exists
expect #129092 focused
key ctrl+a
type "Unser Webdienst für den Kurs"
focus #129096
type "Jo Beispiel"
click button:"Übernehmen"
expect dialog:"Projektinfo" missing
expect text:"Unser Webdienst für den Kurs" exists
expect text:"Autor" exists
expect text:"Jo Beispiel" exists
expect text:"geändert" exists
key ctrl+z
expect text:"Jo Beispiel" missing
expect text:"Ein Loadbalancer verteilt die Anfragen auf drei Webserver und prüft sie." exists
# Abbrechen changes nothing
cmd 1001
focus #129096
type "Niemand"
click button:"Abbrechen"
expect text:"Niemand" missing
# ---- the setting: in Einstellungen, on by default; here it only changes (the next start reads it)
cmd 216
expect dialog:"Einstellungen" exists
focus "Beim Start anzeigen"
expect "Beim Start anzeigen" checked
click "Beim Start anzeigen"
expect "Beim Start anzeigen" unchecked
click "Beim Start anzeigen"
expect "Beim Start anzeigen" checked
click button:"Schließen"
expect_nowarn
