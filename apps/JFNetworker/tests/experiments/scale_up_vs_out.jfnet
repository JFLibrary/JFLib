{
  "format": "jfn",
  "version": 1,
  "title": "Größer oder mehr? Ein Webdienst mit Datenbank",
  "description": "GEN schickt Last an den Load Balancer LB, dahinter rechnen WEB1 bis WEB8, jeder fragt die Datenbank DB. Das Projekt simuliert Hardware. Jede Anfrage kostet 4 ms Rechenzeit am Referenzkern, dazu eine kurze Sperre im Server und in der Datenbank. Das Experiment scale_up_vs_out.jfnex vergleicht einen immer größeren Server mit immer mehr kleinen.",
  "seed": 11,
  "next_id": 50,
  "strict_mdix": false,
  "metered": true,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 40,
      "y": 200,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.0.2/"
            ],
            "mode": "open",
            "rps": 100,
            "arrival": "poisson",
            "timeout_ms": 30000,
            "connect_timeout_ms": 1000,
            "max_conns": 256
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s48x",
      "x": 220,
      "y": 200,
      "off": false,
      "startup_config": "hostname SW1\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "LB",
      "model": "load-balancer",
      "x": 400,
      "y": 80,
      "off": false,
      "startup_config": "hostname LB\nip addr add 10.0.0.2/24 dev eth0\n",
      "services": [
        {
          "kind": "lb",
          "name": "lb",
          "disabled": false,
          "config": {
            "port": 80,
            "algorithm": "least-conn",
            "cpu_us": 60,
            "health": {
              "type": "tcp",
              "interval_ms": 5000,
              "timeout_ms": 1000
            },
            "backends": [
              {
                "name": "WEB1",
                "addr": "10.0.0.11",
                "port": 80
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 4,
      "name": "DB",
      "model": "database",
      "x": 400,
      "y": 320,
      "off": false,
      "startup_config": "hostname DB\nip addr add 10.0.0.30/24 dev eth0\n",
      "services": [
        {
          "kind": "http-server",
          "name": "db",
          "disabled": false,
          "config": {
            "port": 80,
            "cpu_ms": 0.1,
            "serial_us": 170,
            "routes": [
              {
                "path": "/q",
                "body": "row"
              }
            ],
            "mem_mb": 2048,
            "conn_kb": 256
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 10,
      "name": "WEB1",
      "model": "server-s",
      "x": 620,
      "y": 40,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 10.0.0.11/24 dev eth1\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "port": 80,
            "cpu_ms": 4,
            "serial_us": 180,
            "usl": {
              "sigma": 0.01,
              "kappa": 0.0002
            },
            "routes": [
