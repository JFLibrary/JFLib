#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/dot1x_lab.jfnet
# 802.1X in the window on fixtures/dot1x_lab.jfnet: SW1's ports Gi1/0/2 and Gi1/0/3 ask for a
# login, no PC has one, so their cables say so; IP-Konfiguration's 802.1X panel on PC1 (the desktop)
# writes the supplicant's file and the port opens; the identity is needed; a wrong password on PC2
# keeps its port closed; the inspector of an enterprise network shows its RADIUS server; the
# laptop's panel for company Wi-Fi joins it.  (That the file is one step of the project: the
# selftest group dot1x.)
# Ids: the device window 26624; IP-Konfiguration's panel in window 0 at 120832: 802.1X an der
# Netzwerkbuchse + 1 (120833), method + 2, identity + 3 (120835), password + 4 (120836),
# Unternehmens-WLAN + 5 (120837), SSID + 6 (120838), method + 7, identity + 8 (120840), password +
# 9 (120841), Anmeldung übernehmen + 10 (120842).
size 1280 900
theme light
wait 500
# ---- the ports are closed: the cables say it
expect listitem:"Kabel PC1 eth0 – SW1 Gi1/0/2, Kupfer, gerade, nicht autorisiert" exists
expect listitem:"Kabel PC2 eth0 – SW1 Gi1/0/3, Kupfer, gerade, nicht autorisiert" exists
expect listitem:"Kabel R1 Gi0/0/0 – SW1 Gi1/0/4, Kupfer, gerade, aktiv" exists
# ---- PC1 logs in over its panel
dblclick listitem:"PC1" shift
expect window 26624 open
resizewin 26624 900 840
expect tab:"Desktop" selected
dblclick listitem:"IP-Konfiguration"
click button:"Maximieren: IP-Konfiguration"
expect text:"Anmeldung am Netz (802.1X)" exists
expect #120842 disabled
click #120833
# without an identity it says what is missing
click #120842
expect text:"Eine Anmeldung braucht eine Identität, im WLAN auch die SSID." exists
click #120835
type "anna"
click #120836
type "geheim"
click #120842
wait 2500
expect text:"eth0: angemeldet als anna (EAP-MD5)" exists
close window 26624
expect listitem:"Kabel PC1 eth0 – SW1 Gi1/0/2, Kupfer, gerade, aktiv" exists
expect listitem:"Kabel PC2 eth0 – SW1 Gi1/0/3, Kupfer, gerade, nicht autorisiert" exists
# ---- PC2 with a wrong password stays out, EAP-PWD this time
dblclick listitem:"PC2" shift
expect window 26624 open
resizewin 26624 900 840
dblclick listitem:"IP-Konfiguration"
click button:"Maximieren: IP-Konfiguration"
click #120833
click #120834
click listitem:"EAP-PWD"
click #120835
type "carla"
click #120836
type "falsch"
click #120842
wait 2500
expect text:"eth0: carla abgelehnt, wartet" exists
close window 26624
expect listitem:"Kabel PC2 eth0 – SW1 Gi1/0/3, Kupfer, gerade, nicht autorisiert" exists
# ---- the access point's network in the inspector
click listitem:"AP1"
expect #121856 text "10.0.0.10"
# ---- the laptop: company Wi-Fi over its panel (the network needs an identity first)
dblclick listitem:"Laptop1" shift
expect window 26624 open
resizewin 26624 900 840
dblclick listitem:"IP-Konfiguration"
click button:"Maximieren: IP-Konfiguration"
click #120837
click #120838
type "Firma"
click #120840
type "anna"
click #120841
type "geheim"
click #120842
wait 5000
expect text:"wlan0: angemeldet als anna (EAP-PWD)" exists
close window 26624
expect text:"Funk: Laptop1 – AP1 (Firma, 5 GHz, -73 dBm, 576,0 Mbit/s)" exists
