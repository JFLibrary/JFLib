#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/units.jfnet
# F5 on a file that runs as a unit (workspace/ide/debug.rs, doc/ide.rs unit_of) on DEV1 of
# fixtures/units.jfnet: web.service runs server.jfs.  Never started: nothing holds the file.  Once
# systemctl started it, the unit is the IDE's target, F5 starts it anew with the saved file (the
# project gets no second service, PC1 reads the new text), Stoppen goes through the unit, F5 starts
# it again; Neu starten the same.
# Ids: the device window 26624; the IDE from 98304: Stoppen 98325, Neu starten 98326, the editor
# 98816, Ausgabe 98569, Terminal 98570.
size 1280 900
theme light
wait 1500
rclick listitem:"DEV1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
resizewin 26624 1180 820
wait 300
dblclick listitem:"app"
wait 600
dblclick listitem:"server.jfs"
wait 300
expect tab:"server.jfs" selected
expect text:"Dienst web: läuft" missing
expect #98325 disabled
# the unit starts at the device's console
rclick listitem:"DEV1"
move 700,300
click menuitem:"Konsole öffnen"
wait 200
type "systemctl start web\n"
wait 500
activate 26624
wait 100
expect text:"Dienst web: läuft" exists
expect #98325 enabled
# a change, F5: it is saved, the unit starts anew, no second service
click #98816
key ctrl+home
type "print(\"neu geladen\")\n"
key f5
wait 300
expect #98569 selected
expect text:"Dienst web: läuft" exists
expect text:"neu geladen" exists
expect text:"bereit, Version 2" exists
rclick listitem:"PC1"
move 700,300
click menuitem:"Konsole öffnen"
wait 200
type "curl -s http://10.0.0.10/\n"
wait 500
expect text:"Version 2 von web" exists
activate 26624
wait 100
# Stoppen: through the unit; F5 starts the same unit again
click #98816
key shift+f5
wait 100
expect text:"Dienst web: gestoppt" exists
expect #98325 disabled
wait 600
key f5
wait 500
expect text:"Dienst web: läuft" exists
# Neu starten: the unit once more
wait 600
key ctrl+shift+f5
wait 500
expect text:"Dienst web: läuft" exists
# the project has no service of the file
wait 600
click tab:"Dienste"
expect text:"Skript · server" missing
expect_nowarn
