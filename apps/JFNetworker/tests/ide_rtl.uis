#!args --rtl --verify-dirty --open apps/JFNetworker/tests/fixtures/ide.jfnet
# the IDE mirrored (IDE1, ui/rtl.rs as for Arabic or Hebrew) on SRV1 of fixtures/ide.jfnet: the
# side bar on the right, the menus from the right, the code itself left to right; a file opened
# from the Explorer, a completion list and the Probleme pane work as drawn.  Shots light and dark
# (build/jfnetworker/ide_rtl_*.png).  Ids: 26624 the device window, 98816 the editor, 98571
# Probleme.
size 1280 900
theme light
wait 1500
rclick listitem:"SRV1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
resizewin 26624 1100 760
wait 300
dblclick listitem:"app"
wait 600
dblclick listitem:"server.jfs"
wait 300
expect tab:"server.jfs" selected
expect #98816 focused
# the side bar is on the right of the editor
expect tab:"Explorer" rect 1010 139 75 30
key ctrl+end
type "lib.gr"
expect listitem:"greet – fn greet(path)" exists
shot build/jfnetworker/ide_rtl_light.png window 26624
key esc
type "\nprnt(1)"
wait 300
click #98571
expect text:"server.jfs:13:1: Unbekannter Name prnt – meinst du print?" exists
theme dark
shot build/jfnetworker/ide_rtl_dark.png window 26624
theme light
expect_nowarn
