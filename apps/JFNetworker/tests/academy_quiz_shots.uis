#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/academy
# the pictures of quizzes, tests and fault hunts: a practice quiz with its explanations, a test before, during
# and after an attempt, a fault hunt with its diagnosis; light and dark, 100 and 150 %, narrow; in
# build/jfnetworker/quiz_<view>.png.  The narrow window must not scroll sideways.  Ids: as in academy_quiz.uis
# and academy_fault.uis.
size 1280 800
theme light
cmd 1005
key enter
shot build/jfnetworker/quiz_outline.png
# ---- practice: wrong, partly right, right, with their explanations
click #136195
wait 100
shot build/jfnetworker/quiz_practice_light_100.png
click #145669
click #145666
wait 100
shot build/jfnetworker/quiz_wrong_light_100.png
theme dark
wait 100
shot build/jfnetworker/quiz_wrong_dark_100.png
scale 150
wait 100
shot build/jfnetworker/quiz_wrong_dark_150.png
theme light
wait 100
shot build/jfnetworker/quiz_wrong_light_150.png
scale 100
size 800 520
wait 100
shot build/jfnetworker/quiz_wrong_narrow.png
size 1280 800
click #145668
click #145666
focus #145696
key space
focus #145694
key space
wait 200
shot build/jfnetworker/quiz_partly.png
focus #145781
wait 200
shot build/jfnetworker/quiz_order.png
theme dark
wait 100
shot build/jfnetworker/quiz_order_dark.png
theme light
size 800 520
wait 100
shot build/jfnetworker/quiz_order_narrow.png
size 1280 800
# enough to go on: the rest of the quiz
focus #145697
key space
focus #145694
key space
focus #145721
type "10.1.2.0/24"
focus #145722
key space
focus #145749
type "254"
focus #145750
key space
key esc
expect button:"Quiz: Netze und Adressen, erledigt, bestes Ergebnis 83 %" exists
wait 100
shot build/jfnetworker/quiz_outline_best.png
# ---- a test: before, during, the question, after
click #136197
wait 100
shot build/jfnetworker/quiz_exam_ready_light_100.png
theme dark
wait 100
shot build/jfnetworker/quiz_exam_ready_dark_100.png
theme light
click button:"Test beginnen"
wait 100
shot build/jfnetworker/quiz_exam_light_100.png
theme dark
wait 100
shot build/jfnetworker/quiz_exam_dark_100.png
scale 150
wait 100
shot build/jfnetworker/quiz_exam_dark_150.png
theme light
wait 100
shot build/jfnetworker/quiz_exam_light_150.png
scale 100
size 800 520
wait 100
shot build/jfnetworker/quiz_exam_narrow.png
size 1280 800
focus #145668
key space
focus #145749
type "63"
click #145410
wait 100
shot build/jfnetworker/quiz_exam_ask.png
click button:"Abgeben"
wait 100
shot build/jfnetworker/quiz_exam_result_light_100.png
theme dark
wait 100
shot build/jfnetworker/quiz_exam_result_dark_100.png
scale 150
wait 100
shot build/jfnetworker/quiz_exam_result_dark_150.png
theme light
scale 100
size 800 520
wait 100
shot build/jfnetworker/quiz_exam_result_narrow.png
size 1280 800
wheel 640,400 -600
wait 200
shot build/jfnetworker/quiz_exam_result_below.png
key esc
# ---- the fault hunt
click #136196
wait 1000
shot build/jfnetworker/fault_start_light_100.png
theme dark
wait 100
shot build/jfnetworker/fault_start_dark_100.png
scale 150
wait 100
shot build/jfnetworker/fault_start_dark_150.png
theme light
scale 100
size 800 520
wait 100
shot build/jfnetworker/fault_start_narrow.png
size 1280 800
click #145440
wait 100
shot build/jfnetworker/fault_picking.png
click listitem:"R1"
wait 100
shot build/jfnetworker/fault_picked.png
click #63810
wait 100
click button:"Abgeben"
wait 200
shot build/jfnetworker/fault_handed_in.png
theme dark
wait 100
shot build/jfnetworker/fault_handed_in_dark.png
theme light
expect_nowarn
