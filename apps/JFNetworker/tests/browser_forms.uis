#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/web_site.jfnet
# forms in the Webbrowser (B2) against the jfs script laden.jfs on WEB1 (fixtures/web_site.jfnet,
# http.serve on port 8080): a search sent with Enter goes as GET with the query in the address,
# the answer is a new entry and Back brings the form with what was typed; an order sent with its
# button goes as POST (the script reads req.form); Reload of the POST's result asks first: Abbrechen
# keeps the page, Erneut senden makes the second order; a link that redirects shows the final
# address; Stop and Esc give up a page on its way; a stopped simulation leaves the request waiting
# and says so; the page's fields take Tab from the address line
# Ids (window 0): the address 26800, Zurück 26803, Vor 26804, Neu laden 26805, the question's
# Erneut senden 26806, Abbrechen 26807; the shop's fields (md_field_id of the page 114688): Suchwort
# 3841261569, Suchen 3841261570, Ware 3841261571, Menge 3841261572, Bestellen 3841261573
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
resizewin 26624 900 680
dblclick listitem:"Webbrowser"
click #26800
key ctrl+a
type "web.lab:8080\n"
wait 1000
expect #26800 text "http://web.lab:8080/"
expect heading:"Der Laden" exists
expect dialog:"Der Laden – Webbrowser" exists
expect text:"Suchwort" exists
expect #3841261569 text ""
expect #3841261571 text "Roggenbrot"
expect #3841261572 text "1"
shot build/jfnetworker/browser_form.png window 26624
# ---- GET: the query in the address, the script's answer
click #3841261569
type "Käse & Brot\n"
wait 500
expect heading:"Suche" exists
expect #26800 text "http://web.lab:8080/suche?q=K%C3%A4se+%26+Brot"
expect text:"Gesucht wurde: Käse & Brot" exists
expect dialog:"Suche – Webbrowser" exists
shot build/jfnetworker/browser_form_get.png window 26624
# back: the form again, what was typed still in it
click #26803
expect heading:"Der Laden" exists
expect #26800 text "http://web.lab:8080/"
expect #3841261569 text "Käse & Brot"
# forward: the answer without a request, also its address
click #26804
expect text:"Gesucht wurde: Käse & Brot" exists
expect #26800 text "http://web.lab:8080/suche?q=K%C3%A4se+%26+Brot"
click link:"Zurück zum Laden"
wait 500
expect heading:"Der Laden" exists
expect #26804 disabled
# ---- POST: an order with its button
click #3841261572
key ctrl+a
type "3"
click #3841261573
wait 500
expect heading:"Bestellt" exists
expect text:"Bestellung 1: 3 mal Roggenbrot" exists
# a POST's address has no query
expect #26800 text "http://web.lab:8080/bestellen"
shot build/jfnetworker/browser_form_post.png window 26624
# Reload of a POST's result asks first
key f5
expect text:"Diese Seite ist die Antwort auf ein Formular. Neu laden sendet es noch einmal." exists
shot build/jfnetworker/browser_form_ask.png window 26624
click #26807
expect text:"Diese Seite ist die Antwort auf ein Formular. Neu laden sendet es noch einmal." missing
expect text:"Bestellung 1: 3 mal Roggenbrot" exists
click #26805
expect text:"Diese Seite ist die Antwort auf ein Formular. Neu laden sendet es noch einmal." exists
click #26806
wait 500
expect text:"Bestellung 2: 3 mal Roggenbrot" exists
expect text:"Diese Seite ist die Antwort auf ein Formular. Neu laden sendet es noch einmal." missing
# the reload took the entry's place: one Back leads to the form
key alt+left
expect heading:"Der Laden" exists
# ---- a link that redirects: the final address, the redirect in the status line
click link:"Ein Link, der weiterleitet"
wait 500
expect #26800 text "http://web.lab:8080/suche?q=weitergeleitet"
expect text:"Gesucht wurde: weitergeleitet" exists
key alt+left
expect heading:"Der Laden" exists
# ---- a page that takes long: Stop, Esc
click #26800
key ctrl+a
type "web.lab:8080/langsam\n"
wait 200
expect button:"Anhalten" exists
expect text:"Lädt von web.lab …" exists
click button:"Anhalten"
expect button:"Neu laden" exists
expect #26800 text "http://web.lab:8080/"
expect heading:"Der Laden" exists
key ctrl+l
type "web.lab:8080/langsam\n"
wait 200
key esc
expect button:"Neu laden" exists
expect heading:"Der Laden" exists
# ---- the simulation stands: the request waits and says so, then it comes
cmd 52
click #26800
key ctrl+a
type "web.lab/\n"
wait 200
expect text:"Lädt von web.lab … Die Simulation ist angehalten: die Antwort kommt, wenn sie weiterläuft." exists
expect heading:"Der Laden" exists
cmd 52
wait 500
expect heading:"Bäckerei Krume" exists
# ---- the keyboard: Tab from the page to its first stop, a link activated with Enter
click #26800
key ctrl+a
type "web.lab:8080/\n"
wait 500
expect heading:"Der Laden" exists
key tab
expect #3841261569 focused
type "Tab\n"
wait 500
expect text:"Gesucht wurde: Tab" exists
expect_nowarn
