#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/academy
# the Akademie (workspace/academy) with the sample course of apps/JFNetworker/academy: the course's card on
# the start page above the labs; the outline with its states and progress; the lessons with their pictures,
# a link, Weiter and Vorheriger Schritt; the lab with its goals, the bar over the canvas, back and forth
# without losing what was done, going on without finishing, finishing; the unsaved-changes question; the
# progress on the card; Fortschritt zurücksetzen with its question; Datei › Akademie; the language switched
# to English in a lesson; the keyboard.  A headless run keeps the progress in memory.  Ids: 130048 the
# course's card, 135170 back, 135171 Weiter of the outline, 135172 its progress, 135173 the reset, 135200 a
# lesson's document, 135201 Vorheriger Schritt, 135202 Weiter, 135217 Zurück zum Kurs, 135218 Weiter im
# Kurs, 135424 + i the list's cards, 136192 + k the steps of the outline, 129040 the page's first card,
# 49153 "Prüfen", 49168 + i the goals, 209344286 the language in the settings, 1005 Datei › Akademie.
size 1280 800
theme light
# ---- the card, a group of its own above the labs
expect text:"Akademie: Kurse mit Lektionen zum Lesen und Laboren im Simulator." exists
expect button:"Kurs: Beispielkurs: das erste Netz" exists
expect text:"Einsteiger · 40 Min. · Was ein Netz ist, wozu Adressen dienen, ein erstes Labor im Simulator, dann ein Quiz, eine Fehlersuche und ein Test." exists
expect button:"Campus: ein VLAN für die Studierenden" exists
expect #129040 focused
click button:"Kurs: Beispielkurs: das erste Netz"
# ---- the outline replaces the page: units, steps, states, no steps done
expect button:"Leeres Projekt" missing
expect tab:"Geräte" missing
expect menu:"Datei" exists
expect text:"Beispielkurs: das erste Netz" exists
expect text:"Einsteiger · 40 Min." exists
expect text:"0 von 6 Schritten erledigt" exists
expect #135172 value 0
expect text:"Grundlagen" exists
expect text:"Übung" exists
expect button:"Was ist ein Netz?, als Nächstes" exists
expect button:"Adressen" exists
expect button:"PC2 braucht eine Adresse" exists
expect button:"Beginnen" exists
expect button:"Fortschritt zurücksetzen" missing
expect #135171 focused
# what makes no sense without a project is off, the way back on
click menu:"Datei"
expect menuitem:"Speichern" disabled
expect menuitem:"Startseite" enabled
expect menuitem:"Akademie …" enabled
key esc
# ---- the first lesson: its text, its picture from the course's folder, no note about the language
click button:"Beginnen"
expect heading:"Was ist ein Netz?" exists
expect #135200 exists
expect #135200 focused
expect image:"Zwei PCs, jeder mit einem Kabel an einem Switch in der Mitte" exists
expect text:"Schritt 1 von 6" exists
expect "Diese Lektion gibt es noch nicht in Ihrer Sprache" missing
expect #135201 missing
expect button:"Weiter" exists
# a link inside the course: the lesson it names; that is no Weiter, the first stays open
click link:"nächsten Lektion"
expect text:"Schritt 2 von 6" exists
expect heading:"Adressen" exists
expect image:"Links ein Netz mit zwei Hosts, rechts ein zweites Netz mit einem Host; die beiden berühren sich nicht" exists
expect #135201 exists
# Vorheriger Schritt, then on with Weiter: now the first is done
click button:"Vorheriger Schritt"
expect text:"Schritt 1 von 6" exists
click button:"Weiter"
expect text:"Schritt 2 von 6" exists
# Esc: to the outline, on the step just left, and the states have moved
key esc
expect text:"1 von 6 Schritten erledigt" exists
expect #135172 value 1
expect button:"Was ist ein Netz?, erledigt" exists
expect button:"Adressen, als Nächstes" exists
expect button:"Weiter" exists
expect #136193 focused
expect button:"Fortschritt zurücksetzen" exists
# ---- Alt+Left: to the start page, on the course's card, with how far it is
key alt+left
expect button:"Leeres Projekt" exists
expect #130048 focused
expect text:"1 von 6" exists
key enter
expect text:"1 von 6 Schritten erledigt" exists
# ---- the next open step, through to the lab: the bar, the goals, no file; the first frame of the dock
click button:"Weiter"
expect text:"Schritt 2 von 6" exists
click button:"Weiter"
expect text:"PC2 braucht eine Adresse · Beispielkurs: das erste Netz" exists
expect button:"Zurück zum Kurs" exists
expect button:"Weiter im Kurs" exists
expect tab:"Aufgabe" exists
expect text:"0 von 2 Zielen erreicht" exists
expect #49153 focused
expect text:"3 Geräte · 2 Kabel" exists
# back to the course: the project stays below, the page comes up, the lab is what comes next
click button:"Zurück zum Kurs"
expect tab:"Geräte" missing
expect text:"2 von 6 Schritten erledigt" exists
expect button:"PC2 braucht eine Adresse, als Nächstes" exists
expect #136194 focused
# ... and into the same lab again: nothing is reloaded, no question, the Aufgabe in front (also when
# the learner had gone to another tab)
key esc
click tab:"Eigenschaften"
expect #49153 missing
click button:"Zurück zum Kurs"
expect #136194 focused
key enter
expect dialog:"Änderungen speichern?" missing
expect tab:"Geräte" exists
expect text:"0 von 2 Zielen erreicht" exists
expect #49153 focused
# a change, then back and forth: still no question, and Datei › Startseite knows of the change
wait 1000
click listitem:"PC2"
key right
key esc
click button:"Zurück zum Kurs"
expect dialog:"Änderungen speichern?" missing
expect button:"Zurück zum Labor" exists
key esc
expect text:"PC2 braucht eine Adresse · Beispielkurs: das erste Netz" exists
cmd 1000
expect dialog:"Änderungen speichern?" exists
expect text:"„erstes-netz.jfnet“ hat ungespeicherte Änderungen. Sollen sie gespeichert werden?" exists
click button:"Abbrechen"
expect button:"Weiter im Kurs" exists
# going on without finishing leaves it open: the next step shows, the lab is what comes next in the outline
click button:"Weiter im Kurs"
expect text:"Quiz: Netze und Adressen" exists
key esc
expect text:"2 von 6 Schritten erledigt" exists
expect button:"PC2 braucht eine Adresse, als Nächstes" exists
key esc
# ---- finishing it: a console line, the goals follow, the step is done, the bar says so
wait 200
dblclick listitem:"PC2"
type "ip addr add 10.0.0.2/24 dev eth0\n"
wait 3000
expect #49168 checked
expect #49169 checked
expect text:"2 von 2 Zielen erreicht" exists
expect text:"Geschafft: alle Ziele erreicht." exists
click button:"Weiter im Kurs"
expect text:"Quiz: Netze und Adressen" exists
key esc
expect text:"3 von 6 Schritten erledigt" exists
expect #135172 value 3
expect button:"PC2 braucht eine Adresse, erledigt" exists
expect button:"Quiz: Netze und Adressen, als Nächstes" exists
# Speichern unter proposes the lab's file name, as with every lab
key esc
cmd 4
expect dialog:"Speichern unter" exists
expect #1048588 text "erstes-netz.jfnet"
click button:"Abbrechen"
# ---- Fortschritt zurücksetzen: the question, Abbrechen changes nothing, Zurücksetzen all of this course
click button:"Zurück zum Kurs"
click button:"Fortschritt zurücksetzen"
expect dialog:"Fortschritt zurücksetzen?" exists
expect text:"Alles, was Sie in „Beispielkurs: das erste Netz“ erledigt haben, gilt dann wieder als offen. Das lässt sich nicht rückgängig machen." exists
click button:"Abbrechen"
expect dialog:"Fortschritt zurücksetzen?" missing
expect text:"3 von 6 Schritten erledigt" exists
click button:"Fortschritt zurücksetzen"
click button:"Zurücksetzen"
expect dialog:"Fortschritt zurücksetzen?" missing
expect text:"0 von 6 Schritten erledigt" exists
expect #135172 value 0
expect button:"Was ist ein Netz?, als Nächstes" exists
expect button:"Fortschritt zurücksetzen" missing
expect button:"Beginnen" exists
expect #135171 focused
# the lab is still the project below: its step shows it as it is, without a question
click #136194
expect dialog:"Änderungen speichern?" missing
expect text:"2 von 2 Zielen erreicht" exists
# ---- Datei › Akademie: the list of courses over the project; back leads to the project
cmd 1005
expect text:"Akademie" exists
expect button:"Kurs: Beispielkurs: das erste Netz" exists
expect button:"Zurück zum Labor" exists
expect #135424 focused
key enter
expect text:"0 von 6 Schritten erledigt" exists
expect button:"Alle Kurse" exists
expect #135171 focused
key alt+left
expect #135424 focused
key esc
expect tab:"Geräte" exists
expect button:"Weiter im Kurs" exists
# ---- the project goes: the bar goes with it, after the question about its changes
cmd 1
expect dialog:"Änderungen speichern?" exists
click button:"Verwerfen"
expect button:"Weiter im Kurs" missing
# a free lab with a change stands in the way of the course's lab: the question, Abbrechen stays on the page
cmd 300
click text:"Campus: ein VLAN für die Studierenden"
click button:"Öffnen"
expect text:"0 von 4 Zielen erreicht" exists
expect button:"Weiter im Kurs" missing
wait 500
click listitem:"PC1"
key right
key esc
cmd 1005
key enter
expect button:"Zurück zum Kurs" missing
click #136194
expect dialog:"Änderungen speichern?" exists
click button:"Abbrechen"
expect dialog:"Änderungen speichern?" missing
expect text:"0 von 6 Schritten erledigt" exists
click #136194
click button:"Verwerfen"
expect text:"0 von 2 Zielen erreicht" exists
expect button:"Weiter im Kurs" exists
# ---- the keyboard: Tab through the steps, Shift+Tab back, Enter opens, Esc returns to the step
click button:"Zurück zum Kurs"
expect #136194 focused
key shift+tab
expect #136193 focused
key shift+tab
expect #136192 focused
key shift+tab
expect #135171 focused
key shift+tab
expect #135170 focused
key tab
key tab
expect #136192 focused
key enter
expect text:"Schritt 1 von 6" exists
expect #135200 focused
key esc
expect #136192 focused
# ---- the window's language switched while a lesson shows: the lesson in it, the page's own texts too
key enter
expect text:"Schritt 1 von 6" exists
cmd 216
expect dialog:"Einstellungen" exists
focus #209344286
click #209344286
click "English"
expect dialog:"Settings" exists
click button:"Close"
expect text:"Step 1 of 6" exists
expect heading:"What is a network?" exists
expect image:"Two PCs, each with a cable to a switch in the middle" exists
expect button:"Next" exists
key esc
expect text:"Sample course: your first network" exists
expect text:"The basics" exists
expect text:"Beginner · 40 min" exists
expect button:"Reset progress" missing
cmd 216
focus #209344286
click #209344286
click "Deutsch"
click button:"Schließen"
expect text:"Beispielkurs: das erste Netz" exists
expect_nowarn
