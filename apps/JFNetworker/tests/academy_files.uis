#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/tests/fixtures/academy
# the Akademie with courses that are not all right (tests/fixtures/academy): a bad path and an unknown step
# kind, a version from the future, a folder without a course.json: each a card with its message, and they
# hurt nothing else; a lesson in one language only, with the note; links that are refused, pictures that are
# not read; quizzes, fault hunts and exams that are only announced (no file yet) in the outline as not available, without a button.  Ids: 130048
# + i the cards of the start page in the order of the folders (halb, kaputt, neu, ohne), 135170 back, 135171
# Weiter, 136192 + k the steps of a course (quiz 136195, fault hunt 136196, exam 136197), 135202 a lesson's Weiter.
size 1280 800
theme light
# ---- the cards: three bad ones say so, the good one and the labs stay
expect button:"Kurs: Halb fertig" exists
expect button:"Kurs: Kaputt" exists
expect button:"Kurs: Aus der Zukunft" missing
expect button:"Kurs: neu" exists
expect button:"Kurs: ohne" exists
expect button:"Campus: ein VLAN für die Studierenden" exists
# ---- a bad path, an unknown kind: exactly what is wrong, no steps
click button:"Kurs: Kaputt"
expect text:"Kaputt" exists
expect text:"Dieser Kurs lässt sich nicht öffnen. Das stimmt mit seinen Dateien nicht:" exists
expect text:"Schritt 1: Der Pfad „../../../secret.md“ führt mit „..“ aus dem Ordner des Kurses." exists
expect text:"Schritt 2: die Art „vortrag“ gibt es nicht (lesson, lab, quiz, fault, exam)." exists
expect #136192 missing
expect #135171 missing
expect #135170 focused
key esc
expect button:"Leeres Projekt" exists
# ---- a newer version, a folder without its file
click button:"Kurs: neu"
expect text:"Die Datei hat die Version 99; dieses Programm liest Version 1 bis 1." exists
key esc
click button:"Kurs: ohne"
expect text:"Die Datei course.json fehlt oder lässt sich nicht lesen." exists
key esc
# ---- announced, with no file yet: in the outline, disabled, with its reason; Weiter passes over it
click button:"Kurs: Halb fertig"
expect text:"Erfahrene · 5 Min." exists
expect text:"0 von 4 Schritten erledigt" exists
expect button:"Ein Quiz, noch nicht verfügbar" exists
expect #136195 disabled
expect #136196 disabled
expect #136197 disabled
expect button:"Eine Fehlersuche, noch nicht verfügbar" exists
expect button:"Eine Prüfung, noch nicht verfügbar" exists
shot build/jfnetworker/academy_not_yet.png
# nothing to activate: a click stays on the page
click #136195
expect text:"0 von 4 Schritten erledigt" exists
expect_nowarn
# ---- German only, in German: no note
click button:"Beginnen"
expect text:"Diese Lektion gibt es nur auf Deutsch." exists
expect "Diese Lektion gibt es noch nicht in Ihrer Sprache" missing
# English only, in German: the note, and it reads on
click button:"Weiter"
expect text:"This lesson exists in English only." exists
expect "Diese Lektion gibt es noch nicht in Ihrer Sprache" exists
shot build/jfnetworker/academy_other_language.png
click button:"Close"
expect "Diese Lektion gibt es noch nicht in Ihrer Sprache" missing
click button:"Weiter"
# ---- links and pictures: a step: link goes; a step that does not exist, a file and the web are refused;
# a picture outside the course shows its alt text and reads nothing
expect text:"Schritt 3 von 7" exists
expect image:"Ein Bild außerhalb des Kurses" exists
expect image:"Ein Bild, das fehlt" exists
click link:"Weblink"
expect "Der Link „https://example.org/“ geht nicht auf" exists
expect text:"Schritt 3 von 7" exists
click link:"falscher Schritt"
expect "Der Link „step:gibt-es-nicht“ geht nicht auf" exists
click link:"Dateilink"
expect "Der Link „nur-de.md“ geht nicht auf" exists
shot build/jfnetworker/academy_refused.png
click link:"ersten Lektion"
expect text:"Schritt 1 von 7" exists
expect "Der Link „nur-de.md“ geht nicht auf" missing
key esc
expect #136192 focused
# ---- on from the last ready step before the quiz: over the three that are not available
click #136194
click button:"Weiter"
expect text:"Schritt 7 von 7" exists
expect button:"Zur Kursübersicht" exists
click button:"Vorheriger Schritt"
expect text:"Schritt 3 von 7" exists
key esc
click #136198
click button:"Zur Kursübersicht"
expect button:"Zum Schluss, erledigt" exists
expect_nowarn
