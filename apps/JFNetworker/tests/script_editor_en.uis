#!args --verify-dirty --lang en --open apps/JFNetworker/tests/fixtures/scripts.jfnet
# the IDE in English (U7, IDE1): the context menu, the IDE tab, the Explorer's inline scripts, the
# status line, the messages of a run in Problems, Output, the tool bar's names, a template (its
# comments and texts in English) as a new file on PC1, which has no script yet, and the keys in
# the overview of the shortcuts.  The messages of lib/script and of the running program stay
# German.  Ids as in script_editor.uis: 26624 the device window, 98305 File, 98816 the editor,
# 98569 Output, 98571 Problems (rows 99073 + i).
size 1280 900
theme light
wait 3500
rclick listitem:"SRV1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
expect tab:"IDE" selected
resizewin 26624 1100 760
wait 300
expect listitem:"Embedded scripts" exists
dblclick listitem:"zaehler"
wait 300
expect tab:"zaehler (embedded)" selected
expect text:"1 error, 0 warnings" exists
expect text:"as in the project" exists
expect tab:"Output" selected
expect tab:"Problems (1)" exists
expect button:"Run as service" enabled
expect button:"Stop" enabled
expect button:"Restart" enabled
expect button:"Save" disabled
wait 600
click #98571
expect text:"zaehler (embedded):13:15: Error while running (timer, at 3.000 s): Division durch 0" exists
wait 600
click #99073
wait 100
expect text:"Line 13, column 15" exists
expect text:"13:15: Error while running (timer, at 3.000 s): Division durch 0" exists
key ctrl+end
type "\nlet = 5"
wait 300
expect text:"2 errors, 0 warnings" exists
expect tab:"zaehler (embedded) ●" selected
key ctrl+s
expect text:"The script does not compile: line 17, column 5: Nach let fehlt ein Name" exists
shot build/jfnetworker/script_editor_en.png window 26624
key ctrl+z ctrl+z
close window 26624
expect window 26624 closed
# PC1 has no script yet; File › New script makes one from a template, in English
rclick listitem:"PC1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
expect text:"No file open" exists
wait 600
click #98305
click menuitem:"New script: UDP echo"
move 700,300
wait 200
expect tab:"echo.jfs" selected
expect #98816 text "// UDP echo: sends every datagram back to its sender.\nlet port = config.port ?? 7\nnet.udp(port, fn(sock, msg) {\n  metrics.inc(\"echos\")\n  sock.send(msg.from, msg.port, msg.data)\n})\nlog(\"Echo ready on UDP port ${port}\")\n"
shot build/jfnetworker/script_editor_en_template.png window 26624
close window 26624
# the keys of the IDE in the overview of the shortcuts
key f1
expect text:"IDE" exists
expect text:"save the file (one undo step of the project)" exists
expect text:"step over / into / out" exists
key esc
expect_nowarn
