#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/academy
# the course Fehlersuche walked by clicks as a learner does: its outline and a lesson with its picture; the first
# hunt: a pulled cable that nothing announces, the panels that stay hidden, a wrong answer that costs the points,
# Neu beginnen, the new cable, the right diagnosis by the list, handing in with what the explanation says; a hunt
# at the console (a shut port); the hunt with several faults and a time limit, locked until its steps are done, and
# its result only at the end; English.  Ids: 136192 + k the steps of the outline, 145424 + d the list of diagnosis d,
# 145440 + d Auf der Zeichenfläche wählen, 63810 Abgeben (49153 where the score stays hidden), 42 the tool Verbinden,
# 40 the tool Auswahl, 209344286 the language in the settings.
size 1280 800
theme light
expect button:"Kurs: Fehlersuche im Netz" exists
expect text:"Fortgeschrittene · 200 Min. · Eine Methode statt Raten: von unten nach oben, eingrenzen, eine Änderung auf einmal. Dann kaputte Netze zum Reparieren, von einem gezogenen Kabel bis zu mehreren Fehlern gegen die Uhr." exists
click button:"Kurs: Fehlersuche im Netz"
expect text:"0 von 20 Schritten erledigt" exists
expect text:"Die Methode" exists
expect text:"Der Ernstfall" exists
expect button:"Fehlersuche: im falschen VLAN, gesperrt" exists
expect button:"Fehlersuche: Montagmorgen (mit Zeitgrenze), gesperrt" exists
expect button:"Test: Fehlersuche, gesperrt" exists
# ---- a lesson and its picture
click button:"Beginnen"
expect heading:"Erst denken, dann tippen" exists
wheel 640,400 -6000
wait 100
click link:"nächsten Lektion"
expect heading:"Von unten nach oben" exists
expect image:"Vier Schichten übereinander, jede mit ihren Befehlen: Kabel und Ports, Rahmen, Wege, Anwendung" exists
key esc
# ---- the first hunt: broken from the start, nothing tells
focus #136198
key enter
expect text:"Fehlersuche: der Dateiserver ist weg · Fehlersuche im Netz" exists
expect tab:"Aufgabe" exists
expect tab:"Probleme" missing
expect text:"Der Dateiserver ist weg" exists
expect text:"Welches Kabel war schuld?" exists
expect #145424 text "Keine Antwort gewählt"
expect listitem:"Kabel SW1 Gi1/0/3 – SRV1 eth0, Kupfer, gerade, unten" exists
wait 500
click tab:"Eigenschaften"
click listitem:"Kabel SW1 Gi1/0/3 – SRV1 eth0, Kupfer, gerade, unten"
expect button:"Kabel ziehen" missing
expect "Wiederherstellen" missing
key esc
click tab:"Aufgabe"
# what a learner tries first
dblclick listitem:"PC1"
type "ping -c 1 10.0.0.12\n"
wait 1500
type "ping -c 1 10.0.0.10\n"
wait 4000
dblclick listitem:"SRV1"
type "ip -br link\n"
wait 500
# ---- a wrong answer, handed in untouched: below the mark, the explanation comes anyway
click #145424
click "PC1 eth0 – SW1 Gi1/0/1"
click #63810
click button:"Abgeben"
expect text:"Abgegeben: die Bewertung ist endgültig." exists
expect text:"0 von 10 Punkten · 0 %" exists
expect text:"Ihre Antwort: PC1 eth0 – SW1 Gi1/0/1" exists
click button:"Zurück zum Kurs"
expect text:"0 von 20 Schritten erledigt" exists
key esc
# ---- Neu beginnen, then the repair: the cable replaced, the right cable named
click button:"Neu beginnen"
wait 1000
expect #145424 text "Keine Antwort gewählt"
click listitem:"Kabel SW1 Gi1/0/3 – SRV1 eth0, Kupfer, gerade, unten"
key delete
cmd 42
drag listitem:"SW1" listitem:"SRV1" 8 shift
cmd 40
expect text:"4 Geräte · 3 Kabel" exists
wait 3000
click #49153
wait 2500
expect text:"7 von 10 Punkten · 70 %" exists
click #145424
click "SW1 Gi1/0/3 – SRV1 eth0"
click #63810
click button:"Abgeben"
expect text:"10 von 10 Punkten · 100 %" exists
expect text:"Richtig: SW1 Gi1/0/3 – SRV1 eth0" exists
expect text:"Das Kabel zwischen SW1 und SRV1 war gezogen. ip -br link auf SRV1 sagt DOWN, und die Lämpchen an diesem Kabel bleiben dunkel. Dass die PCs einander erreichen, schließt den Switch als Ganzes aus: Nur noch dieser eine Weg blieb übrig." exists
click button:"Zurück zum Kurs"
expect button:"Fehlersuche: der Dateiserver ist weg, erledigt, bestes Ergebnis 100 %" exists
expect text:"1 von 20 Schritten erledigt" exists
# ---- the next hunt, repaired at the console of the switch
focus #136199
key enter
expect dialog:"Änderungen speichern?" exists
click button:"Verwerfen"
expect text:"Fehlersuche: PC2 ist allein · Fehlersuche im Netz" exists
wait 500
dblclick listitem:"SW1"
type "enable\n"
type "show interfaces GigabitEthernet1/0/2\n"
wait 500
key space
wait 200
type "configure terminal\n"
type "interface GigabitEthernet1/0/2\n"
type "no shutdown\n"
type "end\n"
wait 3000
click #145424
click "SW1"
click #63810
click button:"Abgeben"
wait 200
expect text:"10 von 10 Punkten · 100 %" exists
expect text:"Richtig: SW1" exists
click button:"Zurück zum Kurs"
expect button:"Fehlersuche: PC2 ist allein, erledigt, bestes Ergebnis 100 %" exists
expect text:"2 von 20 Schritten erledigt" exists
# ---- what the hunt against the clock waits for: the way back and the name, each by its console
focus #136205
key enter
expect text:"Fehlersuche: hin geht es, zurück nicht · Fehlersuche im Netz" exists
wait 500
dblclick listitem:"PC1"
type "traceroute -n -m 3 -w 1 10.0.2.10\n"
wait 8000
dblclick listitem:"R2"
type "enable\n"
type "configure terminal\n"
type "ip route 10.0.1.0 255.255.255.0 10.0.12.1\n"
type "end\n"
wait 1500
dblclick listitem:"PC1"
type "ping -c 3 10.0.2.10\n"
wait 4000
click #145424
click "R2"
click #63810
click button:"Abgeben"
wait 200
expect text:"10 von 10 Punkten · 100 %" exists
click button:"Zurück zum Kurs"
focus #136206
key enter
expect text:"Fehlersuche: Adresse ja, Name nein · Fehlersuche im Netz" exists
wait 500
dblclick listitem:"PC1"
type "cat /etc/resolv.conf\n"
type "echo \"nameserver 10.0.2.53\" > /etc/resolv.conf\n"
type "ping -c 2 www.firma.lab\n"
wait 6000
click #145424
click "PC1"
click #63810
click button:"Abgeben"
wait 200
expect text:"10 von 10 Punkten · 100 %" exists
click button:"Zurück zum Kurs"
expect text:"4 von 20 Schritten erledigt" exists
# ---- Montagmorgen: the clock runs, the points stay hidden; three faults, three questions
expect button:"Fehlersuche: Montagmorgen (mit Zeitgrenze)" exists
focus #136210
key enter
expect text:"Fehlersuche: Montagmorgen (mit Zeitgrenze) · Fehlersuche im Netz" exists
expect text:"Die Bewertung zeigt sich nach dem Abgeben." exists
expect text:"Welches Kabel war gezogen?" exists
expect text:"Welchem Router fehlte eine Route?" exists
expect text:"Welcher Host fragte den falschen Namensserver?" exists
wait 500
# the cable first
click listitem:"Kabel R2 Gi0/0/1 – SW2 Gi1/0/3, Kupfer, gerade, unten"
key delete
cmd 42
drag listitem:"R2" listitem:"SW2" 8 shift
cmd 40
wait 1000
dblclick listitem:"R2"
type "enable\n"
type "configure terminal\n"
type "ip route 10.0.1.0 255.255.255.0 10.0.12.1\n"
type "end\n"
wait 1000
dblclick listitem:"PC1"
type "echo \"nameserver 10.0.2.53\" > /etc/resolv.conf\n"
type "ping -c 3 10.0.2.53\n"
wait 4000
type "ping -c 2 www.firma.lab\n"
wait 3000
dblclick listitem:"PC2"
type "ping -c 3 10.0.2.80\n"
wait 4000
focus #145440
key space
click listitem:"Kabel R2 Gi0/0/1 – SW2 Gi1/0/3, Kupfer, gerade, aktiv"
focus #145441
key space
click listitem:"R2"
focus #145442
key space
click listitem:"PC1"
click #49153
click button:"Abgeben"
wait 200
expect text:"10 von 10 Punkten · 100 %" exists
expect text:"Richtig: R2 Gi0/0/1 – SW2 Gi1/0/3" exists
expect text:"Richtig: R2" exists
expect text:"Richtig: PC1" exists
click button:"Zurück zum Kurs"
expect button:"Fehlersuche: Montagmorgen (mit Zeitgrenze), erledigt, bestes Ergebnis 100 %" exists
expect text:"5 von 20 Schritten erledigt" exists
# ---- English
focus #136192
key enter
cmd 216
expect dialog:"Einstellungen" exists
focus #209344286
click #209344286
click "English"
expect dialog:"Settings" exists
click button:"Close"
expect heading:"Think first, then type" exists
key esc
expect text:"Fault finding in networks" exists
expect button:"Fault hunt: the file server is gone, done, best result 100 %" exists
focus #136199
key enter
expect dialog:"Save changes?" exists
click button:"Discard"
expect text:"Fault hunt: PC2 is on its own · Fault finding in networks" exists
expect text:"PC2 is on its own" exists
expect text:"Which device was set up wrongly?" exists
cmd 216
focus #209344286
click #209344286
click "Deutsch"
click button:"Schließen"
expect text:"PC2 ist allein" exists
expect_nowarn
