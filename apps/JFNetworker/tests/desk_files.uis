#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/shell_tour.jfnet
# the Dateimanager and the Texteditor of a host's desktop (workspace/devwin/filemgr.rs,
# editor.rs, V2) on PC1 of fixtures/shell_tour.jfnet: the Texteditor opens the device's notes
# (notizen.txt, saved with the project as before) and saves a text as a file of the device
# (Speichern unter … with its chooser), which the shell then reads with cat; the Dateimanager
# shows it, makes a folder (Neuer Ordner), renames it, copies the file into it and pastes it,
# deletes the original (undo and redo through Bearbeiten), and opens the copy in the Texteditor
# with a double click.
# Ids (window 0, desktop block 90112): the editor's text 90368, Speichern 90369, Speichern unter
# … 90372, the chooser's name 90385; the Dateimanager's new name 90641, its list 90880; the
# Terminal's input 25089.
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
# ---- the Texteditor: the notes first, then a file of the device
dblclick listitem:"Texteditor"
expect dialog:"Texteditor" exists
expect text:"notizen.txt" exists
expect text:"gesichert" exists
click #90368
type "Gruss aus dem Editor\n"
expect text:"geändert" exists
click #90372
expect text:"Speichern unter" exists
expect text:"notizen.txt (Notizen des Geräts)" exists
focus #90385
key ctrl+a
type "hallo.txt\n"
expect text:"/root/hallo.txt" exists
expect text:"gesichert" exists
shot build/jfnetworker/desk_files_editor.png window 26624
# ---- the shell sees the file
dblclick listitem:"Terminal"
expect dialog:"Terminal" exists
click #25089
type "cat hallo.txt\n"
wait 100
expect text:"root@PC1:~# cat hallo.txt" exists
expect text:"Gruss aus dem Editor" exists
# ---- the Dateimanager: the file, a new folder, a rename
click button:"Start"
click menuitem:"Dateimanager"
expect dialog:"Dateimanager" exists
expect text:"/root" exists
expect text:"hallo.txt" exists
expect text:"Textdatei" exists
click button:"Neuer Ordner"
expect #90641 text "Neuer Ordner"
key ctrl+a
type "projekt\n"
expect text:"projekt" exists
expect text:"Ordner" exists
click button:"Umbenennen"
expect #90641 text "projekt"
key ctrl+a
type "app\n"
expect text:"app" exists
expect text:"projekt" missing
# copy the file into the folder: choose it, Kopieren, into app (a double click), Einfügen
click text:"hallo.txt"
expect text:"hallo.txt gewählt" exists
click button:"Kopieren"
dblclick text:"app"
expect text:"/root/app" exists
expect text:"Einträge: 0; zum Kopieren bereit: 1" exists
click button:"Einfügen"
expect text:"hallo.txt" exists
shot build/jfnetworker/desk_files_manager.png window 26624
# back up, the original deleted, undo and redo
click button:"Nach oben"
expect text:"/root" exists
click text:"hallo.txt"
click button:"Löschen"
expect text:"hallo.txt" missing
click menu:"Bearbeiten"
click menuitem:"Rückgängig"
move 640,300
expect text:"hallo.txt" exists
click menu:"Bearbeiten"
click menuitem:"Wiederholen"
move 640,300
expect text:"hallo.txt" missing
# the copy in the Texteditor (a double click opens a file with its program)
dblclick text:"app"
dblclick text:"hallo.txt"
expect dialog:"Texteditor" selected
expect text:"/root/app/hallo.txt" exists
expect #90368 text "Gruss aus dem Editor\n"
# its properties
click button:"Dateimanager"
click text:"hallo.txt"
click button:"Eigenschaften"
expect text:"21 B (21 Bytes)" exists
expect text:"Ort" exists
expect_nowarn
