#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/web_scripts.jfnet
# page scripts in the Webbrowser (B3, devwin/pagescript.rs) on PC1's desktop: a click changes the
# page (a src script and an inline one with shared names; the title follows), input, a list that
# grows and shrinks, a stopped and an allowed submit, a clock with the simulation running and
# paused, fetch, the console with line and column, a broken page, an endless loop leaves the window
# usable, Back and Forward keep a page's state and its VM, Reload makes a new one; a page's timers
# wait while it is not shown; links a handler stops and those it lets go
# Ids (window 0): the window 26624; the address 26800, Zurück 26803, Vor 26804, Neu laden 26805;
# the console's button 122880, its Leeren 122882; the fields of a page (md_field_id of the page
# 114688): 3841261569, 3841261570 ..
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
resizewin 26624 900 680
dblclick listitem:"Webbrowser"
# ---- a page without scripts shows no console
click #26800
key ctrl+a
type "web.lab\n"
wait 500
expect heading:"Seiten mit Skripten" exists
expect button:"Konsole" missing
# ---- the counter: src first, an inline script with its names, clicks, the title
click link:"Ein Zähler"
wait 500
expect heading:"Ein Zähler" exists
expect button:"Konsole" exists
expect text:"Stand: 0" exists
click button:"Plus"
expect text:"Stand: 1" exists
click button:"Plus"
click button:"Plus"
expect text:"Stand: 3" exists
expect dialog:"Stand 3 – Webbrowser" exists
# the console: what print and log.warn wrote
click #122880
expect text:"bereit" exists
click button:"Null"
expect text:"Stand: 0" exists
expect text:"zurück auf null" exists
click #122882
expect text:"zurück auf null" missing
expect text:"Noch keine Ausgabe." exists
# ---- Back and Forward: the page as it was, with its state; Reload a new one
click button:"Plus"
click button:"Plus"
expect text:"Stand: 2" exists
click #26803
expect heading:"Seiten mit Skripten" exists
expect button:"Konsole" missing
click #26804
expect heading:"Ein Zähler" exists
expect text:"Stand: 2" exists
click button:"Plus"
expect text:"Stand: 3" exists
click #26805
wait 500
expect text:"Stand: 0" exists
expect text:"bereit" exists
key ctrl+shift+j
expect text:"bereit" missing
key ctrl+shift+j
expect text:"bereit" exists
click #122880
# ---- a list that grows and shrinks, input, a click on what a script made (bubbling)
click #26800
key ctrl+a
type "web.lab/liste.html\n"
wait 500
expect heading:"Eine Liste" exists
expect text:"Einträge: 0" exists
click #3841261569
type "Mehl"
expect text:"Getippt: Mehl" exists
expect #3841261569 text "Mehl"
expect #3841261569 focused
click button:"Dazu"
expect listitem:"Mehl" exists
expect text:"Einträge: 1" exists
expect text:"Getippt: Mehl" exists
click #3841261569
type "Hefe"
click button:"Dazu"
expect listitem:"Hefe" exists
expect text:"Einträge: 2" exists
click listitem:"Hefe"
expect text:"Angeklickt: Hefe" exists
click button:"Den letzten weg"
expect listitem:"Hefe" missing
expect listitem:"Mehl" exists
expect text:"Einträge: 1" exists
# ---- a form: stopped, then allowed; what the handler changed goes along
click #26800
key ctrl+a
type "web.lab/formular.html\n"
wait 500
expect heading:"Bestellen" exists
click button:"Abschicken"
expect text:"Bitte einen Namen eingeben." exists
expect heading:"Bestellen" exists
click #3841261569
type "Anna"
click checkbox:"Eilig"
click #3841261570
key ctrl+a
type "3\n"
wait 500
expect heading:"Danke" exists
expect text:"Name: Anna, Menge: 6, eilig: ja" exists
click #26803
expect heading:"Bestellen" exists
expect text:"Wird gesendet …" exists
# ---- the clock: it follows the simulation, stands while it stands, waits while it is not shown
click #26800
key ctrl+a
type "web.lab/uhr.html\n"
wait 300
expect heading:"Eine Uhr" exists
expect text:"Takte: 0" exists
wait 1000
expect text:"Takte: 2" exists
expect text:"Noch nichts." exists
key f6
wait 3000
expect text:"Takte: 2" exists
expect text:"Noch nichts." exists
key f6
wait 1000
expect text:"Takte: 4" exists
expect text:"Zwei Sekunden sind um." exists
click button:"Halt"
expect text:"Takte: 4" exists
wait 1000
expect text:"Takte: 4" exists
click #26803
click #26804
expect text:"Takte: 4" exists
# (not shown its timers wait; back it fires once and goes on from then)
click #26805
wait 600
expect text:"Takte: 1" exists
click #26803
wait 3000
click #26804
expect text:"Takte: 2" exists
wait 200
expect text:"Takte: 2" exists
wait 500
expect text:"Takte: 3" exists
# ---- fetch: an answer, and one that does not come
click #26800
key ctrl+a
type "web.lab/daten.html\n"
wait 500
click button:"Holen"
expect text:"Kommt …" exists
wait 500
expect text:"Status 200: 3 Waren" exists
expect listitem:"Weizenbrot" exists
# ---- a broken page: the errors in the console with their places, the rest ran
click #26800
key ctrl+a
type "web.lab/kaputt.html\n"
wait 500
expect heading:"Kaputte Skripte" exists
expect text:"Skript eins lief." exists
expect text:"Skript zwei lief." exists
expect text:"Skript drei lief." exists
expect text:"Skript vier lief." exists
expect text:"Skripte anderer Art laufen nicht." exists
click #122880
expect text:"http://web.lab/kaputt.html:10:12: Hier fehlt ein Ausdruck" exists
expect text:"http://web.lab/kaputt.html:14:9: Division durch 0" exists
expect text:"http://web.lab/gibtsnicht.jfs: das Skript kam nicht: 404 Not Found" exists
expect text:"http://web.lab/kaputt.html:19:1: Unbekannter Name unbekannt" exists
click text:"Skript drei lief."
expect text:"http://web.lab/kaputt.html:26:3: absichtlich" exists
click #122880
# ---- an endless loop: the error names its place, the window stays usable
click #26800
key ctrl+a
type "web.lab/schleife.html\n"
wait 500
expect heading:"Eine Endlosschleife" exists
expect text:"Klicks: 0" exists
click #122880
expect text:"http://web.lab/schleife.html:9:1: Rechenzeit aufgebraucht: mehr als 2000000 Schritte in einem Aufruf – eine Endlosschleife?" exists
click button:"Endlos"
expect text:"http://web.lab/schleife.html:17:3: Rechenzeit aufgebraucht: mehr als 2000000 Schritte in einem Aufruf – eine Endlosschleife?" exists
click button:"Zählen"
expect text:"Klicks: 1" exists
click button:"Zählen"
expect text:"Klicks: 2" exists
click #122880
click link:"Zur Startseite"
wait 500
expect heading:"Seiten mit Skripten" exists
# ---- location: the parts, assign, href, a fragment, reload
click link:"Die Adresse"
wait 500
expect heading:"Die Adresse" exists
expect text:"http://web.lab/ort.html?a=1&b=zwei#teil" exists
expect text:"http web.lab web.lab - /ort.html a=1&b=zwei teil" exists
click button:"Zum Teil"
expect #26800 text "http://web.lab/ort.html?a=1&b=zwei#unten"
click button:"Woandershin"
wait 500
expect heading:"Seiten mit Skripten" exists
click #26803
expect heading:"Die Adresse" exists
click button:"Über href"
wait 500
expect heading:"Ein Zähler" exists
# ---- clicks: the way up, a stopped link, a link that goes
resizewin 26624 900 820
click #26800
key ctrl+a
type "web.lab/klicks.html\n"
wait 500
expect heading:"Klicks und Blasen" exists
click heading:"Klicks und Blasen"
expect text:"Spur: dok" exists
click link:"Dieser Link bleibt hier"
expect heading:"Klicks und Blasen" exists
expect text:"Spur: dok halt dok" exists
click text:"Bis hier und nicht weiter"
expect text:"Spur: dok halt dok still" exists
click text:"Innen"
expect text:"Spur: dok halt dok still kasten dok" exists
click link:"Dieser Link geht"
wait 500
expect heading:"Seiten mit Skripten" exists
expect_nowarn
