#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/tests/fixtures/academy_pruefung
# leaving the program with a test under way asks first, on its page and on any other (its answers live in this
# session only).  Beenden ends the program, so it stands last.  Ids: 5 Beenden, 136192 the test, 135170 back.
size 1280 800
theme light
click button:"Kurs: Ein Test"
click #136192
click button:"Test beginnen"
expect button:"Abgeben" exists
cmd 5
expect dialog:"Programm wirklich beenden?" exists
expect text:"Ein Test läuft noch. Seine Antworten gehen beim Beenden verloren, und der Versuch zählt nicht." exists
shot build/jfnetworker/install_quit.png
click button:"Weiterarbeiten"
expect dialog:"Programm wirklich beenden?" missing
expect button:"Abgeben" exists
# on another page it runs on and asks all the same
key esc
expect #136192 exists
cmd 5
expect dialog:"Programm wirklich beenden?" exists
key esc
expect dialog:"Programm wirklich beenden?" missing
expect_nowarn
cmd 5
click button:"Beenden"
