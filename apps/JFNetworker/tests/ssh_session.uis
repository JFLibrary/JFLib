#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/ssh_snmpv3.jfnet
# an SSH session from a PC's Terminal into a router and back (X1f, sshd.rs): the question about the
# new host key, the password typed hidden, R1's prompt in the console, show users with the
# session marked (ssh), exit brings the shell back; the second time no question; a line ~. ends a
# session from this side.
# Ids: ADMIN's console 25088 (input 25089).
size 1280 900
theme light
wait 600
drag 630,671 630,380 8
dblclick listitem:"ADMIN"
expect tab:"ADMIN" selected
expect #25089 focused
type "ssh admin@10.0.0.1\n"
wait 600
expect text:"10.0.0.1 is new here. Its ssh-ed25519 key has the fingerprint SHA256:MZdWrvARXGMejsa4Aj6ZbpEevwMjsKKA+XTc+wlsiA4." exists
expect text:"Remember it and go on? Type yes or no: " exists
expect #25089 focused
type "yes\n"
wait 600
expect text:"Remembered 10.0.0.1 in /root/.ssh/known_hosts." exists
expect text:"Password for admin at 10.0.0.1: " exists
# the password is hidden: the console has no text box meanwhile
expect #25089 missing
type "adminpw\n"
wait 600
expect text:"adminpw" missing
expect text:"R1#" exists
type "show users\n"
wait 600
expect text:"R1#show users" exists
expect text:"*   vty 0      admin      15         00:00:00  10.0.0.100 (ssh)" exists
shot build/jfnetworker/ssh_session.png
type "exit\n"
wait 600
expect text:"Session with 10.0.0.1 ended." exists
expect text:"root@ADMIN:~# " exists
type "echo zurück\n"
expect text:"zurück" exists
# known now: straight to the password; ~. leaves
type "ssh admin@10.0.0.1\n"
wait 600
expect #25089 missing
type "adminpw\n"
wait 600
type "~.\n"
wait 600
expect text:"Closed from this side." exists
type "echo $?\n"
expect text:"255" exists
expect_nowarn
