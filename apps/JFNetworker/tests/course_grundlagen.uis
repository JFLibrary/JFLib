#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/academy
# the course Grundlagen walked by clicks as a learner does: its card, the outline, a lesson with its picture, a
# link to the next lesson, a link to the lab; the lab solved at the consoles and with a new cable, the goals
# coming one by one; Weiter im Kurs into the quiz, answered until it passes; the next unit's lab solved by typing;
# the test that waits for the closing lab; English.  A headless run keeps the progress in memory.  Ids: 136192 + k
# the steps of the outline, 145664 + q * 28 the question at place q of a quiz (+ 1 its input, + 2 Prüfen, + 4 + a
# its answer a), 49168 + i the goals, 42 the tool Verbinden, 209344286 the language in the settings.
size 1280 800
theme light
# ---- the card and the outline: the course stands behind the sample
expect button:"Kurs: Grundlagen der Netze" exists
expect button:"Kurs: Beispielkurs: das erste Netz" exists
expect text:"Einsteiger · 240 Min. · Vom Kabel bis zum Namen: Hosts und Switches, MAC- und IP-Adressen, Router, DHCP und DNS. Jede Einheit mit Lektionen, einem Labor und einem Quiz, am Ende ein Labor über alles und ein Test." exists
focus #130050
key enter
expect text:"Grundlagen der Netze" exists
expect text:"Einsteiger · 240 Min." exists
expect text:"0 von 24 Schritten erledigt" exists
expect text:"Das erste Netz" exists
expect text:"Router und Gateway" exists
expect button:"Was ein Netz ist, als Nächstes" exists
expect button:"Labor: das ganze Netz, gesperrt" exists
expect button:"Test: Grundlagen der Netze, gesperrt" exists
# ---- the lessons: a picture of the course's own, Weiter, a link onward
click button:"Beginnen"
expect heading:"Was ein Netz ist" exists
expect image:"Zwei PCs und ein Server, jeder mit einem eigenen Kabel an einem Switch in der Mitte" exists
expect text:"Schritt 1 von 24" exists
click button:"Weiter"
expect heading:"Rahmen und MAC-Adressen" exists
expect image:"Ein Rahmen als Streifen: Ziel-MAC, Quell-MAC, Typ, Daten und Prüfsumme" exists
wheel 640,400 -6000
wait 100
click link:"ARP"
expect heading:"ARP: von der IP-Adresse zur MAC-Adresse" exists
expect text:"Schritt 3 von 24" exists
# ---- the link to the lab: the goals, the bar, nothing reached yet
wheel 640,400 -6000
wait 100
click link:"Zwei PCs und ein Switch"
expect text:"Labor: zwei PCs und ein Switch · Grundlagen der Netze" exists
expect button:"Zurück zum Kurs" exists
expect button:"Weiter im Kurs" exists
expect tab:"Aufgabe" exists
expect text:"0 von 5 Zielen erreicht" exists
expect text:"3 Geräte · 1 Kabel" exists
wait 500
# ---- the first goal: a cable, as a learner draws it
cmd 42
drag listitem:"PC2" listitem:"SW1" 8 shift
cmd 40
expect text:"3 Geräte · 2 Kabel" exists
wait 1500
expect #49168 checked
expect #49169 unchecked
# the address, at the console of PC2; then the ping and the two tables
dblclick listitem:"PC2"
type "ip addr add 192.168.1.20/24 dev eth0\n"
wait 2500
expect #49169 checked
expect #49170 checked
expect text:"3 von 5 Zielen erreicht" exists
dblclick listitem:"PC1"
type "ping -c 2 192.168.1.20\n"
wait 3000
type "ip neigh\n"
wait 1500
expect #49171 checked
dblclick listitem:"SW1"
type "enable\n"
type "show mac address-table\n"
wait 1500
expect text:"5 von 5 Zielen erreicht" exists
expect text:"Geschafft: alle Ziele erreicht." exists
# ---- Weiter im Kurs: the quiz, answered until it passes
click button:"Weiter im Kurs"
expect text:"Quiz: das erste Netz" exists
expect text:"0 von 7 Punkten · 0 %, bestanden ab 70 %" exists
click #145668
click #145666
expect text:"Richtig." exists
expect text:"1 von 7 Punkten · 14 %, bestanden ab 70 %" exists
focus #145696
key space
focus #145694
key space
expect text:"2 von 7 Punkten · 28 %, bestanden ab 70 %" exists
focus #145721
type "show mac address-table"
focus #145722
key space
expect text:"3 von 7 Punkten · 42 %, bestanden ab 70 %" exists
focus #145780
key space
focus #145781
key space
focus #145782
key space
focus #145778
key space
expect text:"5 von 7 Punkten · 71 % · bestanden" exists
key esc
expect text:"3 von 24 Schritten erledigt" exists
expect button:"Quiz: das erste Netz, erledigt, bestes Ergebnis 71 %" exists
# the lessons a link went past stay open, and Weiter takes the first open one
expect button:"Rahmen und MAC-Adressen, als Nächstes" exists
click button:"Weiter"
expect heading:"Rahmen und MAC-Adressen" exists
key esc
focus #136197
key enter
expect heading:"IPv4-Adressen" exists
expect image:"Eine Adresse als Streifen aus 32 Kästchen: links der Netzteil, rechts der Hostteil" exists
key esc
# ---- the next unit's lab by its step, solved at the console
focus #136200
key enter
expect dialog:"Änderungen speichern?" exists
click button:"Verwerfen"
expect text:"Labor: eine Maske zu eng · Grundlagen der Netze" exists
expect text:"0 von 3 Zielen erreicht" exists
wait 1500
expect text:"0 von 3 Zielen erreicht" exists
dblclick listitem:"PC2"
type "ip addr del 192.168.10.130/25 dev eth0\n"
type "ip addr add 192.168.10.130/24 dev eth0\n"
wait 4000
expect text:"3 von 3 Zielen erreicht" exists
click button:"Zurück zum Kurs"
expect button:"Labor: eine Maske zu eng, erledigt" exists
# ---- what waits for what: the test needs the closing lab, that one its two labs
click #136214
expect text:"Grundlagen der Netze" exists
expect button:"Labor: das ganze Netz, gesperrt" exists
expect button:"Test: Grundlagen der Netze, gesperrt" exists
# ---- English: the same course, its own text and its own picture
focus #136192
key enter
expect heading:"Was ein Netz ist" exists
cmd 216
expect dialog:"Einstellungen" exists
focus #209344286
click #209344286
click "English"
expect dialog:"Settings" exists
click button:"Close"
expect heading:"What a network is" exists
expect image:"Two PCs and a server, each with its own cable to a switch in the middle" exists
wheel 640,400 -6000
wait 100
click link:"frames and MAC addresses"
expect heading:"Frames and MAC addresses" exists
expect image:"A frame as a strip: destination MAC, source MAC, type, data and checksum" exists
key esc
expect text:"Network basics" exists
expect text:"Beginner · 240 min" exists
cmd 216
focus #209344286
click #209344286
click "Deutsch"
click button:"Schließen"
expect text:"Grundlagen der Netze" exists
expect_nowarn
