#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/sessions.jfnet
# telnet from a PC's console into a router and back (X1e, telnetd.rs): the line password is
# typed hidden (the far end asks for it), R1's prompt follows in the console, show users lists
# the vty session from 10.0.0.100, exit closes the connection and the shell's prompt is back.
# Ids: ADMIN's console 25088 (input 25089).
size 1280 900
theme light
wait 600
drag 630,671 630,380 8
dblclick listitem:"ADMIN"
expect tab:"ADMIN" selected
expect #25089 focused
type "telnet 10.0.0.1\n"
wait 600
expect text:"% Connected. The escape is Ctrl+Shift+6." exists
expect text:"Password: " exists
# the far end hides the password: the console has no text box meanwhile
expect #25089 missing
type "cisco\n"
wait 600
expect text:"cisco" missing
expect text:"R1>" exists
type "show users\n"
wait 600
expect text:"R1>show users" exists
expect text:"*   vty 0      -          1          00:00:00  10.0.0.100" exists
shot build/jfnetworker/telnet_vty.png
type "exit\n"
wait 600
expect text:"% Connection closed by foreign host" exists
expect text:"root@ADMIN:~# " exists
type "echo zurück\n"
expect text:"zurück" exists
expect_nowarn
