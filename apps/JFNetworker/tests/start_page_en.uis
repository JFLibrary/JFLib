#!args --verify-dirty --start-page --lang en --recent=apps/JFNetworker/tests/fixtures/two_pcs.jfnet --recent=build/st1/gone.jfnet
# the start page in English: its headings, the templates' names and texts, the labs from their files,
# a template opens with the English title and description; shots light and dark.
size 1280 800
theme light
expect text:"New" exists
expect text:"Recent" exists
expect text:"Learn" exists
expect button:"Empty project" exists
expect button:"Template: Home network" exists
expect button:"Template: Office with VLANs" exists
expect button:"Template: Data centre (leaf-spine)" exists
expect button:"Template: Web service behind a load balancer" exists
expect text:"Two buildings with L3 switches, OSPF to the router, DHCP through relays, DNS." exists
expect button:"Campus: a VLAN for the students" exists
expect text:"Not found" exists
expect button:"Remove from the list" exists
shot build/jfnetworker/start_page_en.png
theme dark
shot build/jfnetworker/start_page_en_dark.png
theme light
click menu:"File"
expect menuitem:"Start page" disabled
expect menuitem:"Project info …" disabled
key esc
click button:"Template: Home network"
expect tab:"Devices" exists
expect #20482 text "Home network"
expect text:"A home router with Wi-Fi and DHCP, with a PC, a printer, a laptop and a smartphone." exists
cmd 1001
expect dialog:"Project info" exists
expect text:"Author" exists
click button:"Cancel"
cmd 216
focus "Show at startup"
expect "Show at startup" checked
key esc
expect_nowarn
