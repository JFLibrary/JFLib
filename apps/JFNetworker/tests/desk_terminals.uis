#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/shell_tour.jfnet
# further Terminal windows of a host's desktop (devwin/desktop.rs terminal_window: V2's desktop
# with X1e's sessions) on PC1 of fixtures/shell_tour.jfnet: the Terminal shows the device's
# console; Start › Weiteres Terminal opens "Terminal (2)" with a command-line session of its own
# (its own prompt and directory, tty pts/0, ps names the terminals); the console keeps its
# directory and who counts the session; closing the window ends it.
# Ids: the device window 26624; the console's input 25089; the first further session's input
# 106497 (ID_SES0).
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
dblclick listitem:"Terminal"
expect dialog:"Terminal" selected
type "cd /etc\n"
wait 100
expect text:"root@PC1:/etc# " exists
# a further Terminal window: a session of its own
click button:"Start"
expect menuitem:"Weiteres Terminal" exists
click menuitem:"Weiteres Terminal"
expect dialog:"Terminal (2)" exists
expect dialog:"Terminal (2)" selected
expect button:"Terminal (2)" checked
expect #106497 focused
expect text:"root@PC1:~# " exists
type "tty\n"
wait 100
expect text:"/dev/pts/0" exists
type "cd /tmp\n"
wait 100
expect text:"root@PC1:/tmp# " exists
type "ps\n"
wait 100
expect text:"  PID USER     TTY      TIME COMMAND" exists
expect text:"  100 root     tty1     0:00 -sh" exists
expect text:"  101 root     pts/0    0:00 -sh" exists
shot build/jfnetworker/desk_terminals.png window 26624
# the console kept its directory; who counts both terminals
click button:"Terminal"
expect dialog:"Terminal" selected
click #25089
type "who | wc -l\n"
wait 100
expect text:"root@PC1:/etc# who | wc -l" exists
expect text:"2" exists
# closing the window ends the session: the console's who no longer counts it
rclick button:"Terminal (2)"
click menuitem:"Schließen"
expect dialog:"Terminal (2)" missing
expect button:"Terminal (2)" missing
click #25089
key ctrl+l
type "who | wc -l\n"
wait 100
expect text:"1" exists
expect text:"2" missing
expect_nowarn
