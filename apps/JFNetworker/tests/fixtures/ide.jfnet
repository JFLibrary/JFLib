    {
      "id": 3,
      "name": "SRV1",
      "model": "server-1u",
      "x": 400,
      "y": 0,
      "off": false,
      "startup_config": "hostname SRV1\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "script",
          "name": "web",
          "disabled": false,
          "config": {
            "file": "/root/app/server.jfs",
            "port": 80
          }
        },
        {
          "kind": "script",
          "name": "zaehler",
          "disabled": false,
          "config": {
            "source": [
              "// zaehler: zählt seine Starts auf der Disk und gibt jede Sekunde einen Takt aus",
              "let n = 0",
              "disk.get(\"starts\", fn(err, v) {",
              "  let s = (v ?? 0) + 1",
              "  disk.put(\"starts\", s)",
              "  print(\"Start ${s}\")",
              "})",
              "timer.every(1000, fn() {",
              "  n += 1",
              "  print(\"Takt ${n}\")",
              "})"
            ]
          }
        }
      ],
      "comment": "",
      "wlan": null,
      "files": [
        {
          "path": "/root/app",
          "dir": true
        },
        {
          "path": "/root/app/hallo.jfs",
          "text": "print(\"Hallo aus ${config.file}\")\nprint(\"${len(config.args)} Argumente\")\n"
        },
        {
          "path": "/root/app/lib.jfs",
          "text": "// lib.jfs: Hilfen für server.jfs\n/// begrüßt einen Pfad\nfn greet(path) {\n  let n = len(path)\n  return \"Hallo ${path} (${n} Zeichen)\"\n}\n/// verdoppelt eine Zahl\nfn double(x) {\n  return x * 2\n}\n"
        },
        {
          "path": "/root/app/server.jfs",
          "text": "// server.jfs: ein kleiner Webserver, die Antworten kommen aus lib.jfs\nlet lib = import(\"lib.jfs\")\nlet port = config.port ?? 80\nlet hits = 0\nhttp.serve(port, fn(req, res) {\n  hits += 1\n  let text = lib.greet(req.path)\n  print(\"Anfrage ${hits}: ${req.path}\")\n  return text + \"\\n\"\n})\nprint(\"bereit auf Port ${port}\")\n"
        },
        {
          "path": "/root/app/test_lib.jfs",
          "text": "let lib = import(\"lib.jfs\")\nfn test_double() {\n  assert_eq(lib.double(21), 42)\n}\nfn test_greet() {\n  assert_eq(lib.greet(\"/\"), \"Hallo /\")\n}\n"
        },
        {
          "path": "/root/notes.txt",
          "text": "Notizen zu SRV1\nweb läuft aus /root/app/server.jfs\n"
        }
      ]
    }
  ],
