{
  "format": "jfn",
  "version": 1,
  "title": "OSPF mit Bereichen",
  "description": "Ein LAN mit vier OSPF-Routern (DR und BDR nach Priorität), R1 als ABR zu Bereich 1 und zum Stub-Bereich 2, R4 als ASBR mit statischer Route und Standardroute ins Internet.",
  "seed": 17,
  "next_id": 20,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "R1",
      "model": "jf-r4",
      "x": 300,
      "y": 300,
      "off": false,
      "startup_config": "hostname R1\n!\ninterface Loopback0\n ip address 1.1.1.1 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.0.0.1 255.255.255.0\n ip ospf priority 50\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 10.1.15.1 255.255.255.0\n no shutdown\n!\ninterface GigabitEthernet0/0/3\n ip address 10.2.16.1 255.255.255.0\n no shutdown\n!\nrouter ospf 1\n router-id 1.1.1.1\n area 2 stub\n network 10.0.0.0 0.0.0.255 area 0\n network 10.1.0.0 0.0.255.255 area 1\n network 10.2.0.0 0.0.255.255 area 2\n network 1.1.1.1 0.0.0.0 area 0\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "R2",
      "model": "jf-r4",
      "x": 100,
      "y": 100,
      "off": false,
      "startup_config": "hostname R2\n!\ninterface Loopback0\n ip address 2.2.2.2 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.0.0.2 255.255.255.0\n ip ospf priority 100\n no shutdown\n!\nrouter ospf 1\n router-id 2.2.2.2\n network 10.0.0.0 0.0.0.255 area 0\n network 2.2.2.2 0.0.0.0 area 0\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
