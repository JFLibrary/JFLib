{
  "format": "jfn",
  "version": 1,
  "title": "AAA mit RADIUS",
  "description": "Zwei Router melden Konsolen-Logins per RADIUS an SRV1 an, mit lokalem Ersatz.",
  "seed": 7,
  "next_id": 9,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "R1",
      "model": "jf-r4",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname R1\n!\nusername admin secret adminpw\n!\naaa new-model\n!\nradius server S1\n address ipv4 10.0.0.10 auth-port 1812 acct-port 1813\n key testing123\n timeout 1\n retransmit 1\n!\naaa authentication login default group radius local\naaa authorization exec default group radius local\n!\ninterface GigabitEthernet0/0/0\n ip address 10.0.0.1 255.255.255.0\n no shutdown\n!\nline con 0\n login authentication default\n!\nend\n",
      "services": [],
      "comment": "",
      "wlan": null,
      "files": []
    },
    {
      "id": 2,
      "name": "R2",
