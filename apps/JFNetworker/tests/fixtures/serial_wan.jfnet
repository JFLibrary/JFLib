      "startup_config": "hostname R1\n!\ninterface GigabitEthernet0/0/0\n ip address 192.168.1.1 255.255.255.0\n no shutdown\n!\ninterface Serial0/2/0\n ip address 10.0.12.1 255.255.255.252\n no shutdown\n!\nip route 192.168.2.0 255.255.255.0 10.0.12.2\n!\nend\n",
      "services": [],
      "comment": ""
