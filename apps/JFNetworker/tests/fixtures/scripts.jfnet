    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 200,
      "y": 0,
      "off": false,
      "startup_config": "",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SRV1",
      "model": "server-1u",
      "x": 400,
      "y": 0,
      "off": false,
      "startup_config": "hostname SRV1\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "script",
          "name": "zaehler",
          "disabled": false,
          "config": {
            "source": [
              "// zaehler.jfs: zählt seine Starts auf der Disk und gibt jede Sekunde einen Takt aus",
              "let n = 0",
              "disk.get(\"starts\", fn(err, v) {",
              "  let s = (v ?? 0) + 1",
              "  disk.put(\"starts\", s)",
              "  metrics.gauge(\"starts\", s)",
              "  print(\"Start ${s}\")",
              "})",
              "timer.every(1000, fn() {",
              "  n += 1",
              "  metrics.gauge(\"takt\", n)",
              "  if n % 3 == 0 {",
              "    let x = n / (n - n)",
              "  }",
              "  print(\"Takt ${n}\")",
              "})"
            ]
          }
        },
        {
          "kind": "script",
          "name": "echo",
          "disabled": false,
          "config": {
            "source": [
              "// echo.jfs: schickt jedes Datagramm an seinen Absender zurück",
              "net.udp(7, fn(sock, msg) {",
              "  metrics.inc(\"echos\")",
              "  sock.send(msg.from, msg.port, msg.data)",
              "})"
            ]
          }
        }
      ],
      "comment": ""
    }
  ],
