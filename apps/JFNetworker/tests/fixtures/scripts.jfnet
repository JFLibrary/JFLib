  "format": "jfn",
  "version": 1,
  "title": "Skripte auf einem Server",
  "description": "SRV1 führt zwei Skripte aus: zaehler zählt seine Starts auf der Disk, gibt jede Sekunde einen Takt aus und scheitert bei jedem dritten an einer Division durch 0; echo spiegelt UDP auf Port 7. PC1 hängt mit am Switch.",
  "seed": 5,
  "next_id": 6,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC1\nip addr add 10.0.0.10/24 dev eth0\n",
      "services": [],
