{
  "format": "jfn",
  "version": 1,
  "title": "IPv6 über zwei Router",
  "description": "PC1 und PC2 (SLAAC in 2001:db8:1::/64) erreichen SRV (2001:db8:2::10) über R1 und R2 mit statischen Routen; R2 führt seine Standardroute über die Link-Local-Adresse FE80::1 von R1. Zu SRV ist die MTU 1280: größere Pakete beantwortet R2 mit Packet Too Big, die Absender fragmentieren dann selbst.",
  "seed": 9,
  "next_id": 12,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC1\nsysctl -w net.ipv6.conf.all.disable_ipv6=0\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "PC2",
      "model": "pc",
      "x": 0,
      "y": 160,
      "off": false,
      "startup_config": "hostname PC2\nsysctl -w net.ipv6.conf.all.disable_ipv6=0\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 160,
      "y": 80,
      "off": false,
      "startup_config": "hostname SW1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "R1",
      "model": "jf-r4",
      "x": 320,
      "y": 80,
      "off": false,
      "startup_config": "hostname R1\n!\nipv6 unicast-routing\n!\ninterface GigabitEthernet0/0/0\n description LAN\n ipv6 address 2001:DB8:1::1/64\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n description to R2\n ipv6 address FE80::1 link-local\n ipv6 address 2001:DB8:12::1/64\n no shutdown\n!\nipv6 route 2001:DB8:2::/64 2001:DB8:12::2\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 5,
      "name": "R2",
      "model": "jf-r4",
      "x": 480,
      "y": 80,
      "off": false,
      "startup_config": "hostname R2\n!\nipv6 unicast-routing\n!\ninterface GigabitEthernet0/0/0\n description to R1\n ipv6 address 2001:DB8:12::2/64\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n description servers\n ipv6 address 2001:DB8:2::1/64\n ipv6 mtu 1280\n ipv6 nd ra mtu suppress\n no shutdown\n!\nipv6 route ::/0 GigabitEthernet0/0/0 FE80::1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 6,
      "name": "SRV",
      "model": "server-1u",
      "x": 640,
      "y": 80,
      "off": false,
      "startup_config": "hostname SRV\nsysctl -w net.ipv6.conf.all.disable_ipv6=0\nsysctl -w net.ipv6.conf.eth0.autoconf=0\nip -6 addr add 2001:db8:2::10/64 dev eth0\n",
      "services": [],
      "comment": ""
    }
  ],
