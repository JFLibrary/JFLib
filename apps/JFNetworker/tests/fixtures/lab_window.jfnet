{
  "format": "jfn",
  "version": 1,
  "title": "Labor im Fenster",
  "description": "GEN fragt über den Cache CACHE1 den Loadbalancer LB1, der die Anfragen auf WEB1 und WEB2 verteilt; die Webserver lesen und schreiben im KV-Speicher aus KV1 bis KV3 (Replikationsfaktor 2). PROD legt jede Sekunde 30 Aufträge in die Queue MQ1, WRK1 arbeitet sie ab. SRV1 bietet DNS und DHCP, SCR1 ein Skript (UDP-Echo).",
  "seed": 17,
  "next_id": 30,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.1.10/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "fill",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.1.1/"
            ],
            "mode": "closed",
            "users": 1,
            "requests": 50,
            "timeout_ms": 5000,
            "mix": [
              {
                "method": "PUT",
                "path": "/item/k{seq}",
                "body": "v{seq}"
              }
            ]
          }
        },
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.1.3/"
            ],
            "mode": "open",
            "rps": 60,
            "arrival": "poisson",
            "delay_ms": 1000,
            "timeout_ms": 5000,
            "mix": [
              {
                "path": "/item/k{hot:50}",
                "weight": 4
              },
              {
                "method": "PUT",
                "path": "/item/k{rand:50}",
                "body": "neu{seq}",
                "weight": 1
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 120,
      "y": 0,
      "off": false,
      "startup_config": "hostname SW1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "CACHE1",
      "model": "cache",
      "x": 120,
      "y": -140,
      "off": false,
      "startup_config": "hostname CACHE1\nip addr add 10.0.1.3/24 dev eth0\n",
      "services": [
        {
          "kind": "cache",
          "name": "cache",
          "disabled": false,
          "config": {
            "backend": "http://10.0.1.1/",
            "ttl_ms": 2000,
            "hit_us": 50
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 4,
      "name": "LB1",
      "model": "load-balancer",
      "x": 240,
      "y": 0,
      "off": false,
      "startup_config": "hostname LB1\nip addr add 10.0.1.1/24 dev eth0\nip addr add 10.0.2.1/24 dev eth1\n",
      "services": [
        {
          "kind": "lb",
          "name": "lb",
          "disabled": false,
          "config": {
            "mode": "http",
            "port": 80,
            "algorithm": "round-robin",
            "backends": [
              {
                "name": "web1",
                "addr": "10.0.2.11"
              },
              {
                "name": "web2",
                "addr": "10.0.2.12"
              }
            ],
            "health": {
              "type": "http",
              "path": "/health",
              "interval_ms": 1000,
              "timeout_ms": 500,
              "rise": 2,
              "fall": 3
            }
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 5,
      "name": "SW2",
      "model": "jf-s24p",
      "x": 380,
      "y": 0,
      "off": false,
      "startup_config": "hostname SW2\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 6,
      "name": "WEB1",
      "model": "server-1u",
      "x": 520,
      "y": -150,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 10.0.2.11/24 dev eth0\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "time_ms": 1,
            "routes": [
              {
                "path": "/health",
                "body": "ok\n"
              },
              {
                "path": "/item/*",
                "method": "*",
                "backend": "kv"
              }
            ],
            "kv": {
              "nodes": [
                "10.0.2.21",
                "10.0.2.22",
                "10.0.2.23"
              ],
              "rf": 2
            }
          }
        }
      ],
      "comment": ""
    },
