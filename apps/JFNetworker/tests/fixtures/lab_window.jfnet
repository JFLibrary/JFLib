    {
      "id": 11,
      "name": "MQ1",
      "model": "queue",
      "x": 300,
      "y": 170,
      "off": false,
      "startup_config": "hostname MQ1\nip addr add 10.0.2.30/24 dev eth0\n",
      "services": [
        {
          "kind": "mq",
          "name": "mq",
          "disabled": false,
          "config": {
            "topics": [
              "jobs"
            ],
            "visibility_ms": 2000,
            "max_deliveries": 3
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 12,
      "name": "WRK1",
      "model": "container-host",
      "x": 440,
      "y": 170,
      "off": false,
      "startup_config": "hostname WRK1\nip addr add 10.0.2.31/24 dev eth0\n",
      "services": [
        {
          "kind": "worker",
          "name": "worker",
          "disabled": false,
          "config": {
            "queue": "http://10.0.2.30:9000/",
            "topic": "jobs",
            "time_ms": 40,
            "concurrency": 2,
            "wait_ms": 2000
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 13,
      "name": "PROD",
      "model": "traffic-gen",
      "x": 160,
      "y": 170,
      "off": false,
      "startup_config": "hostname PROD\nip addr add 10.0.2.40/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "jobs",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.2.30:9000/"
            ],
            "mode": "open",
            "rps": 30,
            "arrival": "uniform",
            "delay_ms": 1000,
            "timeout_ms": 5000,
            "mix": [
              {
                "method": "POST",
                "path": "/topics/jobs",
                "body": "job{seq}"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 14,
      "name": "SRV1",
      "model": "server-tower",
      "x": 240,
      "y": -140,
      "off": false,
      "startup_config": "hostname SRV1\nip addr add 10.0.2.50/24 dev eth0\n",
      "services": [
        {
          "kind": "dns-server",
          "name": "named",
          "disabled": false,
          "config": {
            "zones": [
              {
                "origin": "lab",
                "ttl": 300,
                "records": [
                  "web A 10.0.2.1",
                  "kv1 A 10.0.2.21"
                ]
              }
            ]
          }
        },
        {
          "kind": "dhcp-server",
          "name": "dhcpd",
          "disabled": false,
          "config": {
            "pools": [
              {
                "name": "LAB",
                "network": "10.0.2.0/24",
                "range": [
                  "10.0.2.100",
                  "10.0.2.150"
                ],
                "dns": [
                  "10.0.2.50"
                ],
                "domain": "lab",
                "lease": 3600
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 15,
      "name": "SCR1",
      "model": "server-1u",
      "x": 380,
      "y": -150,
      "off": false,
      "startup_config": "hostname SCR1\nip addr add 10.0.2.60/24 dev eth0\n",
      "services": [
        {
          "kind": "script",
          "name": "echo",
          "disabled": false,
          "config": {
            "source": [
              "// echo.jfs: every datagram on port 7 goes back to its sender",
              "net.udp(config.port, fn(s, m) { s.send(m.from, m.port, m.data) })"
            ],
            "port": 7
          }
        }
      ],
      "comment": ""
    }
