{
  "format": "jfn",
  "version": 1,
  "title": "Campus: zwei VLANs, DHCP-Relay, DNS",
  "description": "Abnahme Phase 1: MLS1 routet VLAN 10 (Staff) und VLAN 20 (Students) und reicht DHCP an R1 weiter (ip helper-address); R1 vergibt die Adressen aus zwei Pools und führt ins Servernetz zu SRV1 (DNS-Zone lab mit server.lab, Zeitquelle für R1 und MLS1).",
  "seed": 5,
  "next_id": 17,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "R1",
      "model": "jf-r4",
      "x": 440,
      "y": 0,
      "off": false,
      "startup_config": "hostname R1\n!\nip dhcp excluded-address 10.10.10.1 10.10.10.99\nip dhcp excluded-address 10.10.20.1 10.10.20.99\n!\nip dhcp pool STAFF\n network 10.10.10.0 255.255.255.0\n default-router 10.10.10.1\n dns-server 10.10.100.10\n domain-name lab\n!\nip dhcp pool STUDENTS\n network 10.10.20.0 255.255.255.0\n default-router 10.10.20.1\n dns-server 10.10.100.10\n domain-name lab\n!\ninterface GigabitEthernet0/0/1\n description server network\n ip address 10.10.100.1 255.255.255.0\n no shutdown\n!\ninterface TenGigabitEthernet0/1/0\n description downlink to MLS1\n ip address 10.10.0.1 255.255.255.252\n no shutdown\n!\nip route 10.10.10.0 255.255.255.0 10.10.0.2\nip route 10.10.20.0 255.255.255.0 10.10.0.2\n!\nntp server 10.10.100.10\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "MLS1",
      "model": "jf-s24l3",
      "x": 260,
      "y": 160,
      "off": false,
      "startup_config": "hostname MLS1\n!\nip routing\n!\nvlan 10\n name Staff\n!\nvlan 20\n name Students\n!\ninterface GigabitEthernet1/0/1\n switchport access vlan 10\n switchport mode access\n!\ninterface GigabitEthernet1/0/2\n switchport access vlan 10\n switchport mode access\n!\ninterface GigabitEthernet1/0/3\n switchport access vlan 20\n switchport mode access\n!\ninterface GigabitEthernet1/0/4\n switchport access vlan 20\n switchport mode access\n!\ninterface TenGigabitEthernet1/1/1\n description uplink to R1\n no switchport\n ip address 10.10.0.2 255.255.255.252\n!\ninterface Vlan10\n description gateway of VLAN 10 Staff\n ip address 10.10.10.1 255.255.255.0\n ip helper-address 10.10.0.1\n!\ninterface Vlan20\n description gateway of VLAN 20 Students\n ip address 10.10.20.1 255.255.255.0\n ip helper-address 10.10.0.1\n!\nip route 0.0.0.0 0.0.0.0 10.10.0.1\n!\nntp server 10.10.100.10\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SRV1",
      "model": "server-1u",
      "x": 620,
      "y": 0,
      "off": false,
      "startup_config": "hostname SRV1\nip addr add 10.10.100.10/24 dev eth0\nip route add default via 10.10.100.1\n",
      "services": [
        {
          "kind": "dns-server",
          "name": "named",
          "disabled": false,
          "config": {
            "zones": [
              {
                "origin": "lab",
                "ttl": 300,
                "records": [
                  "server A 10.10.100.10",
                  "srv1 CNAME server",
                  "r1 A 10.10.0.1",
                  "mls1 A 10.10.0.2"
                ]
              }
            ]
          }
        },
        {
          "kind": "ntp",
          "name": "chronyd",
          "disabled": false,
          "config": {
            "master": 8
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 4,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 180,
      "off": false,
      "startup_config": "hostname PC1\n",
      "services": [
        {
          "kind": "dhcp-client",
          "name": "dhcp-client@eth0",
          "disabled": false,
          "config": {
            "iface": "eth0"
          }
        }
      ],
      "comment": ""
    },
    {
