{
  "format": "jfn",
  "version": 1,
  "title": "Änderungen unter Last",
  "description": "GEN schickt Last an den Load Balancer LB mit WEB1 und WEB2 und an den Cache vor WEB3. Das Szenario ändert unter Last die Rate, die Backends, den Algorithmus, die Einstellungen eines Webservers und den KV-Speicher, ohne dass ein Dienst neu startet.",
  "seed": 19,
  "next_id": 40,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 40,
      "y": 160,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.0.2/"
            ],
            "mode": "open",
            "rps": 100,
            "arrival": "poisson",
            "delay_ms": 1000,
            "timeout_ms": 3000
          }
        },
        {
          "kind": "http-load",
          "name": "users",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.0.40/"
            ],
            "mode": "closed",
            "users": 2,
            "think_ms": 100,
            "delay_ms": 1000,
            "timeout_ms": 3000
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 220,
      "y": 160,
      "off": false,
      "startup_config": "hostname SW1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "LB",
      "model": "load-balancer",
      "x": 400,
      "y": 40,
      "off": false,
      "startup_config": "hostname LB\nip addr add 10.0.0.2/24 dev eth0\n",
      "services": [
        {
          "kind": "lb",
          "name": "lb",
          "disabled": false,
          "config": {
            "algorithm": "round-robin",
            "backends": [
              {
                "name": "web1",
                "addr": "10.0.0.11"
              },
              {
                "name": "web2",
                "addr": "10.0.0.12"
              }
            ],
            "health": {
              "type": "http",
              "path": "/",
              "interval_ms": 1000,
              "timeout_ms": 500
            },
            "drain_ms": 2000
          }
        }
      ],
      "comment": ""
    },
