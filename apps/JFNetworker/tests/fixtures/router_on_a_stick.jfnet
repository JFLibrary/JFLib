{
  "format": "jfn",
  "version": 1,
  "title": "Router-on-a-stick",
  "description": "SW1 trennt VLAN 10 (PC1) und VLAN 20 (PC2); R1 routet über einen Trunk mit 802.1Q-Subinterfaces.",
  "seed": 3,
  "next_id": 8,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC1\nip addr add 10.0.10.10/24 dev eth0\nip route add default via 10.0.10.1\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "PC2",
      "model": "pc",
      "x": 240,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC2\nip addr add 10.0.20.10/24 dev eth0\nip route add default via 10.0.20.1\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 120,
      "y": 140,
      "off": false,
      "startup_config": "hostname SW1\n!\nvlan 10\n name Office\n!\nvlan 20\n name Lab\n!\ninterface GigabitEthernet1/0/1\n switchport access vlan 10\n switchport mode access\n!\ninterface GigabitEthernet1/0/2\n switchport access vlan 20\n switchport mode access\n!\ninterface GigabitEthernet1/0/24\n switchport trunk allowed vlan 1,10,20\n switchport mode trunk\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "R1",
      "model": "jf-r4",
      "x": 120,
      "y": 280,
      "off": false,
      "startup_config": "hostname R1\n!\ninterface GigabitEthernet0/0/0\n no ip address\n no shutdown\n!\ninterface GigabitEthernet0/0/0.10\n encapsulation dot1Q 10\n ip address 10.0.10.1 255.255.255.0\n!\ninterface GigabitEthernet0/0/0.20\n encapsulation dot1Q 20\n ip address 10.0.20.1 255.255.255.0\n!\nend\n",
      "services": [],
      "comment": ""
    }
  ],
  "links": [
    {
      "id": 5,
      "a": {
        "dev": 1,
        "port": "eth0"
      },
      "b": {
        "dev": 3,
        "port": "GigabitEthernet1/0/1"
      },
      "cable": "copper",
      "cable_fixed": false,
      "kbps": 1000000,
      "delay_ns": 50,
      "jitter_ns": 0,
      "loss_ppm": 0,
      "down": false,
      "route": "straight",
