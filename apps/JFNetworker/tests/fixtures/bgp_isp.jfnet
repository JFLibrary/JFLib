{
  "format": "jfn",
  "version": 1,
  "title": "BGP: Kunden, Provider, Transit",
  "description": "Zwei Kunden mit eigenem AS (65010 an zwei Providern, 65020 an einem), die Provider AS 100 und AS 200 und der Transit-Provider AS 300 aus zwei Routern mit iBGP zwischen ihren Loopbacks (OSPF darunter, next-hop-self).",
  "seed": 21,
  "next_id": 17,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "CA",
      "model": "jf-r4",
      "x": 0,
      "y": 200,
      "off": false,
      "startup_config": "hostname CA\n!\ninterface Loopback0\n ip address 10.255.0.10 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.1.1.1 255.255.255.252\n description zu ISP1\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 10.2.1.1 255.255.255.252\n description zu ISP2\n no shutdown\n!\ninterface GigabitEthernet0/0/2\n ip address 192.168.10.1 255.255.255.0\n no shutdown\n!\nrouter bgp 65010\n bgp router-id 10.255.0.10\n network 192.168.10.0\n neighbor 10.1.1.2 remote-as 100\n neighbor 10.1.1.2 description ISP1\n neighbor 10.2.1.2 remote-as 200\n neighbor 10.2.1.2 description ISP2\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "ISP1",
      "model": "jf-r4",
      "x": 250,
      "y": 0,
      "off": false,
      "startup_config": "hostname ISP1\n!\ninterface Loopback0\n ip address 1.1.1.1 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.1.1.2 255.255.255.252\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 10.13.1.1 255.255.255.252\n no shutdown\n!\nrouter bgp 100\n network 1.1.1.1 mask 255.255.255.255\n neighbor 10.1.1.1 remote-as 65010\n neighbor 10.13.1.2 remote-as 300\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "TR1",
      "model": "jf-r4",
      "x": 500,
      "y": 0,
      "off": false,
      "startup_config": "hostname TR1\n!\ninterface Loopback0\n ip address 3.3.3.1 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.13.1.2 255.255.255.252\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 10.33.0.1 255.255.255.252\n ip ospf network point-to-point\n no shutdown\n!\nrouter ospf 1\n network 3.3.3.0 0.0.0.255 area 0\n network 10.33.0.0 0.0.0.3 area 0\n!\nrouter bgp 300\n neighbor 3.3.3.2 remote-as 300\n neighbor 3.3.3.2 update-source Loopback0\n neighbor 3.3.3.2 next-hop-self\n neighbor 10.13.1.1 remote-as 100\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "TR2",
      "model": "jf-r4",
      "x": 750,
      "y": 0,
      "off": false,
      "startup_config": "hostname TR2\n!\ninterface Loopback0\n ip address 3.3.3.2 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.23.1.1 255.255.255.252\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 10.33.0.2 255.255.255.252\n ip ospf network point-to-point\n no shutdown\n!\nrouter ospf 1\n network 3.3.3.0 0.0.0.255 area 0\n network 10.33.0.0 0.0.0.3 area 0\n!\nrouter bgp 300\n neighbor 3.3.3.1 remote-as 300\n neighbor 3.3.3.1 update-source Loopback0\n neighbor 3.3.3.1 next-hop-self\n neighbor 10.23.1.2 remote-as 200\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 5,
      "name": "ISP2",
      "model": "jf-r4",
      "x": 500,
      "y": 400,
      "off": false,
      "startup_config": "hostname ISP2\n!\ninterface Loopback0\n ip address 2.2.2.2 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.23.1.2 255.255.255.252\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 10.2.1.2 255.255.255.252\n no shutdown\n!\ninterface GigabitEthernet0/0/2\n ip address 10.2.2.1 255.255.255.252\n no shutdown\n!\nrouter bgp 200\n network 2.2.2.2 mask 255.255.255.255\n neighbor 10.2.1.1 remote-as 65010\n neighbor 10.2.2.2 remote-as 65020\n neighbor 10.23.1.1 remote-as 300\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 6,
      "name": "CB",
      "model": "jf-r4",
      "x": 750,
      "y": 400,
      "off": false,
      "startup_config": "hostname CB\n!\ninterface GigabitEthernet0/0/0\n ip address 10.2.2.2 255.255.255.252\n no shutdown\n!\ninterface GigabitEthernet0/0/2\n ip address 192.168.20.1 255.255.255.0\n no shutdown\n!\nrouter bgp 65020\n redistribute connected\n neighbor 10.2.2.1 remote-as 200\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 7,
      "name": "PC-A",
      "model": "pc",
      "x": -250,
      "y": 200,
      "off": false,
      "startup_config": "hostname PC-A\nip addr add 192.168.10.10/24 dev eth0\nip route add default via 192.168.10.1\n",
      "services": [],
      "comment": ""
    },
