{
  "format": "jfn",
  "version": 1,
  "title": "Büro hinter NAT",
  "description": "PC1, PC2 und WEB (192.168.1.0/24) hinter R1 mit PAT auf 203.0.113.1; WEB:80 ist von außen über 203.0.113.1:80 erreichbar; die Zugriffsliste 110 lässt PC2 nicht ins Web. ISP verbindet R1 mit SRV (198.51.100.10) und EXT (192.0.2.20) und kennt das Büronetz nicht.",
  "seed": 3,
  "next_id": 16,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC1\nip addr add 192.168.1.10/24 dev eth0\nip route add default via 192.168.1.1\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "PC2",
      "model": "pc",
      "x": 0,
      "y": 120,
      "off": false,
      "startup_config": "hostname PC2\nip addr add 192.168.1.11/24 dev eth0\nip route add default via 192.168.1.1\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "WEB",
      "model": "server-1u",
      "x": 0,
      "y": 240,
      "off": false,
      "startup_config": "hostname WEB\nip addr add 192.168.1.20/24 dev eth0\nip route add default via 192.168.1.1\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "workers": 4,
            "time_ms": 2,
            "routes": [
              {
                "path": "/",
                "body": "Hallo vom Webserver im Buero, {client} fragt {host}\n"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 4,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 160,
      "y": 120,
      "off": false,
      "startup_config": "hostname SW1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 5,
      "name": "R1",
      "model": "jf-r4",
      "x": 320,
      "y": 120,
      "off": false,
      "startup_config": "hostname R1\n!\ninterface GigabitEthernet0/0/0\n description LAN\n ip address 192.168.1.1 255.255.255.0\n ip access-group 110 in\n ip nat inside\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n description Provider\n ip address 203.0.113.1 255.255.255.0\n ip nat outside\n no shutdown\n!\nip nat inside source list 1 interface GigabitEthernet0/0/1 overload\nip nat inside source static tcp 192.168.1.20 80 203.0.113.1 80\nip route 0.0.0.0 0.0.0.0 203.0.113.254\n!\naccess-list 1 permit 192.168.1.0 0.0.0.255\naccess-list 110 remark PC2 darf nicht ins Web\naccess-list 110 deny tcp host 192.168.1.11 any eq www\naccess-list 110 permit ip any any\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 6,
      "name": "ISP",
      "model": "jf-r4",
      "x": 480,
      "y": 120,
      "off": false,
      "startup_config": "hostname ISP\n!\ninterface GigabitEthernet0/0/0\n ip address 203.0.113.254 255.255.255.0\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 198.51.100.1 255.255.255.0\n no shutdown\n!\ninterface GigabitEthernet0/0/2\n ip address 192.0.2.1 255.255.255.0\n no shutdown\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 7,
      "name": "SRV",
      "model": "server-1u",
      "x": 640,
      "y": 60,
      "off": false,
      "startup_config": "hostname SRV\nip addr add 198.51.100.10/24 dev eth0\nip route add default via 198.51.100.1\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "workers": 4,
            "time_ms": 2,
            "routes": [
              {
                "path": "/",
                "body": "Hallo aus dem Internet, {client} fragt {host}\n"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 8,
      "name": "EXT",
      "model": "pc",
      "x": 640,
      "y": 180,
      "off": false,
      "startup_config": "hostname EXT\nip addr add 192.0.2.20/24 dev eth0\nip route add default via 192.0.2.1\n",
      "services": [],
      "comment": ""
    }
  ],
