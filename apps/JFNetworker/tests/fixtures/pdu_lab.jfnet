{
  "format": "jfn",
  "version": 1,
  "title": "PDU-Labor",
  "description": "PC1 holt Adresse und DNS-Server per DHCP von SRV1; SRV1 hat DNS (Zone lab) und einen TCP-Echo-Dienst; PC2 hat eine feste Adresse.",
  "seed": 4,
  "next_id": 8,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC1\n",
      "services": [
        {
          "kind": "dhcp-client",
          "name": "dhclient",
          "disabled": false,
          "config": {
            "iface": "eth0"
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "PC2",
      "model": "pc",
      "x": 240,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC2\nip addr add 10.0.0.2/24 dev eth0\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 120,
      "y": 140,
      "off": false,
      "startup_config": "hostname SW1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "SRV1",
      "model": "server-1u",
      "x": 360,
      "y": 140,
      "off": false,
      "startup_config": "hostname SRV1\nip addr add 10.0.0.10/24 dev eth0\n",
      "services": [
        {
          "kind": "dhcp-server",
          "name": "dhcpd",
          "disabled": false,
          "config": {
            "pools": [
              {
                "name": "LAN",
                "network": "10.0.0.0/24",
                "range": [
                  "10.0.0.100",
                  "10.0.0.150"
                ],
                "dns": [
                  "10.0.0.10"
                ],
                "domain": "lab",
                "lease": 3600
              }
            ]
          }
        },
        {
          "kind": "dns-server",
          "name": "named",
          "disabled": false,
          "config": {
            "zones": [
              {
                "origin": "lab",
                "ttl": 300,
                "records": [
                  "srv1 A 10.0.0.10",
                  "pc2 A 10.0.0.2"
                ]
              }
            ]
          }
        },
        {
          "kind": "tcp-echo",
          "name": "echo",
          "disabled": false,
          "config": {
            "port": 7
          }
        }
      ],
      "comment": ""
    }
  ],
  "links": [
    {
      "id": 5,
      "a": {
        "dev": 1,
        "port": "eth0"
      },
      "b": {
        "dev": 3,
        "port": "GigabitEthernet1/0/1"
      },
      "cable": "copper",
