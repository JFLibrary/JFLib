        {
          "path": "/root/app",
          "dir": true
        },
        {
          "path": "/root/app/laden.jfs",
          "text": "// laden.jfs: ein kleiner Laden als Webserver: die Suche sendet mit GET, die Bestellung mit POST\nlet port = config.port ?? 8080\nlet bestellungen = 0\n\nfn seite(titel, inhalt) {\n  return \"<html><head><title>${titel}</title></head><body><h1>${titel}</h1>${inhalt}</body></html>\"\n}\n\nfn html(res, status, titel, inhalt) {\n  res.send(status, seite(titel, inhalt), {\"Content-Type\": \"text/html; charset=utf-8\"})\n}\n\n// Text aus einem Formular ohne Tags\nfn sauber(s) {\n  return (s ?? \"\").replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\")\n}\n\nlet start = \"<p>Was darf es sein?</p>\" +\n  \"<form action='/suche' method='get'><p><label>Suchwort <input name='q'></label> <input type='submit' value='Suchen'></p></form>\" +\n  \"<form action='/bestellen' method='post'><p><label>Ware <input name='ware' value='Roggenbrot'></label> \" +\n  \"<label>Menge <input name='menge' value='1'></label> <input type='submit' value='Bestellen'></p></form>\" +\n  \"<p><a href='/weiter'>Ein Link, der weiterleitet</a></p>\"\n\nhttp.serve(port, fn(req, res) {\n  let p = req.path\n  if p == \"/\" {\n    return html(res, 200, \"Der Laden\", start)\n  }\n  if p == \"/suche\" {\n    return html(res, 200, \"Suche\", \"<p>Gesucht wurde: ${sauber(req.query.q)}</p><p><a href='/'>Zurück zum Laden</a></p>\")\n  }\n  if p == \"/bestellen\" {\n    if req.method != \"POST\" {\n      return res.send(405, \"Bestellen geht nur mit POST.\\n\", {\"Allow\": \"POST\"})\n    }\n    bestellungen += 1\n    let f = req.form ?? {}\n    return html(res, 200, \"Bestellt\", \"<p>Bestellung ${bestellungen}: ${sauber(f.menge)} mal ${sauber(f.ware)}</p><p><a href='/'>Zurück zum Laden</a></p>\")\n  }\n  if p == \"/weiter\" {\n    return res.send(302, \"\", {\"Location\": \"/suche?q=weitergeleitet\"})\n  }\n  if p == \"/schleife\" {\n    return res.send(302, \"\", {\"Location\": \"/schleife\"})\n  }\n  if p == \"/moved\" {\n    return res.send(301, \"\", {\"Location\": \"/echo\"})\n  }\n  if p == \"/found\" {\n    return res.send(302, \"\", {\"Location\": \"/echo\"})\n  }\n  if p == \"/see\" {\n    return res.send(303, \"\", {\"Location\": \"/echo\"})\n  }\n  if p == \"/temp\" {\n    return res.send(307, \"\", {\"Location\": \"/echo\"})\n  }\n  if p == \"/perm\" {\n    return res.send(308, \"\", {\"Location\": \"/echo\"})\n  }\n  if p == \"/echo\" {\n    return \"${req.method} ${req.body}\\n\"\n  }\n  if p == \"/kaputt\" {\n    return html(res, 500, \"Der Ofen ist aus\", \"<p>Eine Seite des Servers zu seinem Fehler.</p>\")\n  }\n  if p == \"/fehler\" {\n    return 503\n  }\n  if p == \"/leer\" {\n    return res.send(204, \"\")\n  }\n  // /langsam bekommt nie eine Antwort\n  if p == \"/langsam\" {\n    return\n  }\n  res.send(404, \"Das führt der Laden nicht.\\n\")\n})\nprint(\"Der Laden öffnet auf Port ${port}\")\n"
        },
        {
          "path": "/var/www",
          "dir": true
        },
        {
          "path": "/var/www/brot",
          "dir": true
        },
        {
          "path": "/var/www/brot/index.html",
          "text": "<html><head><title>Unser Brot</title></head><body>\n<h1>Unser Brot</h1>\n<p>Jeden Morgen frisch: <a href=\"roggen.html\">Roggenbrot</a> und <a href=\"./weizen.html\">Weizenbrot</a>.</p>\n<p><a href=\"../index.html\">Zur Startseite</a></p>\n</body></html>\n"
        },
        {
          "path": "/var/www/brot/roggen.html",
          "text": "<html><head><title>Roggenbrot</title></head><body>\n<h1>Roggenbrot</h1><p>Mit Sauerteig, zwei Tage geführt.</p><p><a href=\"./\">Zurück zum Brot</a></p>\n</body></html>\n"
        },
        {
          "path": "/var/www/brot/weizen.html",
          "text": "<html><head><title>Weizenbrot</title></head><body>\n<h1>Weizenbrot</h1><p>Hell und locker.</p><p><a href=\"./\">Zurück zum Brot</a></p>\n</body></html>\n"
        },
