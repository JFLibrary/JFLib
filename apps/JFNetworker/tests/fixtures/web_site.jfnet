      "startup_config": "hostname WEB1\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-server",
          "name": "www",
          "disabled": false,
          "config": {
            "port": 80,
            "root": "/var/www"
          }
