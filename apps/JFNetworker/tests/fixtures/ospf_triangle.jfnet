{
  "format": "jfn",
  "version": 1,
  "title": "OSPF im Dreieck",
  "description": "Drei Router mit OSPF in Bereich 0: ein LAN mit DR und BDR, eine serielle Leitung und eine Punkt-zu-Punkt-Ethernet-Verbindung, hinter jedem Router ein PC.",
  "seed": 13,
  "next_id": 13,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "R1",
      "model": "jf-r4",
      "x": 100,
      "y": 100,
      "off": false,
      "startup_config": "hostname R1\n!\ninterface Loopback0\n ip address 1.1.1.1 255.255.255.255\n no shutdown\n!\ninterface GigabitEthernet0/0/0\n ip address 10.0.12.1 255.255.255.0\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n ip address 10.0.13.1 255.255.255.0\n ip ospf network point-to-point\n no shutdown\n!\ninterface GigabitEthernet0/0/2\n ip address 10.0.1.1 255.255.255.0\n no shutdown\n!\nrouter ospf 1\n router-id 1.1.1.1\n passive-interface GigabitEthernet0/0/2\n network 10.0.0.0 0.255.255.255 area 0\n network 1.1.1.1 0.0.0.0 area 0\n!\nend\n",
      "services": [],
      "comment": ""
    },
