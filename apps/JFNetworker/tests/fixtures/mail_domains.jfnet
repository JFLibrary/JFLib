          "mtime": 1767225600
        },
        {
          "path": "/root/Mail/account",
          "text": "# E-Mail: the account of the program on the desktop\nname = Anna Muster\naddress = anna@a.lab\nsmtp = mail.a.lab\nsmtp_port = 25\npop3 = mail.a.lab\npop3_port = 110\nuser = anna\npassword = geheim\nkeep = no\n",
          "mtime": 1767225600
        }
      ]
    },
