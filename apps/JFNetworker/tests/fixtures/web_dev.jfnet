    {
      "id": 3,
      "name": "WEB1",
      "model": "server-1u",
      "x": 400,
      "y": -80,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-server",
          "name": "www",
          "disabled": false,
          "config": {
            "port": 80,
            "root": "/var/www"
          }
        },
        {
          "kind": "script",
          "name": "konto",
          "disabled": false,
          "config": {
            "file": "/root/app/konto.jfs",
            "port": 8080
          }
        },
        {
          "kind": "http-server",
          "name": "sicher",
          "disabled": false,
          "config": {
            "root": "/var/www",
            "tls": {
              "names": [
                "web.lab",
                "www.web.lab"
              ],
              "org": "Hofladen Sonnenfeld"
            },
            "routes": [
              {
                "path": "/tresor",
                "body": "Tresor\n",
                "headers": {
                  "Set-Cookie": "tresor=auf; Secure; Path=/"
                }
              },
              {
                "path": "/hin",
                "status": 302,
                "body": "",
                "headers": {
                  "Location": "http://web.lab:8080/lesen"
                }
              }
            ]
          }
        },
        {
          "kind": "http-server",
          "name": "selbst",
          "disabled": false,
          "config": {
            "port": 8441,
            "root": "/var/www",
            "tls": {
              "names": [
                "web.lab"
              ],
              "issuer": "self",
              "org": "Eigenbau"
            }
          }
        },
        {
          "kind": "http-server",
          "name": "alt",
          "disabled": false,
          "config": {
            "port": 8442,
            "root": "/var/www",
            "tls": {
              "names": [
                "web.lab"
              ],
              "age_days": 400,
              "days": 365
            }
          }
        },
        {
          "kind": "http-server",
          "name": "anders",
