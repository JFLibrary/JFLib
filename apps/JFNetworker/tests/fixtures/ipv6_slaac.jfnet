{
  "format": "jfn",
  "version": 1,
  "title": "Zwei LANs mit IPv6",
  "description": "R1 verbindet 2001:db8:1::/64 (SW1: PC1, PC2) und 2001:db8:2::/64 (SW2: PC3, SRV) und kündigt beide Präfixe an. Die PCs bilden ihre Adressen per SLAAC aus Präfix und MAC (EUI-64); SRV hat 2001:db8:2::10 fest und kein SLAAC.",
  "seed": 6,
  "next_id": 14,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "PC1",
      "model": "pc",
      "x": 0,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC1\nsysctl -w net.ipv6.conf.all.disable_ipv6=0\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 2,
      "name": "PC2",
      "model": "pc",
      "x": 0,
      "y": 160,
      "off": false,
      "startup_config": "hostname PC2\nsysctl -w net.ipv6.conf.all.disable_ipv6=0\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 160,
      "y": 80,
      "off": false,
      "startup_config": "hostname SW1\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 4,
      "name": "R1",
      "model": "jf-r4",
      "x": 320,
      "y": 80,
      "off": false,
      "startup_config": "hostname R1\n!\nipv6 unicast-routing\n!\ninterface GigabitEthernet0/0/0\n description LAN 1\n ipv6 address 2001:DB8:1::1/64\n no shutdown\n!\ninterface GigabitEthernet0/0/1\n description LAN 2\n ipv6 address 2001:DB8:2::1/64\n no shutdown\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 5,
      "name": "SW2",
      "model": "jf-s24p",
      "x": 480,
      "y": 80,
      "off": false,
      "startup_config": "hostname SW2\n!\nend\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 6,
      "name": "PC3",
      "model": "pc",
      "x": 640,
      "y": 0,
      "off": false,
      "startup_config": "hostname PC3\nsysctl -w net.ipv6.conf.all.disable_ipv6=0\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 7,
      "name": "SRV",
      "model": "server-1u",
      "x": 640,
      "y": 160,
      "off": false,
      "startup_config": "hostname SRV\nsysctl -w net.ipv6.conf.all.disable_ipv6=0\nsysctl -w net.ipv6.conf.eth0.autoconf=0\nip -6 addr add 2001:db8:2::10/64 dev eth0\n",
      "services": [],
      "comment": ""
    }
  ],
