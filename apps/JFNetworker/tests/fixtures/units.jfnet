        },
        {
          "path": "/root/app/server.jfs",
          "text": "// der Webdienst: Version 2\nlet version = 2\nmetrics.gauge(\"version\", version)\nhttp.serve(80, fn(req, res) {\n  if (req.path == \"/health\") {\n    return \"gesund\\n\"\n  }\n  return \"Version ${version} von ${config.env.NAME}\\n\"\n})\nprint(\"bereit, Version ${version}\")\n",
          "mtime": 1767225600
        },
        {
          "path": "/root/app/crash.jfs",
          "text": "// endet nach 500 ms mit einem Fehler\ntimer.after(500, fn() {\n  throw \"kaputt\"\n})\nprint(\"gestartet\")\n",
          "mtime": 1767225600
        },
        {
          "path": "/root/app/once.jfs",
          "text": "// tut etwas und endet\nprint(\"einmal\")\n",
          "mtime": 1767225600
        },
        {
          "path": "/root/app/needs.jfs",
          "text": "// läuft, solange ihn niemand stoppt\ntimer.every(1000, fn() { })\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/jfn",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/jfn/statisch.json",
          "text": "{\"port\": 8090, \"routes\": [{\"path\": \"/\", \"body\": \"fertig\\n\"}]}\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system",
          "dir": true,
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/web.service",
          "text": "[Unit]\nDescription=Der Webdienst\n\n[Service]\nExecStart=jfs /root/app/server.jfs\nEnvironment=NAME=web\nRestart=on-failure\nRestartSec=2\n\n[Install]\nWantedBy=multi-user.target\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/crash.service",
          "text": "[Unit]\nDescription=Stürzt ab\n\n[Service]\nExecStart=jfs /root/app/crash.jfs\nSettings={\"stop_on_error\": true}\nRestart=on-failure\nRestartSec=1\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/once.service",
          "text": "[Service]\nExecStart=jfs /root/app/once.jfs\nRestart=always\nRestartSec=2s\n\n[Install]\nWantedBy=multi-user.target\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/kaputt.service",
          "text": "[Unit]\nDescription=Ohne Programm\nQuatsch=1\n\n[Service]\nRestart=manchmal\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/braucht.service",
          "text": "[Unit]\nDescription=Braucht web\nRequires=web.service\nAfter=web.service\n\n[Service]\nExecStart=jfs /root/app/needs.jfs\n",
          "mtime": 1767225600
        },
        {
          "path": "/etc/systemd/system/statisch.service",
          "text": "[Unit]\nDescription=Fertiger Webserver\n\n[Service]\nExecStart=jfn-service http-server /etc/jfn/statisch.json\n\n[Install]\nWantedBy=multi-user.target\n",
          "mtime": 1767225600
        }
      ]
    },
