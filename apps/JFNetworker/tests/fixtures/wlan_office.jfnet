{
  "format": "jfn",
  "version": 1,
  "title": "WLAN im Büro",
  "description": "Zwei Access Points mit dem WLAN „Buero“ (WPA2, 5 GHz, Kanal 36 und 44) und ein Gastnetz „Gaeste“ (offen, VLAN 20, 2,4 GHz) an AP1; R1 vergibt die Adressen beider Netze (Router-on-a-stick). Laptop2 kennt die Passphrase nicht richtig.",
  "seed": 11,
  "next_id": 20,
  "strict_mdix": false,
  "devices": [
    {
      "id": 1,
      "name": "R1",
      "model": "jf-r4",
      "x": 500,
      "y": -160,
      "off": false,
      "startup_config": "hostname R1\n!\nip dhcp excluded-address 192.168.10.1 192.168.10.20\nip dhcp excluded-address 192.168.20.1 192.168.20.20\n!\nip dhcp pool BUERO\n network 192.168.10.0 255.255.255.0\n default-router 192.168.10.1\n dns-server 192.168.10.10\n!\nip dhcp pool GAESTE\n network 192.168.20.0 255.255.255.0\n default-router 192.168.20.1\n dns-server 192.168.10.10\n!\ninterface GigabitEthernet0/0/0\n description office LAN (VLAN 1)\n ip address 192.168.10.1 255.255.255.0\n no shutdown\n!\ninterface GigabitEthernet0/0/0.20\n description guests (VLAN 20)\n encapsulation dot1Q 20\n ip address 192.168.20.1 255.255.255.0\n!\n",
      "services": [],
      "comment": "",
      "wlan": null
    },
    {
      "id": 2,
      "name": "SRV1",
      "model": "server-1u",
      "x": 760,
      "y": -160,
      "off": false,
      "startup_config": "hostname SRV1\nip addr add 192.168.10.10/24 dev eth0\nip route add default via 192.168.10.1\n",
      "services": [],
      "comment": "",
      "wlan": null
    },
    {
      "id": 3,
      "name": "SW1",
      "model": "jf-s24p",
      "x": 500,
      "y": 0,
      "off": false,
      "startup_config": "hostname SW1\n!\nvlan 20\n name Gaeste\n!\ninterface GigabitEthernet1/0/1\n description uplink to R1\n switchport mode trunk\n!\ninterface GigabitEthernet1/0/2\n description AP1\n switchport mode trunk\n!\ninterface GigabitEthernet1/0/3\n description AP2\n!\n",
      "services": [],
      "comment": "",
      "wlan": null
    },
    {
