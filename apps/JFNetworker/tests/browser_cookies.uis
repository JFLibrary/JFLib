#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/web_dev.jfnet
# cookies in the Webbrowser (B4) on PC1's desktop: Set-Cookie with each attribute, the page's cookies in
# the developer view, what the jar refuses in the console, document.cookie without HttpOnly, a script
# that sets and one that may not, fetch that carries them, a login whose redirect sets the cookie for the
# next hop, deleting them, what lasts over closing the browser and what does not
# Ids (window 0): the window 26624; the address 26800, Zurück 26803, Neu laden 26805; the developer
# view's button 124928; Cookie löschen 124960, Alle löschen 124961
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
resizewin 26624 1200 860
dblclick listitem:"Webbrowser"
click button:"Maximieren: Webbrowser"
click #26800
key ctrl+a
type "web.lab:8080/kekse\n"
wait 500
expect heading:"Kekse" exists
# ---- the page's cookies: what it set, with their attributes
click #124928
click tab:"Cookies"
expect text:"sitzung" exists
expect text:"abc" exists
expect text:"dauer" exists
expect text:"datum" exists
expect text:"2070-01-01 00:00 UTC" exists
expect text:"nurhttp" exists
expect text:"HttpOnly" exists
expect text:"falsch" missing
expect text:"sicher" missing
shot build/jfnetworker/cookies_table.png window 26624
# ---- what the jar refused, with the reason
click tab:"Konsole"
expect text:"Cookie falsch von web.lab nicht gespeichert: die Domain passt nicht zur Adresse" exists
expect text:"Cookie sicher von web.lab nicht gespeichert: Secure geht nur über https" exists
# ---- what a request carries: the head in the network log
click #26800
key ctrl+a
type "web.lab:8080/lesen\n"
wait 500
expect text:"Gesendet: sitzung=abc; dauer=lang; datum=fest; nurhttp=geheim" exists
click tab:"Netzwerk"
click text:"http://web.lab:8080/lesen"
expect text:"Cookie: sitzung=abc; dauer=lang; datum=fest; nurhttp=geheim" exists
expect text:"Host: web.lab:8080" exists
expect text:"User-Agent: JFN-Browser/1.0" exists
click tab:"Konsole"
# ---- document.cookie: no HttpOnly; another port of the host has the same cookies
click #26800
key ctrl+a
type "web.lab/konto.html\n"
wait 500
expect heading:"Das Konto" exists
click button:"Lesen"
expect text:"Kekse: sitzung=abc; dauer=lang; datum=fest" exists
# an assignment shows after its call, set_cookie at once
click button:"Setzen"
click button:"Lesen"
expect text:"Kekse: sitzung=abc; dauer=lang; datum=fest; skript=1" exists
click button:"Sofort"
expect text:"Kekse: sitzung=abc; dauer=lang; datum=fest; skript=1; sofort=2" exists
# what a script may not do
click button:"Sperre"
expect text:"Kekse: sitzung=abc; dauer=lang; datum=fest; skript=1; sofort=2" exists
expect text:"Cookie verboten nicht gespeichert: HttpOnly dürfen Skripte nicht setzen oder überschreiben" exists
# fetch carries them, HttpOnly too
click button:"Holen"
wait 500
expect text:"Gesendet: sitzung=abc; dauer=lang; datum=fest; nurhttp=geheim; skript=1; sofort=2" exists
click tab:"Netzwerk"
expect text:"http://web.lab:8080/lesen" exists
expect text:"fetch" exists
click tab:"Cookies"
expect text:"skript" exists
expect text:"sofort" exists
# ---- a login: Set-Cookie on the redirect, the cookie on the next hop
click tab:"Konsole"
click #26800
key ctrl+a
type "web.lab:8080/login\n"
wait 500
expect heading:"Willkommen" exists
expect #26800 text "http://web.lab:8080/konto"
expect text:"Angemeldet mit: sitzung=abc; dauer=lang; datum=fest; nurhttp=geheim; skript=1; sofort=2; anmeldung=frisch" exists
click tab:"Netzwerk"
expect text:"http://web.lab:8080/login" exists
expect text:"http://web.lab:8080/konto" exists
expect text:"302 Found" exists
expect text:"200 OK" exists
click text:"http://web.lab:8080/login"
expect text:"Set-Cookie: anmeldung=frisch; Path=/" exists
expect text:"Location: /konto" exists
# ---- deleting: one, then what is left of this page; Reload sends what remains
click tab:"Cookies"
click text:"anmeldung"
click #124960
expect text:"anmeldung" missing
expect text:"sitzung" exists
click #26800
key ctrl+a
type "web.lab:8080/konto\n"
wait 500
expect heading:"Nicht angemeldet" exists
# ---- the browser ends: what lasts for the session goes, what has a date stays
click tab:"Konsole"
key f12
click button:"Schließen: Nicht angemeldet – Webbrowser"
expect dialog:"Nicht angemeldet – Webbrowser" missing
dblclick listitem:"Webbrowser"
click button:"Maximieren: Webbrowser"
click #26800
key ctrl+a
type "web.lab:8080/lesen\n"
wait 500
expect text:"Gesendet: dauer=lang; datum=fest" exists
key f12
click tab:"Cookies"
click #124961
expect text:"Diese Seite hat keine Cookies." exists
click #26805
wait 500
expect text:"Gesendet: " exists
expect_nowarn
