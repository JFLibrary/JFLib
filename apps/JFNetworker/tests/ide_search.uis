#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/ide.jfnet
# find and replace in the IDE (IDE1: workspace/ide/search.rs) on SRV1 of fixtures/ide.jfnet: Ctrl+F
# finds in the shown file (the editor's find bar), Ctrl+Shift+F in every .jfs file of the device
# (the word at the caret, the matches as a list, a click opens the file there), whole words,
# replace all (refused while a file with matches has unsaved changes) as one undo step of the
# project, undone from the main window's Bearbeiten menu.
# Ids: the device window 26624; the IDE from 98304: the search's text 98592, its replacement
# 98593, Ganzes Wort 98595, Alle ersetzen 98597, Ersetzen ein / aus 98598, the matches' rows
# 99329 + i, the editor 98816.
size 1280 900
theme light
wait 1500
rclick listitem:"SRV1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
resizewin 26624 1100 760
wait 300
dblclick listitem:"app"
wait 600
dblclick listitem:"server.jfs"
wait 300
# Ctrl+F: the editor's find bar in the file
key ctrl+f
type "hits"
key enter
expect text:"Zeile 6, Spalte 7" exists
key esc
# Ctrl+Shift+F with the caret on greet: every file
key ctrl+home
key down down down down down down
key end
key left left left left left left left left left left left left
key ctrl+shift+f
expect #98592 text "greet"
expect text:"4 Treffer in 3 Dateien" exists
expect listitem:"lib.jfs:3: fn greet(path) {" exists
expect listitem:"server.jfs:7: let text = lib.greet(req.path)" exists
expect listitem:"test_lib.jfs:5: fn test_greet() {" exists
shot build/jfnetworker/ide_search.png window 26624
# a click opens the file at the match
click listitem:"lib.jfs:3: fn greet(path) {"
wait 200
expect tab:"lib.jfs" selected
expect text:"Zeile 3, Spalte 4" exists
# whole words: test_greet is no match any more
wait 600
click #98595
expect text:"3 Treffer in 3 Dateien" exists
# replace all: refused while lib.jfs has unsaved changes, then one step of the project
click #98816
key ctrl+end
type "// offen"
wait 600
click #98598
click #98593
type "hello"
click #98597
expect text:"„/root/app/lib.jfs“ hat ungespeicherte Änderungen: erst speichern, dann in den Dateien ersetzen." exists
click #98816
key ctrl+s
wait 600
click #98597
wait 100
expect text:"3 Stellen in 3 Dateien ersetzt (ein Rückgängig-Schritt)." exists
expect text:"Keine Treffer." exists
click #98592
key ctrl+a
type "hello"
expect text:"3 Treffer in 3 Dateien" exists
# the project's undo takes every file back
click menu:"Bearbeiten"
click menuitem:"Rückgängig"
move 640,300
wait 100
expect text:"Keine Treffer." exists
expect_nowarn
