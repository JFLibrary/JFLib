#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/firewall_zones.jfnet
# the parts Zonen and Sitzungen of the Firewall tab (F2, workspace/devwin/fwzones.rs) on
# fixtures/firewall_zones.jfnet: FW with the zones INNEN, DMZ and AUSSEN.  The picture of who may talk to
# whom; a zone, a class, a policy and a pair from the forms, each one undo step on the console;
# refusals with their reasons; the sessions of a ping and their clear button; the Test part with
# "keine Regel zwischen den Zonen" and "bestehende Verbindung"; a router has neither part.  (What every
# form types and that the prediction equals the engine: the selftest group firewall.)
# Ids: the window 26624; ID_FW2 = 143360: a zone's name 143360, Zone anlegen 143361, a class's name 143362,
# the protocol 143364, Klasse anlegen 143367, a policy's name 143368, its class 143369, the action 143370,
# log 143371, Regel setzen 143372, a pair's name 143373, from 143374, to 143375, its policy 143376, Paar
# anlegen 143377, Sitzungen löschen 143378, Zähler löschen 143379; remove: a policy 143552 + i, a pair
# 143616 + i; the Test part as in firewall_panel.uis (ID_FW0 = 131072).
size 1280 900
theme light
wait 500
dblclick listitem:"FW" shift
expect window 26624 open
resizewin 26624 900 840
click tab:"Firewall"
expect tab:"Regeln" selected
expect tab:"Zonen" exists
expect tab:"Sitzungen" exists
click tab:"Zonen"
expect tab:"Zonen" selected
# ---- the picture
expect text:"Wer darf mit wem sprechen?" exists
expect text:"Von INNEN nach AUSSEN: NACH-AUSSEN" exists
expect text:"Von AUSSEN nach DMZ: IN-DIE-DMZ" exists
expect text:"Von AUSSEN nach INNEN: gesperrt" exists
expect text:"Von DMZ nach INNEN: gesperrt" exists
expect text:"Von INNEN nach INNEN: frei" exists
expect text:"Von INNEN nach self: frei" exists
expect text:"INNEN: Gi0/0" exists
expect text:"DMZ: Gi0/1" exists
expect text:"AUSSEN: Gi0/2" exists
expect text:"ALLES: protocol tcp oder protocol udp oder protocol icmp" exists
expect text:"match protocol udp" exists
expect text:"WEB: protocol http" exists
expect text:"WEB → inspect log (0 Pakete)" exists
expect text:"class-default → drop log (0 Pakete)" exists
expect text:"A-D: AUSSEN → DMZ, IN-DIE-DMZ" exists
# ---- a name of two words is refused, then the zone is there
click #143360
type "ZWEI WORTE"
click #143361
expect text:"Eine Zone braucht einen Namen aus einem Wort." exists
click #143360
key ctrl+a
type "LABOR"
click #143361
expect text:"zone security LABOR" exists
expect text:"LABOR: keine Schnittstelle" exists
expect text:"Von LABOR nach INNEN: gesperrt" exists
# the same again is refused
click #143361
expect text:"Die Zone LABOR gibt es schon." exists
# ---- a class, a policy, a pair (further down the part)
wheel #131192 -420
wait 100
click #143362
type "SSH"
click #143364
click listitem:"ssh"
click #143367
expect text:"class-map type inspect SSH" exists
expect text:"SSH: protocol ssh" exists
wheel #131192 -1000
wait 100
click #143368
type "NUR-SSH"
click #143369
click listitem:"SSH"
click #143372
expect text:"policy-map type inspect NUR-SSH" exists
expect text:"SSH → inspect (0 Pakete)" exists
wheel #131192 -1000
wait 100
click #143374
click listitem:"LABOR"
click #143375
click listitem:"DMZ"
click #143376
click listitem:"NUR-SSH"
click #143377
expect text:"zone-pair security LABOR-DMZ source LABOR destination DMZ" exists
expect text:"service-policy type inspect NUR-SSH" exists
expect text:"LABOR-DMZ: LABOR → DMZ, NUR-SSH" exists
expect text:"Von LABOR nach DMZ: NUR-SSH" exists
# a policy in use stays, a zone in a pair stays: with the reason
click #143554
expect text:"Das Zonenpaar LABOR-DMZ benutzt die Richtlinie NUR-SSH: erst das Paar ändern." exists
# a pair of one zone is refused
click #143375
click listitem:"LABOR"
click #143377
expect text:"Ein Zonenpaar verbindet zwei verschiedene Zonen." exists
wheel #131192 3000
wait 100
# ---- it is on the console and in the running configuration
click tab:"CLI"
wait 100
type "\n"
type "enable\n"
type "show zone-pair security\n"
expect text:"pair LABOR-DMZ: LABOR -> DMZ, policy NUR-SSH" exists
type "show zone security LABOR\n"
expect text:"zone LABOR" exists
expect text:"  interfaces: none" exists
click tab:"Firewall"
# ---- undo: one step each, the pair is gone again
cmd 10
wait 500
expect text:"LABOR-DMZ: LABOR → DMZ, NUR-SSH" missing
expect text:"SSH → inspect (0 Pakete)" exists
cmd 10
wait 500
cmd 10
wait 500
cmd 10
wait 500
expect text:"LABOR: keine Schnittstelle" missing
# ---- the sessions of a ping from PC1, in the second device window
click tab:"Sitzungen"
expect tab:"Sitzungen" selected
expect text:"Laufende Sitzungen" exists
dblclick listitem:"PC1" shift
expect window 27136 open
resizewin 27136 700 500
click tab:"CLI" window 27136
activate 27136
wait 100
type "ping -c 3 203.0.113.10\n"
wait 4000
activate 26624
expect text:"Sitzung 1: icmp 192.168.1.10 nach 203.0.113.10, –" exists
expect #143378 enabled
click #143378
expect text:"do clear zone-pair inspect sessions" exists
expect text:"Gerade läuft keine Sitzung. Eine Sitzung beginnt, wenn eine Klasse mit „inspect“ das erste Paket einer Verbindung durchlässt." exists
# ---- the Test part: no rule between the zones
click tab:"Test"
expect tab:"Test" selected
click #131168
click listitem:"Gi0/2"
click #131171
type "203.0.113.10"
click #131172
type "192.168.1.10"
click #131174
type "80"
click #131177
expect text:"Gi0/2 hat eingehend keine Liste: das Paket passiert." exists
expect text:"Zonen: wird verworfen" exists
expect text:"Keine Regel zwischen den Zonen AUSSEN und INNEN: wird still verworfen." exists
# to the web server: its class, through the port forward as well
click #131172
key ctrl+a
type "203.0.113.1"
click #131177
expect text:"Zonen: passiert" exists
expect text:"A-D, Richtlinie IN-DIE-DMZ, Klasse WEB: inspect, das Paket passiert und beginnt eine Sitzung." exists
# another port: class-default
click #131172
key ctrl+a
type "10.0.0.10"
click #131174
key ctrl+a
type "22"
click #131177
expect text:"A-D, Richtlinie IN-DIE-DMZ, Klasse class-default: wird still verworfen." exists
# ---- an existing connection: the answer to what PC1 pings now
activate 27136
type "clear\n"
wait 100
type "ping -c 8 203.0.113.10\n"
wait 1500
activate 26624
click #131168
click listitem:"Gi0/2"
click #131171
key ctrl+a
type "203.0.113.10"
click #131172
key ctrl+a
type "192.168.1.10"
click #131174
key ctrl+a
type "80"
click #131177
expect text:"Keine Regel zwischen den Zonen AUSSEN und INNEN: wird still verworfen." exists
close window 27136
activate 26624
# ---- a router has neither part (the tab of the other model is firewall_panel.uis)
expect tab:"Zonen" exists
close window 26624
