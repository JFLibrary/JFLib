#!args --verify-dirty --open apps/JFNetworker/tests/experiments/scale_up_vs_out.jfnet --exp-golden apps/JFNetworker/tests/experiments/sweep_small.report
# the panel Experimente (workspace/experiments) on the project of the reference study: sweep_small
# defined by clicks, findings live with their words, one undo step per change, a run with its progress
# whose table equals tests/experiments/sweep_small.report byte for byte (the page says so: --exp-golden), the
# file dirty only once a run is kept, two runs compared, the file dialog for the CSV and for .jfnex, cancel
# leaves nothing.  Ids: Neu 149520, Einlesen 149521, Ausgeben 149522, Starten 149536, Abbrechen 149537,
# the name of a run 149540, Behalten 149541; Aufbau: name 149697, title 149698, levels 149704, warm-up 149705,
# settling 149706, measuring 149707, seeds 149708, p99 149714; a series 149760 + 8 s (its name, remove, +
# 2 Achse hinzufügen), Reihe hinzufügen 149718; an axis 150016 + 96 k (+ 0 kind, + 1 name, + 2 remove, + 3 its
# device, + 13 counts, + 14 Wert hinzufügen, + 16 + 6 r a value's preset, cores, speed, RAM, + 64 + h a host
# of the pool: the hosts of the project without the network's, GEN 0, LB 1, DB 2, WEB1 3); Vergleich: B 151554
size 1500 2800
theme light
wait 500
# ---- the panel comes with its command, nothing in it yet
key ctrl+shift+e
expect tab:"Experimente" selected
expect text:"Noch kein Experiment" exists
expect text:"Passt zum Projekt" missing
# ---- a new one: what the project has, three levels, it fits as it is
click #149520
wait 50
expect text:"experiment1" exists
expect #149697 text "experiment1"
expect #149704 text "100, 200, 400"
expect #149714 text "200"
expect text:"Passt zum Projekt: 3 Läufe." exists
cmd 10
wait 50
expect text:"Noch kein Experiment" exists
cmd 11
wait 50
expect text:"experiment1" exists
# ---- findings live, with their words; a list that is no list stays at its field
click #149704
key ctrl+a
type "400, 100"
wait 50
expect text:"Last: die Stufen müssen streng steigen, das Knie gilt sonst nichts." exists
click #149704
key ctrl+a
type "100, x"
wait 50
expect text:"„x“ ist keine ganze Zahl." exists
click #149704
key ctrl+a
type "100, 400, 1600"
wait 50
expect text:"Last: die Stufen müssen streng steigen, das Knie gilt sonst nichts." missing
expect text:"„x“ ist keine ganze Zahl." missing
# ---- sweep_small by clicks
click #149697
key ctrl+a
type "sweep_small"
click #149698
type "Der kurze Lauf der Testsuite"
click #149705
key ctrl+a
type "2"
click #149706
key ctrl+a
type "1"
click #149707
key ctrl+a
type "2"
click #149708
type "11, 12"
wait 50
# the series "größer": the first host of the pool and two kinds of server
click #149718
wait 50
click #149760
type "größer"
click #149762
wait 50
click #150016
click listitem:"Backends"
wait 50
click #150017
type "Hosts"
click #150019
click listitem:"LB"
wait 50
# the pool: WEB1 .. WEB8
click #150083
click #150084
click #150085
click #150086
click #150087
click #150088
click #150089
click #150090
click #150029
type "1"
wait 50
click #149762
wait 50
click #150113
type "Server"
click #150115
click listitem:"WEB1"
wait 50
click #150126
wait 50
click #150129
type "2"
click #150130
type "1,1"
click #150131
type "16"
click #150126
wait 50
click #150134
click listitem:"server-m"
wait 50
# the series "mehr": two and four hosts
click #149718
wait 50
click #149768
type "mehr"
click #149770
wait 50
click #150208
click listitem:"Backends"
wait 50
click #150209
type "Hosts"
click #150211
click listitem:"LB"
wait 50
click #150275
click #150276
click #150277
click #150278
click #150279
click #150280
click #150281
click #150282
click #150221
type "2, 4"
click #149697
wait 100
expect text:"Passt zum Projekt: 24 Läufe." exists
shot build/jfnetworker/experiments_define.png
# ---- its run: the file is not touched
expect text:"Änderungen" missing
click tab:"Lauf"
expect text:"Noch kein Lauf in dieser Sitzung; behaltene Läufe stehen im Vergleich." exists
expect text:"Ein Lauf rechnet auf einer Kopie des Projekts. Was Sie währenddessen ändern, wirkt erst im nächsten Lauf, und die laufende Simulation bleibt unberührt." exists
click #149536
wait 100
expect #149537 enabled
sync 120000
wait 300
expect text:"golden: gleich" exists
expect #149537 disabled
expect text:"Lauf von 2000-01-01 00:00: sweep_small" exists
shot build/jfnetworker/experiments_run.png
# keep it under a name; a name that is taken is refused
click #149540
key ctrl+a
type "erster"
click #149541
wait 50
expect text:"Behaltene Läufe (1)" exists
expect text:"Behalten als „erster“. Das Projekt hat sich damit geändert; Speichern schreibt den Lauf in die Datei." exists
# ---- a second run on one thread, the same bytes; a name that is taken
click #149538
key ctrl+a
type "1\n"
click #149536
wait 100
sync 120000
wait 300
expect text:"golden: gleich" exists
click #149540
key ctrl+a
type "erster"
click #149541
wait 50
expect text:"Einen Lauf „erster“ gibt es schon." exists
click #149540
key ctrl+a
type "zweiter"
click #149541
wait 50
expect text:"Behaltene Läufe (2)" exists
# ---- compare the two: the table, the charts, the words about what it means
click tab:"Vergleich"
wait 50
expect #151617 exists
expect #151620 exists
expect #151568 exists
expect text:"Kosten, Hardware und Dienstzeiten sind Annahmen des Modells, keine Preise und Messungen echter Systeme: Das Ergebnis zeigt die Form, nicht die Zahl." exists
click #151554
click listitem:"erster (2000-01-01 00:00)"
wait 50
expect #151617 exists
expect text:"Latenzen gelten nur für beantwortete Anfragen: Lesen Sie p99 zusammen mit den Fehlern, abgelaufene Anfragen haben keine Latenz." exists
expect #151569 exists
shot build/jfnetworker/experiments_compare.png
# ---- the CSV of A through the file dialog
click #151555
expect dialog:"Speichern unter" exists
click #1179660
key ctrl+a
type "../../../../build/jfnetworker/sweep_small_window.csv"
click button:"Speichern"
wait 100
expect dialog:"Speichern unter" missing
# ---- .jfnex out and in again, under a free name
click #149522
expect dialog:"Speichern unter" exists
click #1179660
key ctrl+a
type "../../../../build/jfnetworker/sweep_small_window.jfnex"
click button:"Speichern"
wait 100
expect dialog:"Speichern unter" missing
click #149521
expect dialog:"Öffnen" exists
click #1179660
key ctrl+a
type "../../../../build/jfnetworker/sweep_small_window.jfnex"
click button:"Öffnen"
wait 100
expect dialog:"Öffnen" missing
expect text:"experiment1" exists
# ---- cancel: nothing stays
click tab:"Lauf"
click #149536
click #149537
sync 120000
wait 300
expect text:"Abgebrochen: von diesem Lauf bleibt nichts." exists
expect text:"Behaltene Läufe (2)" exists
# ---- a kept run goes after its question
click #149635
expect dialog:"Lauf entfernen?" exists
click button:"Entfernen"
wait 50
expect text:"Behaltene Läufe (1)" exists
# ---- a kept run through a file: saved, opened again, there to compare
cmd 4
expect dialog:"Speichern unter" exists
click #1048588
key ctrl+a
type "../../../../build/jfnetworker/experiments_saved.jfnet"
click button:"Speichern"
wait 100
expect dialog:"Speichern unter" missing
cmd 2
expect dialog:"Öffnen" exists
click #1048588
key ctrl+a
type "experiments_saved.jfnet"
click button:"Öffnen"
wait 200
expect dialog:"Öffnen" missing
expect text:"Behaltene Läufe (1)" exists
click tab:"Vergleich"
wait 50
expect #151617 exists
expect text:"sweep_small" exists
