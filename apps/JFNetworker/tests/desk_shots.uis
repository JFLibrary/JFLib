#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/shell_tour.jfnet
# the shot matrix of a host's desktop (workspace/devwin/desktop.rs, V2) on PC1 of
# fixtures/shell_tour.jfnet: the desktop with the Terminal, the Dateimanager and the
# Systemmonitor open, then with the start menu, each light and dark at 100 and 150 %
# (build/jfnetworker/desk_<view>_<theme>_<scale>.png); high contrast; the backgrounds Netz and
# Sand with large icons.  JFNetworker links the netlab style only: the library's window area in
# the other styles is apps/desktest's shots.uis.
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
dblclick listitem:"Terminal"
type "ls /\n"
wait 100
click button:"Start"
click menuitem:"Dateimanager"
click button:"Start"
click menuitem:"Systemmonitor"
expect dialog:"Systemmonitor" exists
# ---- three windows
shot build/jfnetworker/desk_windows_light_100.png window 26624
theme dark
shot build/jfnetworker/desk_windows_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/desk_windows_dark_150.png window 26624
theme light
shot build/jfnetworker/desk_windows_light_150.png window 26624
scale 100 window 26624
# ---- the start menu
click button:"Start"
expect menuitem:"Einstellungen" exists
shot build/jfnetworker/desk_start_light_100.png window 26624
theme dark
shot build/jfnetworker/desk_start_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/desk_start_dark_150.png window 26624
theme light
shot build/jfnetworker/desk_start_light_150.png window 26624
scale 100 window 26624
key esc
# ---- high contrast: the window's background, no pattern
theme contrast
shot build/jfnetworker/desk_windows_contrast_100.png window 26624
theme light
# ---- the backgrounds Netz and Sand, large icons
click button:"Start"
click menuitem:"Einstellungen"
click "Netz"
click "Groß"
click button:"Minimieren: Einstellungen"
shot build/jfnetworker/desk_net_light_100.png window 26624
theme dark
shot build/jfnetworker/desk_net_dark_100.png window 26624
theme light
click button:"Einstellungen (minimiert)"
click "Sand"
click button:"Minimieren: Einstellungen"
shot build/jfnetworker/desk_sand_light_100.png window 26624
expect_nowarn
