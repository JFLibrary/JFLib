click #145669
expect #145669 checked
expect #145666 enabled
click #145666
expect text:"Noch nicht richtig." exists
expect text:"Er sucht in seiner Routing-Tabelle das nächste Netz. → Das tut ein Router." exists
expect #145667 exists
expect text:"Ein Switch merkt sich, an welchem Port welche MAC-Adresse hängt, und schickt den Rahmen nur dorthin. IP-Adressen sieht er nicht an." exists
expect text:"0 von 6 Punkten · 0 %, bestanden ab 70 %" exists
click #145668
expect #145668 checked
expect #145669 unchecked
expect text:"Noch nicht richtig." missing
expect #145667 missing
# right; its points stay
click #145666
expect text:"Richtig." exists
expect #145667 exists
expect text:"1 von 6 Punkten · 16 %, bestanden ab 70 %" exists
# a change takes the verdict away, not the points
click #145670
expect text:"Richtig." missing
expect text:"1 von 6 Punkten · 16 %, bestanden ab 70 %" exists
click #145668
# ---- several right: partial credit, then all of it
focus #145696
key space
expect #145696 checked
focus #145694
key space
expect text:"Teilweise richtig: 1 von 2 Punkten." exists
expect text:"2 von 6 Punkten · 33 %, bestanden ab 70 %" exists
focus #145697
key space
focus #145694
key space
expect text:"3 von 6 Punkten · 50 %, bestanden ab 70 %" exists
# a wrong one too loses again, what it reached stays
focus #145698
key space
focus #145694
key space
expect text:"Teilweise richtig: 1 von 2 Punkten." exists
expect text:"192.168.6.5 → Die dritte Zahl ist 6, nicht 5: ein anderes Netz." exists
expect text:"3 von 6 Punkten · 50 %, bestanden ab 70 %" exists
focus #145698
key space
