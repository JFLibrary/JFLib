key esc
expect text:"1 von 6 Schritten erledigt" exists
expect button:"Quiz: Netze und Adressen, erledigt, bestes Ergebnis 83 %" exists
expect #136197 enabled
click #136195
# ---- an order, from a fixed start: entry 4 at the top must go to the bottom; the keyboard stays on it
expect "1." exists
focus #145780
expect #145780 disabled
focus #145781
