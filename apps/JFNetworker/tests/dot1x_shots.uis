#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/dot1x_imap.jfnet
# the shot matrix of X1g: the canvas with its amber LED at the port that stays closed and the desktop's
# IP-Konfiguration with the 802.1X panel on PC1, then the E-Mail program with an IMAP account on PC1,
# each light and dark at 100 and 150 % (build/jfnetworker/x1g_<view>_<theme>_<scale>.png)
# Ids: the device window 26624; E-Mail in window 0: Abrufen 73729, the account's type 73808, name
# 73744, address 73745, SMTP server 73746, server 73748, port 73749, user 73750, password 73751,
# Speichern 73754; the message shown 73776.
size 1280 900
theme light
wait 3000
expect listitem:"Kabel PC2 eth0 – SW1 Gi1/0/3, Kupfer, gerade, nicht autorisiert" exists
expect listitem:"Kabel PC1 eth0 – SW1 Gi1/0/2, Kupfer, gerade, aktiv" exists
move 640,860
shot build/jfnetworker/x1g_ports_light_100.png
theme dark
shot build/jfnetworker/x1g_ports_dark_100.png
scale 150
move 960,1290
shot build/jfnetworker/x1g_ports_dark_150.png
theme light
shot build/jfnetworker/x1g_ports_light_150.png
scale 100
# ---- the panel
dblclick listitem:"PC1" shift
expect window 26624 open
resizewin 26624 900 840
dblclick listitem:"IP-Konfiguration"
click button:"Maximieren: IP-Konfiguration"
expect text:"Anmeldung am Netz (802.1X)" exists
expect text:"eth0: angemeldet als anna (EAP-MD5)" exists
shot build/jfnetworker/x1g_panel_light_100.png window 26624
theme dark
shot build/jfnetworker/x1g_panel_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/x1g_panel_dark_150.png window 26624
theme light
shot build/jfnetworker/x1g_panel_light_150.png window 26624
scale 100 window 26624
# ---- the E-Mail program: the server's folders, a message read
rclick button:"IP-Konfiguration"
click menuitem:"Schließen"
dblclick listitem:"E-Mail"
expect dialog:"E-Mail (maximiert)" exists
click #73808
click listitem:"IMAP"
click #73744
type "Anna"
click #73745
type "anna@a.lab"
click #73746
type "10.0.0.10"
click #73748
type "10.0.0.10"
click #73749
key ctrl+a
type "143"
click #73750
type "anna"
click #73751
type "geheim"
click #73754
click #73729
wait 2000
expect tab:"Posteingang (2)" exists
expect tab:"Papierkorb (0)" exists
click text:"Hallo Anna"
wait 1500
expect #73776 text "Der erste Text\n"
shot build/jfnetworker/x1g_mail_light_100.png window 26624
theme dark
shot build/jfnetworker/x1g_mail_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/x1g_mail_dark_150.png window 26624
theme light
shot build/jfnetworker/x1g_mail_light_150.png window 26624
scale 100 window 26624
close window 26624
