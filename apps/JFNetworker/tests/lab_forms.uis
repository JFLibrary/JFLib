#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/lab_forms.jfnet
# the services of a device as forms (workspace/devwin/svcform.rs, svcedit.rs) on tests/fixtures/lab_forms.jfnet:
# HOST1 without a service, WEB1 with a web server that has a member of its own, MQ1 with a queue, HOST2
# without a service.  "Dienst hinzufügen" for each kind, its form and its JSON agree; a device chosen writes
# the address the service needs; what a form does not show stays; a refusal with its words; live or a
# restart, said before and done; one undo step; a view that only reads; placing the tiles that bring a
# service, in one undo step, with what they lack on their cards and in Probleme; English; the keyboard.
# Ids: the first device window 26624; "Dienst hinzufügen …" 140304, its kind 140321, its name 140322; the
# form: Übernehmen 140288, Abbrechen 140289, Als JSON bearbeiten 140290, the rarer settings 140292 + group, a
# field 140544 + 2 i (its choice of a device + 1), a row of its list 140800 + 8 r (its device, address,
# remove, name, port, weight), Hinzufügen 141056; "Einstellungen …" of the card i 51200 + i; the JSON
# 51456, its Übernehmen 51472
size 1400 1200
theme light
wait 3000
# ---- a device without a service: the tab says so and offers the dialog
dblclick listitem:"HOST1" shift
expect window 26624 open
resizewin 26624 900 1100
click tab:"Dienste"
expect text:"Auf HOST1 läuft kein Dienst. Dienste (DHCP, DNS, Syslog, NTP) kommen aus der Projektdatei oder aus Einstellungen wie „Adresse per DHCP beziehen“." exists
# ---- a web server: the first kind of the dialog, its usual name, a name that is taken is refused
click #140304
expect dialog:"Dienst hinzufügen" exists
expect #140322 text "web"
expect text:"Antwortet auf HTTP-Anfragen, mit Rechenzeit, Wartezeit und Fehlerrate." exists
expect text:"HOST1 startet dafür neu. Danach folgt das Formular." exists
focus #140322
key ctrl+a
key backspace
click button:"Hinzufügen"
expect text:"Der Dienst braucht einen Namen." exists
focus #140322
type "web"
click button:"Hinzufügen"
expect dialog:"Dienst hinzufügen" missing
wait 200
# its form is open: labels, units, help, the defaults the service says, nothing changed yet
expect text:"Webserver (HTTP) · web" exists
expect text:"Hier nimmt der Webserver Verbindungen an." exists
expect text:"Noch nichts geändert." exists
expect #140288 disabled
expect #140544 text ""
# the rarer settings are folded away
expect text:"Streuung der Wartezeit" missing
click #140293
expect text:"Streuung der Wartezeit" exists
click #140293
# a refusal with its exact words: it does not reach the project
click #140544
type "70000"
wait 50
expect text:"Dienst http-server: Port 70000 gibt es nicht." exists
expect #140288 disabled
click #140544
key ctrl+a
type "achtzig"
wait 50
expect text:"Port: das ist keine ganze Zahl." exists
# a number that fits; a new port takes a restart, and it says so
click #140544
key ctrl+a
type "8081"
click #140546
type "1,5"
wait 50
expect text:"HOST1 startet dafür neu." exists
expect #140288 enabled
# form and JSON agree: what the fields have goes along
click #140290
expect #51456 exists
focus #51456
key ctrl+a
key ctrl+c
clip expect text
click #51473
expect button:"Einstellungen …" exists
# the same as a form, applied: one undo step
click button:"Einstellungen …"
click #140544
type "8081"
click #140546
type "1,5"
click #140288
wait 200
expect #140544 missing
expect text:"Port 8081: 0 Anfragen, 0 Antworten, 0 in Arbeit, 0 wartend" exists
# the running service takes a time without a restart, and the form says so first
click button:"Einstellungen …"
expect #140544 text "8081"
expect #140546 text "1,5"
click #140548
type "3"
wait 50
expect text:"Gilt sofort: web läuft weiter, ohne Neustart." exists
click #140288
wait 200
expect button:"Einstellungen …" exists
# what the form wrote, read as JSON
click button:"Einstellungen …"
click #140290
expect #51456 exists
click #51473
cmd 10
wait 100
click button:"Einstellungen …"
expect #140548 text ""
click #140289
cmd 11
wait 100
# ---- a kind that needs something: the balancer lacks backends and says so
click #140304
click #140321
click listitem:"Loadbalancer"
expect #140322 text "lb"
click button:"Hinzufügen"
wait 200
expect text:"Loadbalancer · lb" exists
expect text:"läuft nicht" exists
expect text:"Noch keine Backends: der Load Balancer hat niemanden, an den er verteilen kann." exists
# a backend chosen from the project's devices: the name, the address, the port of its web server
click #141056
click #140800
click listitem:"WEB1 (10.0.0.12)"
wait 50
expect #140801 text "10.0.0.12"
expect #140803 text "WEB1"
expect #140804 text "8080"
# and one typed
click #141056
click #140809
type "10.0.0.14"
wait 50
click #140288
wait 300
expect text:"Noch keine Backends: der Load Balancer hat niemanden, an den er verteilen kann." missing
expect text:"HTTP Port 80, round-robin: 2 von 2 Backends verfügbar, 0 Anfragen, 0 Fehler" exists
shot build/jfnetworker/lab_forms_lb.png window 26624
cmd 10
wait 100
cmd 10
wait 100
cmd 10
wait 100
cmd 10
wait 100
close window 26624
wait 100
# ---- the other kinds on HOST2: each its form, what it lacks, a device chosen
dblclick listitem:"HOST2" shift
resizewin 26624 900 1100
click tab:"Dienste"
click #140304
click #140321
click listitem:"Lastgenerator (HTTP)"
click button:"Hinzufügen"
wait 200
expect text:"Noch kein Ziel: der Lastgenerator sendet nichts." exists
click #141056
click #140800
click listitem:"WEB1 (10.0.0.12)"
wait 50
expect #140801 text "http://10.0.0.12:8080/"
click #140289
click #140304
click #140321
click listitem:"KV-Knoten"
click button:"Hinzufügen"
wait 200
expect text:"Noch keine Knoten: der KV-Speicher weiß nicht, wer dazugehört." exists
click #140289
click #140304
click #140321
click listitem:"Cache"
click button:"Hinzufügen"
wait 200
expect text:"Noch kein Backend: der Cache kann nichts nachladen." exists
click #140545
click listitem:"WEB1 (10.0.0.12)"
wait 50
expect #140544 text "http://10.0.0.12:8080/"
click #140289
click #140304
click #140321
click listitem:"Message Queue"
click button:"Hinzufügen"
wait 200
expect text:"Message Queue · mq" exists
click #140289
click #140304
click #140321
click listitem:"Worker"
click button:"Hinzufügen"
wait 200
expect text:"Noch keine Queue: der Worker holt nichts ab." exists
click #140545
click listitem:"MQ1 (10.0.0.13)"
wait 50
expect #140544 text "http://10.0.0.13:9000/"
click #140288
wait 300
expect text:"Noch keine Queue: der Worker holt nichts ab." missing
shot build/jfnetworker/lab_forms_kinds.png window 26624
close window 26624
wait 100
# ---- what a form does not show stays: WEB1's own member, its routes
dblclick listitem:"WEB1" shift
resizewin 26624 900 1100
click tab:"Dienste"
click button:"Einstellungen …"
expect #140544 text "8080"
expect #140548 text "2"
click #140548
key ctrl+a
type "4"
click #140288
wait 200
click button:"Einstellungen …"
click #140290
focus #51456
expect text:"Die Einstellungen von web als JSON. Übernehmen prüft sie." exists
click #51473
close window 26624
wait 100
# ---- a view of the past reads only
key f5
wait 100
key f7
key f7
wait 300
key shift+f7
wait 300
dblclick listitem:"WEB1" shift
resizewin 26624 900 1100
click tab:"Dienste"
expect #140304 disabled
click button:"Einstellungen …"
expect text:"Das ist eine Ansicht der Vergangenheit: hier ändert sich nichts. „Zurück zu live“ macht die Einstellungen wieder änderbar." exists
expect #140544 disabled
expect #140288 disabled
click #140289
close window 26624
wait 100
key shift+f5
wait 100
# ---- the tiles that bring a service: one undo step, what is missing on the card and in Probleme
click button:"Verteilte Systeme (6)"
wait 50
focus button:"Load Balancer"
key enter
wait 100
expect text:"6 Geräte · 4 Kabel" exists
click tab:"Probleme"
expect text:"LB1: Der Dienst lb läuft nicht. Noch keine Backends: der Load Balancer hat niemanden, an den er verteilen kann." exists
dblclick listitem:"LB1" shift
resizewin 26624 900 1100
click tab:"Dienste"
expect text:"Loadbalancer · lb" exists
expect text:"läuft nicht" exists
expect text:"Noch keine Backends: der Load Balancer hat niemanden, an den er verteilen kann." exists
# the form is one click away
click button:"Einstellungen …"
expect text:"An diese Server verteilt der Load Balancer: ein Gerät wählen oder eine Adresse eintippen." exists
click #140289
close window 26624
wait 100
cmd 10
wait 100
expect text:"5 Geräte · 4 Kabel" exists
expect text:"LB1: Der Dienst lb läuft nicht. Noch keine Backends: der Load Balancer hat niemanden, an den er verteilen kann." missing
cmd 11
wait 100
expect text:"6 Geräte · 4 Kabel" exists
expect text:"LB1: Der Dienst lb läuft nicht. Noch keine Backends: der Load Balancer hat niemanden, an den er verteilen kann." exists
cmd 10
wait 100
focus button:"DB-Shard"
key enter
wait 100
focus button:"Traffic-Generator"
key enter
wait 100
focus button:"Cache"
key enter
wait 100
focus button:"Message Queue"
key enter
wait 100
expect text:"9 Geräte · 4 Kabel" exists
# the database brings a small example table and runs, like the queue: neither is a finding
expect text:"DB1: Der Dienst db läuft nicht." missing
expect text:"Gen1: Der Dienst load läuft nicht. Noch kein Ziel: der Lastgenerator sendet nichts." exists
expect text:"Cache1: Der Dienst cache läuft nicht. Noch kein Backend: der Cache kann nichts nachladen." exists
# ---- the keyboard: Tab walks through a form
dblclick listitem:"WEB1" shift
resizewin 26624 900 1100
click tab:"Dienste"
click button:"Einstellungen …"
focus #140544
key tab
expect #140546 focused
key tab
expect #140548 focused
type "9"
key shift+tab
expect #140546 focused
expect #140548 text "9"
key tab
key ctrl+a
key backspace
wait 50
expect #140548 text ""
