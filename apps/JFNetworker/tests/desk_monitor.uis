#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/shell_tour.jfnet
# the Systemmonitor and Einstellungen of a host's desktop (workspace/devwin/sysmon.rs,
# desktop.rs, V2) on fixtures/shell_tour.jfnet: PC1's processes as ps sees them with a job
# started in the Terminal (sleep 100 &), ended with Beenden (kill in the Terminal), init that
# cannot be ended; SRV1's services (the web server running) and its CPU load and memory;
# Einstellungen changes the background, the icons' size and the clock, and Werkzeuge ›
# Einstellungen shows the same values (the user's settings).
# Ids: the device window 26624; the Systemmonitor's page Dienste 91139; the settings dialog's
# Hintergrund 196519993, Größe der Symbole 258906034, Uhr der Taskleiste 224541706 (hashed:
# scope "page", key, "value").
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
dblclick listitem:"Terminal"
expect dialog:"Terminal" exists
type "sleep 100 &\n"
wait 100
click button:"Start"
click menuitem:"Systemmonitor"
expect dialog:"Systemmonitor" exists
expect tab:"Prozesse" selected
expect text:"init" exists
expect text:"-sh" exists
expect text:"sleep 100" exists
expect text:"Prozesse: 3" exists
expect button:"Beenden" disabled
# init is no job the shell may end
click text:"init"
expect button:"Beenden" disabled
# the job: Beenden types kill in the Terminal, the process goes
click text:"sleep 100"
expect button:"Beenden" enabled
shot build/jfnetworker/desk_monitor_procs.png window 26624
click button:"Beenden"
wait 100
expect text:"root@PC1:~# kill 101" exists
expect text:"sleep 100" missing
expect text:"Prozesse: 2" exists
expect button:"Beenden" disabled
# ---- SRV1: the web server among the services, CPU and memory
close window 26624
dblclick listitem:"SRV1" shift
expect window 26624 open
expect tab:"Desktop" selected
click button:"Start"
click menuitem:"Systemmonitor"
expect dialog:"Systemmonitor" exists
click #91139
expect text:"web" exists
expect text:"Webserver (HTTP)" exists
expect text:"läuft" exists
click tab:"Leistung"
expect text:"CPU-Last" exists
expect text:"0,0 %" exists
expect text:"Arbeitsspeicher der Skripte" exists
shot build/jfnetworker/desk_monitor_perf.png window 26624
# ---- Einstellungen: the background, the icons, the clock
click button:"Start"
click menuitem:"Einstellungen"
expect dialog:"Einstellungen" exists
expect "Schiefer" checked
expect "Mittelgroß" checked
expect "Stunden und Minuten" checked
click "Nachtblau"
expect "Nachtblau" checked
expect "Schiefer" unchecked
shot build/jfnetworker/desk_settings_night.png window 26624
click "Groß"
expect listitem:"Terminal" rect * * 106 98
click "Mit Sekunden"
expect "Mit Sekunden" checked
# the app's settings show the same (Werkzeuge › Einstellungen, section Desktop)
click menu:"Werkzeuge"
click menuitem:"Einstellungen …"
expect #196519993 value 3
expect #258906034 value 2
expect #224541706 value 1
click button:"Schließen"
expect_nowarn
