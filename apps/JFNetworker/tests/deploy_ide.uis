#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/units.jfnet
# Bereitstellen aus der IDE (A2: workspace/ide/deploy.rs, jfn_sim deploy.rs) auf DEV1 von
# fixtures/units.jfnet, die Hosts die Gruppe Webserver: die Datei server.jfs zeigen, Ausführen ›
# Bereitstellen öffnet den Bereich mit dem Ordner der Datei und der Einheit, die daraus läuft.
# Die HTTP-Prüfung scheitert auf WEB2, dort hält der Dienst alt den Port: der Fortschritt zeigt
# WEB1 fertig, WEB2 gescheitert mit dem Grund, WEB3 nicht begonnen.  WEB2 ohne alt: dieselbe
# Bereitstellung geht durch; WEB1 liest danach die Datei, und ihr Dienst läuft unter Metriken.  Eine
# Liste von Hosts, eine fehlende Einheit und ihre Ablehnung, Einheit anlegen, Abbrechen.
# Ids: 26624 the device window; the IDE from 98304: Ausführen 98307, its row Bereitstellen 98405;
# from 110592 the pane: + 2 the group, + 3 the list, + 4 the files, + 5 the unit, + 6 the check,
# + 7 its port, + 13 Bereitstellen, + 14 Abbrechen, + 15 Einheit anlegen, + 0x10 the hosts' kind.
size 1280 900
theme light
wait 1500
rclick listitem:"DEV1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
resizewin 26624 1180 820
wait 300
dblclick listitem:"app"
wait 600
dblclick listitem:"server.jfs"
wait 300
expect tab:"server.jfs" selected
# Ausführen › Bereitstellen
click #98307
click #98405
wait 200
expect tab:"Bereitstellen" selected
expect #110596 text "/root/app"
expect #110597 text "web.service"
expect text:"WEB1, WEB2, WEB3" exists
expect text:"Hier steht der Fortschritt je Host: Dateien kopieren, Einheit neu starten, prüfen, dann der nächste." exists
shot build/jfnetworker/deploy_ide_form.png window 26624
# die Prüfung: HTTP auf Port 80, /health
expect #110599 exists
click #110605
wait 30
expect text:"web.service" exists
expect text:"kopiert" exists
wait 100
expect text:"prüft" exists
wait 400
expect text:"wartet nach der Prüfung" exists
wait 2000
expect text:"fertig" exists
expect text:"läuft: 1 von 3 Hosts fertig" exists
wait 12000
expect text:"gescheitert: 1 von 3 Hosts fertig, der Rest bleibt, wie er war" exists
expect text:"nicht begonnen" exists
expect text:"WEB2: die Prüfung hielt nicht: Status 404 statt 200" exists
expect #110605 enabled
expect #110606 disabled
shot build/jfnetworker/deploy_ide_failed.png window 26624
# WEB2 ohne alt
rclick listitem:"WEB2"
move 700,300
click menuitem:"Konsole öffnen"
wait 200
type "systemctl stop alt\n"
wait 300
activate 26624
wait 100
click #110605
wait 15000
expect text:"fertig: 3 von 3 Hosts" exists
expect text:"nicht begonnen" missing
shot build/jfnetworker/deploy_ide_done.png window 26624
# WEB3 hat die Datei bekommen, die Einheit läuft
rclick listitem:"WEB3"
move 700,300
click menuitem:"Konsole öffnen"
wait 200
type "systemctl is-active web; cat /root/app/server.jfs | head -2\n"
wait 300
expect text:"active" exists
expect text:"// der Webdienst: Version 2" exists
activate 26624
wait 100
# die Auswahl statt der Gruppe
click tab:"Auswahl"
wait 100
expect #110594 missing
# eine Liste, eine Einheit, die es nicht gibt
click tab:"Liste"
wait 100
expect #110595 exists
click #110595
type "WEB1"
click #110597
key ctrl+a
type "gibtsnicht"
wait 100
expect #110607 enabled
click #110605
wait 100
expect text:"Die Einheit gibtsnicht.service gibt es auf DEV1 nicht: weder in /etc/systemd/system noch unter den Dateien." exists
# Einheit anlegen: die Datei kommt als Tab
click #110607
wait 300
expect tab:"gibtsnicht.service" selected
expect #110607 missing
# Abbrechen im Lauf
click #110605
wait 100
expect #110606 enabled
click #110606
wait 100
expect text:"abgebrochen: 0 von 1 Hosts fertig" exists
