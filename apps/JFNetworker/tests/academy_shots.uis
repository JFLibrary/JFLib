#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/academy
# the pictures of the Akademie: the start page with the course, the list of courses, the outline, a lesson
# with its picture, the lab with its bar, the question before resetting; light and dark at 100 and 150 %,
# narrow; in build/jfnetworker/academy_<view>.png.  The narrow window must not scroll sideways.  Ids: as in
# academy_course.uis.
size 1280 800
theme light
shot build/jfnetworker/academy_start_light_100.png
theme dark
shot build/jfnetworker/academy_start_dark_100.png
theme light
# ---- the outline
click button:"Kurs: Beispielkurs: das erste Netz"
shot build/jfnetworker/academy_course_light_100.png
theme dark
shot build/jfnetworker/academy_course_dark_100.png
scale 150
shot build/jfnetworker/academy_course_dark_150.png
theme light
shot build/jfnetworker/academy_course_light_150.png
scale 100
size 800 520
shot build/jfnetworker/academy_course_narrow.png
size 1280 800
# ---- a lesson with its picture
click button:"Beginnen"
wait 100
shot build/jfnetworker/academy_lesson_light_100.png
theme dark
wait 100
shot build/jfnetworker/academy_lesson_dark_100.png
scale 150
wait 100
shot build/jfnetworker/academy_lesson_dark_150.png
theme light
wait 100
shot build/jfnetworker/academy_lesson_light_150.png
scale 100
size 800 520
wait 100
shot build/jfnetworker/academy_lesson_narrow.png
theme dark
wait 100
shot build/jfnetworker/academy_lesson_narrow_dark.png
theme light
size 1280 800
click button:"Weiter"
wait 100
shot build/jfnetworker/academy_lesson2_light_100.png
wheel 640,400 -1200
wait 100
shot build/jfnetworker/academy_lesson2_end.png
key esc
# ---- progress in the outline and on the card, the list of courses, the question
shot build/jfnetworker/academy_course_progress.png
click button:"Fortschritt zurücksetzen"
expect dialog:"Fortschritt zurücksetzen?" exists
shot build/jfnetworker/academy_reset.png
click button:"Abbrechen"
key esc
shot build/jfnetworker/academy_start_progress.png
cmd 1005
expect #135424 focused
shot build/jfnetworker/academy_home_light_100.png
theme dark
shot build/jfnetworker/academy_home_dark_100.png
theme light
key enter
# ---- the lab: the bar over the canvas
click button:"Weiter"
click button:"Weiter"
wait 600
shot build/jfnetworker/academy_lab_light_100.png
theme dark
shot build/jfnetworker/academy_lab_dark_100.png
scale 150
shot build/jfnetworker/academy_lab_dark_150.png
theme light
shot build/jfnetworker/academy_lab_light_150.png
scale 100
size 800 520
shot build/jfnetworker/academy_lab_narrow.png
size 1280 800
dblclick listitem:"PC2"
type "ip addr add 10.0.0.2/24 dev eth0\n"
wait 2000
expect text:"2 von 2 Zielen erreicht" exists
shot build/jfnetworker/academy_lab_done.png
theme dark
shot build/jfnetworker/academy_lab_done_dark.png
theme light
expect_nowarn
