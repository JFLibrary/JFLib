#!args --verify-dirty --start-page --academy-dir apps/JFNetworker/academy
# the pictures of the real courses: the list of courses and the outline; a lesson with its drawing and one with
# console output; a lab and a fault hunt with their panels; a quiz; light and dark, 100 and 150 %, narrow; in
# build/jfnetworker/courses_<view>.png.  The narrow window must not scroll sideways.  Ids: 135424 + i the cards of the
# list (0 the sample, 1 Fehlersuche, 2 Grundlagen), 136192 + k the steps of the outline, 135202 Weiter of a lesson.
size 1280 800
theme light
cmd 1005
wait 100
shot build/jfnetworker/courses_list.png
theme dark
wait 100
shot build/jfnetworker/courses_list_dark.png
theme light
focus #135426
key enter
wait 100
shot build/jfnetworker/courses_outline.png
theme dark
wait 100
shot build/jfnetworker/courses_outline_dark.png
theme light
# ---- a lesson with a drawing: the frame, light and dark, 100 and 150 %, narrow
focus #136193
key enter
wait 100
shot build/jfnetworker/courses_lesson.png
theme dark
wait 100
shot build/jfnetworker/courses_lesson_dark.png
scale 150
wait 100
shot build/jfnetworker/courses_lesson_dark_150.png
theme light
wait 100
shot build/jfnetworker/courses_lesson_150.png
scale 100
size 800 520
wait 100
shot build/jfnetworker/courses_lesson_narrow.png
wheel 400,300 -1200
wait 100
shot build/jfnetworker/courses_lesson_narrow2.png
size 1280 800
# ---- a lesson with console output, further down: how a console block reads
wheel 640,400 -1500
wait 100
shot build/jfnetworker/courses_console.png
theme dark
wait 100
shot build/jfnetworker/courses_console_dark.png
theme light
key esc
# ---- the lab of the unit
focus #136195
key enter
wait 500
shot build/jfnetworker/courses_lab.png
click button:"Zurück zum Kurs"
wait 100
# ---- a quiz
focus #136196
key enter
wait 100
shot build/jfnetworker/courses_quiz.png
theme dark
wait 100
shot build/jfnetworker/courses_quiz_dark.png
theme light
key esc
# ---- the other course: its outline and a fault hunt
cmd 1005
wait 100
focus #135425
key enter
wait 100
shot build/jfnetworker/courses_outline2.png
focus #136194
key enter
wait 100
shot build/jfnetworker/courses_lesson2.png
key esc
focus #136198
key enter
wait 500
shot build/jfnetworker/courses_hunt.png
theme dark
wait 100
shot build/jfnetworker/courses_hunt_dark.png
theme light
size 800 520
wait 100
shot build/jfnetworker/courses_hunt_narrow.png
size 1280 800
expect_nowarn
