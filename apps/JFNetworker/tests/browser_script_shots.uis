#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/web_scripts.jfnet
# the shot matrix of the page scripts (B3) on PC1's desktop: a counter a script changed, a list, a
# form with its message, the console with errors (build/jfnetworker/script_<view>_<theme>_<scale>.png)
# Ids: the window 26624; the address 26800; the console's button 122880; the list's field 3841261569
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
resizewin 26624 900 680
dblclick listitem:"Webbrowser"
# ---- the counter
click #26800
key ctrl+a
type "web.lab/zaehler.html\n"
wait 500
click button:"Plus"
click button:"Plus"
expect text:"Stand: 2" exists
shot build/jfnetworker/script_counter_light_100.png window 26624
theme dark
shot build/jfnetworker/script_counter_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/script_counter_dark_150.png window 26624
theme light
shot build/jfnetworker/script_counter_light_150.png window 26624
scale 100 window 26624
# ---- the list
click #26800
key ctrl+a
type "web.lab/liste.html\n"
wait 500
click #3841261569
type "Mehl"
click button:"Dazu"
click #3841261569
type "Hefe"
click button:"Dazu"
expect text:"Einträge: 2" exists
shot build/jfnetworker/script_list_light_100.png window 26624
theme dark
shot build/jfnetworker/script_list_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/script_list_dark_150.png window 26624
theme light
shot build/jfnetworker/script_list_light_150.png window 26624
scale 100 window 26624
# ---- the form, stopped
click #26800
key ctrl+a
type "web.lab/formular.html\n"
wait 500
click button:"Abschicken"
expect text:"Bitte einen Namen eingeben." exists
shot build/jfnetworker/script_form_light_100.png window 26624
theme dark
shot build/jfnetworker/script_form_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/script_form_dark_150.png window 26624
theme light
shot build/jfnetworker/script_form_light_150.png window 26624
scale 100 window 26624
# ---- the console with errors, the status line's note
click #26800
key ctrl+a
type "web.lab/kaputt.html\n"
wait 500
expect heading:"Kaputte Skripte" exists
shot build/jfnetworker/script_note_light_100.png window 26624
click #122880
expect text:"http://web.lab/kaputt.html:14:9: Division durch 0" exists
shot build/jfnetworker/script_console_light_100.png window 26624
theme dark
shot build/jfnetworker/script_console_dark_100.png window 26624
scale 150 window 26624
shot build/jfnetworker/script_console_dark_150.png window 26624
theme light
shot build/jfnetworker/script_console_light_150.png window 26624
scale 100 window 26624
expect_nowarn
