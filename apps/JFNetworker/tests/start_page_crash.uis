#!args --verify-dirty --autosave-dir build/jfn_start_autosave --open apps/JFNetworker/tests/fixtures/two_pcs.jfnet
# the first half of the recovery on the start page: a session with an unsaved change ends without
# saving, its copy stays for start_page_later.uis and start_page_recover.uis, which run next
# (autosave.uis does the same for the bar above the canvas).  The first shot puts the folder of the copies in place before the
# program starts (build_rs.py makes the folders of shots), so the command line hands it over.
shot build/jfn_start_autosave/start.png
theme light
click listitem:"PC2"
key delete
key esc
expect text:"2 Geräte · 1 Kabel" exists
system suspend
expect text:"geändert, automatisch gesichert" exists
system resume
expect_nowarn
system session-end
