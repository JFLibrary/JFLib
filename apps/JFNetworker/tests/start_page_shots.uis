#!args --verify-dirty --start-page --recent=apps/JFNetworker/tests/fixtures/two_pcs.jfnet --recent=apps/JFNetworker/tests/fixtures/campus.jfnet --recent=build/st1/gone.jfnet --recent=apps/JFNetworker/tests/fixtures/office.jfnet|C:/Windows/win.ini
# the pictures of the start page: light and dark at 100 and 150 %, narrow, the smallest window, with
# a focus ring on a card; in build/jfnetworker/start_page_<view>.png.  The narrow windows must not
# scroll sideways: the cards fold into fewer columns.
size 1280 800
theme light
shot build/jfnetworker/start_page_light_100.png
theme dark
shot build/jfnetworker/start_page_dark_100.png
scale 150
shot build/jfnetworker/start_page_dark_150.png
theme light
shot build/jfnetworker/start_page_light_150.png
scale 100
# the smallest window of the app, then a wide one
size 800 520
shot build/jfnetworker/start_page_narrow.png
theme dark
shot build/jfnetworker/start_page_narrow_dark.png
theme light
wheel 400,400 -1200
wait 100
shot build/jfnetworker/start_page_narrow_scrolled.png
size 1920 1080
shot build/jfnetworker/start_page_wide.png
# the keyboard's ring, a card under the pointer
size 1280 800
key tab
expect #129041 focused
move 900,240
wait 100
shot build/jfnetworker/start_page_focus.png
# the Projektinfo dialog over a project
click button:"Vorlage: Campus"
wait 200
expect text:"12 Geräte · 11 Kabel" exists
shot build/jfnetworker/start_page_campus.png
cmd 1001
expect dialog:"Projektinfo" exists
shot build/jfnetworker/start_page_info.png
click button:"Abbrechen"
expect_nowarn
