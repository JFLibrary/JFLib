#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/shell_tour.jfnet
# the desktop of a host (workspace/devwin/desktop.rs, V2) on PC1 of fixtures/shell_tour.jfnet: a
# host's device window opens on its Desktop; the icons (a click chooses one, a double click,
# Enter and the start menu open programs), several program windows at once, the taskbar (a
# click activates, a second one minimises, a third one brings the window back), maximising and
# minimising with the title bar's buttons, moving by the title bar, Alt+F6, F11 and the
# taskbar's Vollbild (full screen and back), the Terminal window as the device's console (the
# Terminal panel points there), closing a program, and the desktop as it was after the device
# window was closed and opened again.
# Ids: the device window 26624; the desktop of window 0: Start 90113, Vollbild 90115, the icons
# 90160 + p (Terminal 90160, Dateimanager 90161, Texteditor 90162), the Terminal's input 25089.
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
expect tab:"Desktop" selected
expect list:"Desktop" exists
expect listitem:"Terminal" exists
expect listitem:"IDE" exists
expect button:"Start" exists
expect button:"Vollbild" unchecked
# a click chooses an icon, a double click opens it (its window on top, its taskbar button)
click listitem:"Texteditor"
expect listitem:"Texteditor" selected
dblclick listitem:"Terminal"
expect listitem:"Terminal" selected
expect dialog:"Terminal" exists
expect dialog:"Terminal" selected
expect button:"Terminal" checked
type "echo hallo vom Desktop\n"
wait 100
expect text:"hallo vom Desktop" exists
# the console is drawn here: its tab in the Terminal panel points to the device window
dblclick listitem:"PC1"
expect tab:"PC1" selected
expect text:"Die Konsole von PC1 ist im Gerätefenster offen" exists
# the start menu: the programs in groups
click button:"Start"
expect text:"Netzwerk" exists
expect text:"System" exists
expect text:"Entwicklung" exists
expect menuitem:"Systemmonitor" exists
click menuitem:"Systemmonitor"
expect dialog:"Systemmonitor" exists
expect button:"Systemmonitor" checked
expect button:"Terminal" unchecked
# the keyboard: the icons are one Tab stop, the arrows move between them, Enter opens
focus listitem:"Terminal"
key down
expect listitem:"Dateimanager" focused
expect listitem:"Dateimanager" selected
key enter
expect dialog:"Dateimanager" exists
expect button:"Dateimanager" checked
shot build/jfnetworker/desk_programs_three.png window 26624
# the taskbar: a click brings a window forward, a second minimises it, a third restores it
click button:"Terminal"
expect button:"Terminal" checked
expect dialog:"Terminal" selected
click button:"Terminal"
expect button:"Terminal (minimiert)" exists
expect dialog:"Terminal" missing
expect text:"Die Konsole von PC1 ist im Gerätefenster offen" missing
click button:"Terminal (minimiert)"
expect dialog:"Terminal" exists
expect text:"Die Konsole von PC1 ist im Gerätefenster offen" exists
# maximise and back with the title bar's buttons
click button:"Maximieren: Terminal"
expect dialog:"Terminal (maximiert)" exists
click button:"Wiederherstellen: Terminal"
expect dialog:"Terminal" exists
# minimise with the title bar's button (the window to the front first), back from the taskbar
click button:"Systemmonitor"
expect dialog:"Systemmonitor" selected
click button:"Minimieren: Systemmonitor"
expect button:"Systemmonitor (minimiert)" exists
expect dialog:"Systemmonitor" missing
click button:"Systemmonitor (minimiert)"
expect dialog:"Systemmonitor" selected
# moving by the title bar (points in the device window)
window 26624
drag titlebar:"Systemmonitor" 600,330
window any
expect dialog:"Systemmonitor" selected
# Alt+F6: the next window comes forward
key alt+f6
expect button:"Systemmonitor" unchecked
# full screen: F11 and the taskbar's Vollbild
click titlebar:"Terminal"
key f11
expect window 26624 fullscreen
expect button:"Vollbild" checked
shot build/jfnetworker/desk_programs_full.png window 26624
key f11
expect window 26624 windowed
click button:"Vollbild"
expect window 26624 fullscreen
click button:"Vollbild"
expect window 26624 windowed
# closing a program (the taskbar button's menu) takes its button away
rclick button:"Systemmonitor"
click menuitem:"Schließen"
expect button:"Systemmonitor" missing
expect dialog:"Systemmonitor" missing
# the device window closed and opened again: the desktop as it was
close window 26624
expect window 26624 closed
expect text:"Die Konsole von PC1 ist im Gerätefenster offen" missing
dblclick listitem:"PC1" shift
expect window 26624 open
expect tab:"Desktop" selected
expect dialog:"Terminal" exists
expect dialog:"Dateimanager" exists
expect button:"Terminal" exists
expect button:"Dateimanager" exists
expect button:"Systemmonitor" missing
expect text:"hallo vom Desktop" exists
shot build/jfnetworker/desk_programs_again.png window 26624
expect_nowarn
