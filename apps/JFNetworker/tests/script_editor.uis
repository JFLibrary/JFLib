#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/scripts.jfnet
# the script editor in the IDE (U7, IDE1: workspace/ide, doc/scripts.rs) on SRV1 of the fixture:
# its device window from the context menu on the IDE tab, the inline scripts in the Explorer;
# zaehler's runtime error in line 13 (a mark in the editor, the Probleme list, a click puts the
# caret there) and its output in Ausgabe, following live; typing with the check while typing (at
# most every 250 ms) and F8 from one message to the next; Ctrl+S refuses a source that does not
# compile and saves one that does -- one undo step, the script starts again with its disk
# (Start 2), undo and redo go back and forth (Start 3, Start 4) without restarting the device;
# stop, run, restart; a new script from a template (a file: run as a service it fails, port 7 is
# taken, with its mark in line 3); deleting an inline script with undo; the Dienste tab knows the
# scripts too.  Shots: build/jfnetworker/script_editor_*.png.
# Ids: the device window 26624; the IDE from 98304: Datei 98305, Speichern 98321, Als Dienst
# ausführen 98324, Stoppen 98325, Neu starten 98326, the editor 98816, Ausgabe 98569, Probleme
# 98571 (its rows 99073 + i).
size 1280 900
theme light
# zaehler prints "Start 1" and then a beat a second; the third beat divides by 0 (line 13)
wait 3500
rclick listitem:"SRV1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
expect tab:"IDE" selected
resizewin 26624 1100 760
wait 300
expect listitem:"zaehler" exists
expect listitem:"echo" exists
dblclick listitem:"zaehler"
wait 300
expect tab:"zaehler (eingebettet)" selected
expect text:"Dienst zaehler: läuft" exists
expect text:"1 Fehler, 0 Warnungen" exists
expect text:"wie im Projekt" exists
expect text:"Start 1" exists
expect text:"Takt 2" exists
expect text:"Takt 3" missing
expect #98321 disabled
expect #98325 enabled
shot build/jfnetworker/script_editor_open.png window 26624
# the error of the run: in Probleme, a click puts the caret on it
click #98571
expect tab:"Probleme (1)" selected
expect text:"zaehler (eingebettet):13:15: Fehler im Lauf (timer, bei 3,000 s): Division durch 0" exists
click #99073
wait 100
expect #98816 focused
expect text:"Zeile 13, Spalte 15" exists
expect text:"13:15: Fehler im Lauf (timer, bei 3,000 s): Division durch 0" exists
# typing: a line that does not compile; the check comes after a moment
key ctrl+end
type "\nlet = 5"
expect text:"1 Fehler, 0 Warnungen" exists
wait 300
expect text:"2 Fehler, 0 Warnungen" exists
expect tab:"zaehler (eingebettet) ●" selected
expect #98321 enabled
# F8: round the end to the first message, then the next
key f8
expect text:"Zeile 13, Spalte 15" exists
key f8
expect text:"Zeile 17, Spalte 5" exists
shot build/jfnetworker/script_editor_errors.png window 26624
key shift+f8
expect text:"Zeile 13, Spalte 15" exists
expect text:"13:15: Fehler im Lauf (timer, bei 3,000 s): Division durch 0" exists
key f8
expect text:"17:5: Nach let fehlt ein Name" exists
# Ctrl+S refuses it: the project keeps the old source
key ctrl+s
expect text:"Das Skript übersetzt nicht: Zeile 17, Spalte 5: Nach let fehlt ein Name" exists
# the editor's own undo takes the typing back; a line that compiles
key ctrl+z ctrl+z
wait 300
expect text:"1 Fehler, 0 Warnungen" exists
expect text:"wie im Projekt" exists
key ctrl+end
type "\nprint(\"neu\")"
wait 300
expect text:"1 Fehler, 0 Warnungen" exists
# Ctrl+S: into the project and the running script; it starts again and keeps its disk
key ctrl+s
wait 200
expect text:"wie im Projekt" exists
expect text:"keine Meldungen" exists
click #98569
expect text:"Start 2" exists
expect text:"neu" exists
expect text:"Start 1" missing
expect tab:"Probleme" exists
shot build/jfnetworker/script_editor_applied.png window 26624
# undo: the source before, in the editor and the simulator (the disk counts on)
click menu:"Bearbeiten"
click menuitem:"Rückgängig"
move 640,300
wait 200
expect text:"Start 3" exists
expect text:"neu" missing
expect text:"wie im Projekt" exists
expect #98321 disabled
# redo: the new source again
click menu:"Bearbeiten"
click menuitem:"Wiederholen"
move 640,300
wait 200
expect text:"Start 4" exists
expect text:"neu" exists
# stop, run, restart: the simulator only (the project is as it was); clicks 600 ms apart (no
# double clicks)
click #98325
wait 300
expect text:"Dienst zaehler: gestoppt" exists
expect #98325 disabled
expect text:"Start 4" exists
wait 600
click #98324
wait 300
expect text:"Start 5" exists
expect text:"Start 4" missing
expect #98325 enabled
wait 600
click #98326
wait 300
expect text:"Start 6" exists
# a new script from a template: a file of the device; run as a service it fails (port 7 is
# taken by echo), with its mark in line 3
wait 600
click #98305
click menuitem:"Neues Skript: UDP-Echo"
move 700,300
wait 200
expect tab:"echo.jfs" selected
expect listitem:"echo.jfs" exists
key f5
wait 200
expect text:"Dienst echo2: mit Fehler beendet" exists
expect text:"1 Fehler, 0 Warnungen" exists
wait 600
click #98571
shot build/jfnetworker/script_editor_template.png window 26624
# delete the inline echo, undo brings it back
wait 600
click listitem:"echo"
key delete
wait 100
expect listitem:"echo" missing
click menu:"Bearbeiten"
click menuitem:"Rückgängig"
move 640,300
expect listitem:"echo" exists
# the Dienste tab lists the scripts as services
wait 600
click tab:"Dienste"
expect text:"Skript · zaehler" exists
expect text:"Skript · echo" exists
expect text:"Skript · echo2" exists
expect_nowarn
