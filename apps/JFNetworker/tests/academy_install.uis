#!args --verify-dirty --start-page --academy-dir mem://ak3/academy --academy-gate --academy-folder apps/JFNetworker/tests/fixtures
# installing courses, without a network: a folder source (tests/fixtures/academy_src, academy_src2) through the same way
# as the web; the courses go to mem://, so a run leaves nothing behind.  Nobody asks in a script, so the connection to
# the courses' host is refused here and no request leaves the program.  --academy-gate stops the worker before each
# file until `cmd 1039 N` lets N through, and `sync` waits until it stands there.
# Ids: 1005 Datei › Akademie, 216 Einstellungen, 166945967 the address in the settings, 209344286 the language there;
# 135170 back, 147456 Nach Kursen suchen, 147457 Jetzt installieren, 147458 Aus Ordner installieren, 147459 Ordner
# schließen, 147460 Abbrechen, 147461 its bar, 147462 the way there on the start page, 147463 the note's close button,
# 147712 + i Aktualisieren, 148224 + i Deinstallieren of course i, 148736 + k Jetzt installieren of entry k of the list
# (in academy_src: defekt, falsch, grund, zweit), 135424 + i the card of course i, 136192 + k step k.
size 1280 800
theme light
# ---- the start page has the way there, also while there is no course
expect button:"Alle Kurse …" missing
expect text:"Akademie: Kurse mit Lektionen zum Lesen und Laboren im Simulator." exists
click button:"Kurse installieren …"
expect text:"Noch keine Kurse" exists
expect #147457 focused
expect text:"Noch keine Kursliste geladen. Erst „Nach Kursen suchen“ verbindet das Programm mit dem Kursserver; installierte Kurse brauchen kein Netz." exists
expect text:"Lädt die Kurse von GitHub. Das Programm verbindet sich erst nach diesem Klick und fragt vorher." exists
# ---- the host of the rule: nobody asks in a script, so it is refused, and said so with what to do
click button:"Jetzt installieren"
sync
expect text:"Die Verbindung wurde nicht erlaubt" exists
expect text:"Die Verbindung zu raw.githubusercontent.com wurde nicht erlaubt." exists
click #147463
expect text:"Die Verbindung wurde nicht erlaubt" missing
click button:"Nach Kursen suchen"
sync
expect text:"Die Verbindung wurde nicht erlaubt" exists
expect text:"Noch keine Kurse" exists
# ---- the question comes with the click: the worker waits for it, the window keeps running; refused, nothing leaves
perm answer dialog
perm expect none
click button:"Nach Kursen suchen"
perm wait 5000
perm expect open
expect text:"Grund: Kurse der Akademie laden" exists
expect text:"Regel: net.connect raw.githubusercontent.com:443" exists
shot build/jfnetworker/install_question.png
expect #147460 exists
expect text:"Die Kursliste wird geladen" exists
click button:"Ablehnen"
sync
perm expect net.connect raw.githubusercontent.com:443 deny
expect text:"Die Verbindung wurde nicht erlaubt" exists
perm reset
perm answer none
# ---- another host is the setting's: refused without a question, and the way back is beside it
cmd 216
focus #166945967
key ctrl+a
type "https://example.org/kurse/"
click button:"Schließen"
click button:"Nach Kursen suchen"
sync
expect text:"Dieser Host ist nicht erlaubt" exists
expect text:"Der Host example.org ist nicht erlaubt; Kurse kommen nur von raw.githubusercontent.com." exists
expect text:"Unter Einstellungen › Akademie lässt sich die Adresse auf die Vorgabe zurücksetzen." exists
cmd 216
expect #166945967 text "https://example.org/kurse/"
focus button:"Zurücksetzen: Adresse der Kurse"
key enter
expect #166945967 text "https://raw.githubusercontent.com/JFLibrary/JFLib/main/apps/JFNetworker/academy/"
click button:"Schließen"
click button:"Nach Kursen suchen"
sync
expect text:"Die Verbindung wurde nicht erlaubt" exists
# ---- a folder without a list says what is missing; cancelling the dialog does nothing
click button:"Aus Ordner installieren …"
expect dialog:"Ordner auswählen" exists
key esc
expect dialog:"Ordner auswählen" missing
click button:"Aus Ordner installieren …"
click text:"academy_leer"
click button:"Ordner auswählen"
sync
expect text:"Die Kursliste ist nicht in Ordnung" exists
# ---- a folder with a list: what it offers
click button:"Aus Ordner installieren …"
click text:"academy_src"
click button:"Ordner auswählen"
sync
expect text:"Die Kursliste ist nicht in Ordnung" missing
expect button:"Ordner schließen" exists
expect text:"Grundkurs" exists
expect text:"Einsteiger · 10 Min. · Version 1 · 4,5 KB" exists
expect text:"Noch ein Kurs" exists
expect text:"Erfahrene · 5 Min. · Version 3 · 600 B" exists
expect text:"Beispiel" exists
# ---- install, with its progress: file by file, then cancelled half way
focus #148738
click #148738
sync
expect text:"„Grundkurs“ wird installiert" exists
expect text:"Datei 1 von 4 · 0 B von 4,5 KB" exists
expect #147460 focused
expect #147461 value 0
expect #147456 disabled
expect #147458 disabled
expect #148739 disabled
cmd 1039 2
sync
expect text:"Datei 3 von 4 · 833 B von 4,5 KB" exists
expect #147461 value 177
click button:"Abbrechen"
sync
expect text:"Abgebrochen" exists
expect text:"Was schon angekommen ist, bleibt, und beim nächsten Mal geht es dort weiter. Was vorher da war, ist unverändert." exists
expect #147460 missing
expect text:"Noch keine Kurse" exists
expect button:"Kurs: Grundkurs" missing
expect text:"Einsteiger · 10 Min. · Version 1 · 4,5 KB · angefangen, es geht dort weiter" exists
# on from there: the two files that came stay
focus #148738
click #148738
sync
expect text:"Datei 3 von 4 · 833 B von 4,5 KB" exists
cmd 1039 2
sync
expect text:"„Grundkurs“ ist installiert" exists
expect text:"Noch keine Kurse" missing
expect button:"Kurs: Grundkurs" exists
expect #135424 focused
expect text:"Version 1 · 4,5 KB · aktuell" exists
expect button:"Erneut installieren" exists
# and the start page knows it
key esc
expect button:"Kurs: Grundkurs" exists
expect button:"Alle Kurse …" exists
click button:"Alle Kurse …"
# ---- refused: a course that is not in order, a file against the list; the course that is here stays
focus #148736
click #148736
sync
cmd 1039 2
sync
expect text:"Dieser Kurs ist nicht in Ordnung" exists
expect text:"Der Kurs defekt hat 1 Fehler." exists
expect text:"Er wurde nicht installiert, was vorher da war, bleibt. Das sagt die Prüfung:" exists
expect text:"Schritt weg: die Datei labs/fehlt.jfnet fehlt." exists
expect button:"Kurs: Defekter Kurs" missing
focus #148737
click #148737
sync
cmd 1039 2
sync
expect text:"Eine Datei passt nicht zur Kursliste" exists
expect text:"Die Prüfsumme der Datei de/x.md stimmt nicht mit der Kursliste überein." exists
expect "Eine Datei passt nicht zur Kursliste" exists
expect button:"Kurs: Falsche Prüfsumme" missing
expect button:"Kurs: Grundkurs" exists
# ---- the folder closes: no list again, the course is simply there
click button:"Ordner schließen"
expect #147458 focused
expect text:"Noch ein Kurs" missing
expect button:"Kurs: Grundkurs" exists
expect text:"Version 1 · 4,5 KB" exists
expect button:"Erneut installieren" missing
# ---- a lesson: a web link opens only after a question that shows the address; a lab after it
click button:"Kurs: Grundkurs"
expect text:"0 von 2 Schritten erledigt" exists
click button:"Beginnen"
expect heading:"Die erste Lektion" exists
click link:"Mehr dazu"
expect dialog:"Diese Adresse öffnen?" exists
expect text:"https://example.org/kurs" exists
click button:"Abbrechen"
expect dialog:"Diese Adresse öffnen?" missing
click link:"Mehr dazu"
key esc
expect dialog:"Diese Adresse öffnen?" missing
expect heading:"Die erste Lektion" exists
click link:"Mehr dazu"
click button:"Öffnen"
expect dialog:"Diese Adresse öffnen?" missing
expect text:"Schritt 1 von 2" exists
click button:"Weiter"
expect button:"Zurück zum Kurs" exists
click button:"Zurück zum Kurs"
expect text:"1 von 2 Schritten erledigt" exists
cmd 1005
# ---- an update: only when the list has a newer version
click button:"Aus Ordner installieren …"
click text:"academy_src2"
click button:"Ordner auswählen"
sync
expect text:"Version 1 · 4,5 KB · Version 2 verfügbar" exists
expect button:"Aktualisieren" exists
expect text:"Alle Kurse dieser Kursliste sind installiert." exists
# cancelled: the old course stays and can be opened
focus button:"Aktualisieren"
click button:"Aktualisieren"
sync
expect text:"Datei 1 von 6 · 0 B von 4,7 KB" exists
cmd 1039 3
sync
click button:"Abbrechen"
sync
expect text:"Abgebrochen" exists
expect text:"Version 1 · 4,5 KB · Version 2 verfügbar" exists
click button:"Kurs: Grundkurs"
expect text:"1 von 2 Schritten erledigt" exists
click #136192
expect heading:"Die erste Lektion" exists
key esc
key esc
# the update goes on while the learner reads that course: the page goes back to its outline, the progress stays, the
# lab stays the project below it
focus button:"Aktualisieren"
click button:"Aktualisieren"
sync
click button:"Kurs: Grundkurs"
click #136192
expect heading:"Die erste Lektion" exists
cmd 1039 3
sync
expect "Dieser Kurs hat sich geändert" exists
expect text:"1 von 3 Schritten erledigt" exists
click #136192
expect heading:"Die erste Lektion, neue Fassung" exists
key esc
key esc
expect text:"Version 2 · 4,7 KB · aktuell" exists
expect button:"Aktualisieren" missing
expect button:"Erneut installieren" exists
# ---- uninstall: with a question, with the open lab left alone, the progress kept
focus #148224
click #148224
expect dialog:"Kurs deinstallieren?" exists
expect text:"„Grundkurs“ wird von diesem Rechner entfernt. Ihr Fortschritt bleibt erhalten und gilt wieder, wenn Sie den Kurs erneut installieren." exists
expect text:"Das offene Labor dieses Kurses bleibt als Projekt geöffnet, nur ohne die Leiste des Kurses." exists
click button:"Abbrechen"
expect button:"Kurs: Grundkurs" exists
focus #148224
click #148224
click button:"Deinstallieren"
sync
expect text:"„Grundkurs“ ist deinstalliert" exists
expect text:"Ihr Fortschritt bleibt erhalten und gilt wieder, wenn Sie den Kurs erneut installieren." exists
expect button:"Kurs: Grundkurs" missing
expect text:"Noch keine Kurse" exists
key esc
expect button:"Zurück zum Kurs" missing
expect tab:"Geräte" exists
# back in, from the folder: what was done counts again
cmd 1005
focus #148736
click #148736
sync
cmd 1039 6
sync
expect text:"„Grundkurs“ ist installiert" exists
click button:"Kurs: Grundkurs"
expect text:"1 von 3 Schritten erledigt" exists
key esc
# ---- the keyboard: the note's close, the two ways, a course's buttons; Abbrechen takes the keyboard while a worker runs
click #147463
focus #147458
key enter
expect dialog:"Ordner auswählen" exists
key esc
focus #147712
key enter
sync
expect #147460 focused
key enter
sync
expect text:"Abgebrochen" exists
focus #148224
key enter
expect dialog:"Kurs deinstallieren?" exists
key esc
expect dialog:"Kurs deinstallieren?" missing
expect button:"Kurs: Grundkurs" exists
# ---- English
cmd 216
focus #209344286
click #209344286
click "English"
click button:"Close"
expect button:"Look for courses" exists
expect button:"Install from folder …" exists
expect button:"Uninstall" exists
expect text:"Version 2 · 4.7 KB · current" exists
focus button:"Install again"
click button:"Install again"
sync
expect text:"Installing “Basic course”" exists
expect text:"File 1 of 6 · 0 B of 4.7 KB" exists
click button:"Cancel"
sync
expect text:"Cancelled" exists
click button:"Close folder"
click button:"Look for courses"
sync
expect text:"The connection was not allowed" exists
expect text:"The connection to raw.githubusercontent.com was not allowed." exists
cmd 216
focus #209344286
click #209344286
click "Deutsch"
click button:"Schließen"
expect button:"Nach Kursen suchen" exists
expect_nowarn
