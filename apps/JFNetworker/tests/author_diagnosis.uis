#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/lan_router.jfnet
# a diagnosis in Aufgabe erstellen (workspace/author.rs): the device or cable that is the cause; what is refused, a
# device, a cable, its row, its editor, removing it, and a task that keeps it through saving into the project.
# Ids: 510 Aufgabe erstellen, 147536 its cause, 147537 Diagnose hinzufügen, 63488 + ... as in assess_author.uis.
size 1280 800
theme light
wait 1000
cmd 510
click button:"Aktuelles Netz als Ziel"
expect text:"Ziel: 3 Geräte, 2 Kabel." exists
# ---- refused, each with its reason
focus #147537
key enter
expect text:"Nennen Sie ein Gerät oder die beiden Enden eines Kabels: R1 oder PC1 - SW1." exists
focus #147536
type "XX"
focus #147537
key enter
expect text:"Das Gerät XX gibt es im Projekt nicht." exists
focus #147536
key ctrl+a
type "PC1 - PC2"
focus #147537
key enter
expect text:"Zwischen PC1 und PC2 gibt es kein Kabel." exists
# ---- a device
focus #147536
key ctrl+a
type "r1"
focus #147537
key enter
expect text:"Zwischen PC1 und PC2 gibt es kein Kabel." missing
expect #147536 text ""
expect button:"Welches Gerät oder Kabel ist die Ursache? → R1 · 2 Punkte" exists
expect text:"Ursache" exists
# ---- a cable
focus #147536
type "PC1 - R1"
focus #147537
key enter
expect button:"Welches Gerät oder Kabel ist die Ursache? → PC1 - R1 · 2 Punkte" exists
# ---- it goes again
click button:"Welches Gerät oder Kabel ist die Ursache? → R1 · 2 Punkte"
click button:"Nicht bewerten"
expect button:"Welches Gerät oder Kabel ist die Ursache? → R1 · 2 Punkte" missing
expect button:"Welches Gerät oder Kabel ist die Ursache? → PC1 - R1 · 2 Punkte" exists
expect_nowarn
