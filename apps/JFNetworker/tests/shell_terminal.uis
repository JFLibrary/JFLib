#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/shell_tour.jfnet
# PC1's shell in the Terminal panel (V1, doc/console.rs): folders with mkdir and cd (the prompt
# shows the working directory), ls, Tab completes a path (a directory with its /, a file with a
# space after it; several choices: their common part, then the list below the line), a pipe, a
# jfs script run as a process and ended with Ctrl+C ($? is 130 then), a background job with its
# "[1] PID" at once and its done line before the next prompt, less paging through --More--.
# The files reach the project as undo steps (--verify-dirty: the project is changed after it).
# Ids: PC1's console 25088 (its input line 25089).
size 1280 900
theme light
drag 630,671 630,380 8
dblclick listitem:"PC1"
expect tab:"PC1" selected
expect #25089 focused
expect text:"root@PC1:~# " exists
type "mkdir -p app/lib\n"
type "cd app\n"
expect text:"root@PC1:~# cd app" exists
type "echo hallo > notiz.txt; ls\n"
expect text:"root@PC1:~/app# echo hallo > notiz.txt; ls" exists
expect text:"lib  notiz.txt" exists
# Tab: a directory gets its /, a file a space after it
type "cd l"
key tab
expect #25089 text "cd lib/"
key ctrl+a
key backspace
type "cat no"
key tab
expect #25089 text "cat notiz.txt "
key enter
expect text:"hallo" exists
# several choices: the common part first, the list with the next Tab
type "touch server.jfs service.jfs\n"
type "cat se"
key tab
expect #25089 text "cat serv"
key tab
expect text:"server.jfs   service.jfs" exists
key ctrl+a
key backspace
# a pipe
type "echo eins zwei drei | wc -w | xargs echo Anzahl\n"
expect text:"Anzahl 3" exists
# a script as a process: the console waits for it, Ctrl+C ends it
type "echo 'let n = 0; timer.every(1000, fn() { n += 1; print(\"tick ${n}\") })' > tick.jfs\n"
type "jfs tick.jfs\n"
wait 2500
expect text:"tick 2" exists
expect #25089 missing
key ctrl+c
expect text:"^C" exists
expect #25089 focused
type "echo Status $?\n"
expect text:"Status 130" exists
# a background job: "[1] PID" at once, the done line with the next prompt
type "sleep 1 &\n"
expect text:"[1] 102" exists
wait 1500
type "\n"
expect text:"[1]+  Done                    sleep 1" exists
shot build/jfnetworker/shell_terminal.png
# less pages with --More-- (Space the next page)
type "seq 30 > zahlen.txt; less zahlen.txt\n"
expect text:" --More-- " exists
expect #25089 missing
key space
expect text:"30" exists
expect text:" --More-- " missing
expect #25089 focused
# the project has the files: one undo step each
click menu:"Bearbeiten"
expect menuitem:"Rückgängig" exists
key esc
expect_nowarn
