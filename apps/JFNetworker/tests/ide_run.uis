#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/ide.jfnet
# running from the IDE (IDE1: workspace/ide/debug.rs, lower.rs; jfn_sim's services from files) on
# SRV1 of fixtures/ide.jfnet: hallo.jfs as a process (Ctrl+F5 types "jfs FILE" into the
# Terminal, its output follows there); server.jfs as a service (F5 restarts web, which runs the
# file: Ausgabe shows its output, a request from PC1 adds a line); saving the file changes
# nothing in the running program -- the status line says so and its Neu starten takes the saved
# file; Stoppen (Shift+F5); the Dienste tab names the service.
# Ids: the device window 26624; the IDE from 98304: Ausführen 98307, Als Prozess ausführen
# 98323, Als Dienst ausführen 98324, Stoppen 98325, Neu starten 98326, the hint's Neu starten
# 98689, the editor 98816, Ausgabe 98569, Terminal 98570.
size 1280 900
theme light
wait 1500
rclick listitem:"SRV1"
move 700,300
click menuitem:"IDE …"
expect window 26624 open
resizewin 26624 1100 760
wait 300
dblclick listitem:"app"
wait 600
# a process: jfs FILE in the Terminal
dblclick listitem:"hallo.jfs"
wait 300
expect tab:"hallo.jfs" selected
expect text:"Dienst web: läuft" missing
expect #98325 disabled
key ctrl+f5
wait 500
expect #98570 selected
expect text:"Hallo aus /root/app/hallo.jfs" exists
expect text:"0 Argumente" exists
shot build/jfnetworker/ide_run_process.png window 26624
# a service: web runs server.jfs; F5 starts it anew, Ausgabe follows it
wait 600
dblclick listitem:"server.jfs"
wait 300
expect tab:"server.jfs" selected
expect text:"Dienst web: läuft" exists
expect #98325 enabled
key f5
wait 300
expect #98569 selected
expect text:"bereit auf Port 80" exists
rclick listitem:"PC1"
move 700,300
click menuitem:"Konsole öffnen"
wait 200
type "curl -s http://10.0.0.1/abc\n"
wait 500
expect text:"Hallo /abc (4 Zeichen)" exists
activate 26624
wait 100
expect text:"Anfrage 1: /abc" exists
shot build/jfnetworker/ide_run_service.png window 26624
# saving the running file: the program stays as it was until Neu starten
click #98816
key ctrl+end
type "print(\"neu geladen\")"
key ctrl+s
wait 100
expect text:"Der Dienst web läuft noch mit der Fassung vor dem Speichern – Neu starten übernimmt die Datei." exists
expect text:"neu geladen" missing
click #98689
wait 300
expect text:"Der Dienst web läuft noch mit der Fassung vor dem Speichern – Neu starten übernimmt die Datei." missing
expect text:"bereit auf Port 80" exists
expect text:"neu geladen" exists
expect text:"Anfrage 1: /abc" missing
# Stoppen
click #98816
key shift+f5
wait 100
expect text:"Dienst web: gestoppt" exists
expect #98325 disabled
wait 600
click #98324
wait 100
expect text:"Dienst web: läuft" exists
# the Dienste tab lists web as a script
wait 600
click tab:"Dienste"
expect text:"Skript · web" exists
expect_nowarn
