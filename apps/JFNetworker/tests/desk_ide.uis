#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/ide.jfnet
# the IDE on a host's desktop (devwin/desktop.rs ide_window and open_jfs: IDE1's IDE in V2's
# maximised IDE window, its Terminal a session of X1e) on SRV1 of fixtures/ide.jfnet: a .jfs
# file opened in the Dateimanager comes up in the IDE; Ctrl+F5 runs it in the IDE's Terminal,
# which is a session of its own (pts/0) beside the device's console; who counts both; closing
# the IDE's window ends its session.
# Ids: the device window 26624; the IDE from 98304 (its Terminal pane 98570); the console's
# input 25089.
size 1280 900
theme light
wait 1500
dblclick listitem:"SRV1" shift
expect window 26624 open
resizewin 26624 1100 760
wait 300
expect tab:"Desktop" selected
# a script from the Dateimanager opens in the IDE
click button:"Start"
click menuitem:"Dateimanager"
expect dialog:"Dateimanager" exists
dblclick text:"app"
expect text:"/root/app" exists
dblclick text:"hallo.jfs"
wait 300
expect dialog:"IDE (maximiert)" selected
expect button:"IDE" checked
expect tab:"hallo.jfs" selected
# run as a process: in the IDE's own terminal
key ctrl+f5
wait 500
expect #98570 selected
expect text:"Hallo aus /root/app/hallo.jfs" exists
type "tty\n"
wait 100
expect text:"/dev/pts/0" exists
shot build/jfnetworker/desk_ide.png window 26624
# the device's console is another terminal: who counts both
click button:"Start"
click menuitem:"Terminal"
expect dialog:"Terminal" selected
click #25089
type "who | wc -l\n"
wait 100
expect text:"2" exists
# closing the IDE's window ends its session
rclick button:"IDE"
click menuitem:"Schließen"
expect dialog:"IDE (maximiert)" missing
click #25089
key ctrl+l
type "who | wc -l\n"
wait 100
expect text:"1" exists
expect text:"2" missing
expect_nowarn
