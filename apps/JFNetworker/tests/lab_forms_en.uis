#!args --verify-dirty --lang en --open apps/JFNetworker/tests/fixtures/lab_forms.jfnet
# the forms in English (workspace/devwin/svcform.rs): the dialog, a form's words, what a service lacks, a
# refusal, what applying does.  Ids as in lab_forms.uis
size 1400 1200
theme light
wait 2000
dblclick listitem:"HOST1" shift
resizewin 26624 900 1100
click tab:"Services"
click #140304
expect dialog:"Add a service" exists
expect text:"Answers HTTP requests, with computing time, waiting time and an error rate." exists
click #140321
click listitem:"Load balancer"
click button:"Add"
wait 200
expect text:"No backends yet: the load balancer has nobody to distribute to." exists
expect text:"The load balancer distributes to these servers: choose a device or type an address." exists
expect button:"Edit as JSON" exists
click #141056
click #140800
click listitem:"WEB1 (10.0.0.12)"
wait 50
expect #140801 text "10.0.0.12"
click #140288
wait 300
click button:"Settings …"
click #140548
key ctrl+a
type "abc"
wait 50
expect text:"Port: that is not a whole number." exists
click #140289
close window 26624
wait 100
key ctrl+shift+e
expect tab:"Experiments" selected
expect text:"No experiment yet" exists
