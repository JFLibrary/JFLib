#!args --verify-dirty --open apps/JFNetworker/tests/fixtures/web_site.jfnet
# what the Webbrowser sends over the network, by the numbers of WEB1's web server in its Dienste
# tab: a page and its picture are two requests (the picture went over the network), a link one more;
# Back and Forward show what is kept and send nothing; PC1's device window closed and opened
# again brings its browser back as it was; Reload asks again, for the picture too
# Ids (window 0): the address 26800, Zurück 26803, Vor 26804, Neu laden 26805
size 1280 900
theme light
dblclick listitem:"PC1" shift
expect window 26624 open
dblclick listitem:"Webbrowser"
click #26800
key ctrl+a
type "web.lab\n"
wait 1000
expect heading:"Bäckerei Krume" exists
expect image:"Das Zeichen der Bäckerei" exists
click link:"Unser Brot"
wait 500
expect heading:"Unser Brot" exists
click #26803
expect heading:"Bäckerei Krume" exists
click #26804
expect heading:"Unser Brot" exists
key alt+left
expect heading:"Bäckerei Krume" exists
close window 26624
# three requests: the page, its picture, the second page
dblclick listitem:"WEB1" shift
expect window 26624 open
click tab:"Dienste"
expect text:"Port 80: 3 Anfragen, 3 Antworten, 0 in Arbeit, 0 wartend" exists
close window 26624
# PC1's desktop as it was; Reload: the page and its picture again
dblclick listitem:"PC1" shift
expect window 26624 open
expect heading:"Bäckerei Krume" exists
expect #26804 enabled
click #26805
wait 500
expect heading:"Bäckerei Krume" exists
close window 26624
dblclick listitem:"WEB1" shift
expect window 26624 open
click tab:"Dienste"
expect text:"Port 80: 5 Anfragen, 5 Antworten, 0 in Arbeit, 0 wartend" exists
expect_nowarn
