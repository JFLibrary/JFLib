# Spanning Tree (IEEE 802.1D) im Dreieck: SW1 wird mit Priorität 4096 die Root-Bridge, SW3 blockiert
# seinen Port zu SW2; die Ports zwischen den Switches brauchen 2 × 15 s bis Forwarding (die PCs
# hängen an Edge-Ports). Dann fällt das Kabel SW1–SW2 aus: SW2 hält sich für die Root-Bridge, SW3
# übernimmt erst, wenn seine Information von SW2 abläuft (Max Age), und braucht dann wieder 30 s.
SW1: enable
SW2: enable
SW3: enable
SW3: debug spanning-tree events
at 1s SW3: show spanning-tree
expect SW3 output contains "Gi1/0/1             Desg LIS 20000     128.1    P2p"
at 2s PC2: ping -c 2 10.0.0.3
run 4s
expect PC2 output contains "100% packet loss"
at 16s SW2: show spanning-tree
expect SW2 output contains "Gi1/0/1             Root LRN 20000     128.1    P2p"
at 31s PC2: ping -c 2 10.0.0.3
run 2s
expect PC2 output contains "2 packets transmitted, 2 received, 0% packet loss"
SW1: show spanning-tree
expect SW1 output contains "This bridge itself is the root"
SW3: show spanning-tree
expect SW3 output contains "Gi1/0/1             Altn BLK 20000     128.1    P2p"
SW3: show spanning-tree root
at 40s link down SW1 Gi1/0/1
run 1s
SW2: show spanning-tree
expect SW2 output contains "This bridge itself is the root"
PC2: ping -c 2 -W 1 10.0.0.1
run 4s
expect PC2 output contains "100% packet loss"
at 60s SW3: show spanning-tree
expect SW3 output contains "Gi1/0/1             Desg LIS 20000     128.1    P2p"
at 88s PC2: ping -c 2 10.0.0.1
run 2s
expect PC2 output contains "2 packets transmitted, 2 received, 0% packet loss"
SW2: show spanning-tree
expect SW2 output contains "Gi1/0/2             Root FWD 20000     128.2    P2p"
SW3: show spanning-tree interface gi1/0/1 detail
expect hops stp >= 100
