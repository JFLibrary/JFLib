# Rundgang durch die Shell von PC1: ein kleiner Projektbaum mit Ordnern, ein Skript, das mit
# echo entsteht und als Prozess läuft (seine Ausgabe in eine Logdatei), das Log mit grep, Pipes
# hinter ping und curl, Jobs im Hintergrund mit jobs, ps und kill, Platzhalter und find; dazu
# Ordner in flash: von R1. Die Zeiten sind virtuell: ein Skript rechnet mit 5 ns je Anweisung,
# ein Ping braucht über SW1 rund 4 µs hin und zurück.
PC1: mkdir -p projekt/src projekt/logs
PC1: cd projekt
PC1: pwd
expect PC1 output contains "/root/projekt"
PC1: echo 'let runden = int.parse(config.args[0])' > src/zaehler.jfs
PC1: echo 'for i in 1..runden + 1 { print("Runde ${i} von ${runden}") }' >> src/zaehler.jfs
PC1: echo 'timer.after(500, fn() { print("fertig"); log("zaehler fertig") })' >> src/zaehler.jfs
PC1: cat src/zaehler.jfs
PC1: tree
expect PC1 output contains "2 directories, 1 file"
# das Skript als Prozess: die Konsole wartet, bis sein Timer abgelaufen ist
PC1: jfs src/zaehler.jfs 3 > logs/lauf.log
run 1s
PC1: echo $?
expect PC1 output contains "0"
PC1: cat logs/lauf.log
expect PC1 output contains "Runde 3 von 3"
PC1: grep -c Runde logs/lauf.log
expect PC1 output contains "3"
PC1: grep -n fertig logs/lauf.log
expect PC1 output contains "4:fertig"
PC1: ls -l logs
# Pipes: die linke Seite liefert, wenn sie fertig ist
PC1: ping -c 3 10.0.0.10 | grep -c ttl
run 4s
expect PC1 output contains "3"
PC1: ping -c 2 10.0.0.10 | tail -1 | cut -d ' ' -f 1,2
run 3s
expect PC1 output contains "rtt min/avg/max/mdev"
PC1: curl -s http://10.0.0.10/ | tee logs/seite.html | wc -c
run 1s
expect PC1 output contains "15"
# Jobs im Hintergrund: ihre Ausgabe kommt ins Terminal, das Ende vor der nächsten Eingabe
PC1: jfs src/zaehler.jfs 2 &
PC1: sleep 30 &
PC1: jobs
expect PC1 output contains "[2]+  Running                 sleep 30 &"
PC1: ps
expect PC1 output contains "    1 root     ?        0:00 init"
run 1s
PC1: kill %2
expect PC1 output contains "[2]+  Terminated              sleep 30"
PC1: jobs
# Platzhalter, find, Umleitungen und Listen
PC1: ls logs/*.log logs/*.html
PC1: find . -type f | sort
PC1: find . -name '*.log' | wc -l; test -f nichts.txt || echo fehlt
expect PC1 output contains "fehlt"
PC1: grep -l Runde */*.log && echo gefunden
expect PC1 output contains "gefunden"
PC1: cat nichts.txt 2> fehler.txt; echo Status $?; cat fehler.txt
expect PC1 output contains "Status 1"
expect PC1 output contains "cat: nichts.txt: No such file or directory"
PC1: cd /; ls; cd -
PC1: history | tail -2
# Ordner in flash: von R1
R1: enable
R1: mkdir sicherung
R1: cd sicherung
R1: copy running-config r1.cfg
R1: dir
expect R1 output contains "Directory of flash:/sicherung/"
R1: pwd
expect R1 output contains "flash:/sicherung/"
R1: cd ..
R1: dir
expect R1 output contains "drw-"
