# RIP im Ring: R1 bis R4 mit RIPv2 (network 10.0.0.0, die LANs passiv), hinter jedem ein PC.
# Beim Start fragt jeder Router nach den Tabellen der Nachbarn und schickt seine eigene; was neu
# ist, geht als ausgelöstes Update weiter. Zu R3s LAN führen zwei gleich gute Wege. Dann wird das
# Kabel R1-R2 gezogen: R1 und R2 melden die verlorenen Netze mit Metrik 16, halten sie im
# Holddown und löschen sie nach der Garbage Collection (120 s); mit dem nächsten Update von R4
# bzw. R3 führt der Weg über die andere Seite des Rings.
R1: enable
R1: debug ip rip
run 5s
expect R1 output contains "RIP: new route 10.0.2.0/24 via 10.0.12.2, metric 2"
expect R1 output contains "RIP: triggered update v2 out of GigabitEthernet0/0/0 to 224.0.0.9, 2 routes"
expect R1 output contains "RIP: one more path to 10.0.3.0/24 via 10.0.14.4, metric 3"
R1: undebug all
run 35s
R1: show ip route
expect R1 route 10.0.2.0/24 via 10.0.12.2
expect R1 route 10.0.3.0/24 via 10.0.12.2
expect R1 route 10.0.3.0/24 via 10.0.14.4
expect R1 route 10.0.4.0/24 via 10.0.14.4
expect R1 route 10.0.23.0/24 via 10.0.12.2
R1: show ip rip database
R1: show ip protocols
R1: show running-config
expect R1 output contains "router rip\n version 2\n passive-interface GigabitEthernet0/0/2\n network 10.0.0.0\n no auto-summary\n!"
R3: enable
R3: show ip route rip
expect R3 route 10.0.1.0/24 via 10.0.23.2
expect R3 route 10.0.1.0/24 via 10.0.34.4
PC1: ping -c 2 10.0.3.10
run 3s
PC1: traceroute -n 10.0.3.10
run 10s
expect PC1 output contains " 2  10.0.14.4"
expect PC1 output contains " 3  10.0.34.3"
expect PC1 output contains " 4  10.0.3.10"
# das Kabel R1-R2 fehlt
link down R1 Gi0/0/1
run 1s
R1: show ip route
expect R1 no route 10.0.2.0/24
expect R1 route 10.0.3.0/24 via 10.0.14.4
R1: show ip rip database
expect R1 output contains "10.0.2.0/24    unreachable (metric 16): held down"
R2: enable
R2: show ip rip database
R4: enable
R4: show ip route rip
PC1: ping -c 1 10.0.2.10
run 3s
expect PC1 output contains "Destination Net Unreachable"
# nach der Garbage Collection: der Weg über R4 und R3
run 180s
R1: show ip route rip
expect R1 route 10.0.2.0/24 via 10.0.14.4
R1: show ip rip database
R2: show ip route rip
expect R2 route 10.0.1.0/24 via 10.0.23.3
PC1: ping -c 2 10.0.2.10
run 12s
expect PC1 output contains "64 bytes from 10.0.2.10: icmp_seq=2 ttl=60"
PC1: traceroute -n 10.0.2.10
run 10s
expect PC1 output contains " 2  10.0.14.4"
expect PC1 output contains " 3  10.0.34.3"
expect PC1 output contains " 4  10.0.23.2"
expect PC1 output contains " 5  10.0.2.10"
expect R1 svc rip metric neighbours == 1
expect hops rip >= 60
