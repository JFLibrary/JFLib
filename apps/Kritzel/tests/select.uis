# selection tool ("Auswahl"): rectangle, move, undo, select all + delete, copy / paste
# (headless clipboard), keyed-out background colour, crop, free-form, invert, resize,
# rotate, commit on tool change
expect text:"1152 × 648px" exists
# something to select: a red brush stroke and a blue pencil line
click #1213
drag 200,332 600,412 12
click #1100
click #1217
drag 150,232 700,252 10
# select tool; the flyout under the big button chooses the rectangle
click #1107
expect #1107 checked
click #1400
expect #1401 checked
expect #1402 unchecked
expect #1404 disabled
click #1401
# a rectangle around the red stroke, moved by dragging inside
drag 180,312 620,432 8
expect text:"440 × 120px" exists
