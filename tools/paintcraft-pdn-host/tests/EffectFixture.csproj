<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><NoWarn>$(NoWarn);CS0618</NoWarn>
    <PaintDotNetDir Condition="'$(PaintDotNetDir)' == ''">C:\Program Files\paint.net</PaintDotNetDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EffectFixture.cs" />
    <ProjectReference Include="K4os.Compression.LZ4.csproj" />
    <Reference Include="PaintDotNet.Base;PaintDotNet.Collections;PaintDotNet.ComponentModel;PaintDotNet.Core;PaintDotNet.Data;PaintDotNet.Effects.Core;PaintDotNet.Effects.Gpu;PaintDotNet.Framework;PaintDotNet.Fundamentals;PaintDotNet.ObjectModel;PaintDotNet.Primitives;PaintDotNet.PropertySystem;PaintDotNet.Windows;PaintDotNet.Windows.Core;PaintDotNet.Windows.Framework">
      <HintPath>$(PaintDotNetDir)\%(Identity).dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
