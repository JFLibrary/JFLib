# app:// assets (apps/NAME/assets) are built into the program byte for byte: no line-ending
# conversion on checkout
apps/*/assets/** -text
# the WGSL corpus (tools/wgsl_corpus): expected.json holds byte offsets into the .wgsl files, and
# some files test line breaks themselves: no line-ending conversion
tools/wgsl_corpus/** -text
# render2dtest's DXF files from ezdxf (apps/render2dtest/dxf): byte for byte as published, one of them binary
apps/render2dtest/dxf/** -text
# modeltool's examples and their reports are built into the program (include_str!) and hashed by its checksum:
# no line-ending conversion on checkout, so the checksum does not depend on the checkout
apps/modeltool/examples/** -text
